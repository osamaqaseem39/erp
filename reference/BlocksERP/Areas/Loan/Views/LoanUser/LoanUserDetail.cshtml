@{
    string lineColor = "#212121";
    ViewBag.Title = "Loan User Detail";
}


<style>
       .heading-1 {
        position: relative;
        text-align: center;
    }

        .heading-1:before {
            content: "";
            display: block;
            border-top: solid 2px @lineColor;
            width: 100%;
            height: 2px;
            position: absolute;
            top: 50%;
            z-index: 0;
        }

        .heading-1 span {
            background: #fff;
            padding: 0 10px;
            position: relative;
            z-index: 1;
        }
    .ItemNote:focus {
        background-color: #F0FFF0 !important;
        border-color: #7DC27D !important;
    }

</style>


@model BlocksERP.Models.clsUser
<main id="js-page-content" role="main" class="page-content">
    <div class="mySelect" style="overflow: hidden;padding: 0px">
            <div class="row">
                <div class="col-lg-6" style="margin-top:4px">

                </div>
                <div class="col-md-12" style="display:flex">
                    <table style="width:100%">
                        <tr>
                            <th>
