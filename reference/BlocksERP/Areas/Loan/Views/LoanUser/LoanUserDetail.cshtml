                            @{
                                int vrownumw = 0;
                            }
                            <table class="table table-striped table-bordered" style="width:95%;margin-left:20px">
                                <thead style="background-color: #212121; color: white;">
                                    <tr>
                                        <th style="text-align:center;width:50px;">Sr#</th>
                                        <th style="text-align:left;">Document Type</th>
                                        <th style="text-align:center;width:100px;">Date</th>
                                        <th style="text-align:center;width:100px;">Description</th>
                                        <th style="text-align:center;width:60px;">Status</th>
                                        <th style="text-align: center; width: 50px;">OK</th>
                                        <th style="text-align: center; width: 50px;">View</th>
                                        <th style="text-align: center; width: 50px;">Download</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BlocksERP.Models.clsDocument vrow in Model.DocList)
                                    {
                                        vrownumw++;

                                        <tr style="border-bottom: 1px solid #D8D8D8">
                                            <td style="text-align: center; padding: 3px">@vrownumw</td>
                                            <td style="text-align: left; padding: 3px">@vrow.DocumentType </td>
                                            <td style="text-align: left; padding: 3px">@Convert.ToDateTime(vrow.Date).ToString("dd-MMM-yyyy")</td>
                                            <td style="text-align: left; padding: 3px">@vrow.Description </td>
                                            <td style="text-align: center; padding: 3px" id="rowStatus_@vrow.DocumentId">@vrow.Status </td>
                                            @if (vrow.Status.ToLower() != "verified")
                                            {
                                                <td style="text-align: center; padding: 3px">
                                                    <a href="javascript:void(0);" id="rowBtn_@vrow.DocumentId" data-value="@vrow.DocumentId" class="btn btn-primary verifyDocument" style="padding:5px;color:#fff !important">
                                                        OK
                                                    </a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td style="text-align: center; padding: 3px">
                                                    &nbsp;
                                                </td>
                                            }

                                            <td style="text-align: center; padding: 3px">
                                                <a href="/FormsDocuments/UserDocument/@Convert.ToInt32(vrow.userId).ToString()/@Convert.ToInt32(vrow.DocumentId).ToString().@vrow.DocumentExtension" data-value="@vrow.DocumentId" target="_blank" class="btn btn-warning viewDocument" style="padding:5px;color:#000 !important">
                                                    View
                                                </a>
                                            </td>
                                            <td style="text-align: center; padding: 3px">
                                                <a href="/FormsDocuments/UserDocument/@Convert.ToInt32(vrow.userId).ToString()/@Convert.ToInt32(vrow.DocumentId).ToString().@vrow.DocumentExtension" data-value="@vrow.DocumentId" download class="btn btn-success downloadDocument" style="padding:5px;color:#000 !important">
                                                    Download
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <div class="panel-container show">
                        <div class="panel-content">
                            <h1 class="heading-1" style="margin-top: 30px;  color:@lineColor;font-weight:bold "><span>Job/Works Detail</span></h1>
                            @{
                                int vrownum = 0;
                            }
                            <table class="table table-striped table-bordered" style="width:95%;margin-left:20px">
                                <thead style="background-color: #212121; color: white;">
                                    <tr>
                                        <th style="text-align:center;width:50px;">Sr#</th>
                                        <th style="text-align:left;">Income Source</th>
                                        <th style="text-align:center;width:100px;">D.O.J</th>
                                        <th style="text-align:center;width:100px;">Status</th>
                                        <th style="text-align: center; width: 100px;">Organization<br />Name</th>
                                        <th style="text-align: center; width: 100px;">Phone No.</th>
