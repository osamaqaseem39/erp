                                            <td style="text-align: left; padding: 3px">@vrow.ContactRelationName</td>
                                            <td style="text-align: left; padding: 3px">@vrow.RefferalName</td>
                                            <td style="text-align: left; padding: 3px">@vrow.RefferalPhoneNumber </td>
                                            <td style="text-align: left; padding: 3px">@vrow.RefferalSIN </td>
                                            <td style="text-align: left; padding: 3px">@vrow.RefferalAddress </td>
