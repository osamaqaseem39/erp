                                            <td style="text-align: center; padding: 3px">@vrownumb</td>
                                            <td style="text-align: left; padding: 3px">@vrow.BankName</td>
                                            <td style="text-align: left; padding: 3px">@vrow.AccountNumber</td>
                                            <td style="text-align: left; padding: 3px">@vrow.HolderName </td>
                                            <td style="text-align: left; padding: 3px">@vrow.Description </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                </div>

                <fieldset style="padding:1.25rem">
                </fieldset>

                <footer class="modal-footer" style="margin-top:-50px;background-color:#F9F9F9;border-top:1px solid #ddd">

                    @*@if (Model.DeleteRoleId > 0)
        {
            <button type="button" class="btn btn-danger pull-left btnDeleteRecord">Delete</button>
        }*@

                    @if (Model.Status.ToLower() == ("Pending").ToLower())
                    {
                        <a href="/loan/loanuser/newloanuserIndex">
                            <button type="button" class="btn btn-labeled btn btn-secondary pull-right">
                                Close
                            </button>
                        </a>


                        <button type="button" id="btn_Save" title="Verify" class="btn btn-primary btnVerifyUser">Verify</button>
                    }
                    else
                    {
                        <a href="/loan/loanuser/loanuserIndex">
                            <button type="button" class="btn btn-labeled btn btn-secondary pull-right">
                                Close
                            </button>
                        </a>
                    }





                </footer>
    }
    </div>
</main>
<script type="text/javascript">
    $(document).on('click', '.verifyDocument', function () {
        var id = $(this).attr("data-value");
        var checkstr = confirm('Are you sure you want to verify this Record?');
        if (checkstr == true) {
            $.ajax({
                url: '/loan/loanuser/UpdateDocumentStatus/',
                data: { 'id': id, 'status': 'verified' },
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {
                        toastr.success("Record Updated Successfully", "Update", { timeOut: 3000, "closeButton": true });
                        $('#rowStatus_' + id).html("verified");
                        $('#rowBtn_' + id).hide();
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        }
        else {
            return false;
        }
    });

    function checkpendingDocument(id) {
        $.ajax({
            url: '/loan/loanuser/CheckAnyPendingDocuement/' + id,
            type: "POST",
            dataType: 'json',
            success: function (data) {
                if (data.status == true) {
                    if (parseInt(data.countPending) != 0) {
                        return 0;
                    } else {
                        return 1;
                    }
                }
                else {
                    return 0;
                }
            }
        })
    }

    $(document).on('click', '.btnVerifyUser', function () {
        var id = $("#UserId").val();
        //var vretnum = checkpendingDocument(id);
        //alert(vretnum);

        //if (checkpendingDocument(id) == 1) {
            var checkstr = confirm('Are you sure you want to verify this Record?');
            if (checkstr == true) {
                $.ajax({
                    url: '/loan/loanuser/UpdateUserStatus/',
                    data: { 'id': id, 'status': 'Active' },
                    type: "POST",
                    dataType: 'json',
                    success: function (data) {
                        if (data.status == true) {
                            toastr.success("Record Updated Successfully", "Update", { timeOut: 3000, "closeButton": true });
                            window.location = "/loan/loanuser/newloanuserIndex";

                        }
                        else {
                            toastr.error(data.message, "Error", { timeOut: 3000, "closeButton": true });
                        }
                    }
                })
            }
            else {
                return false;
            }
        //} else {
        //    toastr.error("First Verify all Documents", "Error", { timeOut: 3000, "closeButton": true });
        //}

    });



</script>

<script>
    // Example starter JavaScript for disabling form submissions if there are invalid fields
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName('needs-validation');
            // Loop over them and prevent submission
            var validation = Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

</script>
