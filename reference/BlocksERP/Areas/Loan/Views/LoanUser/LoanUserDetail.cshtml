                            }
                            <table class="table table-striped table-bordered" style="width:95%;margin-left:20px">
                                <thead style="background-color: #212121; color: white;">
                                    <tr>
                                        <th style="text-align:center;width:50px;">Sr#</th>
                                        <th style="text-align: left; width: 100px;">Bank Name</th>
                                        <th style="text-align:center;width:130px;">Account No.</th>
                                        <th style="text-align:center;width:130px;">Account Title</th>
                                        <th style="text-align: center;">Description</th>
                                    </tr>
                                </thead>
                                <tbody>
