<style>
</style>
@model BlocksERP.Models.clsAdminEmail
<div style="overflow-x:hidden;margin-top:-20px;padding:0px">
    @using (Html.BeginForm("InsertUpdateAdminEmail", "AdminEmail", FormMethod.Post, new { id = "popupForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
    {
    <fieldset style="padding:1.25rem">
        <div class="row" style="margin-top:15px">
            <section class="col col-md-12">
                <label class="form-label">Admin Email (*)</label>
                <input type="hidden" id="AdminEmailID" name="AdminEmailID" value=@Model.AdminEmailID />
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text">
                            <i class="fal fa-info"></i>
                        </span>
                    </div>
                    @Html.TextBoxFor(a => a.AdminEmail, new { @placeholder = "Admin Email", @class = "form-control num",autocomplete="off" })
                </div>
            </section>
        </div>
        <div class="row" style="margin-top:15px">
            <div class="col-md-12">
                <label class="form-label">Type</label>
                @*<div>
                    <select class="custom-select num" id="Type" name="Type">
                        <option value="Admin" selected>Admin</option>
                        <option value="Sales">Sales</option>
                    </select>
                </div>*@
                @Html.TextBoxFor(a => a.Type, new { @placeholder = "", @class = "form-control num", autocomplete = "off" })
            </div>
        </div>
        @if (Model != null && Model.AdminEmailID > 0)
        {
            <div class="row" style="margin-top:15px">
                <section class="col-md-12">
                    <label class="form-label" style="margin-top: -7px;position:absolute;right:15px;">
                        @if (Model.Status == 1)
                        {
                            <input id="Status" type="checkbox" name="Status" checked /><i></i>
                        }
                        else
                        {
                            <input id="Status" type="checkbox" name="Status" /><i></i>
                        }
                        Active
                    </label>
                </section>
            </div>
        }
    </fieldset>
        <footer class="modal-footer" style="margin-top:11px;background-color:#F9F9F9;border-top:1px solid #ddd">
            @if (Model.DeleteRoleId > 0)
            {
                <button type="button" class="btn btn-danger pull-left btnDeleteRecord">Delete</button>
            }
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            @if (Model.AdminEmailID > 0)
            {
                if (Model.UpdateRoleId > 0)
                {
                    <button type="submit" id="btn_Save" class="btn btn-primary btnSaveForm">Update</button>

                }
            }
            else
            {
                <button type="submit" id="btn_Save" class="btn btn-primary btnSaveForm">Save</button>
            }
        </footer>
    }
</div>
<script src="~/Scripts/app.bundle.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
      
       
    })
    var $checkoutForm = $('#popupForm').validate({
        rules: {
            AdminEmail: {
                required: true
            },
        },
        messages: {
            AdminEmail: {
                required: 'Admin Email is required.'
            },
        },
        errorPlacement: function (error, element) {
            error.insertAfter(element.parent());
        }
    });
    $(".num").keyup(function (event) {
        if (event.keyCode == 13) {
            textboxes = $(".num");
            currentBoxNumber = textboxes.index(this);
            if (currentBoxNumber == 1) {
                $('#btn_Save').focus();
                $('#btn_Save').click();
            }
                else  {
                    nextBox = textboxes[currentBoxNumber + 1];
                    nextBox.focus();
                    nextBox.select();
                }
            event.preventDefault();
            return false;
        }
    });
    $('#popupForm').on('submit', function (e) {
        e.preventDefault();
        if (!$("#popupForm").valid()) {
            return false;
        }

        $('#btn_Save').attr('disabled', 'disabled');
        $('#btn_Save').html("<i class='fa fa-refresh fa-spin'></i> &nbsp; Processing...");
        var AdminEmailID = $('#AdminEmailID').val();
        var AdminEmail = $('#AdminEmail').val();
        var Type = $('#Type').val();
        var statusString = '';
        if ($('#Status').is(":checked")) {
            statusString = "Active";
        }
        else {
            statusString = "Inactive";
        }

        var st =
        {
            AdminEmailID: AdminEmailID,
            AdminEmail: AdminEmail,
            Type: Type,
            StatusString: statusString
        }
        $.ajax({
            type: "POST",
            url: "/Loan/AdminEmail/InsertUpdateAdminEmail/",
            data: st,
            dataType: 'json',
            success: function (data) {

                if ($('#AdminEmailID').val() > 0) {
                    $('#btn_Save').html("Update");
                }
                else {
                    $('#btn_Save').html("Save");
                }
                $('#btn_Save').prop('disabled', false);
                if (data.status) {
                    toastr.success("Record Saved Successfully", "Success", { timeOut: 3000, "closeButton": true });
                    $('.close').click();
                    oTable.ajax.reload(null, false);
                }
                else {
                    toastr.error(data.message, "Error", { timeOut: 3000, "closeButton": true });
                }
            }
        })
    })
</script>
<script>
    // Example starter JavaScript for disabling form submissions if there are invalid fields
    (function () {
        'use strict';
        window.addEventListener('load', function () {
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.getElementsByClassName('needs-validation');
            // Loop over them and prevent submission
            var validation = Array.prototype.filter.call(forms, function (form) {
                form.addEventListener('submit', function (event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

</script>