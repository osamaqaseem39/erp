    $(document).on('click', '.btnDeleteRecord', function () {

        var id = $('#AdminEmailID').val();
        DeleteRecord(id);
    });


    //========= DELETE FUNCTION ==========\\
    function DeleteRecord(id) {


        var checkstr = confirm('Are you sure you want to delete this Record?');
        if (checkstr == true) {
            $.ajax({
                url: '/Loan/AdminEmail/DeleteAdminEmail/' + id,
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {
                        //$('#MyModal').modal('toggle');
                        toastr.success("Record Deleted Successfully", "Deleted", { timeOut: 3000, "closeButton": true });

                        $('.close').click();
                        oTable.ajax.reload(null, false);
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        }
        else {
            return false;
        }
    }
