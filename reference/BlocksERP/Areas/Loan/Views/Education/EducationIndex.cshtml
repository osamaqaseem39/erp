    //        dataType: 'json',
    //        success: function (data) {
    //            if (data.status == true) {
    //                oTable.ajax.reload(null, false);
    //                $('#DeleteModal').modal('toggle');
    //            }
    //            else {
    //                alert(data.message);
    //            }
    //        }
    //    })
    //}

    //========= CLICK ON DELETE BUTTON ==========\\
    $(document).on('click', '.btnDeleteRecord', function () {

        var id = $('#EducationID').val();
        DeleteRecord(id);
    });


    //========= DELETE FUNCTION ==========\\
    function DeleteRecord(id) {


        var checkstr = confirm('Are you sure you want to delete this Education?');
        if (checkstr == true) {
            $.ajax({
                url: '/Loan/Education/DeleteModule/' + id,
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {
                        //$('#MyModal').modal('toggle');
                        toastr.error("Education Deleted Successfully", "Deleted", { timeOut: 3000, "closeButton": true });

                        $('.close').click();
                        oTable.ajax.reload(null, false);
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        }
        else {
            return false;
        }
    }


</script>


