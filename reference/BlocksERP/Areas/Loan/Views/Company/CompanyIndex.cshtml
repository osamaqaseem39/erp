@{
    ViewBag.Title = "Company";
}

@model List<BlocksERP.Models.clsModule>
<!-- END Page Header -->
<!-- BEGIN Page Content -->
<!-- the #js-page-content id is needed for some plugins to initialize -->

<main id="js-page-content" role="main" class="page-content">
    <div class="row">
        <div class="col-md-12" style="display:flex">
            <table style="width:100%">
                <tr>
                    <th>
                        <ol class="breadcrumb breadcrumb-sm breadcrumb-arrow">
                            <li>
                                <a href="javascript:void(0)">
                                    <i class="fal fa-clipboard"></i>
                                    &nbsp;
                                    <span class="hidden-md-down">Loan</span>
                                </a>
                            </li>
                            <li class="">
                                <a href="javascript:void(0)">
                                    <i class="fal fa-list-ol"></i>
                                    &nbsp;
                                    <span class="hidden-md-down">Company List</span>
                                </a>
                            </li>
                        </ol>
                    </th>
                    <th style="text-align:right">
                        <h6 class="js-get-date" style="margin-top: -7px;"></h6>
                    </th>
                </tr>
            </table>

        </div>

    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="panel">
                <div class="panel-hdr bg-primary-500 bg-info-gradient" role="heading">
                    <h2>Company List</h2>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        <div class="row" style="padding-left: 0px;padding-right: 0px;padding-top:0px">
                            <div class="col-lg-6" style="margin-top:4px">

                                @if (Model.Any(x => x.ActionName.ToLower() == "save"))
                                {
                                    <a href="javascript:void(0)" data-toggle="modal" data-target="#MyModal" data-value="0" class="btn btn-outline-primary waves-effect waves-themed btnNew AddEditRecord" id="AddEditRecord">
                                        <i class="fal fa-plus-circle"></i>
                                        &nbsp;
                                        Add Company
                                    </a>
                                }
                                @if (Model.Any(x => x.ActionName.ToLower() == "edit") || Model.Any(x => x.ActionName.ToLower() == "delete"))
                                {
                                    <input type="hidden" id="EditActionRole" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="EditActionRole" value="0" />
                                }
                                @if (Model.Any(x => x.ActionName.ToLower() == "delete"))

                                {
                                    <input type="hidden" id="DeleteActionRole" value="1" />

                                }
                                else
                                {
                                    <input type="hidden" id="DeleteActionRole" value="0" />
                                }


                            </div>
                            <div class="col-lg-6" style="margin-top:4px">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <button id="btnSearchCompany" class="btn btn-outline-default dropdown-toggle btnSearchGo" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Company Name</button>
                                        <div class="dropdown-menu" id="ulSearchCompany">
                                            <a class="dropdown-item" href="#">Company Name</a>
                                        </div>
                                    </div>
                                    <input type="text" id="txtSearch" class="form-control" placeholder="Search here..." aria-label="Text input with dropdown button">
                                    <div class="input-group-append">
                                        <button id="btnSearch" class="btn btn-outline-default btnSearchGo" type="button" aria-haspopup="true" aria-expanded="false">Go</button>
                                    </div>
                                </div>
                                @*<div class="pull-right top_search" style="width:100%">
                                        <div class="input-group">
                                            <input type="text" id="txtSearch" class="form-control" placeholder="Search here...">
                                            <span class="input-group-btn">
                                                <button id="btnSearch" class="btn btn-outline-primary waves-effect waves-themed btnSearchGo" type="button">Go</button>
                                            </span>
                                        </div>
                                    </div>*@
                            </div>
                        </div>

                        <table id="myTable" class="table table-bordered table-hover table-striped w-100">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Company Name</th>
                                    <th class="min-desktop">Phone No.</th>
                                    <th class="max-mobile-p">Cell No.</th>
                                    <th class="min-desktop">Email</th>
                                    <th class="min-desktop">Contact Person</th>
                                    <th class="min-desktop">Address</th>
                                    <th class="min-desktop">Website</th>
                                    <th class="max-mobile-p">Created Date</th>
                                    <th class="max-mobile-p">Created By</th>
                                    <th class="max-mobile-p">Updated Date</th>
                                    <th class="max-mobile-p">Updated By</th>
                                    <th>Edit</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</main>
<!-- this overlay is activated only when mobile menu is triggered -->

<script type="text/javascript">
    $(document).ready(function () {

        $('#myTable').dataTable({

            "autoWidth": true,
            "bLengthChange": false,
            //"searching": false,
            "processing": true,
            "serverSide": true,
            "responsive": true,

            "ajax": {
                "url": "/Loan/Company/GetAllCompany",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ImagePath", "width": "45px", "class": "Acenter", "orderable": false, "render": function (data) {
                        return '<img src="' + data + '" style="height:45px;width:45px;" />';
                    }
                },
                { "data": "CompanyName", "name": "CompanyName", "autoWidth": true },
                { "data": "PhoneNo", "name": "PhoneNo", "autoWidth": true },
                { "data": "CellNo", "name": "CellNo", "autoWidth": true },
                { "data": "Email", "name": "Email", "autoWidth": true },
                { "data": "ContactPerson", "name": "ContactPerson", "autoWidth": true },
                { "data": "Address", "name": "Address", "autoWidth": true },
                { "data": "Website", "name": "Website", "autoWidth": true },
                {
                    "data": "CreatedDate", "name": "CreatedDate", "class": "Acenter", "orderable": true, "autoWidth": true, 'render': function (date) {
                        return getDateTimeForDatatable(date);
                    }
                },
                { "data": "CreatedByString", "name": "CreatedBy", "autoWidth": true },
                {
                    "data": "UpdatedDate", "name": "UpdatedDate", "class": "Acenter", "orderable": true, "autoWidth": true, 'render': function (date) {
                        return getDateTimeForDatatable(date);
                    }
                },
                { "data": "UpdatedByString", "name": "UpdatedBy", "autoWidth": true },
                {
                    "data": "CompanyId", "width": "50px", "class": "Acenter", "orderable": false, "render": function (data) {
                        var edit = '<a title="Edit Company" data-toggle="modal" data-target="#MyModal" class="AddEditRecord btn btn-primary" href="javascript:void(0)" data-value="' + data + '" style="border-radius:20px;padding:5px;color:#fff;padding-left:15px;padding-right:15px"><i class="fal fa-fw fa-edit"></i></a>&nbsp';
                        var final = '';
                        if ($('#EditActionRole').val() > 0) {
                            final = final + edit;
                        }
                        return final;
                    }
                },
                //{
                //    "data": "CompanyId", "width": "50px", "class": "Acenter", "orderable": false, "render": function (data) {
                //        var del = '<a title="Delete Company" class="DeleteRecord btn btn-danger" data-toggle="modal" data-target="#DeleteModal" href="javascript:void(0)" data-value="' + data + '" style="border-radius:20px;padding:5px;color:#fff;padding-left:15px;padding-right:15px"><i class="fal fa-fw fa-times-circle"></i></a>&nbsp';
                //        var final = '';
                //        if ($('#DeleteActionRole').val() > 0) {
                //            final = final + del;
                //        }
                //        return final;
                //    }
                //}

            ]
        });
        oTable = $('#myTable').DataTable();

    });
    $(document).keypress(function (e) {
        var keyCode = (e.keyCode ? e.keyCode : e.which);
        if (keyCode == '13') {
            e.preventDefault();
        }
    });
    $(document).on('keydown', function (event) {
        if (event.ctrlKey && event.keyCode === 13) {
            $('#btn_Save').click();
        }
    })
   
     $(document).on('keydown', function (event) {
            if (event.altKey && event.keyCode === 78) {
                $('#AddEditRecord').click();
            }
        })
    $(document).on('shown.bs.modal',"#MyModal", function(){
        $('#CompanyName').focus();
});
    $(document).on('click', '.AddEditRecord', function () {
        $("#MyModal").find('.modal-dialog').removeClass("modal-lg").addClass("modal-lg");
            var id = $(this).attr("data-value");
            if(id > 0)
            {
                $('#ModelHeaderSpan').html('Edit Company');
            }
            else {
                $('#ModelHeaderSpan').html('Add Company');
            }
            $('#modalDiv').html('');
            $('#modalDiv').load('@Url.Action("InsertUpdateCompany", "Company", new { area = "Loan" })?id=' + id + '');
    });
    $('#btnSearch').click(function () {
            SearchItem();
        });
        $('#txtSearch').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCompany");
            if (BElement.html() == 'Company Name') {
                oTable.columns(0).search($('#txtSearch').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
    
    $(document).on('click', '.btnDeleteRecord', function () {
        var id = $('#CompanyId').val();
        DeleteRecord(id);
    });


    //========= DELETE FUNCTION ==========\\
    function DeleteRecord(id) {


        var checkstr = confirm('Are you sure you want to delete this Company?');
        if (checkstr == true) {
            $.ajax({
                url: '/Loan/Company/DeleteModule/' + id,
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {
                        //$('#MyModal').modal('toggle');
                        toastr.success("Company Deleted Successfully", "Deleted", { timeOut: 3000, "closeButton": true });

                        $('.close').click();
                        oTable.ajax.reload(null, false);
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        }
        else {
            return false;
        }
    }
</script>
