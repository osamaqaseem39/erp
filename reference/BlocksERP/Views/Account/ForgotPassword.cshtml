@model LoginViewModel
@{
    ViewBag.PageId = "extr-page";
    ViewBag.PageClass = "animated fadeInDown";
    Layout = "~/Views/Shared/_PartialLayout.cshtml";
}
<style>
    body {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #FFF;
        color: #232428;
        line-height: 1.5;
        font-weight: 400;
        overflow-x: hidden;
    }

    .mrs-white {
        background-color: #FFF;
        color: #232428;
    }

    .in-times-container, .in-times-social-column {
        width: 100%;
    }

    #geometric {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

    .canvas_overley {
        background-color: #fff;
        bottom: 0;
        left: 0;
        opacity: 0.93;
        position: absolute;
        right: 0;
        top: 0;
    }
</style>
<div class="in-times-container">
    <canvas id="geometric" width="1349" height="430"></canvas>
    <div class="canvas_overley"></div>
    <div class="">
        <div class="lg-mn-con-sch">
            <div class="row mrgn-lss-rw">
                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12 sch-lg-col-right"></div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 sch-lg-col-right">
                        <div class="well no-padding dv_ForgotForm" style="overflow: hidden;">
                            <form id="forgotForm" class="smart-form client-form rotat">
                                <header>Reset Password</header>
                                <fieldset>
                                    <section>
                                        <label class="label">E-mail</label>
                                        <label class="input">
                                            <i class="icon-append fa fa-envelope"></i>
                                            <input type="email" name="Username" id="Username">
                                            <b class="tooltip tooltip-top-right"><i class="fa fa-user txt-color-teal"></i> Please enter the email address the account was registered with</b>
                                        </label>

                                        <div class="note">
                                            <a href="@Url.Action("login", "account")"><i class="fa fa-smile-o"></i> I remembered my password!</a>
                                        </div>
                                    </section>
                                </fieldset>
                                <footer>
                                    <span class="btn btn-primary pull-left"><a style="color: white;" href="#" class="btn_message"><i class="fa fa-envelope"></i> Send message</a></span>
                                    <span class="btn btn-primary"><a style="color: white;" href="#" class="btn_email"><i class="fa fa-envelope"></i> Send email</a></span>
                                </footer>
                            </form>
                        </div>
                        <div class="spc-ln"></div>
                        @{ Html.RenderPartial("_SocialMedia"); }
                    </div>
                </div>
        </div>
    </div>
    <div id="ft" class="hidden-sm hidden-xs">
        <div class="ft-ln-mn">
            <div class="footer-bd">
                <a class="ft-lg-g"></a>
                <a href="#">Terms of use</a>
                <a href="#">Privacy Policy</a>
                <a href="#">&copy; Glow</a>
                <a class="pull-right" href="#"><b>Powerd by: codehex</b></a>
                <div class="ft-brd-lft-ex"></div>
                <div class="ft-brd-right-btm"></div>
            </div>
        </div>
    </div>
</div>
<script src="~/Scripts/plugin/spc-scrpt/jquery-3.1.1.min.js"></script>
<script src="~/Scripts/plugin/spc-scrpt/paricles-shapify.js"></script>
<script src="~/Scripts/plugin/bootstrap-wizard/jquery.bootstrap.wizard.min.js"></script>
<script src="~/Scripts/plugin/fuelux/wizard/wizard.min.js"></script>]
<script type="text/javascript">
    $('.btn_email').click(function (e) {
        $('#forgotForm').fadeOut(2000);
        $.ajax({
            type: "POST",
            url: "@Url.Action("ForgotPasswordByEmail", "account")",
            data: $('#forgotForm').serialize(),
            dataType: 'json',
            success: function (data) {
                if (data.status) {
                    $.smallBox({
                        title: data.message,
                        content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                        color: "#5F895F",
                        iconSmall: "fa fa-check bounce animated",
                        timeout: 4000
                    });
                    var content = '<form id="forgotFormCode" class="smart-form client-form rotat">' +
                                '<header>Enter Code</header>' +
                                '<fieldset>' +
                                    '<section>' +
                                        '<label class="label">Code</label>' +
                                        '<label class="input">' +
                                            '<i class="icon-append fas fa-key"></i>' +
                                            '<input type="text" name="CodeSent" id="CodeSent">' +
                                            '<b class="tooltip tooltip-top-right">' +
                                                '<i class="fa fa-user txt-color-teal"></i> Please enter the code which is sent from www.glowsims.com</b>' +
                                        '</label><div class="note"><a href="#"><i class="fa fa-smile-o"></i> I remembered my password!</a></div>' +
                                    '</section>' +
                                '</fieldset>' +
                                '<footer>' +
                                    '<span class="btn btn-primary">' +
                                        '<a style="color: white;" href="#" class="btn_ConfirmCode"><i class="fas fa-hand-point-right"></i> Next</a>' +
                                    '</span>' +
                                '</footer>' +
                            '</form>';
                    $('.dv_ForgotForm').html(content).hide().fadeIn(2000);
                }
                else {
                    $.smallBox({
                        title: data.message,
                        content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                        color: "#cf564a",
                        iconSmall: "fa fa-check bounce animated",
                        timeout: 4000
                    });
                    $('#forgotForm').fadeIn(2000);
                }
            }
        });
        e.preventDefault();
    });
    $('.btn_message').click(function (e) {
        $('#forgotForm').fadeOut(2000);
        $.ajax({
            type: "POST",
            url: "@Url.Action("ForgotPasswordBySMS", "account")",
            data: $('#forgotForm').serialize(),
            dataType: 'json',
            success: function (data) {
                if (data.status)
                {
                    $.smallBox({
                        title: data.message,
                        content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                        color: "#5F895F",
                        iconSmall: "fa fa-check bounce animated",
                        timeout: 4000
                    });
                    var content = '<form id="forgotFormCode" class="smart-form client-form rotat">' +
                                '<header>Enter Code</header>' +
                                '<fieldset>' +
                                    '<section>' +
                                        '<label class="label">Code</label>' +
                                        '<label class="input">' +
                                            '<i class="icon-append fas fa-key"></i>' +
                                            '<input type="text" name="CodeSent" id="CodeSent">' +
                                            '<b class="tooltip tooltip-top-right">' +
                                                '<i class="fa fa-user txt-color-teal"></i> Please enter the code which is sent from www.glowsims.com</b>' +
                                        '</label><div class="note"><a href="#"><i class="fa fa-smile-o"></i> I remembered my password!</a></div>' +
                                    '</section>' +
                                '</fieldset>' +
                                '<footer>' +
                                    '<span class="btn btn-primary">' +
                                        '<a style="color: white;" href="#" class="btn_ConfirmCode"><i class="fas fa-hand-point-right"></i> Next</a>' +
                                    '</span>' +
                                '</footer>' +
                            '</form>';
                    $('.dv_ForgotForm').html(content).hide().fadeIn(2000);
                }
                else
                {
                    $.smallBox({
                        title: data.message,
                        content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                        color: "#cf564a",
                        iconSmall: "fa fa-check bounce animated",
                        timeout: 4000
                    });
                    $('#forgotForm').fadeIn(2000);
                }
            }
        });
        e.preventDefault();
    });
    //$("a.btn_ConfirmCode").live("click", function () {
    //    alert("Goodbye!"); // jQuery 1.3+
    //});
    $(document).delegate("a.btn_ConfirmCode", "click", function () {
        $('#forgotFormCode').fadeOut(2000);
        $.ajax({
            type: "POST",
            url: "@Url.Action("ConfirmCode", "account")",
            data: $('#forgotFormCode').serialize(),
            dataType: 'json',
            success: function (response) {
                if (response.status)
                {
                    var content = '<form id="forgotFormPassword" class="smart-form client-form" style="overflow: hidden;">' +
                                '<header>Enter New Password</header>' +
                                 '<input type="hidden" name = "ForgotPasswordId" id="ForgotPasswordId" value=' + response.data.ForgotPasswordId + '>' +
                                    '<input type="hidden" name = "PersonnelId" id="PersonnelId" value=' + response.data.PersonnelId + '>' +
                                    '<input type="hidden" name = "Username" id="Username" value=' + response.data.Username + '>' +
                                    '<input type="hidden" name = "CodeSent" id="CodeSent" value=' + response.data.CodeSent + '>' +
                                '<fieldset>' +
                                    '<section>' +
                                        '<section>' +
                                        '<label class="input">' +
                                            '<i class="icon-append fa fa-lock"></i>' +
                                            '<input type="password" name="NewPassword" placeholder="Password" id="NewPassword" autocomplete="off">' +
                                            '<b class="tooltip tooltip-bottom-right">Don &quot t forget your password</b>' +
                                        '</label>' +
                                    '</section>' +
                                    '<section>' +
                                        '<label class="input">' +
                                            '<i class="icon-append fa fa-lock"></i>' +
                                            '<input type="password" name="confirm_password" id="confirm_password" placeholder="Confirm password" autocomplete="off">' +
                                            '<b class="tooltip tooltip-bottom-right">Don &quot t forget your password</b>' +
                                    '</label>' +
                                    '</section>' +
                                        '<div class="note">' +
                                            '<a href="@Url.Action("login", "account")"><i class="fa fa-smile-o"></i> I remembered my password!</a>' +
                                        '</div>' +
                                    '</section>' +
                                '</fieldset>' +
                                '<footer>' +
                                    '<span class="btn btn-primary"><a style="color: white;" href="#" class="btn_Finish"><i class="fas fa-hand-point-right"></i> Finish</a></span>' +
                                '</footer>' +
                            '</form>';
                    // $('.dv_ForgotForm').html(content);
                    $('.dv_ForgotForm').html(content).hide().fadeIn(2000);
                }
                else
                {
                    $.smallBox({
                        title: response.message,
                        content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                        color: "#cf564a",
                        iconSmall: "fa fa-check bounce animated",
                        timeout: 4000
                    });
                    $('#forgotFormCode').fadeIn(2000);
                }
            }
        });
    });
    $(document).delegate("a.btn_Finish", "click", function () {
        if ($('#NewPassword').val() == $('#confirm_password').val()) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("FinishChangePassword", "account")",
                data: $('#forgotFormPassword').serialize(),
            dataType: 'json',
            success: function (data) {
                $.smallBox({
                    title: "Password successfully changed.",
                    content: "<i class='fa fa-clock-o'></i> <i>1 seconds ago...</i>",
                    color: "#5F895F",
                    iconSmall: "fa fa-check bounce animated",
                    timeout: 4000
                });
                window.location.href = "/account/login";
            }
        });
        }
    });
    $(document).delegate('#confirm_password', 'keyup', function () {
        if ($('#NewPassword').val() == $('#confirm_password').val()) {
            $('#confirm_password').css('border-color', 'green');
        } else
            $('#confirm_password').css('border-color', 'red');
    });
</script>