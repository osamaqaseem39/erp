<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="ADO" connectionString="Server=HELLOWORLD;Database=LoanApp;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
    <add name="ModelDb" connectionString="metadata=res://*/ModelDbContext.csdl|res://*/ModelDbContext.ssdl|res://*/ModelDbContext.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=HELLOWORLD;initial catalog=LoanApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    <add name="EmailServer" connectionString="smtp-mail.outlook.com" />
    <add name="EmailPort" connectionString="587" />
    <add name="Email" connectionString="hairenergy@hotmail.com" />
    <add name="EmailPassword" connectionString="hairenergy" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="SiteUrl" value="http://localhost:27900" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <authentication mode="Forms">
      <forms name="blockserp" loginUrl="~/account/login" timeout="5000" />
    </authentication>
    <customErrors mode="Off" defaultRedirect="~/account/error" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.5" />
    <sessionState mode="InProc" cookieless="false" timeout="5000" />
  </system.web>
