<style>
    .Acenter {
        text-align: center;
    }
</style>

@model POS.Models.clsAccountDetail
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <articles class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                <header>
                    <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                    <h2>Driver's List</h2>
                </header>
                <div>
                    <div class="jarviswidget-editbox">
                    </div>
                    <div class="widget-body">
                        <div class="row">
                            <div class="col-lg-2">
                            </div>
                            <div class="col-lg-10">
                                <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right">
                                    <div class="input-group-btn">
                                        <button id="btnSearchCategoryAccountDetail" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Driver Name</button>
                                        <ul class="dropdown-menu" id="ulSearchCategoryAccountDetail" style="cursor:pointer">
                                            <li data-value="Driver Name">
                                                <a class="ListItem">Driver Name</a>
                                            </li>
                                            <li data-value="Code">
                                                <a class="ListItem">Code</a>
                                            </li>
                                            <li data-value="Status">
                                                <a class="ListItem">Status</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <input class="form-control input-lg" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchAccountDetail">
                                    <div class="input-group-btn">
                                        <button type="button" id="btnSearchAccountDetail" class="btn btn-default">
                                            &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-search fa-lg"></i>&nbsp;&nbsp;&nbsp;
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <table id="myTableAccountDetail" class="table table-striped table-bordered table-hover" width="100%">
                            <thead>
                                <tr>
                                    <th data-hide=""></th>
                                    <th data-class="expand"><i class="fa fa-fw fa-info text-muted"></i> Driver Name</th>
                                    <th data-hide="phone"><i class="fa fa-hashtag text-muted"></i> Code</th>
                                    <th data-hide="phone,tablet"><i class="fa fa-map-marker text-muted"></i> Status</th>
                                    <th data-hide="phone,tablet,desktop"> Emg. Phone No.</th>
                                    <th data-hide="phone,tablet"> Mobile No.</th>
                                    <th data-hide="phone,tablet"> Email (User)</th>
                                    <th data-hide="phone,tablet,desktop"> Address</th>
                                    <th data-hide="phone,tablet,desktop"> Additional Info.</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
                    <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                        <header>
                            <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                            <h2 id="maptitle">Map</h2>
                        </header>
                        <div>
                            <div class="jarviswidget-editbox">
                            </div>
                            <div class="widget-body">
                                <input type="hidden" id="driverdetailcode" />
                                <div class="row">
                                    <div style="display:flex;margin-bottom:10px;">
                                        <span style="margin-left: 10px;">Driver Name :</span><span style="margin-left:5px;font-weight:bold;font-size:14px;color:blue;" id="lblName"></span>
                                        <span style="margin-left:10px;">Last Update Date-Time :</span><span style="margin-left: 5px;; font-weight: bold; font-size: 14px; color: blue;" id="lblDateTime"></span>
                                    </div>
                                </div>
                                <div class="gmap carlist" id="map-canvas" style="height:500px;"></div>
                            </div>
                        </div>
                    </div>
                
</articles>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        
        
        $(document).ready(function () {

            var interval = setInterval(function () { picknewlocation(); }, 120000);

            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1960,
                tablet: 1024,
                phone: 380
            };

            $('#myTableAccountDetail').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableAccountDetail'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/DriversLocation/GetAllDriverDetails",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                    {
                        "data": "DetailCode", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#AccountDetailListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                    },
                    { "data": "Name", "name": "Name", "width": "38%", "orderable": true, "autoWidth": true },
                    { "data": "DetailCode", "name": "DetailCode", "width": "11%", "autoWidth": true, "orderable": true, "class": "Acenter" },
                    { "data": "Status", "name": "Status", "width": "11%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                    { "data": "Phone2", "name": "Phone2", "autoWidth": true },
                    { "data": "Cell1", "name": "Cell1", "autoWidth": true },
                    { "data": "Email", "name": "Email", "autoWidth": true },
                    { "data": "Address", "name": "Address", "autoWidth": true },
                    { "data": "Remarks", "name": "Remarks", "autoWidth": true },

                ]
            });
            oTable = $('#myTableAccountDetail').DataTable();
            $(document).on('click', '.selectBtn', function (e) {
                e.preventDefault();
                var accountCode = $(this).attr("data-value");
                $('#driverdetailcode').val(accountCode);
                picknewlocation();
            })

            function picknewlocation() {
                var accountCode = $('#driverdetailcode').val();
                if (accountCode == null || accountCode == "" || isNaN(accountCode)) { accountCode = 0;}

                $.ajax({
                    type: "POST",
                    url: "/DriversLocation/GetDriverLocationById/" + accountCode,
                    dataType: 'json',
                    success: function (response) {
                        $('#lblName').html(response.data.Name);
                        $('#lblDateTime').html(response.data.LastDateTimeStr);

                        const mapOptions = {
                            zoom: 18,
                            center: { lat: parseFloat(response.data.Latitude), lng: parseFloat(response.data.Longitude) },
                        };

                        map = new google.maps.Map(document.getElementById("map-canvas"), mapOptions);

                        const marker = new google.maps.Marker({
                            position: { lat: parseFloat(response.data.Latitude), lng: parseFloat(response.data.Longitude) },
                            map: map,
                        });


                    }
                })
            }

            $('#btnSearchAccountDetail').click(function () {
                SearchItem();
            });
            $('#txtSearchAccountDetail').on('keypress', function (event) {
                var BElement = $("#btnSearchCategoryAccountDetail");
                if (BElement.html() == 'Detail Code') {
                    NumberPostiveNegativeWithDecimal(event, this);
                }
                if (event.keyCode == 13) {
                    SearchItem();
                }
            });
            function SearchItem() {
                var BElement = $("#btnSearchCategoryAccountDetail");
                if (BElement.html().trim() == 'Code') {
                    oTable.columns(0).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Driver Name') {
                    oTable.columns(1).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Description') {
                    oTable.columns(2).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Status') {
                    oTable.columns(3).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Reference') {
                    oTable.columns(4).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Company Name') {
                    oTable.columns(5).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'Type') {
                    oTable.columns(6).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else if (BElement.html().trim() == 'City') {
                    oTable.columns(7).search($('#txtSearchAccountDetail').val().trim()).draw();
                }
                else {
                    alert("Error! try again.");
                }
            }

            $("#ulSearchCategoryAccountDetail").on("click", "a", function (e) {
                e.preventDefault();
                var $this = $(this).parent();
                $this.addClass("select").siblings().removeClass("select");
                $("#btnSearchCategoryAccountDetail").html($this.data("value"));
                if ($("#btnSearchCategoryAccountDetail").html() == 'Detail Code') {
                    $('#txtSearchAccountDetail').val('');
                }
            })
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }

        function getDate(date) {
            if (date == null) {
                return null;
            }
            else {
                var newdate = new Date(parseInt(date.substr(6)));
                var day = newdate.getDate();
                var month = newdate.getMonth() + 1;
                if (digits_count(day) == 1 || digits_count(day) == 0) {
                    day = "0" + day;
                }
                if (digits_count(month) == 1 || digits_count(month) == 0) {
                    month = "0" + month;
                }
                var year = newdate.getFullYear();
                var today = year + '-' + month + '-' + (day);
                if (year == 1900) {
                    return null;
                }
                else {
                    return today;
                }
            }
        }
        function digits_count(n) {
            var count = 0;
            if (n > 1)
                ++count;
            while (n / 10 >= 1) {
                n /= 10;
                ++count;
            }
            return count;
        }
    </script>
}
