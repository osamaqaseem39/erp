                size: A4;
                margin-top: 7px;
                margin-bottom: 2px;
                margin-left: -45px;
                /*page-break-after: always;*/
            }

            @@page:first {
                size: A4;
                margin-top: -30px;
                margin-bottom: 2px;
                margin-left: -45px;
                /*page-break-after: always;*/
            }

            .mainTable {
                width: 97.5% !important;
                margin-left: 16px !important;
                border-bottom: 0px !important;
                border-top: 0px !important;
            }

            .countRecords {
                padding-right: 20px !important;
            }

            .CustomersDetail {
                padding-left: 316px !important;
            }

