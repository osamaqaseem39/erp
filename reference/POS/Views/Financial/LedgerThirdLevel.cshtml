<style>
    .set-img {
        font-family: "Open Sans",Arial,Helvetica,Sans-Serif;
    }

    .table tr td {
        border: 0 !important;
    }

    .custome-class-form h4 {
        font-weight: bold;
        color: #000;
    }

    .custome-class-form label {
        font-weight: bold !important;
        color: #000;
    }

    .table tr .V__align {
        vertical-align: bottom !important;
    }

    imgs {
        opacity: 0.5;
        filter: alpha(opacity=50); /* For IE8 and earlier */
    }

    .dropwidth {
        width: 100%;
    }

    .btn-primary {
        background-color: #03386C !important;
        border-color: #03386C !important;
    }

        .btn-primary:hover {
            background-color: #03386C !important;
        }
</style>
@model POS.Models.clsFinancialReports
@{
    Layout = null;
}
<div class="widget-body no-padding" style="overflow-x:hidden;">
    @using (Html.BeginForm("printledgerthirdlevelreport", "financial", FormMethod.Post, new { id = "ledgerThirdLevelForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
    {

        <fieldset id="myField1">
            <div class="row">
                <section class="col col-md-12">
                    <label>Third Level Account</label>
                    <div id="ThirdLevelAccountDiv">
                        @Html.DropDownListFor(m => m.ThirdLevelAccountCode, ViewBag.ThirdLevel as SelectList, new { @id = "ThirdLevelAccountCode", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <section class="col-md-12">
                <div style="padding:3px;">
                    <label>Second Level Account</label>
                    <div id="SecondLevelAccountDiv">
                        @Html.DropDownListFor(m => m.SecondLevelAccountCode, ViewBag.SecondLevel as SelectList, new { @id = "SecondLevelAccountCode", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </div>
            </section>
            <div class="row">
                <section class="col col-md-12">
                    <label>Debit / Credit</label>
                    <div id="Div">
                        <select name="DebitCreditType" id="DebitCreditType" style="width:100%">
                            <option value="All">All</option>
                            <option value="Debit">Debit</option>
                            <option value="Credit">Credit</option>
                        </select>
                    </div>
                </section>
            </div>
            <div class="row" hidden>
                <section class="col col-md-12">
                    <label>Opening Balance</label>
                    <div id="Div2">
                        <select name="OpeningBalanceType" id="OpeningBalanceType" style="width:100%">
                            <option value="With Opening Balance">With Opening Balance</option>
                            <option value="Without Opening Balance">Without Opening Balance</option>
                        </select>
                    </div>
                </section>
            </div>
            <div class="row">
                <section class="col col-md-12">
                    <label class="checkbox pull-right checkBoxLbl">
                        <input id="DateCheckbox" type="checkbox" name="DateCheckbox"><i></i>
                        <span style="">Date</span>
                    </label>
                </section>
            </div>
            <section class="col-md-6 dateSection" hidden>
                <div style="padding:3px;">
                    <label>From</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="FromDate" name="FromDate" required />
                    </label>
                </div>
            </section>
            <section class="col-md-6 dateSection" hidden>
                <div style="padding:3px;">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="ToDate" name="ToDate" required />
                    </label>
                </div>
            </section>
        </fieldset>
        <footer>
            <button formtarget="_blank" type="submit" class="btn btn-labeled btn-primary pull-right">
                GENERATE REPORT
            </button>
        </footer>
    }
</div>
<script type="text/javascript">
    $('#DateCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('.dateSection').removeAttr("hidden");
        }
        else {
            $('.dateSection').attr("hidden", "hidden");
        }
    })
    $(document).ready(function () {
        $('#ThirdLevelAccountCode').select2();
        $('#SecondLevelAccountCode').select2();
        $('#ThirdLevelAccountCode').val(null).trigger('change');
        $('#SecondLevelAccountCode').val(null).trigger('change');
        $('#DebitCreditType').select2();
        $('#DebitCreditType').val('All').trigger('change');
        $('#OpeningBalanceType').select2();
        $('#OpeningBalanceType').val('With Opening Balance').trigger('change');
        GetTodayBetweenDate();
    });
    //$('#DetailCode').change(function () {
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('border-color', '#CCCCCC');
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('color', 'black');
    //})
    function GetTodayBetweenDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        $('#FromDate').val(today);
        $('#ToDate').val(today);
    }
    $('#ledgerThirdLevelForm').on('submit', function (e) {
        var secondLevel = $('#SecondLevelAccountCode').val();
        var thirdLevel = $('#ThirdLevelAccountCode').val();
        if (thirdLevel != null && secondLevel != null) {
            alert("Please select only one filter.");
            return false;
        }
    })
</script>
