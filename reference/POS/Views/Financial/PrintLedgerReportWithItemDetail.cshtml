                                                                                        href = "/journalvoucher/journalvoucherreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Ledger")
                                                                                    {
                                                                                        href = "/journalvoucher/ledgervoucherreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        href = "/journalvoucher/VoucherReport/" + v.VoucherNo;
                                                                                    }
                                                                                    <td style="text-align: center;" rowspan="@v.InvoicesList.Count"><a class="aTag" href="@href" title="Print this Voucher" target="_blank" style="color: #3276B1">@v.VoucherNo</a></td>
                                                                                    @*
                                                    <td style="text-align: center;" rowspan="@v.InvoicesList.Count">@v.RefrenceNo</td>*@
                                                                                    <td style="text-align: left; border-top: none;">@v.InvoicesList[0].ItemName</td>
                                                                                    <td style="text-align: center; border-top: none;">@v.InvoicesList[0].Qty</td>
                                                                                    <td style="text-align: right; border-top: none;">@v.InvoicesList[0].Rate</td>
                                                                                    <td style="text-align: right; border-top: none;">@v.InvoicesList[0].Tax1Value</td>
                                                                                    <td style="text-align: right; border-top: none; ">@v.InvoicesList[0].Tax2Value</td>
                                                                                    <td style="text-align: right; border-top: none;">@v.InvoicesList[0].NetValue</td>
                                                                                    @if (v.Debit == 0)
                                                                                    {
                                                                                        <td style="text-align: center; background-color: #F0FFF0;" rowspan="@v.InvoicesList.Count">-</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: right; background-color: #F0FFF0;" rowspan="@v.InvoicesList.Count">@Convert.ToDecimal(v.Debit).ToString("#,##0.00")</td>
                                                                                    }
                                                                                    @if (v.Credit == 0)
                                                                                    {
                                                                                        <td style="text-align: center; background-color: #BEEEFF;" rowspan="@v.InvoicesList.Count">-</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: right; background-color: #BEEEFF;" rowspan="@v.InvoicesList.Count">@Convert.ToDecimal(v.Credit).ToString("#,##0.00")</td>
                                                                                    }
                                                                                    @if (balance < 0)
                                                                                    {
                                                                                        <td class="borderRight" style="text-align: right;" rowspan="@v.InvoicesList.Count">(@Math.Abs(Convert.ToDecimal(balance)).ToString("#,##0.00"))</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="borderRight" style="text-align: right;" rowspan="@v.InvoicesList.Count">@Convert.ToDecimal(balance).ToString("#,##0.00")</td>
                                                                                    }
                                                                                </tr>
                                                                                for (int m = 0; m < v.InvoicesList.Count; m++)
                                                                                {
                                                                                    if (m > 0)
                                                                                    {
                                                                                        <tr class="mainTr">
                                                                                            <td style="text-align: left; border-top: none;">@v.InvoicesList[m].ItemName</td>
                                                                                            <td style="text-align: center; border-top: none;">@v.InvoicesList[m].Qty</td>
                                                                                            <td style="text-align: right; border-top: none;">@v.InvoicesList[m].Rate</td>
                                                                                            <td style="text-align: right; border-top: none;">@v.InvoicesList[m].Tax1Value</td>
                                                                                            <td style="text-align: right; border-top: none; ">@v.InvoicesList[m].Tax2Value</td>
                                                                                            <td style="text-align: right; border-top: none;">@v.InvoicesList[m].NetValue</td>
                                                                                        </tr>
                                                                                    }
                                                                                }

                                                                            }
                                                                            else
                                                                            {
                                                                                <tr class="mainTr">
                                                                                    <td style="text-align: center;">@j</td>
                                                                                    <td style="text-align:center">@Convert.ToDateTime(v.VoucherDate).ToString("dd/MM/yy")</td>
                                                                                    @if (v.VoucherType == "Sale")
                                                                                    {
                                                                                        href = "/sale/saleinvoicereport/" + v.VoucherNo ;
                                                                                    }
                                                                                    else if (v.VoucherType == "Sale Return")
                                                                                    {
                                                                                        href = "/sale/salereturnreport/" + v.VoucherNo ;
                                                                                    }
                                                                                    else if (v.VoucherType == "Purchase")
                                                                                    {
                                                                                        href = "/purchase/purchaseinvoicereport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Purchase Return")
                                                                                    {
                                                                                        href = "/purchase/purchasereturnreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Cash Payment")
                                                                                    {
                                                                                        href = "/cash/cashpaymentreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Cash Receipt")
                                                                                    {
                                                                                        href = "/cash/cashreceiptreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Bank Payment")
                                                                                    {
                                                                                        href = "/bank/bankpaymentreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Bank Receipt")
                                                                                    {
                                                                                        href = "/bank/bankreceiptreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Journal Voucher")
                                                                                    {
                                                                                        href = "/journalvoucher/journalvoucherreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Ledger")
                                                                                    {
                                                                                        href = "/journalvoucher/ledgervoucherreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        href = "/journalvoucher/VoucherReport/" + v.VoucherNo;
                                                                                    }
                                                                                    <td style="text-align: center;"><a class="aTag" href="@href" title="Print this Voucher" target="_blank" style="color: #3276B1">@v.VoucherNo</a></td>
                                                                                    @*
                                                    <td style="text-align: center;">@v.RefrenceNo</td>*@
                                                                                    <td style="text-align: left;">@v.Remarks</td>
                                                                                    <td style="text-align: center;">-</td>
                                                                                    <td style="text-align: center;">-</td>
                                                                                    <td style="text-align: center;">-</td>
                                                                                    <td style="text-align: center; ">-</td>
                                                                                    <td style="text-align: center;">-</td>
                                                                                    @if (v.Debit == 0)
                                                                                    {
                                                                                        <td style="text-align: center; background-color: #F0FFF0;">-</td>
                                                                                    }
                                                                                    else
                                                                                    {

                                                                                        <td style="text-align: right; background-color: #F0FFF0;">@Convert.ToDecimal(v.Debit).ToString("#,##0.00")</td>
                                                                                    }
                                                                                    @if (v.Credit == 0)
