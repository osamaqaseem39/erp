                                                                                        <td style="text-align: center; background-color: #BEEEFF;">-</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: right; background-color: #BEEEFF;">@Convert.ToDecimal(v.Credit).ToString("#,##0.00")</td>
                                                                                    }
                                                                                    @if (balance < 0)
                                                                                    {
                                                                                        <td class="borderRight" style="text-align: right;">(@Math.Abs(Convert.ToDecimal(balance)).ToString("#,##0.00"))</td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="borderRight" style="text-align: right;">@Convert.ToDecimal(balance).ToString("#,##0.00")</td>
                                                                                    }
                                                                                </tr>
