<!-- widget content -->
@model POS.Models.clsVoucher
<div id="content" class="tablecontainer" style="padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-home fa-fw "></i>
                Report
                <span>
                    >
                    Ledger Report
                </span>
            </h1>
        </div>
    </div>
    <section>
        <div class="panel">
            <div class="panel-heading">
                @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                {
                    <span class="header"> Ledger Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                    <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                    <input type="hidden" name="FileName" id="FileName" value="LedgerReport" />
                    <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                        Print
                    </button>
                    <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                }
            </div>
            <div class="panel-body">
                <div id="HtmlData">
                    <div id="printable-content" class="panel rpt" style=" float: left;width: 800px; font-family: Arial, Helvetica, sans-serif;">
                        <table style="padding: 30px;padding-top:0px" id="myTable">
                            <tr>
                                <th style="font-weight: bold; font-size: 12px; text-align: right;font-weight:normal" colspan="12"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                            </tr>
                            <tr>
                                <th style="font-weight: bold; font-size: 20px; text-align: center; padding-bottom: 5px;padding-top:15px" colspan="6">@System.Web.HttpContext.Current.Application["BusinessName"]</th>
                            </tr>
                            <tr>
                                <th style="font-weight: normal; font-size: 14px; text-align: center; padding-bottom: 5px;" colspan="6">@System.Web.HttpContext.Current.Application["BusinessAddress"]</th>
                            </tr>
                            <tr>
                                <th style="font-weight: bold; font-size: 18px; text-align: center;" colspan="6">Ledger</th>
                            </tr>
                            @if (Model.VouchersList.Count != 0)
                            {
                                <tr>
                                    <th style="font-weight: bold; font-size: 14px; text-align: center;" colspan="6"><strong><span style="font-size: 13px">From:</span> </strong>@Convert.ToDateTime(Model.VouchersList[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size:16px">To:</span></strong>@Convert.ToDateTime(Model.VouchersList[0].ToDate).ToString("dd/MM/yyyy")</th>
                                </tr>
                            }
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding-bottom: 10px" colspan="12">&nbsp;</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="12">
                                        <center>
                                            @for (int i = 0; i < Model.DetailList.Count; i++)
                                            {
                                                decimal detailCode = Model.DetailList[i].DetailCode;
                                                decimal balance = 0;

                                                <div style="border:1px solid black; padding:5px;width:96%;border-radius:10px;margin-top:10px">
                                                    <table style="margin-bottom: 30px;margin-top:3px;" class="purchaseHeading">
                                                        <tbody>
                                                            <tr>
                                                                @if (string.IsNullOrEmpty(Model.DetailList[i].CityName))
                                                                {
                                                                    <th style="font-weight: bold; font-size: 18px; text-align: left;width:100%;padding-left:14px" class="accountName" colspan="2">@Model.DetailList[i].Name</th>
                                                                }
                                                                else
                                                                {
                                                                    <th style="font-weight: bold; font-size: 18px; text-align: left;width:100%;padding-left:14px" class="accountName" colspan="2">@Model.DetailList[i].Name, @Model.DetailList[i].CityName</th>
                                                                }
                                                            </tr>
                                                            <tr>
                                                                <th style="font-size: 14px; text-align: left; width: 100%; padding-left: 14px; font-weight: normal;" class="businssName RouteName" colspan="2">@Model.DetailList[i].Address</th>
                                                            </tr>
                                                            <tr>
                                                                <th style="font-size: 14px; text-align: left; width: 50%; padding-left: 14px;font-weight:normal " class="businssName RouteName" colspan="1">@Model.DetailList[i].Phone1</th>
                                                                @if (Model.VouchersList.Count != 0 && Model.VouchersList[0].OpeningBalanceType == "With Opening Balance")
                                                                {
                                                                    <th style="font-size: 14px; text-align: right; width: 50%; padding-right: 14px; " class="businssName RouteName" colspan="1">Previous Balance: @Convert.ToDecimal(Model.DetailList[i].PreviousBalance).ToString("#,##0.00")</th>
                                                                }
                                                                else
                                                                {
                                                                    <th style="font-size: 14px; text-align: right; width: 50%; padding-right: 14px; " class="businssName RouteName" colspan="1">Previous Balance: 0.00</th>
                                                                }
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    @if (Model.VouchersList.Where(x => x.DetailCode == detailCode).Count() != 0)
                                                    {
                                                        int j = 0;
                                                        decimal totalDebit = 0;
                                                        decimal totalCredit = 0;
                                                        string marginTop = "";
                                                        if (i == 0)
                                                        {
                                                            marginTop = "-48px";
                                                        }
                                                        else
                                                        {
                                                            marginTop = "-48px";
                                                        }
                                                        <div class="table-responsive">
                                                            <table class="mainTable" style="margin-top: @marginTop">
                                                                <thead>
                                                                    <tr>
                                                                        <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 13px;border:none;border-bottom:1px solid black" colspan="12">&nbsp;</th>
                                                                    </tr>
                                                                </thead>
                                                                <tr class="mainTr">
                                                                    <th style="text-align: center; width: 25px">Sr#</th>
                                                                    <th style="text-align:center;width:90px">Date</th>
                                                                    <th style="text-align: center;width:110px">Voucher No.</th>
                                                                    @*
                                    <th style="text-align: center; width: 45px">Ref<br />No.</th>*@
                                                                    <th style="text-align: left;">Particular</th>
                                                                    <th style="text-align: center; width: 45px">Qty</th>
                                                                    <th style="text-align: right; width: 45px">Rate</th>
                                                                    <th style="text-align: right; width: 45px">Tax1</th>
                                                                    <th style="text-align: right; width: 45px; ">Tax2</th>
                                                                    <th style="text-align: right; width: 75px">Net Rate</th>
                                                                    @if (Model.VouchersList[0].DebitCreditType == "All")
                                                                    {
                                                                        <th style="text-align: right; width: 50px">Debit</th>
                                                                        <th style="text-align: right; width: 50px">Credit</th>
                                                                    }
                                                                    else if (Model.VouchersList[0].DebitCreditType == "Debit")
                                                                    {
                                                                        <th style="text-align: right; width: 50px">Debit</th>
                                                                    }
                                                                    else
                                                                    {
                                                                        <th style="text-align: right; width: 50px">Credit</th>
                                                                    }
                                                                    <th class="borderRight" style="text-align: right; width: 50px">Balance</th>
                                                                </tr>
                                                                <tbody>
                                                                    @if (Model.VouchersList[0].DebitCreditType == "All")
                                                                    {
                                                                        foreach (clsVoucher v in Model.VouchersList.Where(x => x.DetailCode == detailCode))
                                                                        {
                                                                            j++;
                                                                            totalDebit += Convert.ToDecimal(v.Debit);
                                                                            totalCredit += Convert.ToDecimal(v.Credit);
                                                                            string href = "";
                                                                            if (j == 1)
                                                                            {
                                                                                decimal previousBalance = Convert.ToDecimal(Model.DetailList[i].PreviousBalance);
                                                                                balance = previousBalance + Convert.ToDecimal(v.Debit) - Convert.ToDecimal(v.Credit);
                                                                            }
                                                                            else
                                                                            {
                                                                                balance = balance + Convert.ToDecimal(v.Debit) - Convert.ToDecimal(v.Credit);
                                                                            }
                                                                            if ((v.VoucherType == "Purchase" || v.VoucherType == "Purchase Return" || v.VoucherType == "Sale" || v.VoucherType == "Sale Return")
                                                                            && (v.DetailType == "Customer" || v.DetailType == "Supplier" || v.DetailType == "Customer + Supplier"))
                                                                            {
                                                                                string borderBottom = "";
                                                                                if (v.InvoicesList.Count > 1)
                                                                                {
                                                                                    borderBottom = "none";
                                                                                }
                                                                                <tr class="mainTr">
                                                                                    <td style="text-align: center;" rowspan="@v.InvoicesList.Count">@j</td>
                                                                                    <td style="text-align: center;" rowspan="@v.InvoicesList.Count">@Convert.ToDateTime(v.VoucherDate).ToString("dd/MM/yy")</td>
                                                                                    @if (v.VoucherType == "Sale")
                                                                                    {
                                                                                        href = "/sale/saleinvoicereport/" + v.VoucherNo ;
                                                                                    }
                                                                                    else if (v.VoucherType == "Sale Return")
                                                                                    {
                                                                                        href = "/sale/salereturnreport/" + v.VoucherNo ;
                                                                                    }
                                                                                    else if (v.VoucherType == "Purchase")
                                                                                    {
                                                                                        href = "/purchase/purchaseinvoicereport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Purchase Return")
                                                                                    {
                                                                                        href = "/purchase/purchasereturnreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Cash Payment")
                                                                                    {
                                                                                        href = "/cash/cashpaymentreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Cash Receipt")
                                                                                    {
                                                                                        href = "/cash/cashreceiptreport/" + v.VoucherNo;
                                                                                    }
                                                                                    else if (v.VoucherType == "Bank Payment")
