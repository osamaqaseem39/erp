<!-- widget content -->
@model List<POS.Models.clsInvoice>
    @{
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-shopping-cart fa-fw "></i>
                     Price List
                    <span>
                        >
                       Price List Report
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> Sale Return Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="@Model[0].ComputerNo" />
                        <a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("manualproductprice", "sale")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                            Back
                        </a>
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content" class="panel rpt" style="max-width: 700px; font-size: 12px; padding: 1px; border-radius: 0px">
                            <table style="padding-top: 37px;padding-left: 37px;padding-right: 37px" class="headTable oldCss">
                                <tr>
                                    <td colspan="99">
                                        <table class="purchaseHeading oldCss">
                                            <tbody>
                                                <tr>
                                                    <th style="  text-align: left;padding-right:15px;padding-top:10px;" colspan="12" class="pull-left businssName businssName22">
                                                        <div style="font-weight: bold;font-size: 20px;">@System.Web.HttpContext.Current.Application["BusinessName"]</div>
                                                        <div style="font-size: 16px;margin-left:2px">
                                                            @System.Web.HttpContext.Current.Application["BusinessAddress"]
                                                        </div>
                                                    </th>
                                                    @*<th style="font-weight: bold; font-size: 20px; text-align: right;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-right">
                                                            <img src="@Url.Action("GetBusinessLogo", "Sale", new { id = Convert.ToInt32(Model.SaleInvoice[0].BusinessId) })" style="height:70px;width:70px" alt="Business Logo">
                                                        </th>*@
                                                </tr>
                                                <tr>
                                                    <th style="  text-align: left; padding-bottom: 15px;padding-right:15px;" colspan="12" class="pull-left businssName businssName22">
                                                        <div style="font-weight: bold;font-size: 20px;">Items Prices List</div>
                                                    </th>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <table style="" class="borderLineTable oldCss">
                                            <tr>
                                                <td style="border-bottom:1px solid black;"></td>
                                            </tr>
                                        </table>
                                        <table style="margin-bottom: 30px;margin-top:3px;" class="purchaseHeading oldCss">
                                            <tbody>
                                                <tr>
                                                    <th style="font-weight: bold; font-size: 16px; text-align: left;width:50%" class="accountName"></th>
                                                    <th style="font-weight:bold;text-align:right;font-size:14px">Date: </th>
                                                    <th style="font-weight: NORMAL; text-align: left; width: 18%; font-size: 14px; padding-left:15px; ">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model[0].RecordDate))</th>
                                                </tr>
                                            </tbody>
                                        </table>
                                        @if (!string.IsNullOrEmpty(Model[0].Remarks))
                                        {
                                            <table style="margin-bottom:15px;margin-top:-22px" class="description oldCss">
                                                <tr>
                                                    <td style="font-size:14px"><b><span style="font-size:16px">Remarks:</span></b> @Model[0].Remarks</td>
                                                </tr>
                                            </table>
                                        }
                                        <table style="margin-bottom:15px;margin-top:-15px" class="borderLineTable2 oldCss">
                                            <tr>
                                                <td style="border-bottom:1px solid black;"></td>
                                            </tr>
                                        </table>
                                        <table class="mainTable oldCss" id="" style="margin-top:-12px">
                                            <tr>
                                                <th style="text-align: center; border-bottom: 1px solid black; font-size: 13px; font-weight: bold; width: 40px">Sr#</th>
                                                <th style="padding-left: 8px; border-bottom: 1px solid black; font-size: 13px; font-weight: bold; text-align: center; width: 140px">Code</th>
                                                <th style="padding-left:8px;border-bottom:1px solid black;font-size:13px;font-weight:bold;text-align:left">Brand</th>
                                                <th align="right" style="text-align: right; border-bottom: 1px solid black; font-size: 12px; font-weight: bold; width: 140px">Sale Rate</th>
                                            </tr>
                                            <tbody>
                                                @for (int i = 0; i < Model.Count; i++)
                                                {
                                                    <tr class="">
                                                        <td align="center" style="text-align:center;border-bottom:1px solid black;padding-top:4px;font-size:13px;">@(i + 1)</td>
                                                        <td align="center" style="padding-left: 8px;border-bottom: 1px solid black; padding-top: 4px; font-size: 13px; ">@Model[i].Barcode</td>
                                                        <td align="left" style="padding-left: 8px;border-bottom: 1px solid black; padding-top: 4px; font-size: 13px; ">@Model[i].BrandName</td>
                                                        <td align="right" style="border-bottom: 1px solid black; padding-top: 4px; font-size: 13px;">@Convert.ToDecimal(Model[i].Rate).ToString("#,##0.00") </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <br />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
