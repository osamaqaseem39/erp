<style>
    .Acenter {
        text-align: center;
    }

    .Aright {
        text-align: right;
    }
</style>
@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="widget-body">
        <div class="row">
            <div class="col-lg-2">
            </div>
            <div class="col-lg-10">
                <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right">
                    <div class="input-group-btn">
                        <button id="btnSearchCategoryCity" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Remarks</button>
                        <ul class="dropdown-menu" id="ulSearchCategoryCity" style="cursor:pointer">
                            <li data-value="Remarks">
                                <a class="ListItem">Remarks</a>
                            </li>
                        </ul>
                    </div>
                    <input class="form-control input-lg" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchCity">
                    <div class="input-group-btn">
                        <button type="button" id="btnSearchCity" class="btn btn-default">
                            &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-search fa-lg"></i>&nbsp;&nbsp;&nbsp;
                        </button>
                        @*<button type="button" id="btnRefreshCity" class="btn btn-default">
                            &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-refresh fa-lg"></i>&nbsp;&nbsp;&nbsp;
                        </button>*@
                    </div>
                </div>
            </div>
        </div>
        <table id="myTableSale" class="table table-striped table-bordered table-hover" width="100%">
            <thead>
                <tr>
                    <th data-hide=""></th>
                    <th data-class="expand" style="width:120px"><i class="fa fa-calendar text-muted"></i> Date</th>
                    <th data-hide="phone"><i class="fa fa-info text-muted"></i> Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr class="noRecordTr">
                    <td class="" colspan="3" style="text-align:center;padding:10px">No Record Found.</td>
                </tr>
            </tbody>
        </table>
    </div>
    @*</div>

                    </div>
                </article>
            </div>
        </section>*@
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            tablet: 1024,
            phone: 380
        };

        $('#myTableSale').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableSale'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/sale/GetAllManualPricesSaleLists",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ComputerNo", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                        return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#PriceListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                    }
                },
                 {
                     "data": "RecordDate", "class": "Acenter","orderable": false, 'render': function (date) {
                         if (date != null) {
                             var date = new Date(parseInt(date.substr(6)));
                             var day = date.getDate();
                             var month = date.getMonth() + 1;
                             if (parseFloat(day) < 10) {
                                 day = "0" + day;
                             }
                             if (parseFloat(month) < 10) {
                                 month = "0" + month;
                             }
                             return day + "-" + month + "-" + date.getFullYear();
                         }
                         else {
                             return "";
                         }
                     }
                 },
                    { "data": "Remarks", "name": "Remarks", "autoWidth": true, "orderable": true, },

            ]
        });
        oTable = $('#myTableSale').DataTable();
        $('#btnSearchCity').click(function () {
            SearchItem();
        });
        $('#txtSearchCity').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryCity");
            if (BElement.html().trim() == 'Remarks') {
                oTable.columns(0).search($('#txtSearchCity').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshCity').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryCity").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryCity").html($this.data("value"));
        })
        
    });
    $(document).on('click', '.selectBtn', function (e) {
        e.preventDefault();
        var invoiceNo = $(this).attr("data-value");
        $.ajax({
            type: "POST",
            url: "/sale/GetPriceById/" + invoiceNo,
            dataType: 'json',
            success: function (response) {
                $('#ComputerNo').val(response.data.ComputerNo);
                $('#Remarks').val(response.data.Remarks);
                getInvoiceDetail(response.data.ComputerNo);
            }
        })
    })
    //
    function getInvoiceDetail(invoiceNo) {
        $.ajax({
            type: "POST",
            url: "/sale/GetPriceDetailById/" + invoiceNo,
            dataType: 'json',
            success: function (response) {
                var vtable = $('#priceDetailTable').DataTable();
                vtable.clear().draw();
                for (var key in response.data) {
                    vtable.row.add([
                 "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + response.data[key].ItemID + " />" + response.data[key].UrduName + "</span>",
                "<span><input type='hidden' class='ItemID01' value=" + response.data[key].ItemID + " />" + response.data[key].ItemName + "</span>",
                "<span style='text-align:right' class='pull-right'><input type='hidden' class='SalePrice01' value=" + response.data[key].Rate + " />" + ReplaceNumberWithCommas(parseFloat(response.data[key].Rate).toFixed(2)) + "</span>",
                    ]).draw(false);
                }
            }
        })
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
