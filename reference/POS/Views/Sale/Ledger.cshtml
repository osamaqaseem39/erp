@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2> Ledger </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            <div class="widget-body">
                                <div class="well smart-form" style="border: 1px solid #bdbdbd; background-color: #F7F7F7;padding:10px">
                                    @using (Html.BeginForm("ledgerreport", "financial", FormMethod.Post, new { id = "saleForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                                    {
                                        @Html.HiddenFor(x => x.ByDate, new { @id = "HiddenFomrDate" });
                                        <input type="hidden" id="ReportType" name="ReportType" value="Ledger Report" />
                                        <div class="row">
                                            <div class="col col-md-6">
                                                <label>Account</label>
                                                <label class="select" id="">
                                                    <i class="append fa fa-caret-down"></i>
                                                    @Html.DropDownListFor(model => model.DetailCode, ViewBag.DetailCode as SelectList, new { @style = "width:100%", })
                                                </label>
                                            </div>
                                            <div class="col col-md-3">
                                                <label>Debit / Credit</label>
                                                <label class="select" id="">
                                                    <i class="append fa fa-caret-down"></i>
                                                    <select name="DebitCreditType" id="DebitCreditType" style="width:100%">
                                                        <option value="All">All</option>
                                                        <option value="Debit">Debit</option>
                                                        <option value="Credit">Credit</option>
                                                    </select>
                                                </label>
                                            </div>
                                            <div class="col col-md-3">
                                                <label>Opening Balance</label>
                                                <label class="select" id="">
                                                    <i class="append fa fa-caret-down"></i>
                                                    <select name="OpeningBalanceType" id="OpeningBalanceType" style="width:100%">
                                                        <option value="With Opening Balance">With Opening Balance</option>
                                                        <option value="Without Opening Balance">Without Opening Balance</option>
                                                    </select>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:10px">
                                            <section class="col col-md-2">
                                                <label class="checkbox pull-left checkBoxLbl" style="margin-top:20px">
                                                    <input id="DateCheckbox" type="checkbox" name="DateCheckbox"><i></i>
                                                    <span style="">Date</span>
                                                </label>
                                            </section>
                                            <section class="col col-md-3 dateSection" hidden>
                                                <label>From</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-calendar"></i>
                                                    @Html.TextBoxFor(m => m.FromDate, new
                                               {
                                                   @type = "date"@*, @Value = Model.FromDate.HasValue ? Model.FromDate.GetValueOrDefault().ToString("yyyy/MM/dd") : ""*@ })
                                                </label>
                                            </section>
                                            <section class="col col-md-3 dateSection" hidden>
                                                <label>To</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-calendar"></i>
                                                    <input type="date" name="ToDate" id="ToDate" autocomplete="off" required />
                                                </label>
                                            </section>
                                            <div class="col col-md-4">
                                                <button type="submit" id="btnPrint" class="btn btn-success" style="width: 100px; height: 25px; font-size: 13px; margin-top: 23px; color: white; line-height: 5px;">
                                                    Print Reports
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $('#DateCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('.dateSection').removeAttr("hidden");
            }
            else {
                $('.dateSection').attr("hidden", "hidden");
            }
        })
        $(document).ready(function () {
            $('#DetailCode').select2();
            $('#DetailCode').val(null).trigger('change');
            $('#DebitCreditType').select2();
            $('#DebitCreditType').val('All').trigger('change');
            $('#OpeningBalanceType').select2();
            $('#OpeningBalanceType').val('With Opening Balance').trigger('change');
            GetTodayDate();
        });
        $('#saleForm').on("submit", function () {
            var customerId = $('#DetailCode').val();
            if (customerId == null) {
                alert("Please select an account.");
                return false;
            }
            else {
                return true;
            }
            //var fromDate = $('#FromDate').val();
            //var toDate = $('#ToDate').val();
            //$.ajax({
            //    type: "POST",
            //    url: "/sale/printledgerreport/",
            //    dataType: 'json',
            //    data: { 'customerId': customerId,'fromDate': fromDate, 'toDate': toDate },
            //    success: function (response) {
            //        window.open("/salepurchase/printsaleinvoicereports", "_blank");
            //    }
            //})
        })
        function GetTodayDate() {
            //HiddenFomrDate
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#ToDate').val(today);

            var today2 = new Date($("#HiddenFomrDate").val());
            var dd = today2.getDate();
            var mm = today2.getMonth() + 1; //January is 0!

            var yyyy = today2.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today2 = yyyy + '-' + mm + '-' + dd;
            $('#FromDate').val(today2);
        }
    </script>
}