@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- widget content -->
@model List<POS.Models.clsInvoice>
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        PLS Summary
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> PLS Summary Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
    <input type="hidden" name="FileName" id="FileName" value="SaleInvoiceSummary" />
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content" class="panel rpt" style=" float: center; width: 98%; font-family: Arial, Helvetica, sans-serif;">
                            <table style="padding: 30px;" class="headingTable">
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: right;padding-left:12px;padding-top:0px;border-bottom:none;" colspan="12"><strong>Print Date:&nbsp;</strong>@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 24px; text-align: left;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-left">PLS Summary Report</th>
                                </tr>
                                @if (Model.Count != 0)
                                {
                                    <tr>
                                        <td style="font-size: 13px; text-align: left; padding-bottom: 30px; border-bottom: none; padding-left: 12px; font-weight: normal" colspan="12" class="routeData pull-left"><strong><span style="font-size: 13px">From:</span> </strong>@Convert.ToDateTime(Model[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size:16px">To:</span></strong>@Convert.ToDateTime(Model[0].ToDate).ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 16px; text-align: center; padding-bottom: 10px" colspan="12">&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="12">
                                            @if (Model.Count != 0)
                                            {
                                                decimal tnetsale = 0;
                                                decimal tcost = 0;
                                                decimal tgrosspls = 0;
                                                decimal tbreakge = 0;
                                                decimal tdiscount = 0;
                                                decimal tcoupen = 0;
                                                decimal tother = 0;
                                                decimal tnetpls = 0;
                                                decimal tnetrec=0;
                                                
                                                <table class="mainTable" style="margin-top:-60px;">
                                                    <thead>
                                                        <tr>
                                                            <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 9px; border: none; border-bottom: 1px solid black" colspan="12">&nbsp;</th>
                                                        </tr>
                                                    </thead>
                                                    <tr>
                                                        <th style="text-align: center; font-size: 12px;width:45px">Sr#</th>
                                                        <th style="text-align: left; font-size: 12px">Customer</th>
                                                        <th style="text-align: left; font-size: 12px; width: 90px">City</th>
                                                        <th style="text-align: left; font-size: 12px; width: 90px; ">Salesman</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net Payment<br />Received</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net Sale</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Cost</th>
                                                        <th style="text-align: right; font-size: 12px;width:70px">PLS</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Breakage</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Discount</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Coupen</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Other</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net PLS</th>
                                                    </tr>
                                                    @for (int i = 0; i < Model.Count; i++)
                                                    {

                                                        decimal netsale = Convert.ToDecimal(Model[i].NetSale);
                                                        decimal cost = Convert.ToDecimal(Model[i].NetCost);
                                                        decimal grosspls = netsale - cost;
                                                        decimal breakge = Convert.ToDecimal(Model[i].Breakage);
                                                        decimal discount = Convert.ToDecimal(Model[i].Discount);
                                                        decimal coupen = Convert.ToDecimal(Model[i].Coupen);
                                                        decimal other = Convert.ToDecimal(Model[i].Other);
                                                        decimal netpls = grosspls - breakge - discount - coupen - other;

                                                        decimal recamt = Convert.ToDecimal(Model[i].ReceivedAmount);

                                                        tnetrec += recamt;
                                                        tnetsale += netsale;
                                                        tcost += cost;
                                                        tgrosspls += grosspls;
                                                        tbreakge += breakge;
                                                        tdiscount += discount;
                                                        tcoupen += coupen;
                                                        tother += other;
                                                        tnetpls += netpls;
                                                        
                                                        <tr>
                                                            <td class="mainTd" style="text-align: center; font-size: 12px">@(i + 1)</td>
                                                            <td class="mainTd" style="text-align: left; font-size: 12px; padding-left: 5px">@Model[i].DetailName</td>
                                                            <td class="mainTd" style="text-align: left; font-size: 12px; padding-left: 5px">@Model[i].CityName</td>
                                                            <td class="mainTd" style="text-align: left; font-size: 12px; padding-left: 5px">@Model[i].SalesmanName</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(recamt).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(netsale).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(cost).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(grosspls).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(breakge).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(discount).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(coupen).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px">@Convert.ToDecimal(other).ToString("#,##0")</td>
                                                            <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(netpls).ToString("#,##0")</td>
                                                        </tr>
                                                    }

                                                    <tr>
                                                        <td class="mainTd" style="text-align: left; font-size: 12px;font-weight:bold;padding-left:5px" colspan="4">Total :</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tnetrec).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tnetsale).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tcost).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tgrosspls).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tbreakge).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tdiscount).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tcoupen).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tother).ToString("#,##0")</td>
                                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(tnetpls).ToString("#,##0")</td>
                                                    </tr>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 36.9px;  border: none;" colspan="12">&nbsp;</th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            }
                                            else
                                            {
                                                <table class="mainTable" style="">
                                                    <tr>
                                                        <th style="text-align: center; font-size: 12px;width:45px">Sr#</th>
                                                        <th style="text-align: left; font-size: 12px">Customer</th>
                                                        <th style="text-align: left; font-size: 12px; width: 90px">City</th>
                                                        <th style="text-align: left; font-size: 12px; width: 90px; ">Salesman</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net Payment<br />Received</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net Sale</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Cost</th>
                                                        <th style="text-align: right; font-size: 12px;width:70px">PLS</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Breakage</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Discount</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Coupen</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px">Other</th>
                                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Net PLS</th>
                                                    </tr>
                                                    <tr>
                                                        <td class="mainTd" colspan="13" style="text-align:center;padding:10px">No Record Found.</td>
                                                    </tr>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script src="~/Scripts/CustomJs/ResponsivePrintScreenForLandscape.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                var cssData = $('#CssData').html();
                var htmlData = $('#HtmlData').html();
                $('#DocumentName').val(cssData + htmlData);
            })
            //$.get("ConvertServerDateIntoLocalDate", function (data) {
            //    $('.LocalDate').html(data);
            //});
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
