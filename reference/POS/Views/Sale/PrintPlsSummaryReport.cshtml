<div id="CssData">
    <link href="~/Content/css/PrintMedia.css" rel="stylesheet" />
    <style>
        @@media print {
            #printable {
                display: block;
            }

            .businssName {
                margin-right: -21px !important;
            }

            .mainTable {
                width: 98% !important;
                margin-top: -45px !important;
                border-bottom: none !important;
                border-top: none !important;
            }

                .mainTable .totalTr {
                    border-bottom: 0px !important;
                    border-top: 0px !important;
                }

