<!-- widget content -->
@model List<POS.Models.clsInvoice>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="content" class="tablecontainer" style="padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-shopping-cart fa-fw "></i>
                Sale Estimate
                <span>
                    >
                    Sale Estimate Report
                </span>
            </h1>
        </div>
    </div>
    <section>
        <div class="panel">
            <div class="panel-heading">
                @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                {
                    <span class="header"> Sale Estimate Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                    <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                    <input type="hidden" name="FileName" id="FileName" value="@Model[0].ComputerNo" />
                    <a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("SaleEstimateindex", "sale")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                        Back
                    </a>
                    <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                        Print
                    </button>
                    <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                }
            </div>
            <div class="panel-body">
                <div id="HtmlData">
                    <div id="printable-content" class="panel rpt" style="width:800px;padding: 1px; border-radius: 0px; ">
                        <table style="padding-top: 37px;padding-left: 37px;padding-right: 37px;font-size:18px !important" class="headTable oldCss">
                            <tr><td colspan="99" style="text-align:center;font-size:22px;font-weight:bold;padding-bottom:30px">Sale Estimate</td></tr>
                            <tr>
                                <td colspan="99">
                                    @if (!(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessName"].ToString()))
                                        || !(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessAddress"].ToString())))
                                    {
                                        <table class="purchaseHeading oldCss">
                                            <tbody>
                                                <tr>
                                                    <th style="  text-align: left; padding-bottom: 15px;padding-right:15px;padding-top:10px;" colspan="12" class="pull-left businssName businssName22">
                                                        <div style="font-weight: bold;font-size: 20px;">@System.Web.HttpContext.Current.Application["BusinessName"]</div>
                                                        <div style="font-size: 16px;margin-left:2px">
                                                            @System.Web.HttpContext.Current.Application["BusinessAddress"]
                                                        </div>
                                                    </th>
                                                    @*
                                                        <th style="font-weight: bold; font-size: 20px; text-align: right;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-right">
                                                            <img src="@Url.Action(" getbusinesslogo", "Sale" , new { id=Convert.ToInt32(Model.SaleEstimate[0].BusinessId) })" style="height:70px;width:70px" alt="Business Logo">
                                                        </th>*@
                                                </tr>
                                            </tbody>
                                        </table>
                                        <table style="" class="borderLineTable oldCss">
                                            <tr>
                                                <td style="border-bottom:1px solid black;"></td>
                                            </tr>
                                        </table>
                                    }
                                    <table style="margin-bottom: 30px;margin-top:3px;" class="purchaseHeading oldCss">
                                        <tbody>
                                            <tr>
                                                @if (Model[0].InvoiceType == 1)
                                                {
                                                    <th class="Font18 accountName" style="font-weight: bold; font-size: 14px; text-align: left;width:50%">@Model[0].DetailName</th>
                                                }
                                                else
                                                {
                                                    <th class="Font18 accountName" style="font-weight: bold; font-size: 14px; text-align: left;width:50%">@Model[0].CashCustomerName</th>
                                                }
                                                <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Estimate No: </th>
                                                <th class="Font17" style="font-weight: normal; text-align: left; width: 18%; font-size: 16px; padding-left: 15px; ">@Model[0].ComputerNo</th>
                                            </tr>
                                            <tr>
                                                @if (!(string.IsNullOrEmpty(Model[0].Address)))
                                                {
                                                    <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">@Html.Raw(HttpUtility.HtmlEncode(Model[0].Address).Replace("\n", "<br />"))</th>
                                                }
                                                else
                                                {
                                                    <th style="font-size: 15px; text-align: left; width: 50%; " class="businssName RouteName Font17"></th>
                                                }
                                                <th class="Font17" style="font-weight: bold; text-align: right; font-size: 14px">Date: </th>
                                                <th class="Font17" style="font-weight: normal; text-align: left; width: 18%; font-size: 14px; padding-left: 15px; ">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model[0].RecordDate))</th>
                                            </tr>
                                            <tr>
                                                <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">@Model[0].Phone</th>
                                                <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Ref No: </th>
                                                <th class="Font17" style="text-align: left; width: 18%; font-size: 14px; font-weight: normal; padding-left: 16px">
                                                    @Model[0].RefrenceNo
                                                </th>
                                            </tr>

                                            @if (@Model[0].ShowBalance == 1)
                                            {
                                                <tr>
                                                    <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">&nbsp;</th>
                                                    <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Previous Balance: </th>
                                                    <th class="Font18" style="text-align: left; width: 18%; font-size: 14px;font-weight:bold; padding-left: 16px">
                                                        @Convert.ToDecimal(Model[0].PreviousBalance).ToString("#,##0.00")
                                                    </th>
                                                </tr>
                                            }
                                            
                                            @if (Model[0].SubDetailCode != 0)
                                            {
                                                <tr>
                                                    <th style="font-size: 14px; font-weight: bold; text-align: left; width: 100%; " class="businssName RouteName Font17" colspan="3">
                                                        Sub Customer : &nbsp;&nbsp;&nbsp;
                                                        <span style="font-weight:normal; text-align: right; font-size: 14px">@Model[0].SubDetailName </span>
                                                    </th>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    @if (!string.IsNullOrEmpty(Model[0].Remarks))
                                    {
                                        <table style="margin-bottom:15px;margin-top:-22px" class="description oldCss">
                                            <tr>
                                                <td class="Font17" style="font-size: 14px"><b><span style="font-size: 17px">Remarks:</span></b> @Model[0].Remarks</td>
                                            </tr>
                                        </table>
                                    }
                                    <table class="mainTable oldCss" id="" style="margin-top:-12px">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold; font-size: 13px; text-align: center; padding: 5px; border: none; border-bottom: 1px solid black" colspan="12">&nbsp;</th>
                                            </tr>
                                        </thead>
                                        <tr>
                                            <th class="Font17" style="text-align: center; border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; width: 30px;padding:3px ">Sr#</th>
                                            <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 70px; padding: 3px; ">Qty</th>
                                            <th class="Font17" style="padding-left: 8px; border-top: 1px solid black; border-bottom: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: left; padding: 3px; ">Item Name</th>
                                            <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 70px; padding: 3px; ">Rate</th>
                                            <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 70px; padding: 3px; ">Total</th>
                                            <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 90px; padding: 3px; ">Disc</th>
                                            <th class="Font17" align="center" style="text-align: center; border-top: 1px solid black; border-bottom: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; width: 100px; padding: 3px; ">Amount</th>
                                        </tr>
                                        <tbody>
                                            @{decimal totalQty = 0;
                                              decimal totalAmountbeforedisc = 0;
                                            decimal totalAmount = 0;}
                                            @for (int i = 0; i < Model.Count; i++)
                                            {
                                                totalQty += Convert.ToDecimal(Model[i].Qty);
                                                totalAmount += Convert.ToDecimal(Model[i].LineNetAmount);
                                                var tgamount = Convert.ToDecimal(Model[i].Qty) * Convert.ToDecimal(Model[i].Rate);
                                                totalAmountbeforedisc += tgamount;
                                                
                                                <tr class="">
                                                    <td class="Font17" align="center" style="text-align: center; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; ">@(i + 1)</td>

                                                    @if (Model[i].Qty == Convert.ToInt32(Model[i].Qty))
                                                    {
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(Model[i].Qty), 0) @Model[i].UnitName</td>
                                                    }
                                                    else
                                                    {
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(Model[i].Qty), 2) @Model[i].UnitName</td>
                                                    }
                                                    <td class="Font17" align="left" style="padding-left: 8px; border-bottom: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; ">@Model[i].ItemName</td>
                                                    
                                                    <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[i].Rate).ToString("#,##0.00")</td>
                                                    <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(tgamount).ToString("#,##0.00")</td>
                                                    @if (Convert.ToDecimal(Model[i].LineDiscount) == 0)
                                                    {
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">-</td>
                                                    }
                                                    else
                                                    {
                                                        if (Model[i].LineDiscountType == "%")
                                                        {
                                                            <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[i].LineDiscount).ToString("#,##0.00")%</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">Rs. @Convert.ToDecimal(Model[i].LineDiscount).ToString("#,##0.00")</td>
                                                        }
                                                    }

                                                    <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[i].LineNetAmount).ToString("#,##0.00") </td>
                                                </tr>
                                            }
                                            <tr class="">
                                                <td class="Font17" align="right" style="text-align: right; padding-right: 10px; font-weight: bold; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; "></td>
                                                @if (totalQty == Convert.ToInt32(totalQty))
                                                {
                                                    <td class="Font17" align="center" style="border-bottom: 1px solid black; font-weight: bold; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(totalQty), 0)</td>
                                                }
                                                else
                                                {
                                                    <td class="Font17" align="center" style="border-bottom: 1px solid black; font-weight: bold; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(totalQty), 2)</td>
                                                }
                                                <td class="Font17" style="border-bottom: 1px solid black;text-align:right; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight:bold" colspan="2">Total Amount</td>

                                                
                                                <td class="Font17" style="border-bottom: 1px solid black; text-align: center; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight: bold">@Convert.ToDecimal(totalAmountbeforedisc).ToString("#,##0.00")</td>
                                                <td class="Font17" style="border-bottom: 1px solid black;text-align:right; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight:bold">@Convert.ToDecimal(totalAmountbeforedisc - totalAmount).ToString("#,##0.00")</td>
                                                <td class="Font17" style="border-bottom: 1px solid black; text-align: center; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight: bold">@Convert.ToDecimal(totalAmount).ToString("#,##0.00")</td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 3.9px;  border: none;" colspan="12">&nbsp;</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <table style="margin-top:10px" class="AccountNameTable oldCss">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold; font-size: 2px; text-align: center; padding: 1px; border: none;" colspan="12">&nbsp;</th>
                                            </tr>
                                        </thead>
                                        @if (Model[0].NetDiscount != 0 && Model[0].NetDiscount != null)
                                        {
                                            <tr>
                                                <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; border-top: 1px solid black; width: 230px; text-align: right;padding-right:3px "><span style="font-size: 14px; font-weight: bold" class="Font17">Gross Total:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].GrossTotal).ToString("#,##0.00")</th>
                                            </tr>
                                            <tr>
                                                @if (Model[0].DiscountType == "%")
                                                {
                                                    <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Discount:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].NetDiscount).ToString("#,##0.00")%</th>
                                                }
                                                else
                                                {
                                                    <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Discount:&nbsp;&nbsp; </span>Rs. @Convert.ToDecimal(Model[0].NetDiscount).ToString("#,##0.00")</th>
                                                }
                                            </tr>
                                        }
                                        <tr>
                                            <th class="pull-right Font17" style="font-size: 14px; border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Total:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].NetAmount).ToString("#,##0.00")</th>
                                        </tr>
                                        @if (Model[0].ReceivedAmount != 0 && Model[0].ReceivedAmount != null)
                                        {
                                            <tr>
                                                <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Received:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].ReceivedAmount).ToString("#,##0.00")</th>
                                            </tr>
                                            <tr>
                                                <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold; " class="Font17">Balance Amount:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].BalanceAmount).ToString("#,##0.00")</th>
                                            </tr>
                                        }
                                        @if (@Model[0].ShowBalance == 1)
                                        {
                                            <tr>
                                                <th class="pull-right Font18" style="font-size: 14px; font-weight: bold; width: 230px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; text-align: right; padding-right: 3px">
                                                    <span style="font-size:14px;" class="Font17">Net Balance:&nbsp;&nbsp; </span>@((Convert.ToDecimal(Model[0].PreviousBalance) + Convert.ToDecimal(Model[0].BalanceAmount)).ToString("#,##0.00"))
                                                </th>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <th class="pull-right Font18" style="font-size: 14px; font-weight: bold; width: 230px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; text-align: right; padding-right: 3px">
                                                    <span style="font-size:14px;" class="Font17">Invoice Balance:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[0].BalanceAmount).ToString("#,##0.00")
                                                </th>
                                            </tr>
                                        }
                                        <tfoot>
                                            <tr>
                                                <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 6.9px;  border: none;" colspan="12">&nbsp;</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <br />
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- END MAIN CONTENT -->
@section pagespecific {
    <script src="~/Scripts/CustomJs/ResponsivePrintScreenForInvoices.js?v=2"></script>
    <script type="text/javascript">
        $(document).ready(function () {

        })
        $('#downloadForm').on("submit", function () {
            $("table").each(function () {
                $(this).removeClass("oldCss");
                $(this).addClass("newCss");
                var cssData = $('#CssData').html();
                var htmlData = $('#HtmlData').html();
