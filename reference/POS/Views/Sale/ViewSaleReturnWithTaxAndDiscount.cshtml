<div id="CssData">
    <link href="~/Content/css/PrintMedia.css" rel="stylesheet" />
    <style>
        @@media print {
            #printable {
                display: block;
            }

            .businssName {
                margin-right: -21px !important;
            }

            .mainTable {
                width: 100% !important;
                margin-top: -45px !important;
            }

                .mainTable .totalTr {
                    border-bottom: 0px !important;
                    border-top: 0px !important;
                }

            #printable-content {
                margin: 10px !important;
            }
            /*@@page:first {
                size: landscape;
                margin-bottom: 35px;
                margin-top: 10px;
            }*/
            @@page {
                size: landscape;
                margin-top: 21px;
                margin-bottom: 10px !important;
            }

            @@page:first {
                size: landscape;
                margin-bottom: 50px;
                margin-top: 19px;
            }

            .headingTable {
                border-bottom: none !important;
                border-top: none !important;
            }

            .routeData {
                margin-top: -50px !important;
            }

            .dateData {
                margin-top: -55px !important;
            }
        }

        .rpt {
            background: #fff !important;
            border-width: 0px;
        }

        table {
            width: 100%;
        }

        .mainTable {
            width: 98%;
            margin-left: 10px;
            padding-right: 35px;
        }

            .mainTable th, .mainTd {
                border: 1px solid black;
            }

            .mainTable tr th {
                padding: 4px;
            }

            .mainTable tr td {
                padding: 2px;
            }

        /*.printBtn:hover {
            margin-left: 2px;
            width: 63px !important;
            height: 32px !important;
            transition: width .0001s, height .0001s;
            background-color: #054583 !important;
        }*/
