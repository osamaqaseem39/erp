</div>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- widget content -->
@model List<pos.models.clsinvoice>
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        PLS
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> PLS Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="PLS" />
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content" class="panel rpt" style=" float: center; min-width: 98%; font-family: Arial, Helvetica, sans-serif;">
                            <table style="padding: 30px" class="headingTable">
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: left;padding-left:12px;padding-top:0px;border-bottom:none;" colspan="12" class="pull-right"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    @*<th style="font-weight: bold; font-size: 20px; text-align: right; padding-bottom: 30px;padding-right:15px;padding-top:10px;" colspan="12" class="pull-right businssName">TradeHex</th>*@
                                    <th style="font-weight: bold; font-size: 24px; text-align: left;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-left">PLS</th>
                                </tr>
                                @if (Model.Count != 0)
                                {
                                    <tr>
                                        <td style="font-size: 13px; text-align: left; padding-bottom: 30px; border-bottom: none; padding-left: 12px; font-weight: normal" colspan="12" class="routeData pull-left"><strong><span style="font-size: 13px">From:</span> </strong>@Convert.ToDateTime(Model[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size:16px">To:</span></strong>@Convert.ToDateTime(Model[0].ToDate).ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </table>
                            @if (Model.Count != 0)
                            {
                                <table class="mainTable" style="margin-top:-20px">
                                    <tr>
                                        <th style="text-align: center; font-size: 12px; width: 35px; ">Sr#</th>
                                        <th style="text-align: left; font-size: 12px">Customer</th>
                                        <th style="text-align: center; font-size: 12px; width: 95px; ">Invoice No.</th>
                                        <th style="text-align: center; font-size: 12px; width: 70px">Date</th>
                                        <th style="text-align: left; font-size: 12px">Item Name</th>
                                        <th style="text-align: right; font-size: 12px; width: 50px; ">Qty</th>
                                        <th style="text-align: center; font-size: 12px; width: 40px; ">UOM</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Rate</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Gross<br />Value</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Cost<br />Value</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">PLS</th>
                                    </tr>
                                    @{
                                decimal totatlFirstQuantity = 0;
                                decimal totalSecondQty = 0;
                                decimal totalRate = 0;
                                decimal totalGrossValue = 0;
                                decimal totalCostValue = 0;
                                decimal totalPLS = 0;
                                    }
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        decimal costValue = Convert.ToDecimal(Model[i].AvgRate) * Convert.ToDecimal(Model[i].Qty);
                                        decimal pls = Convert.ToDecimal(Model[i].GrossValue) - costValue;
                                        totatlFirstQuantity += Convert.ToDecimal(Model[i].Qty);
                                        totalSecondQty += Convert.ToDecimal(Model[i].SecondQty);
                                        totalRate += Convert.ToDecimal(Model[i].Rate);
                                        totalGrossValue += Convert.ToDecimal(Model[i].GrossValue);
                                        totalCostValue += costValue;
                                        totalPLS += pls;
                                        <tr>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@(i + 1)</td>
                                            @if (string.IsNullOrEmpty(Model[i].CityName))
                                            {
                                                <td class="mainTd" style="text-align: left; font-size: 11px">@Model[i].DetailName</td>
                                            }
                                            else
                                            {
                                                <td class="mainTd" style="text-align: left; font-size: 11px">@Model[i].DetailName, @Model[i].CityName</td>
                                            }
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Model[i].ComputerNo</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Convert.ToDateTime(Model[i].RecordDate).ToString("dd/MM/yy")</td>
                                            <td class="mainTd" style="text-align: left; font-size: 11px">@Model[i].ItemName</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px; ">@Convert.ToDecimal(Model[i].Qty).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px; ">@Model[i].UnitName</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].Rate).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px; ">@Convert.ToDecimal(Model[i].GrossValue).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px; ">@Convert.ToDecimal(costValue).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px; ">@Convert.ToDecimal(pls).ToString("#,##0.00")</td>
                                        </tr>
                                    }
                                    <tr class="totalTr">
                                        <td class="mainTd" style="text-align: center; border: none; border-bottom: 1px solid #fff; font-size: 11px; "></td>
                                        <td class="mainTd" style="text-align: left; border: none; border-bottom: 1px solid #fff; font-size: 11px"></td>
                                        <td class="mainTd" style="text-align: center; border: none; border-bottom: 1px solid #fff; font-size: 11px"></td>
                                        <td class="mainTd" style="text-align: left; border: none; border-bottom: 1px solid #fff; font-size: 11px"></td>
                                        <td class="mainTd" style="text-align: left; border: none; border-bottom: 1px solid #fff; font-size: 11px"></td>
                                        <td class="mainTd" style="text-align: right; font-size: 12px;font-weight:bold ">@Convert.ToDecimal(totatlFirstQuantity).ToString("#,##0.00")</td>
                                        <td class="mainTd" style="text-align: center; border: none; border-bottom: 1px solid #fff; font-size: 11px"></td>
                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold; ">@Convert.ToDecimal(totalRate).ToString("#,##0.00")</td>
                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold;">@Convert.ToDecimal(totalGrossValue).ToString("#,##0.00")</td>
                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold;">@Convert.ToDecimal(totalCostValue).ToString("#,##0.00")</td>
                                        <td class="mainTd" style="text-align: right; font-size: 12px; font-weight: bold;">@Convert.ToDecimal(totalPLS).ToString("#,##0.00")</td>
                                    </tr>
                                </table>
                            }
                            else
                            {
                                <table class="mainTable" style="">
                                    <tr>
                                        <th style="text-align: center; font-size: 12px">Sr#</th>
                                        <th style="text-align: left; font-size: 12px">Customer</th>
                                        <th style="text-align: center; font-size: 12px">Invoice No.</th>
                                        <th style="text-align: center; font-size: 12px">Date</th>
                                        <th style="text-align: left; font-size: 12px">Item Name</th>
                                        <th style="text-align: right; font-size: 12px; ">Qty</th>
                                        <th style="text-align: center; font-size: 12px">UOM</th>
                                        <th style="text-align: right; font-size: 12px">Rate</th>
                                        <th style="text-align: right; font-size: 12px">Gross<br />Value</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">Cost<br />Value</th>
                                        <th style="text-align: right; font-size: 12px; width: 70px; ">PLS</th>
                                    </tr>
                                    <tr>
                                        <td class="mainTd" colspan="11" style="text-align:center;padding:10px">No Record Found.</td>
                                    </tr>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script type="text/javascript">
            $(document).ready(function () {
                var cssData = $('#CssData').html();
                var htmlData = $('#HtmlData').html();
                $('#DocumentName').val(cssData + htmlData);
            })
            //$.get("ConvertServerDateIntoLocalDate", function (data) {
            //    $('.LocalDate').html(data);
            //});
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
