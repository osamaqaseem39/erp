        function SavePrices(print) {
            var count = 0;
            $('#priceDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("There is no prices records to be saved.");
                return false;
            }
            $('#btnSavePrices').prop('disabled', true);
            $('#btnSaveAndPrintPrices').prop('disabled', true);
            var invoiceDetailData = JSON.stringify(getAllData());
            $.ajax({
                type: "POST",
                url: "/sale/InsertUpdateItemsPricesSale",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'data': invoiceDetailData }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == "Print") {
                            window.location.href = "/sale/pricelistsalereport/" + data.invoiceNo;
                        }
                        else {
                            alert("Success! Prices Record saved successfully.");
                            location.reload();
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSavePrices').prop('disabled', false);
                        $('#btnSaveAndPrintPrices').prop('disabled', false);
                    }
                }
            })
        }
