@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="modal fade" id="PriceListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Prices List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="priceListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Manual Product Price </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            <div class="widget-body">

                                <div class="well smart-form" style="border: 1px solid #bdbdbd; background-color: #F7F7F7;padding:10px">
                                    <div class="row">
                                        <div class="col col-md-4">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 10%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="CategoryCheckbox" type="checkbox" name="CategoryCheckbox"><i></i>
                                                            <span style="font-size:13px">Category</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 90%; padding-left: 3px; " id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            @Html.DropDownListFor(model => model.CategoryID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtCategoryID", @disabled = "disabled" })
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-3">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 10%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="BrandCheckbox" type="checkbox" name="BrandCheckbox"><i></i>
                                                            <span style="font-size:13px">Brand</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 90%; padding-left: 3px; " id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            @Html.DropDownListFor(model => model.BrandID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtBrandID", @disabled = "disabled" })
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-3">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 10%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="CodeCheckbox" type="checkbox" name="CodeCheckbox"><i></i>
                                                            <span style="font-size:13px">Code</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 90%; padding-left: 3px; " id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            @Html.DropDownListFor(model => model.ItemID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtItemID", @disabled = "disabled" })
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-2">
                                            <table class="pull-right" style="margin-right:14px;margin-top:3px">
                                                <tr>
                                                    <td style="padding-left:7px">
                                                        <button type="button" id="btnSearch" class="btn btn-primary" style="width: 65px; height: 25px; font-size: 13px; margin-bottom: 8px; color: white; line-height: 5px;">
                                                            Search
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <button type="button" id="btnRefresh" class="btn btn-default" style="width: 65px; height: 27px; font-size: 13px; margin-left: 5px; margin-bottom: 8px; color: #000; line-height: 3px;">
                                                            Refresh
                                                        </button>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-top:10px">
                                        <div class="col col-md-5">

                                        </div>
                                        <div class="col col-md-5">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 21%; padding-right: 3px; padding-left: 7px;text-align:right" id="">
                                                        <span style="font-size:12px;color:black;font-weight:bold">% Sale</span>
                                                    </td>
                                                    <td style="width: 29%; padding-left: 3px; " id="">
                                                        <label class="input">
                                                            <input type="hidden" id="ComputerNo" value="" />
                                                            <input type="text" class="AddSaleTextbox" value="" style="width:100%" />
                                                        </label>
                                                    </td>
                                                    <td style="width: 23%; padding-left: 7px; " id="" hidden>
                                                        <span style="font-size: 12px; color: black; font-weight: bold; ">% Purchase</span>
                                                    </td>
                                                    <td style="width: 27%; padding-left: 3px;padding-right:5px; " id="" hidden>
                                                        <label class="input">
                                                            <input type="text" class="AddPurchaseTextbox" value="" style="width:100%" />
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-2">
                                            <table class="pull-right" style="margin-right:14px;margin-top:3px">
                                                <tr>
                                                    <td style="padding-left:7px">
                                                        <button type="button" id="btnAddprice" class="btn btn-warning" style="width: 75px; height: 25px; font-size: 13px; margin-bottom: 8px; color: white; line-height: 5px;">
                                                            Add Price
                                                        </button>
                                                    </td>
                                                    <td>
                                                        @if (User.Save == 1)
                                                        {
                                                            <button type="button" id="btnSave" class="btn btn-success" style="width: 65px; height: 27px; font-size: 13px; margin-left: 5px; margin-bottom: 8px; color: #fff; line-height: 3px;">
                                                                Save
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <table id="myTableManualProductPrice" class="table table-striped table-bordered table-hover" width="100%" style="margin-top:20px">
                                    <thead>
                                        <tr>
                                            <th data-class="expand" style="text-align: left;"><i class="fa fa-fw fa-info text-muted"></i> Item Code</th>
                                            <th data-hide="phone" style="text-align: left"><i class="fa fa-fw fa-info text-muted"></i> Item Name</th>
                                            <th data-hide="phone" style="text-align: center; width: 13%"><i class="fa fa-fw fa-info text-muted"></i> Category</th>
                                            <th data-hide="phone" style="text-align: center; width: 10%; "><i class="fa fa-fw fa-info text-muted"></i> Brand</th>
                                            <th data-hide="" style="text-align: right; width: 13%; "><i class="fa fa-fw fa-sort-amount-up text-muted"></i> Sale Price</th>
                                            <th data-hide="phone" style="text-align: right;" class="NoDisplay"> Item Id</th>
                                            <th data-hide="phone" style="text-align: right;" class="NoDisplay"> Sale Price</th>
                                            <th data-hide="phone" style="text-align: right;"> </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="noRecordTr">
                                            <td class="" colspan="6" style="text-align:center;padding:10px">No Record Found.</td>
                                        </tr>
                                    </tbody>
                                </table>
                                @if(User.Change == 1)
                                {
                                    <center>
                                    <div class="col-md-12" style="margin-top:15px">
                                        <a title="Prices List" id="btnPriceList" class="btn btn-primary" href="javascript:void(0)" data-toggle="modal" data-target="#PriceListModal" style="padding:5px">
                                            Manual Prices List
                                        </a>
                                    </div>
                                </center>
                                }
                                
                                <center>
                                    <div class="col-md-12" style="margin-top:15px">
                                        <a title="Add All of Current Page" id="btnaddall" class="btn btn-primary" href="javascript:void(0)" style="padding:5px">
                                            Add All of Current Page
                                        </a>
                                    </div>
                                </center>
                                <div class="col-md-12" style="margin-bottom:5px;margin-top:5px">
                                    <table class="" style="width:100%">
                                        <tr>
                                            <td style="width:80%;padding-left:0px;padding-right:5px" id="">
                                                <label>Remarks</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-info"></i>
                                                    <input type="text" name="Remarks" id="Remarks" class="Remarks" placeholder="Remarks" autocomplete="off" />
                                                </label>
                                            </td>
                                            <td style="width: 20%;padding-right: 3px;padding-top:15px" id="">
                                                @if (User.Save == 1)
                                                {
                                                    <button type="button" id="btnSavePrices" class="btn btn-success pull-right" style="width: 75px; height: 25px; font-size: 13px; color: white; line-height: 5px;">
                                                        Save
                                                    </button>
                                                    <button type="button" id="btnSaveAndPrintPrices" class="btn btn-success pull-right" style="width: 85px; height: 25px; font-size: 13px;margin-right:5px; color: white; line-height: 5px;">
                                                        Save & Print
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-12" style="margin-bottom:10px">
                                    <table id="priceDetailTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th data-class="" style="width: 20px; background-color: #568A89; color: white; padding: 7px; text-align: center; border-left: none; "></th>
                                                <th data-hide="" style="width: 200px; background-color: #568A89; color: white; padding: 7px; text-align: left; ">Item Code</th>
                                                <th data-hide="" style="width: 458px; background-color: #568A89; color: white; padding: 7px; text-align: left; ">Item Name</th>
                                                <th style="width: 100px; background-color: #568A89; color: white; padding: 7px; text-align: center; ">Sale Price</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var responsiveHelper_dt_basic2 = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition2 = {
                tablet: 1024,
                phone: 480
            };
            $('#priceDetailTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic2) {
                        responsiveHelper_dt_basic2 = new ResponsiveDatatablesHelper($('#priceDetailTable'), breakpointDefinition2);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic2.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic2.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });
            //////////////////////Category///////////////////////////
            var pageSizeCategory = 20;
            var optionListUrlCategory = '@Url.Action("GetOptionList", "CategoryComboList")';
            $('#txtCategoryID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlCategory,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeCategory,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeCategory) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Brand///////////////////////////
            var pageSizeBrand = 20;
            var optionListUrlBrand = '@Url.Action("GetOptionList", "BrandComboList")';
            $('#txtBrandID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlBrand,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeBrand,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeBrand) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });



            var pageSize = 20;
            var optionListUrl = '@Url.Action("GetOptionList", "ItemComboList")';

            $('#txtItemID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrl,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSize,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSize) < data.Total
                            }
                        };
                    }
                },
                placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });


        });
        $('#CategoryCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtCategoryID').prop("disabled", false);
            }
            else {
                $('#txtCategoryID').prop("disabled", true);
                $('#txtCategoryID').val('');
            }
        })
        $('#BrandCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtBrandID').prop("disabled", false);
            }
            else {
                $('#txtBrandID').prop("disabled", true);
                $('#txtBrandID').val('');
            }
        })

        $('#CodeCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtItemID').prop("disabled", false);
            }
            else {
                $('#txtItemID').prop("disabled", true);
                $('#txtItemID').val('');
            }
        })
        $('#btnSearch').click(function () {
            //var vtable = $('#priceDetailTable').DataTable();
            //$('#ComputerNo').val("");
            //vtable.clear().draw();
            var brandCheckbox = $('#BrandCheckbox').is(":checked");
            var brand = $('#txtBrandID').val();

            var categoryCheckbox = $('#CategoryCheckbox').is(":checked");
            var category = $('#txtCategoryID').val();

            var itemCheckbox = $('#CodeCheckbox').is(":checked");
            var itemId = $('#txtItemID').val();
            

            $('.showItemsBtn').prop("disabled", true);

            $.ajax({
                type: "POST",
                url: "/sale/SetSessionsForManualProductPrice/",
                dataType: 'json',
                data: {
                    'brandCheckbox': brandCheckbox, 'brandId': brand, 'categoryCheckbox': categoryCheckbox, 'categoryId': category,
                    'itemCheckbox': itemCheckbox, 'itemId': itemId
                },
                success: function (response) {
                    getItems();
                    $('.showItemsBtn').prop("disabled", false);
                }
            })
        })
        $('#btnRefresh').click(function () {
            location.reload();
        })
        function getItems() {
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };
            $('#myTableManualProductPrice').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableManualProductPrice'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "pageLength": 100,
                "bInfo": false,
                "bDestroy": true,
                "ajax": {
                    "url": "/sale/GetAllItemsForManualProductPrice",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                        { "data": "UrduName", "name": "UrduName", "class": "UrduName", "autoWidth": true, "orderable": true, },
                        { "data": "ItemName", "name": "ItemName", "class": "ItemName", "autoWidth": true, "orderable": true, },
                        { "data": "CategoryName", "name": "CategoryName", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        { "data": "BrandName", "name": "BrandName", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        {
                            "data": "SalePrice", "name": "SalePrice", "class": "Amount", "orderable": true, "render": function (data) {
                                return '<input type="text" class="SalePriceTextbox" value="' + ReplaceNumberWithCommas(data) + '" style="width:100%;text-align:right;padding-right:6px;font-weight:bold;font-size:14px;margin-right:3px" />';
                            }
                        },
                        { "data": "ItemID", "name": "ItemID", "class": "ItemID NoDisplay", "autoWidth": true, "orderable": true, },
                        { "data": "SalePrice", "name": "SalePrice", "class": "SalePrice NoDisplay", "autoWidth": true, "orderable": true, },
                        {
                            "data": "ItemID", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                                return '<a href="javascript:void(0);"  class="btn btn-primary plusBtn" data-value="' + data + '"  title="Add to grid" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-plus" style="margin-left:1px;margin-top:5px"></i></a>';
                            }
                        },
                ]
            });
            oTable = $('#myTableManualProductPrice').DataTable();
        }
        $('#btnAddprice').click(function () {
            var addPurchasePrice = $('.AddPurchaseTextbox').val();
            var addSalePrice = $('.AddSaleTextbox').val();
            if (addPurchasePrice == null || addPurchasePrice == '') {
                addPurchasePrice = 0;
            }
            if (addSalePrice == null || addSalePrice == '') {
                addSalePrice = 0;
            }
            $('#myTableManualProductPrice tbody tr[role=row]').each(function () {
                var salePrice = $(this).find('.SalePrice').html();
                var whatToAddInSale = (parseFloat(addSalePrice) * parseFloat(salePrice)) / 100;
                var finalSale = parseFloat(salePrice) + parseFloat(whatToAddInSale);
                finalSale = finalSale.toFixed(2);
                $(this).find('.SalePriceTextbox').val(ReplaceNumberWithCommas(finalSale));
            });
        })
        $('#btnSave').click(function () {
            //var vtable = $('#priceDetailTable').DataTable();
            //$('#ComputerNo').val("");
            //vtable.clear().draw();
            $('#btnSave').prop("disabled", true);
            $('#btnSave').html("<i class='fa fa-refresh fa-spin'></i> &nbsp; Processing...");
            $('#btnSave').css("width", "120px");
            $('#btnAddprice').hide();
            var data = [];
            $('#myTableManualProductPrice tbody tr[role=row]').each(function () {
                var itemId = $(this).find('.ItemID').html();
                var salePrice = ReplaceCommas($(this).find('.SalePriceTextbox').val());
                if (salePrice == '' || salePrice == null) {
                    salePrice = 0;
                }
                var alldata = {
