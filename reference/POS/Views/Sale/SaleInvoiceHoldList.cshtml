<style>
    .Acenter {
        text-align: center;
    }

    .Aright {
        text-align: right;
    }
</style>
@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="widget-body">
        <div class="well smart-form" style="border: 1px solid #bdbdbd; background-color: #F7F7F7;padding:10px">
            <div class="row">
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 200px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="CashCreditTypeCheckboxHold" type="checkbox" name="CashCreditTypeCheckboxHold"><i></i>
                                    <span style="font-size:11px">Type</span>
                                </label>
                            </td>
                            <td style=" width:70%;padding-left: 3px; " id="">
                                <label class="select">
                                    <i class="append fa fa-caret-down"></i>
                                    <select id="CashCreditTypeHold" name="Type" style="width:100%" disabled>
                                        <option value="Cash">Cash</option>
                                        <option value="Credit">Credit</option>
                                    </select>
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 200px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="CustomerCheckboxHold" type="checkbox" name="CustomerCheckboxHold" checked><i></i>
                                    <span style="font-size: 11px">Customer</span>
                                </label>
                            </td>
                            <td style="width: 70%; padding-left: 3px; " id="">
                                <label class="select">
                                    <i class="append fa fa-caret-down"></i>
                                    @Html.DropDownListFor(model => model.DetailCode, ViewBag.DetailCode as SelectList, new { @style = "width:100%", id = "SearchDetailCodeHold" })
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 300px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="CashCustomerNameCheckboxHold" type="checkbox" name="CashCustomerNameCheckboxHold"><i></i>
                                    <span style="font-size:11px">Cash Customer</span>
                                </label>
                            </td>
                            <td style=" width:60%;padding-left: 3px; " id="">
                                <label class="input">
                                    <input type="text" id="SearchCashCustomerNameHold" value="" style="width:100%" disabled />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 300px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="ComputerNoCheckboxHold" type="checkbox" name="ComputerNoCheckboxHold"><i></i>
                                    <span style="font-size:11px">Invoice No.</span>
                                </label>
                            </td>
                            <td style=" width:60%;padding-left: 3px; " id="">
                                <label class="input">
                                    <input type="text" id="SearchComputerNoHold" value="" style="width:100%" disabled />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col col-md-3">
                    <table class="" style="">
                        <tr>
                            <td style="width: 80px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="DateCheckboxHold" type="checkbox" name="DateCheckboxHold"  checked /><i></i>
                                    <span style="font-size:11px">&nbsp;</span>
                                </label>
                            </td>
                            <td style="width: 85%; padding-right: 3px; padding-left: 0px" id="">

                                <label style="font-size:13px">Date</label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-5">
                </div>
                <div class="col col-md-4">
                </div>
            </div>
            <div class="row" style="margin-top:10px;padding-left:40px" id="DatesRowHold">
                <div class="col col-md-4">
                    <table class="" style="">
                        <tr>
                            <td style="width: 10%; padding-right: 3px; padding-left: 7px" id=""></td>
                            <td style="width: 90%; padding-right: 3px; padding-left: 7px" id="">
                                <label>From</label>
                                <label class="input">
                                    <i class="icon-prepend fa fa-user"></i>
                                    <input type="date" name="SearchFromDateHold" id="SearchFromDateHold" autocomplete="off" required />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-4">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-user"></i>
                        <input type="date" name="SearchToDateHold" id="SearchToDateHold" autocomplete="off" required />
                    </label>
                </div>

            </div>
            <div class="row" style="margin-top:10px">
                <table class="pull-right" style="margin-right:14px">
                    <tr>
                        <td style="padding-left:7px">
                            <button type="button" id="btnSearchSaleHold" class="btn btn-primary" style="width: 65px; height: 25px; font-size: 13px; margin-bottom: 8px; color: white; line-height: 5px;">
                                Search
                            </button>
                        </td>
                        @*<td>
                                <button type="button" id="btnRefresh" class="btn btn-default" style="width: 65px; height: 27px; font-size: 13px; margin-left: 5px; margin-bottom: 8px; color: #000; line-height: 3px;">
                                    Refresh
                                </button>
                            </td>*@
                    </tr>
                </table>
            </div>
        </div>
        <table id="myTableSaleHold" class="table table-striped table-bordered table-hover" width="100%">
            <thead>
                <tr>
                    <th data-hide=""></th>
                    <th data-class="expand" style="width:130px"><i class="fa fa-fw fa-hashtag text-muted"></i>Invoice No.</th>
                    <th data-hide="phone"><i class="fa fa-user text-muted"></i> Customer</th>
                    <th data-hide="phone,tablet"><i class="fa fa-hashtag text-muted"></i> Reference No.</th>
                    <th data-hide="phone"><i class="fa fa-calendar text-muted"></i> Date</th>
                    <th data-hide="phone,tablet,desktop"><i class="fa fa-money-bill-alt text-muted"></i> Credit Days</th>
                    <th data-hide="phone"><i class="fa fa-money-bill-alt text-muted"></i> Net Amount</th>
                    <th data-hide="phone,tablet,desktop"> Overhead</th>
                    <th data-hide="phone,tablet,desktop"> Freight</th>
                    <th data-hide="phone,tablet,desktop"> Remarks</th>
                    <th data-hide="phone,tablet,desktop"> Cash Customer</th>
                </tr>
            </thead>
            <tbody>
                <tr class="noRecordTr">
                    <td class="" colspan="11" style="text-align:center;padding:10px">No Record Found.</td>
                </tr>
            </tbody>
        </table>
    </div>
    @*</div>

                    </div>
                </article>
            </div>
        </section>*@
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#SearchDetailCodeHold').select2({
            dropdownParent: $("#SaleHoldListModal")
        });
        $('#SearchDetailCodeHold').val(null).trigger('change');
        $('#CashCreditTypeHold').val('');
        GetTodayDateSearchHold();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var invoiceNo = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/sale/GetSaleInvoiceById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    $('#DisableOrNot').val(1);
                    $('#MainDetailCode').select2().enable(true);
                    $('#ReceivedDetailCode').select2().enable(true);
                    $('#SalesmanID').select2().enable(true);
                    $('#WarehouseID').select2().enable(true);
                    $('#txtItemID').prop("disabled", false);
                    $('#Tax1ID').select2().enable(true);
                    $('#Tax2ID').select2().enable(true);
                    $("input[type='radio']").prop("disabled", false);
                    $('#Date').prop("disabled", false);
                    $('#ReferenceNo').prop("disabled", false);
                    $('#CreditDays').prop("disabled", false);
                    $('#DiscountType').prop("disabled", false);
                    $('#DiscountAmount').prop("disabled", false);
                    $('#Overhead').prop("disabled", false);
                    $('#Freight').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#Paid').prop("disabled", false);
                    $('#ShowBalance').prop("disabled", false);
                    $('#Transporter').prop("disabled", false);
                    $('#BiltyNo').prop("disabled", false);
                    $('#BiltyDate').prop("disabled", false);
                    $('#BiltyPending').prop("disabled", false);
                    $('#Packing').prop("disabled", false);

                    //$('#LineDiscountCheckbox').prop("disabled", false);
                    $('#LineTax1Checkbox').prop("disabled", false);
                    $('#LineTax2Checkbox').prop("disabled", false);

                    $('#Rate').prop("disabled", false);
                    $('#Quantity').prop("disabled", false);
                    //$('#ItemNote').prop("disabled", false);

                    $('#invoiceNoSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    if (response.data.ShowBalance == 1) {
                        $('#ShowBalance').prop("checked", true);
                    }
                    else {
                        $('#ShowBalance').prop("checked", false);
                    }
                    $('#SaleInvoiceNo').val(response.data.ComputerNo);
                    $('#SaleInvoiceNoSpan').html(response.data.ComputerNo);
                    var invoiceType = response.data.InvoiceType;
                    if (invoiceType == 0) {
                        $('#CashCustomerNameLbl').removeAttr("hidden");
                        $('#MainDetailSelect').attr("hidden", "hidden");
                        $('#CashCustomerNameLbl').show();
                        $('#MainDetailSelect').hide();
                        $('#MainDetailCode').val(null).trigger('change');
                        //$('#CashCustomerName').val(response.data.CashCustomerName);
                        if ($('#CashCustomerName').find("option[value='" + response.data.CashCustomerName + "']").length) {
                            $('#CashCustomerName').val(response.data.CashCustomerName).trigger('change');
                        } else {
                            // Create a DOM Option and pre-select by default
                            var newOption = new Option(response.data.CashCustomerName, response.data.CashCustomerName, true, true);
                            // Append it to the select
                            $('#CashCustomerName').append(newOption).trigger('change');
                        }
                        $("input[value='Cash']").prop("checked", true);
                    }
                    else {
                        $('#MainDetailSelect').removeAttr("hidden");
                        $('#CashCustomerNameLbl').attr("hidden", "hidden");
                        $('#CashCustomerNameLbl').hide();
                        $('#MainDetailSelect').show();
                        $('#MainDetailCode').val(response.data.DetailCode).trigger('change');
                        $('#CashCustomerName').val("");
                        $("input[value='Credit']").prop("checked", true);
                    }

                    $('#Date').val(getDate(response.data.RecordDate));
                    $('#ReferenceNo').val(response.data.RefrenceNo);
                    $('#CreditDays').val(response.data.CreditDays);
                    $('#DiscountType').val(response.data.DiscountType);
                    $('#DiscountAmount').val(response.data.Discount);
                    $('#NetDiscount').val(response.data.NetDiscount);
                    $('#Overhead').val(response.data.Overhead);
                    $('#Freight').val(response.data.Freight);
                    $('#Remarks').val(response.data.Remarks);
                    $('#HiddenStock').val(0);
                    $('#PreviousBalance').html(ReplaceNumberWithCommas(parseFloat(response.data.PreviousBalance).toFixed(2)));
                    if (response.data.Received == 1) {
                        $('#PaidRow').removeAttr("hidden");
                        $('#Paid').prop("checked", true);
                    }
                    else {
                        $('#Paid').prop("checked", false);
                        $('#PaidRow').attr("hidden", "hidden");
                    }
                    $('#ReceivedDetailCode').val(response.data.ReceivedDetailCode).trigger('change');
                    $('#PaidAmount').val(response.data.ReceivedAmount);
                    $('#PaidRemarks').val(response.data.ReceivedRemarks);
                    $('#BalanceAmount').val(response.data.BalanceAmount);

                    if (response.data.ExtraOrNot == 1) {
                        $('#ExtraInfoOrNot').val(1);
                        $('#ExtraInformation').removeAttr("hidden");
                    }
                    else {
                        $('#ExtraInfoOrNot').val(0);
                        $('#ExtraInformation').attr("hidden", "hidden");
                    }
                    $('#Transporter').val(response.data.Transporter);
                    $('#BiltyNo').val(response.data.BiltyNo);
                    $('#Packing').val(response.data.BiltyPacking);
                    $('#BiltyDate').val(getDate(response.data.BiltyDate));
                    $('#SalesmanID').select2('val', response.data.SalesmanID);
                    if (response.data.BiltyPending == 1) {
                        $('#BiltyPending').prop("checked", true);
                    }
                    else {
                        $('#BiltyPending').prop("checked", false);
                    }
                    //$('#LineDiscountCheckbox').prop("checked", false);
                    $('#LineTax1Checkbox').prop("checked", false);
                    $('#LineTax2Checkbox').prop("checked", false);
                    //$('#LineDiscountDiv').attr("hidden", "hidden");
                    $('#tax1Row').attr("hidden", "hidden");
                    $('#tax2Row').attr("hidden", "hidden");

                    $('.LineGrossTotalDiv').removeAttr("hidden");
                    //$('.LineNetAmountDiv').removeAttr("hidden");

                    $('#btnCancelDetail').hide();
                    $('#WarehouseID').val(null).trigger('change');
                    $('#txtItemID').val(null).trigger('change');
                    $('#Tax1ID').val(null).trigger('change');
                    $('#Tax2ID').val(null).trigger('change');
                    $('#Rate').val('');
                    $('#Quantity').val('');
                    //$('#ItemNote').val('');
                    $('#ItemInfoDiv').attr("hidden", "hidden");
                    $('#LineDiscountType').val('%');
                    $('#LineDiscount').val('');
                    $('#IsEdit').val(0);
                    $('#Tax1Rate').val('');
                    $('#Tax1Value').val('');

                    $('#Tax2Rate').val('');
                    $('#Tax2Value').val('');

                    $('#LineGrossTotal').html('0.00');
                    $('#LineNetRate').html('0.00');
                    $('#LineNetAmount').html('0.00');
                    $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
                    $('#Rate').css('border-color', '#bdbdbd');
                    $('#Rate').css('background-color', '#fff');
                    $('#Quantity').css('border-color', '#bdbdbd');
                    $('#Quantity').css('background-color', '#fff');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');

                    $('#DocumentGallaryPanel').attr("hidden", "hidden");
                    $('#DisplayImage').prop("src", '');

                    $('.DeleteSection').removeAttr("hidden");
                    $('.PreviousBalance').removeAttr("hidden");
                    $('.GrossTotal').removeAttr("hidden");
                    //$('.heading-1').css('margin-top', '130px');
                    $('.NetAmount').removeAttr("hidden");
                    var vtable = $('#invoiceDetailTable').DataTable();
                    vtable.clear().draw();

                    $('#btnSaveSale').prop('disabled', false);
                    $('#btnHold').prop('disabled', false);
                    $('#btnSaveAndPrintSale').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#holdTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#holdTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '41%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '41%', 'text-align': 'right' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                    getInvoiceDetail(invoiceNo);
                }
            })
        })
        function getInvoiceDetail(invoiceNo) {
            $.ajax({
                type: "POST",
                url: "/sale/GetSaleInvoiceDetailById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#invoiceDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                       "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<center><span class='SrNo'><input type='hidden' class='SR01' value='' /></span></center>",
                    "<span><input type='hidden' class='WarehouseID01' value=" + response.data[key].WarehouseID + " />" + response.data[key].WarehouseName + "</span>",
                    "<span><input type='hidden' class='ItemID01' value=" + response.data[key].ItemID + " />" + response.data[key].ItemName + "</span>",
                    "<span style='text-align:center;float:center' class=''><input type='hidden' class='Quantity01' value=" + response.data[key].Qty + " /><center>" + response.data[key].Qty + "</center></span>",
                    "<span style='text-align:right' class='pull-right'><input type='hidden' class='Rate01' value=" + response.data[key].Rate + " />" + ReplaceNumberWithCommas(response.data[key].Rate) + "</span>",
                    //"<span><input type='hidden' class='ItemNote01' value=" + response.data[key].ItemNote + " />" + response.data[key].ItemNote + "</span>",
                    "<span><input type='hidden' class='LineDiscountType01' value=" + response.data[key].LineDiscountType + " />" + response.data[key].LineDiscountType + "</span>",
                    "<span style='text-align:right' class='pull-right'><input type='hidden' class='LineDiscount01' value=" + response.data[key].LineDiscount + " />" + ReplaceNumberWithCommas(response.data[key].LineDiscount) + "</span>",
                    // "<span><input type='hidden' class='Tax1Id01' value=" + response.data[key].Tax1ID + " />" + response.data[key].Tax1Name + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax1Rate01' value=" + response.data[key].Tax1Rate + " />" + ReplaceNumberWithCommas(response.data[key].Tax1Rate) + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax1Value01' value=" + response.data[key].Tax1Value + " />" + ReplaceNumberWithCommas(response.data[key].Tax1Value) + "</span>",
                    //  "<span><input type='hidden' class='Tax2Id01' value=" + response.data[key].Tax2ID + " />" + response.data[key].Tax2Name + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax2Rate01' value=" + response.data[key].Tax2Rate + " />" + ReplaceNumberWithCommas(response.data[key].Tax2Rate) + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax2Value01' value=" + response.data[key].Tax2Value + " />" +ReplaceNumberWithCommas( response.data[key].Tax2Value) + "</span>",
                    "<span class='pull-right'><input type='hidden' class='NetRate01' value=" + response.data[key].LineNetRate + " />" + ReplaceNumberWithCommas(response.data[key].LineNetRate) + "</span>",
                    "<span class='pull-right'><input type='hidden' class='GrossTotal01' value=" + response.data[key].LineGrossAmount + " />" + ReplaceNumberWithCommas(response.data[key].LineGrossAmount) + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='NetAmount01' value=" + response.data[key].LineNetAmount + " />" +ReplaceNumberWithCommas(response.data[key].LineNetAmount) + "</span>",
                        ]).draw(false);
                    }
                    getSerialNo();
                    getMainGrossTotal();
                    getMainNetAmount();
                }
            })
        }

    });
    $('#CustomerCheckboxHold').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchDetailCodeHold').prop("disabled", false);
        }
        else {
            $('#SearchDetailCodeHold').prop("disabled", true);
            $('#SearchDetailCodeHold').val(null).trigger('change');
        }
    })
    $('#CashCustomerNameCheckboxHold').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchCashCustomerNameHold').prop("disabled", false);
        }
        else {
            $('#SearchCashCustomerNameHold').prop("disabled", true);
            $('#SearchCashCustomerNameHold').val('');
        }
    })
    $('#CashCreditTypeCheckboxHold').change(function () {
        if ($(this).is(":checked")) {
            $('#CashCreditTypeHold').prop("disabled", false);
        }
        else {
            $('#CashCreditTypeHold').prop("disabled", true);
            $('#CashCreditTypeHold').val('');
        }
    })
    $('#DateCheckboxHold').change(function () {
        if ($(this).is(":checked")) {
            $('#DatesRowHold').removeAttr("hidden");
        }
        else {
            $('#DatesRowHold').attr("hidden", "hidden");
        }
    })
    $('#ComputerNoCheckboxHold').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchComputerNoHold').prop("disabled", false);
        }
        else {
            $('#SearchComputerNoHold').prop("disabled", true);
            $('#SearchComputerNoHold').val('');
        }
    })
    $('#btnSearchSaleHold').click(function () {
        var customerCheckbox = $('#CustomerCheckboxHold').is(":checked");
        var customerId = $('#SearchDetailCodeHold').val();
        var cashCustomerNameCheckbox = $('#CashCustomerNameCheckboxHold').is(":checked");
        var cashCustomerName = $('#SearchCashCustomerNameHold').val();

        var cashCreditTypeCheckbox = $('#CashCreditTypeCheckboxHold').is(":checked");
        var cashCreditType = $('#CashCreditTypeHold').val();

        var computerNoCheckbox = $('#ComputerNoCheckboxHold').is(":checked");
        var computerNo = $('#SearchComputerNoHold').val();

        var dateCheckbox = $('#DateCheckboxHold').is(":checked");
        var fromDate = $('#SearchFromDateHold').val();
        var toDate = $('#SearchToDateHold').val();
        $('#btnSearchSale').prop("disabled", true);
        $.ajax({
            type: "POST",
            url: "/sale/SetSessionsForSaleList/",
            dataType: 'json',
            data: {
                'customerCheckbox': customerCheckbox, 'customerId': customerId, 'dateCheckbox': dateCheckbox,
                'fromDate': fromDate, 'toDate': toDate, 'cashCustomerCheckbox': cashCustomerNameCheckbox,
                'cashCustomerName': cashCustomerName, 'cashCreditTypeCheckbox': cashCreditTypeCheckbox, 'cashCreditType': cashCreditType,
                'computerNoCheckbox': computerNoCheckbox, 'computerNo': computerNo,
            },
            success: function (response) {
                getInvoicesHold();

            }
        })
    })
    function getInvoicesHold() {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableSaleHold').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableSaleHold'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "bDestroy": true,
            //"scrollX": true,
            "ajax": {
                "url": "/sale/GetAllSaleHoldInvoices",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
