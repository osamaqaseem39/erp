@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        var acc = document.getElementsByClassName("accordion");
        var i;
        for (i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function () {
                this.classList.toggle("active");
                var panel = this.nextElementSibling;
                if (panel.style.maxHeight) {
                    panel.style.maxHeight = null;
                } else {
                    panel.style.maxHeight = panel.scrollHeight + "px";
                }
            });
        }
        $(document).ready(function () {
            $('.PurchaseRatePanel').css("max-height", "100%");
            $('#PurchaseRateAccordion').addClass("active");
            $('.SaleRatePanel').css("max-height", "100%");
            $('#SaleRateAccordion').addClass("active");
            ///////////////////////Item///////////////////////////////
            var pageSize = 20;
            var optionListUrl = '@Url.Action("GetOptionList", "ItemComboList")';
            $('#txtItemID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrl,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSize,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSize) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Category///////////////////////////
            var pageSizeCategory = 20;
            var optionListUrlCategory = '@Url.Action("GetOptionList", "CategoryComboList")';
            $('#txtCategoryID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlCategory,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeCategory,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeCategory) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Brand///////////////////////////
            var pageSizeBrand = 20;
            var optionListUrlBrand = '@Url.Action("GetOptionList", "BrandComboList")';
            $('#txtBrandID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlBrand,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeBrand,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeBrand) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Code///////////////////////////
            var pageSizeCode = 20;
            var optionListUrlCode = '@Url.Action("GetOptionList", "CodeComboList")';
            $('#txtCode').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlCode,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeCode,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeCode) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
        });
        $('#ItemCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtItemID').prop("disabled", false);
            }
            else {
                $('#txtItemID').prop("disabled", true);
                $('#txtItemID').val(null).trigger('change');
            }
        })
        $('#CategoryCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtCategoryID').prop("disabled", false);
            }
            else {
                $('#txtCategoryID').prop("disabled", true);
                $('#txtCategoryID').val('');
            }
        })
        $('#BrandCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtBrandID').prop("disabled", false);
            }
            else {
                $('#txtBrandID').prop("disabled", true);
                $('#txtBrandID').val('');
            }
        })
        $('#CodeCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtCode').prop("disabled", false);
            }
            else {
                $('#txtCode').prop("disabled", true);
                $('#txtCode').val('');
            }
        })
        $('#btnSearch').click(function () {
            //$('.noRecordTrItemsList').html('<td class="" colspan="10" style="text-align:center;padding:10px"><i class="fa fa-refresh fa-spin></i>&nbsp;&nbsp;Processing..."</td>')
            var itemCheckbox = $('#ItemCheckbox').is(":checked");
            var itemId = $('#txtItemID').val();
            var categoryCheckbox = $('#CategoryCheckbox').is(":checked");
            var category = $('#txtCategoryID').val();

            var brandCheckbox = $('#BrandCheckbox').is(":checked");
            var brand = $('#txtBrandID').val();

            var codeCheckbox = $('#CodeCheckbox').is(":checked");
            var code = $('#txtCode').val();

            $.ajax({
                type: "POST",
                url: "/sale/SetSessions/",
                dataType: 'json',
                data: {
                    'itemCheckbox': itemCheckbox, 'itemId': itemId, 'categoryCheckbox': categoryCheckbox,
                    'categoryId': category, 'brandCheckbox': brandCheckbox, 'brandId': brand, 'codeCheckbox': codeCheckbox, 'code': code,
                },
                success: function (response) {
                    getItems();
                    $('.showItemsBtn').prop("disabled", true);
                }
            })
        })
        $('#btnRefresh').click(function () {
            location.reload();
        })
        function getItems() {
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };
            $('#myTableItemsList').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableItemsList'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                //"bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "pageLength": 5,
                "bInfo": true,
                "bDestroy": true,
                "lengthMenu": [[5, 10, 25, 50, 100, 250], [5, 10, 25, 50, 100, 250]],
                //"sScrollY": "400",
                //"bScrollCollapse": true,
                "ajax": {
                    "url": "/sale/GetAllItems",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                    {
                        "data": "ItemID", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                            return '<a href="javascript:void(0);"  class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:2px;margin-top:5px"></i></a>';
                        }
                    },
                    {
                        "data": "ItemID", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                            return '<a href="javascript:void(0);"  class="btn btn-success plusBtn" data-value="' + data + '"  title="Stock Detail" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;border-radius:2px "><i class="fa fa-plus plusCss" style=""></i></a>';
                        }
                    },
                        { "data": "ItemName", "name": "ItemName","class":"ItemName", "autoWidth": true, "orderable": true, },
                        { "data": "Stock", "name": "Stock", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "CostPrice", "name": "CostPrice", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "SalePrice", "name": "SalePrice", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "MinLevel", "name": "MinLevel", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "MaxLevel", "name": "MaxLevel", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "AverageRate2", "name": "AverageRate2", "class": "Amount", "autoWidth": true, "orderable": true, },
                       { "data": "PurchaseRate", "name": "PurchaseRate", "class": "Amount", "autoWidth": true, "orderable": true, },

                ]
            });
            oTable = $('#myTableItemsList').DataTable();
        }
        $(document).on('click', '.plusBtn', function () {
            var i = $(this).find('i');
            var a = $(this).closest('a');
            var itemId = a.data("value");
            var tr = $(this).closest('tr');

            if (i.hasClass("fa-plus")) {
                $(i).removeClass('fa-plus');
                $(i).removeClass('plusRight');
                $(i).addClass('fa-spin fa-refresh minusCss');
                getStockDetail(itemId, tr, i);
            }
            else if (i.hasClass("fa-refresh")) {
                return false;
            }
            else {
                $(i).removeClass('fa-minus');
                $(i).addClass('fa-plus');
                $(".newAppendedRows" + itemId)
                            .children('td, th')
                            .animate({
                                padding: 0
                            })
                            .wrapInner('<div />')
                            .children()
                            .slideUp(function () {
                                $(".newAppendedRows" + itemId).remove();
                            });
            }
            return false;
        });
        function getStockDetail(itemId, tr, i) {
            var div = '<tr style="" class="newAppendedRows' + itemId + '">' +
                            '<th style="text-align: center;">' +

                           ' </th>' +
                           '<th style="text-align: center;">' +

                           ' </th>' +
                            '<th style="text-align: left;padding:5px;font-size:14px;color:maroon" colspan="7">' +
                                'Warehouse Name' +
                           ' </th>' +
                            '<th style="text-align: right; padding: 5px;font-size:14px;color:maroon">' +
                               'Stock' +
                            '</th>' +
                        '</tr>';
            $.ajax({
                type: 'POST',
                url: '/sale/ItemStockListWarehouseBaseProductLookup/' + itemId,
                dataType: 'json',
                success: function (response) {
                    if (response.data.length == 0) {
                        $(i).removeClass('fa-spin fa-refresh minusCss');
                        $(i).addClass('fa-minus plusCss');
                    }
                    else {
                        var j = 0;
                        for (var key in response.data) {
                            j++;
                            div += '<tr style="" class="newAppendedRows' + itemId + '">' +
                                        '<th style="text-align: center;">' +

                                        ' </th>' +
                                       '<th style="text-align: center;color:maroon">' +
                                       '' + j + '' +
                                      ' </th>' +
                                       '<th style="text-align: left;color:maroon;font-weight:normal" colspan="7">' +
                                           '' + response.data[key].WarehouseName + '' +
                                      ' </th>' +
                                       '<th style="text-align: right;color:maroon;font-weight:normal">' +
                                          '' + response.data[key].Stock + '' +
                                       '</th>' +
                                    '</tr>';
                        }
                        tr.after(div);
                        $('.newAppendedRows' + itemId).hide();
                        $('.newAppendedRows' + itemId).slideDown(500).show();
                        $(i).removeClass('fa-spin fa-refresh minusCss');
                        $(i).addClass('fa-minus plusCss');
                    }
                }
            });
        }
        $(document).on('click', '.selectBtn', function () {
            var itemId = $(this).data("value");
            var itemName = $(this).closest("tr").find(".ItemName").html();
            $('#PurchaseRateAccordion').html(itemName + " Purchase Rate");
            $('#SaleRateAccordion').html(itemName + " Sale Rate");
            $.ajax({
                type: "POST",
                url: "/sale/SetSessionForItemId/",
                dataType: 'json',
                data: {
                    'itemId': itemId
                },
                success: function (response) {
                    getLastPurchaseRate();
                    getLastSaleRate();
                }
            })
        })
