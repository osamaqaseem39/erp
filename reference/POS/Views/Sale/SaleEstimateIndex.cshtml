            if (!$("#SaleForm").valid()) {
                return false;
            }

            var titleVal = $(this).find("button:focus").attr("title");
            var print = 0;
            var status = "Unpost";
            if (titleVal.trim() == "Save" || titleVal.trim() == "Hold") {
                print = 0;
            }
            else {
                print = 1;
            }
            if (titleVal.trim() == "Hold") {
                status = "Hold";
            }
            var count = 0;
            $('#invoiceDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("Error! Please add invoice detail");
                return false;
            }



            var radioValue = $("input[name='InvoiceType']:checked").val();
            if (radioValue == "Cash") {
                var cashCustomerName = $("#CashCustomerName").val();
                if (cashCustomerName == '' || cashCustomerName == null) {
                    alert("Customer is required.");
                    return false;
                }
            }
            else {
                var CustomerCode = $('#MainDetailCode').val();
                if (CustomerCode == '' || CustomerCode == null) {
                    alert("Customer is required.");
                    return false;
                }
            }

            var netAmount = ReplaceCommas($('#NetAmount').html());
            var paidAmount = $('#PaidAmount').val();
            if (paidAmount == null || paidAmount == "") {
                paidAmount = 0;
            }
            //if (radioValue == 0) {
