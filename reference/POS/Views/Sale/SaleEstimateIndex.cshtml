            }
            var quantity = $('#Quantity').val();
            if (quantity == '' || quantity == null) {
                quantity = 0;
            }
            var netRate = ReplaceCommas($('#LineNetRate').html());
            var grossTotal = parseFloat(quantity) * parseFloat(netRate);
            var tax2Amount = parseFloat(grossTotal) * parseFloat(tax2Rate);
            tax2Amount = (parseFloat(tax2Amount) / 100);
            $('#Tax2Value').val(tax2Amount.toFixed(2));
            getLineTotals();
        }
        function getLineTotals() {
            var rate = $('#Rate').val();
            var quantity = $('#Quantity').val();
            if (rate == '' || rate == null || isNaN(rate)) {
                rate = 0;
            }
            if (quantity == '' || quantity == null || isNaN(quantity)) {
                quantity = 0;
            }
            var discountAmount = 0;
            var tax1 = 0;
            var tax2 = 0;
            var discountType = $('#LineDiscountType').val();
            var netDiscount = 0;

            //LineDiscountCheckbox LineTax1Checkbox LineTax2Checkbox
            if ($('#LineDiscountCheckbox').is(':checked')) {
                discountAmount = $('#LineDiscount').val();
                if (discountAmount == '' || discountAmount == null || isNaN(discountAmount)) {
                    discountAmount = 0;
                }
                if (discountType.trim() == '%') {
                    netDiscount = parseFloat(discountAmount) / 100 * parseFloat(rate);
                    netDiscount = parseFloat(netDiscount.toFixed(2));
                }
                else if (discountType.trim() == 'Rs') {
                    netDiscount = parseFloat(discountAmount).toFixed(2);
                }
                rate = parseFloat(rate) - netDiscount;
            }
            var grossTotal = 0;
            grossTotal = parseFloat(rate) * parseFloat(quantity);
            grossTotal = grossTotal.toFixed(2);
            $('#LineGrossTotal').html(ReplaceNumberWithCommas(grossTotal));
            $('#LineNetRate').html(ReplaceNumberWithCommas(parseFloat(rate).toFixed(2)));
            var netAmount = grossTotal;

            if ($('#LineTax1Checkbox').is(':checked')) {
                tax1 = $('#Tax1Value').val();
                if (tax1 == '' || tax1 == null || isNaN(tax1)) {
                    tax1 = 0;
                }
            }
            if ($('#LineTax2Checkbox').is(':checked')) {
                tax2 = $('#Tax2Value').val();
                if (tax2 == '' || tax2 == null || isNaN(tax2)) {
                    tax2 = 0;
                }
            }
            var totalAmount = parseFloat(netAmount) + parseFloat(tax1) + parseFloat(tax2);
            $('#LineNetAmount').html(ReplaceNumberWithCommas(parseFloat(totalAmount).toFixed(2)));
        }

