        function CheckMinRate() {
            var count = 0;
            $('#invoiceDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#invoiceDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();

                var itemId = data[4].split('value=')[1].split('/>')[0].trim();
                var itemName = data[5].split('value=')[1].split('/>')[0].trim();
                var rate = data[7].split('value=')[1].split('/>')[0].trim();
                $.ajax({
                    type: "POST",
                    url: "/Sale/getItemInformation/",
                    dataType: 'json',
                    data: { 'itemId': itemId, 'detailCode': 0, 'cashCustomerName': '' },
                    success: function (response) {
                        if (parseFloat(rate).toFixed(2) < parseFloat(response.data.MinSalePrice).toFixed(2)) {
                            alert('You cannot sale below min Sale Price ---- ' + itemName);
                            return false;
                        }
                    }
                })
            }
            return true;
        }





        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#Date').val(today);
            $('#BiltyDate').val(today);
        }
        function ReplaceCommas(yourNumber) {
            var noCommas = yourNumber.replace(/,/g, ''),
                asANumber = +noCommas;
            return noCommas;
        }
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
        function getDates(date) {
            if (date == null) {
                return null;
            }
            else {
                var newdate = new Date(parseInt(date.substr(6)));
                var day = newdate.getDate();
                var month = newdate.getMonth() + 1;
                if (digits_count(day) == 1 || digits_count(day) == 0) {
                    day = "0" + day;
                }
                if (digits_count(month) == 1 || digits_count(month) == 0) {
                    month = "0" + month;
                }
                var year = newdate.getFullYear();
                var today = year + '-' + month + '-' + (day);
                if (year == 1900) {
                    return null;
                }
                else {
                    return today;
                }
            }
        }
        function digits_count(n) {
            var count = 0;
            if (n > 1)
                ++count;
            while (n / 10 >= 1) {
                n /= 10;
                ++count;
            }
            return count;
        }
