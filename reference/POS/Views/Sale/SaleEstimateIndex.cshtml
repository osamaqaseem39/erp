            //        return false;
            //    }
            //}

            $('#btnSaveSale').prop('disabled', true);
            $('#btnHold').prop('disabled', true);
            $('#btnSaveAndPrintSale').prop('disabled', true);
            var invoiceDetailData = JSON.stringify(getAllData());
            var url = $('#SaleForm')[0].action;
            $.ajax({
