        function getSubCustomer(detailCode, value, text) {
            if (detailCode == null) {
                detailCode = 0;
            }
            var pageSize = 20;
            var optionListUrl = '@Url.Action("GetOptionACSubDetailList", "Sale")';

            $('#SubDetailCode').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrl,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSize,
                            pageNumber: params.page,
                            detailCode: detailCode
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSize) < data.Total
                            }
                        };
                    }
                },
                placeholder: "-- Sub Customer--",
                //minimumInputLength: 0,
                allowClear: true,
                tags: true,
                createTag: function (tag) {
                    return { id: tag.term, text: tag.term, tag: true };
                }
            });

            if (value == 0) {
                $('#SubDetailCode').val(null).trigger('change');
            }
            else {
                if ($('#SubDetailCode').find("option[value='" + value + "']").length) {
                    $('#SubDetailCode').val(value).trigger('change');
                }
                else {
                    var newOption = new Option(text, value, true, true);
                    $('#SubDetailCode').append(newOption).trigger('change');
                }
            }
        }

