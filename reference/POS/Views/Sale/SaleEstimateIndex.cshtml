        function getTax1Value() {
            var tax1Rate = $('#Tax1Rate').val();
            var quantity = $('#Quantity').val();
            if (quantity == '' || quantity == null) {
                quantity = 0;
            }
            var netRate = ReplaceCommas($('#LineNetRate').html());
            var grossTotal = parseFloat(quantity) * parseFloat(netRate);
            if (tax1Rate == '' || tax1Rate == null || isNaN(tax1Rate)) {
                tax1Rate = 0;
            }
            var tax1Amount = parseFloat(grossTotal) * parseFloat(tax1Rate);
            tax1Amount = (parseFloat(tax1Amount) / 100);
            $('#Tax1Value').val(tax1Amount.toFixed(2));
            getLineTotals();
        }
        function getTax2Value() {
