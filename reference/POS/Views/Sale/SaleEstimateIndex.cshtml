        function DeleteSale(id) {
            var a = $.confirm({
                title: 'Delete Invoice',
                content: 'Are you sure u want to delete this invoice?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/Sale/DeleteSaleEstimate/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
