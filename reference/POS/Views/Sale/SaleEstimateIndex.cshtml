@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).keypress(function (event) {
            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') {
                event.preventDefault();
            }
        });

        $('#CashCustomerName').on('select2:select', function (e) {
            $('#Date').focus();
        });

        $('#MainDetailCode').on('select2:select', function (e) {
            $('#Date').focus();
        });
        $('#SubDetailCode').on('select2:select', function (e) {
            $('#Remarks').focus();
        });

        $('input[type=radio][name=InvoiceType]').change(function () {
            var radioValue = $("input[name='InvoiceType']:checked").val();
            if (radioValue == 'Cash') {
                $('#CashCustomerNameLbl').removeAttr("hidden");
                $('#MainDetailSelect').attr("hidden", "hidden");
                $('#CashCustomerNameLbl').show();
                $('#MainDetailSelect').hide();
                $('#MainDetailCode').val(null).trigger('change');
                $('#SubDetailCode').val(null).trigger('change');
                $('#CashCustomerName').val("");
                $('#divSubDetail').hide();
                $("#Paid").prop("checked", true);
                //$('#PaidRow').removeAttr("hidden");
                $('.PreviousBalance').attr("hidden", "hidden");
            }
            else {
                $('#MainDetailSelect').removeAttr("hidden");
                $('#CashCustomerNameLbl').attr("hidden", "hidden");
                $('.PreviousBalance').removeAttr("hidden");
                $('#CashCustomerNameLbl').hide();
                $('#MainDetailSelect').show();
                $('#MainDetailCode').val(null).trigger('change');
                $('#SubDetailCode').val(null).trigger('change');
                $('#CashCustomerName').val("");
                $('#divSubDetail').show();
                $("#Paid").prop("checked", false);
                $('#PaidRow').attr("hidden", "hidden");
                $('#ReceivedDetailCode').val(null).trigger('change');
                $('#PaidAmount').val('');
                $('#PaidRemarks').val('');
                getPaidBalanceAmount();
            }
        });


        $('#Paid').click(function () {
            if ($(this).is(':checked')) {
                //$('#PaidRow').removeAttr("hidden");
            }
            else {
                $('#PaidRow').attr("hidden", "hidden");
                $('#ReceivedDetailCode').val(null).trigger('change');
                $('#PaidAmount').val('');
                $('#PaidRemarks').val('');
                getPaidBalanceAmount();
            }
        })
        $('#LineDiscountCheckbox').click(function () {
            //if ($(this).is(':checked')) {
            //    $('#LineDiscountDiv').removeAttr("hidden");
            //}
            //else {
            //    $('#LineDiscountDiv').attr("hidden", "hidden");
            //    $('#LineDiscountType').val('%');
            //    $('#LineDiscount').val('');
            //    getLineTotals();
            //}
        })
        $('#LineTax1Checkbox').click(function () {
            if ($(this).is(':checked')) {
                $('#tax1Row').removeAttr("hidden");
            }
            else {
                $('#tax1Row').attr("hidden", "hidden");
                $('#Tax1ID').val(null).trigger('change');
                $('#Tax1Rate').val('');
                $('#Tax1Value').val('');
                getTax1Value();
                getTax2Value();
            }
        })
        $('#LineTax2Checkbox').click(function () {
            if ($(this).is(':checked')) {
                $('#tax2Row').removeAttr("hidden");
            }
            else {
                $('#tax2Row').attr("hidden", "hidden");
                $('#Tax2ID').val(null).trigger('change');
                $('#Tax2Rate').val('');
                $('#Tax2Value').val('');
                getTax1Value();
                getTax2Value();
            }
        })
        $('#togglePannel').click(function () {
            if ($('#DisableOrNot').val() == 1) {

                if ($('#iconToggle').hasClass('fa-plus')) {
                    $('#iconToggle').removeClass('fa-plus');
                    $('#iconToggle').addClass('fa-minus');
                    $('#ExtraInfoOrNot').val(1);
                    $('#ExtraInformation').slideDown().removeAttr("hidden");
                }
                else {
                    $('#iconToggle').removeClass('fa-minus');
                    $('#iconToggle').addClass('fa-plus');
                    $('#ExtraInfoOrNot').val(0);
                    $('#Transporter').val('');
                    $('#BiltyNo').val('');
                    $('#Packing').val('');
                    $('#SalesmanID').val(null).trigger('change');
                    $('#BiltyPending').prop('checked', false);
                    $('#ExtraInformation').slideUp(function () { $('#ExtraInformation') });
                }
            }
            return false;
        })
        $('#btnAddInvoiceDetail').click(function () {

            if ($('#DisableOrNot').val() == 1) {
                $('#IsEdit').val(0);
                var itemId = $('#txtItemID option:selected').val();
                var warehouseId = 0; // $('#WarehouseID option:selected').val();
                var check = 0;
