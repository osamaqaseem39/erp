<script type="text/javascript">
    $(document).ready(function () {
        GetItemsListNew();
    });
    function GetItemsListNew() {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1366,
            tablet: 1024,
            phone: 380
        };

        $('#myTableItemNew').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableItemNew'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "pageLength": 10,
            "bInfo": true,
            "bDestroy": true,
            "lengthMenu": [[5, 10, 25, 50, 100, 250], [5, 10, 25, 50, 100, 250]],
            "ajax": {
                "url": "/sale/GetAllItemsList",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ItemID", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ItemListNewModal" class="btn btn-primary selectItemBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "UrduName", "name": "UrduName", "class": "ItemCodeFromList", "width": "90px", "autoWidth": true, "orderable": true, },
                    { "data": "ItemName", "name": "ItemName", "class": "ItemNameFromList", "autoWidth": true, "orderable": true, },
                    //{ "data": "UnitName", "name": "UnitName", "autoWidth": true, "orderable": true, },
                    { "data": "CategoryName", "name": "CategoryName", "autoWidth": true, "orderable": true, },
                    { "data": "BrandName", "name": "BrandName", "autoWidth": true, "orderable": true, },
            ]
        });
        oTable2 = $('#myTableItemNew').DataTable();
    }
    $(document).one('click', '.selectItemBtn', function (e) {
        e.preventDefault();
        var itemId = $(this).attr("data-value");
        var itemCode = $(this).closest('tr').find('.ItemCodeFromList').html().trim();
        var itemName = $(this).closest('tr').find('.ItemNameFromList').html().trim();
        var newItemName = itemCode ;
        $('#txtItemID').val(itemId).trigger('change');
        if ($('#txtItemID').find("option[value='" + itemId + "']").length) {
            $('#txtItemID').val(itemId).trigger('change');
        } else {
            // Create a DOM Option and pre-select by default
            var newOption = new Option(newItemName, itemId, true, true);
            // Append it to the select
            $('#txtItemID').append(newOption).trigger('change');
        }
    })
    $('#btnSearchItemMain').click(function () {
        SearchItem();
    });
    $('#txtSearchItem').on('keypress', function (event) {
        if (event.keyCode == 13) {
            SearchItem();
        }
    });
    function SearchItem() {
        var BElement = $("#btnSearchItem");
        if (BElement.html().trim() == 'Item Name') {
            oTable2.columns(0).search($('#txtSearchItem').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Item Code') {
            oTable2.columns(1).search($('#txtSearchItem').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Category') {
            oTable2.columns(2).search($('#txtSearchItem').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Brand') {
            oTable2.columns(3).search($('#txtSearchItem').val().trim()).draw();
        }
        else {
            alert("Error! try again.");
        }
    }
    $('#btnRefreshItemNew').click(function () {
        $('#txtSearchItem').val('');
        GetItemsListNew();
    });
    $("#ulSearchItem").on("click", "a", function (e) {
        e.preventDefault();
        var $this = $(this).parent();
        $this.addClass("select").siblings().removeClass("select");
        $("#btnSearchItem").html($this.data("value"));
    })
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
