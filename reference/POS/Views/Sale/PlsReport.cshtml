@model POS.Models.clsInvoice
@{
    Layout = null;
}
<div class="widget-body no-padding" style="overflow-x:hidden;">
    @using (Html.BeginForm("printplsreport", "sale", FormMethod.Post, new { id = "saleScheduleForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
    {

        <fieldset id="myField1">
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Customer</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(m => m.DetailCode, ViewBag.Customers as SelectList, new { @id = "DetailCode", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>From</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="FromDate" name="FromDate" required />
                    </label>
                </div>
            </section>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="ToDate" name="ToDate" required />
                    </label>
                </div>
            </section>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>Invoice No.</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-hashtag"></i>
                        <input type="text" id="ComputerNo" name="ComputerNo" placeholder="Invoice No." autocomplete="off" />
                    </label>
                </div>
            </section>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>Reference No.</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="text" id="ReferenceNo" name="ReferenceNo" placeholder="Reference No." autocomplete="off" />
                    </label>
                </div>
            </section>
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Item</label>
                    <div id="ItemIDDiv">
                        @Html.DropDownListFor(model => model.ItemID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtItemID", @multiple = "multiple" })
                    </div>
                </section>
            </div>

            <div class="row">
                <section class="col col-md-6">
                    <label>Select Category</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(m => m.CategoryID, ViewBag.Category as SelectList, new { @id = "CategoryID", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
                <section class="col col-md-6">
                    <label>Select City</label>
                    <label class="select">
                        <i class="append fa fa-caret-down"></i>
                        @Html.DropDownListFor(model => model.CityId, ViewBag.City as SelectList, new { @style = "width:100%", @multiple = "multiple" })
                    </label>
                </section>
            </div>

            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>Warehouse</label>
                    <div id="WarehouseIDDiv">
                        @Html.DropDownListFor(m => m.WarehouseID, ViewBag.Warehouse as SelectList, new { @id = "WarehouseID", @style = "width:100%" })
                    </div>
                </div>
            </section>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>Salesman</label>
                    <div id="SalesmanIDDiv">
                        @Html.DropDownListFor(m => m.SalesmanID, ViewBag.Salesman as SelectList, new { @id = "SalesmanID", @style = "width:100%" })
                    </div>
                </div>
            </section>
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Report Type</label>
                    <div id="ReportTypeDiv">
                        <select name="ReportType" id="ReportType" style="width:100%">
                            <option value="Sale">Sale Invoice</option>
                            <option value="Sale Return">Sale Return</option>
                        </select>
                    </div>
                </section>
            </div>
        </fieldset>
        <footer>
            <button formtarget="_blank" type="submit" class="btn btn-labeled btn-primary pull-right">
                GENERATE REPORT
            </button>
        </footer>
    }
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#DetailCode').select2();
        //$('#ItemID').select2();
        $('#WarehouseID').select2();
        $('#SalesmanID').select2();
        $('#CategoryID').select2();
        $('#CityId').select2();
        $('#ItemID').select2('val',0);
        $('#WarehouseID').select2('val', 0);
        $('#SalesmanID').select2('val', 0);
        $('#ReportType').select2();
        $('#ReportType').val('Sale').trigger('change');
        GetTodayBetweenDate();
        var pageSize = 20;
        var optionListUrl = '@Url.Action("GetOptionList", "ItemComboList")';
        $('#txtItemID').select2({
            ajax: {
                delay: 150,
                url: optionListUrl,
                dataType: 'json',

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        searchTerm: params.term,
                        pageSize: pageSize,
                        pageNumber: params.page
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.Results,
                        pagination: {
                            more: (params.page * pageSize) < data.Total
                        }
                    };
                }
            },
            //placeholder: "-- Select Item--",
            minimumInputLength: 0,
            allowClear: true,
        });
    });
    //$('#DetailCode').change(function () {
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('border-color', '#CCCCCC');
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('color', 'black');
    //})
    function GetTodayBetweenDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        var today2 = yyyy + '-' + mm + '-01';
        $('#FromDate').val(today2);
        $('#ToDate').val(today);
    }
