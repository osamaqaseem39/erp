}
<table class="mainTable" style="@marginTop">
    <thead>
        <tr>
            <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 13px;border:none;border-bottom:1px solid black" colspan="12">&nbsp;</th>
        </tr>
    </thead>
    <tr class="mainTr">
        <th style="text-align: center; width: 85px">Sr#</th>
        <th style="text-align:left;">Description</th>
        <th class="borderRight" style="text-align: center; width: 120px">Account Code</th>
    </tr>
    @if (Model.Count != 0)
    {
        <tbody>
            @{
        int j = 0;
            }
            @foreach (clsChartOfAccount s in Model.Where(x => x.AcLevel == 1))
            {
                j++;
                int k = 0;
                <tr class="mainTr">
                    <td style="text-align: left; font-weight: bold;padding-left:20px">@(j)</td>
                    <td style="text-align: left; font-weight: bold">@s.Description</td>
                    <td class="borderRight" style="text-align: center; font-weight: bold;">@s.AccountCodeV</td>
                </tr>
                foreach (clsChartOfAccount t in Model.Where(x => x.AcLevel == 2 && x.RefKey == s.AccountCodeV))
                {
                    k++;
                    int m = 0;
                    <tr class="mainTr">
                        <td style="text-align: center;">@j.@k</td>
                        <td style="text-align: left;padding-left:30px">@t.Description</td>
                        <td class="borderRight" style="text-align: center; ">@t.AccountCodeV</td>
                    </tr>
                    foreach (clsChartOfAccount r in Model.Where(x => x.AcLevel == 3 && x.RefKey == t.AccountCodeV && x.Status == "Active"))
                    {
                        m++;
                        <tr class="mainTr">
                            <td style="text-align: right;padding-right:10px">@j.@k.@m</td>
                            <td style="text-align: left;padding-left:60px">@r.Description</td>
                            <td class="borderRight" style="text-align: center; ">@r.AccountCodeV</td>
                        </tr>
                    }
                }
            }
        </tbody>
    }
    else
    {
        <tbody>
            <tr class="mainTr">
                <td class="borderRight" colspan="3" style="text-align:center;padding:10px">No Record Found.</td>
            </tr>
        </tbody>
    }
    <tfoot>
        <tr>
            <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 10px;  border: none;" colspan="12">&nbsp;</th>
        </tr>
    </tfoot>
</table>

