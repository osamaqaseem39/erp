@model POS.Models.clsChartOfAccount
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="AccountDetailListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Accounts List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="accountDetailListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Account </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("InsertUpdateAccountDetail", "chartofaccount", FormMethod.Post, new { id = "accountDetailForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Account" id="btnAddAccountDetail" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveAccountDetail" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Accounts List" id="btnAccountDetailList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#AccountDetailListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshAccountDetail" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitAccountDetail" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveAccountDetail" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Accounts List" id="btnAccountDetailList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#AccountDetailListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshAccountDetail" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitAccountDetail" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="col-md-12" id="accountCodeSection" style="padding-top: 15px;" hidden>
                                    <div class="col-md-2"></div>
                                    <div class="col-md-8">
                                        <input type="hidden" id="IsNewOrEdit" value="" />
                                        <input type="hidden" id="AccountCode" value="0" />
                                        <label class="" style="font-size:16px;">
                                            Account Code:
                                            <span class="badge bg-color-blue" id="AccountCodeSpan" style="font-size:16px;border-radius:4px;padding:5px;"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px;">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Account Name</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Account Name" name="DetailName" id="DetailName" required />
                                        </label>
                                    </div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Select Reference</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.ThirdLevelAccountCode, ViewBag.ThirdLevel as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="padding-bottom: 15px;">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Urdu Name</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Urdu Name" name="UrduName" id="UrduName" />
                                        </label>
                                    </div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Description</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Description" name="Description" id="Description" />
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12 StatusSection" style="" hidden>
                                    <section class="col col-md-2"></section>
                                    <section class="col col-md-8">
                                        <label class="checkbox pull-right" style="margin-right:-20px;margin-top:-12px">
                                            <input id="Status" type="checkbox" name="Status"><i></i>
                                            Active
                                        </label>
                                    </section>
                                    <section class="col col-md-2"></section>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-2"></section>
                                    <section class="col col-md-8">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete First Level" id="btnDeleteAccountDetail" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-2"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ThirdLevelAccountCode').select2();
            $('#ThirdLevelAccountCode').val(null).trigger('change');
            $('#accountDetailForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    DetailName: {
                        required: true
                    },
                    ThirdLevelAccountCode: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    DetailName: {
                        required: 'Account Name is required.'
                    },
                    ThirdLevelAccountCode: {
                        required: 'Reference is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddAccountDetail').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#ThirdLevelAccountCode').select().enable(true);
            $('#ThirdLevelAccountCode').val(null).trigger('change');
            $('#DetailName').prop("disabled", false);
            $('#UrduName').prop("disabled", false);
            $('#Description').prop("disabled", false);

            $('#DetailName').val('');
            $('#UrduName').val('');
            $('#Description').val('');
            $('#btnSaveAccountDetail').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $.ajax({
                type: "POST",
                url: "/chartofaccount/getMaxCodeForDetail/",
                dataType: 'json',
                success: function (response) {
                    $('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("New");
                    $('#AccountCode').val(response);
                    $('#AccountCodeSpan').html(response);
                }
            })
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#btnRefreshAccountDetail').click(function () {
            location.reload();
        })
        $('#btnAccountDetailList').click(function () {
            $('#accountDetailListDiv').load('@Url.Action("accountdetailslist", "chartofaccount")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#ThirdLevelAccountCode').select().enable(false);
            $('#ThirdLevelAccountCode').val(null).trigger('change');
            $('#DetailName').prop("disabled", true);
            $('#UrduName').prop("disabled", true);
            $('#Description').prop("disabled", true);

            $('#DetailName').val('');
            $('#UrduName').val('');
            $('#Description').val('');
            $('#btnSaveAccountDetail').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#accountCodeSection').attr("hidden", "hidden");
            $('#IsNewOrEdit').val("New");
            $('#AccountCode').val(0);
            $('#AccountCodeSpan').html('0');
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#accountDetailForm').on('submit', function (e) {
            if (!$("#accountDetailForm").valid()) {
                return false;
            }
            $('#btnSaveAccountDetail').prop('disabled', true);
            var isNewOrEdit = $('#IsNewOrEdit').val();
            var accountCode = $('#AccountCode').val();
            var thirdLevel = $('#ThirdLevelAccountCode').val();
            var detailName = $('#DetailName').val();
            var urduName = $('#UrduName').val();
            var description = $('#Description').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var detail =
            {
                DetailCode: accountCode,
                Name: detailName,
                AccountCode: thirdLevel,
                UrduName: urduName,
                AcDescription: description,
                IsNewOrEdit: isNewOrEdit,
                Status: stringStatus
            }
            var url = $('#accountDetailForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'detail': detail }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Account Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveAccountDetail').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteAccountDetail').click(function () {
            var accCode = $('#AccountCode').val();
            DeleteAccountDetail(accCode);
        })
        function DeleteAccountDetail(id) {
            var a = $.confirm({
                title: 'Delete Account Detail',
                content: 'Are you sure u want to delete this account detail?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/chartofaccount/deleteaccountdetail/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}