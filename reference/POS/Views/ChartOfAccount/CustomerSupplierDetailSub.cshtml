@*@section pagespecific {*@
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#acdetailsubForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    FullName: {
                        required: true
                    },
                    Address: {
                        required: true
                    },
                    Email: {
                        email: true
                    },
                },

                // Messages for form validation
                messages: {
                    SalesmanName: {
                        required: 'Sub Customer Name is required.'
                    },
                    Address: {
                        required: 'Address is required.'
                    },
                    Email: {
                        email: 'Please enter a VALID email address'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFieldsACDetailSub();

            var responsiveHelper_dt_basic_sub = undefined;
            var responsiveHelper_datatable_fixed_column_sub = undefined;
            var responsiveHelper_datatable_col_reorder_sub = undefined;
            var responsiveHelper_datatable_tabletools_sub = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };


            $('#myTableACDetailSub').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic_sub) {
                        responsiveHelper_dt_basic_sub = new ResponsiveDatatablesHelper($('#myTableACDetailSub'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic_sub.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic_sub.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/ChartOfAccount/GetAllACDetailSub?detailCode=" + '@ViewBag.DetailCode',
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                    {
                        "data": "SubDetailCode", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                            if ($('#CanChangeACDetailSub').val() == 1 || $('#CanDeleteACDetailSub').val() == 1) {
                                return '<a href="javascript:void(0);"  class="btn btn-primary selectBtnACDetail" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                            }
                            else {
                                return '';
                            }
                        }
                    },
                        { "data": "Name", "name": "Name", "autoWidth": true, "orderable": true, },
                        { "data": "Email", "name": "Email", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        { "data": "Cell1", "name": "Cell1", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        { "data": "Cell2", "name": "Cell2", "autoWidth": true, "orderable": true, },
                        { "data": "UrduName", "name": "UrduName", "autoWidth": true, "orderable": true, },
                        { "data": "Address", "name": "Address", "autoWidth": true, "orderable": true, },
                        { "data": "Remarks", "name": "Remarks", "autoWidth": true, "orderable": true, },
                        { "data": "Status", "name": "Status", "class": "Acenter", "autoWidth": true, "orderable": true, },

                ]
            });
            oTable = $('#myTableACDetailSub').DataTable();


        })
        $('#btnAddSalesman').click(function () {
            EnableFormFieldsACDetailSub();
        })
        function EnableFormFieldsACDetailSub() {
            $('#ACDetailSubCode').val(0);
            $('#FullName').prop("disabled", false);
            $('#Email').prop("disabled", false);
            $('#Cell1').prop("disabled", false);
            $('#Cell2').prop("disabled", false);
            $('#CNIC').prop("disabled", false);
            $('#Address').prop("disabled", false);
            $('#Remarks').prop("disabled", false);

            $('#FullName').val('');
            $('#Email').val('');
            $('#Cell1').val('');
            $('#Cell2').val('');
            $('#CNIC').val('');
            $('#Address').val('');
            $('#Remarks').val('');
            $('#btnSaveACDetailSub').prop('disabled', false);
            $('#saveTdACDetailSub').removeAttr("hidden");
            $('#addTdACDetailSub').attr("hidden", "hidden");
            $('#saveTdACDetailSub').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#btnRefreshSalesman').click(function () {
            ClearFormFieldsACDetailSub();
        })
        $('#btnExitSalesman').click(function () {
            alert('@ViewBag.DetailCode');
        })
        

        $('#btnSalesmanList').click(function () {
            $('#salesmanListDiv').load('@Url.Action("Sublist", "salesman")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFieldsACDetailSub() {
            //$('#DetailCode').val(0);
            $('#ACDetailSubCode').val(0);
            $('#FullName').prop("disabled", true);
            $('#Email').prop("disabled", true);
            $('#Cell1').prop("disabled", true);
            $('#Cell2').prop("disabled", true);
            $('#CNIC').prop("disabled", true);
            $('#Address').prop("disabled", true);
            $('#Remarks').prop("disabled", true);

            $('#FullName').val('');
            $('#Email').val('');
            $('#Cell1').val('');
            $('#Cell2').val('');
            $('#CNIC').val('');
            $('#Address').val('');
            $('#Remarks').val('');
            $('#btnSaveACDetailSub').prop('disabled', true);
            $('#addTdACDetailSub').removeAttr("hidden");
            $('#saveTdACDetailSub').attr("hidden", "hidden");
             $('.deleteRow').attr("hidden", "hidden");
            $('#saveTdACDetailSub').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSaveACDetailSub').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTdACDetailSub').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#acdetailsubForm').on('submit', function (e) {
            if (!$("#acdetailsubForm").valid()) {
                return false;
            }
            //FullName Email Cell1 Cell2 CNIC Address Remarks

            $('#btnSaveACDetailSub').prop('disabled', true);
            var detailcode = $('#Detailcode').val();
            var acdetailsubId = $('#ACDetailSubCode').val();
            var fullName = $('#FullName').val();
            var email = $('#Email').val();
            var cell1 = $('#Cell1').val();
            var cell2 = $('#Cell2').val();
            var cnic = $('#CNIC').val();
            var address = $('#Address').val();
            var remarks = $('#Remarks').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var acdetailsubForm =
            {
                SubDetailCode: acdetailsubId,
                DetailCode: detailcode,
                Name: fullName,
                Email: email,
                Cell1: cell1,
                Cell2: cell2,
                Address: address,
                UrduName: cnic,
                Remarks: remarks,
                Status: stringStatus
            }
            var url = $('#acdetailsubForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'acdetailsub': acdetailsubForm }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDivACSubDetail').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Salesman Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDivACSubDetail').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFieldsACDetailSub();
                        SearchItemACDetailSub();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveACDetailSub').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteACDetailSub').click(function () {
            var ACDetailSubCode = $('#ACDetailSubCode').val();
            DeleteACDetailSub(ACDetailSubCode);
        })
        function DeleteACDetailSub(id) {
            var a = $.confirm({
                title: 'Delete Sub Customer',
                content: 'Are you sure u want to delete this Sub Customer?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/ChartOfAccount/deleteACDetailSub/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        //location.reload();
                                        ClearFormFieldsACDetailSub();
                                        SearchItemACDetailSub();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }












        $(document).ready(function () {
            $(document).on('click', '.selectBtnACDetail', function (e) {
                e.preventDefault();
                var ACDetailSubCode = $(this).attr("data-value");
                $.ajax({
                    type: "POST",
                    url: "/ChartOfAccount/GetACDetailSubById/" + ACDetailSubCode,
                    dataType: 'json',
                    success: function (response) {
                        $('#FullName').prop("disabled", false);
                        $('#Email').prop("disabled", false);
                        $('#Cell1').prop("disabled", false);
                        $('#Cell2').prop("disabled", false);
                        $('#CNIC').prop("disabled", false);
                        $('#Address').prop("disabled", false);
                        $('#Remarks').prop("disabled", false);

                        $('#ACDetailSubCode').val(response.data.SubDetailCode);
                        $('#Detailcode').val(response.data.DetailCode);
                        $('#FullName').val(response.data.Name);
                        $('#Email').val(response.data.Email);
                        $('#Cell1').val(response.data.Cell1);
                        $('#Cell2').val(response.data.Cell2);
                        $('#CNIC').val(response.data.UrduName);
                        $('#Address').val(response.data.Address);
                        $('#Remarks').val(response.data.Remarks);
                        $('.StatusSection').removeAttr("hidden");
                        
                        if (response.data.Status == "Active") {
                            $('#Status').prop("checked", true);
                        }
                        else {
                            $('#Status').prop("checked", false);
                        }
                        $('#btnSaveSalesman').prop('disabled', false);
                        if ($('#CanChangeACDetailSub').val() == 1) {
                            $('#saveTdACDetailSub').removeAttr("hidden");
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                        else {
                            $('#saveTdACDetailSub').attr("hidden", "hidden");
                            if ($('#CanSaveACDetailSub').val() == 0) {
                                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                            }
                            else {
                                $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                            }
                        }


                        if ($('#CanSaveACDetailSub').val() == 0) {
                            $('#saveTdACDetailSub').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#addTdACDetailSub').removeAttr("hidden");
                            $('#saveTdACDetailSub').css({ 'width': '3%', 'text-align': 'left' });
                        }


                        if ($('#CanDeleteACDetailSub').val() == 1) {
                            $('.deleteRow').removeAttr("hidden");
                        }
                    }
                })
            })
            $('#btnSearchACDetailSub').click(function () {
                SearchItemACDetailSub();
            });
            $('#txtSearchACDetailSub').on('keypress', function (event) {
                if (event.keyCode == 13) {
                    SearchItemACDetailSub();
                }
            });
            //$('#btnRefreshSalesman').click(function () {
            //    oTable.ajax.reload(null,false);
            //});
            $("#ulSearchACDetailSub").on("click", "a", function (e) {
                e.preventDefault();
                var $this = $(this).parent();
                $this.addClass("select").siblings().removeClass("select");
                $("#btnSearchCategoryACDetailSub").html($this.data("value"));
            })
        });

        function SearchItemACDetailSub() {
            var BElement = $("#btnSearchCategoryACDetailSub");
            if (BElement.html().trim() == 'Name') {
                oTable.columns(0).search($('#txtSearchACDetailSub').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Email') {
                oTable.columns(1).search($('#txtSearchACDetailSub').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Remarks') {
                oTable.columns(2).search($('#txtSearchACDetailSub').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(3).search($('#txtSearchACDetailSub').val().trim()).draw();
            }
            else {
                oTable.columns(0).search('').draw();
            }
        }

        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
