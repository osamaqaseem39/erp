        function getModelDetail(id) {
            $.ajax({
                type: "POST",
                url: "/ChartOfAccount/GetACZoneDetailById/" + id,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#ModelDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                            "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                            "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                            "<span><input type='hidden' class='ItemID01' value=" + response.data[key].ZoneID + " />" + response.data[key].ZoneName + "</span>",
                        ]).draw(false);
                    }
                }
            })
        }


        function getVehicleDetail(id) {
            $.ajax({
                type: "POST",
                url: "/ChartOfAccount/GetACVehicleDetailById/" + id,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#FleetDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                            "<span style='text-align:left;' class='text-left'><input type='hidden' class='gCabType' value=" + response.data[key].CabTypeID + " /><center style='text-align:left;'>" + response.data[key].CabTypeName + "</center></span>",
                            "<span style='text-align:center;' class='text-center'><input type='text' class='gQty'style='width: 65px;text-align:center;' value=" + response.data[key].NoOfVeh + " /><center></span>",
                        ]).draw(false);
                    }
                }
            })
        }


        function getDocDetail(id) {
            $.ajax({
                type: "POST",
                url: "/ChartOfAccount/GetACDocDetailById/" + id,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#DocDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        var checkstatus = "";
                        if (response.data[key].DocStatus == "1") {
                            checkstatus = "checked";
                        }
                        var vexpdate = getDate(response.data[key].ExpiryDate);

                        vtable.row.add([
                            "<span style='text-align:left;' class='text-left'><input type='hidden' class='gdoctype' value=" + response.data[key].CabTypeID + " /><center style='text-align:left;'>" + response.data[key].CabTypeName + "</center></span>",
                             "<span style='text-align:center;' class='text-center'><input type='text' class='gdocnumber'style='width: 100%;text-align:center;' value='" + response.data[key].DocumentNo + "' /><center></span>",
                             "<span style='text-align:center;' class='text-center'><input type='date' class='gdocexpiry'style='width: 100%;' value='" + vexpdate + "' /><center></span>",
                             "<span style='text-align:center;' class='text-center'><input type='checkbox' class='gdocstatus'style='width: 65px;' " + checkstatus + " /><center></span>",
                        ]).draw(false);
                    }
                }
            })
        }
        

        function LoadReferenceComboForList(type, accCode) {
            $.ajax({
                type: "POST",
                url: "/chartofaccount/getThirdLevelsList/",
                dataType: "json",
                data: { 'type': type },
                success: function (response) {
                    var select = $("#ThirdLevelAccountCode");
                    select.children().remove();
                    for (var key in response.data) {
                        select.append('<option value="' + response.data[key].AccountCode + '">' + response.data[key].Description + '</option>');
                    }
                    select.val(accCode).trigger('change');
                }
            });
        }
        $('#btnSearchAccountDetail').click(function () {
            SearchItem();
        });
        $('#txtSearchAccountDetail').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryAccountDetail");
            if (BElement.html() == 'Detail Code') {
                NumberPostiveNegativeWithDecimal(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryAccountDetail");
            if (BElement.html().trim() == 'Code') {
                oTable.columns(0).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Supplier Name') {
                oTable.columns(1).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Description') {
                oTable.columns(2).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(3).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Reference') {
                oTable.columns(4).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Company Name') {
                oTable.columns(5).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Type') {
                oTable.columns(6).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'City') {
                oTable.columns(7).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshAccountDetail').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryAccountDetail").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryAccountDetail").html($this.data("value"));
            if ($("#btnSearchCategoryAccountDetail").html() == 'Detail Code') {
                $('#txtSearchAccountDetail').val('');
            }
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }

    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
