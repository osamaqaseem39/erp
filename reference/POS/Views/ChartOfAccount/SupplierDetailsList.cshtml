<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1960,
            tablet: 1024,
            phone: 380
        };

        $('#myTableAccountDetail').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableAccountDetail'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/chartofaccount/GetAllSupplierDetails",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "DetailCode", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#AccountDetailListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                     { "data": "Name", "name": "Name", "width": "38%", "orderable": true, "autoWidth": true },
                     { "data": "DetailCode", "name": "DetailCode", "width": "11%", "autoWidth": true, "orderable": true, "class": "Acenter" },
                     { "data": "AcDescription", "name": "AcDescription", "orderable": true, "autoWidth": true },
                     { "data": "Status", "name": "Status", "width": "11%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                     { "data": "UrduName", "name": "UrduName", "autoWidth": true },
                     { "data": "Phone1", "name": "Phone1",  "autoWidth": true },
                     { "data": "Phone2", "name": "Phone2",  "autoWidth": true },
                     { "data": "Cell1", "name": "Cell1",  "autoWidth": true },
                     { "data": "Cell2", "name": "Cell2", "autoWidth": true },
                     { "data": "Email", "name": "Email", "autoWidth": true },
                     { "data": "Website", "name": "Website", "autoWidth": true },
                     { "data": "Address", "name": "Address", "autoWidth": true },
                     { "data": "CityName", "name": "CityName",  "autoWidth": true },
                     { "data": "Remarks", "name": "Remarks", "autoWidth": true },
                    
            ]
        });
        oTable = $('#myTableAccountDetail').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var accountCode = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/chartofaccount/GetAccountDetailById/" + accountCode,
                dataType: 'json',
                success: function (response) {
                    $('#ThirdLevelAccountCode').select().enable(true);
                    $('#CityId').select().enable(true);
                    $('#DetailName').prop("disabled", false);
                    $('#AccountNameTd').css("width", "98%");
                    //$('#AddPriceTd').removeAttr("hidden");
                    //$('#AddDetailSub').removeAttr("hidden");
                    $('#UrduName').prop("disabled", false);
                    $('#AcDescription').prop("disabled", false);
                    $('#Phone1').prop("disabled", false);
                    $('#Phone2').prop("disabled", false);
                    $('#Cell1').prop("disabled", false);
                    $('#Cell2').prop("disabled", false);
                    $('#Fax').prop("disabled", false);
                    $('#Email').prop("disabled", false);
                    $('#Website').prop("disabled", false);
                    $('#Address').prop("disabled", false);
                    $('#Type').prop("disabled", false);
                    $('#CreditDays').prop("disabled", false);
                    $('#CreditLimit').prop("disabled", false);
                    $('#TaxType').prop("disabled", false);
                    $('#GST').prop("disabled", false);
                    $('#NTN').prop("disabled", false);
                    $('#CNIC').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    //$('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#AccountCode').val(response.data.DetailCode);
                    $('#AccountCodeSpan').html(response.data.DetailCode);
                    //$('#ThirdLevelAccountCode').select2('val', response.data.AccountCode);
                    $('#DetailName').val(response.data.Name);
                    $('#UrduName').val(response.data.UrduName);
                    $('#AcDescription').val(response.data.AcDescription);
                    $('#Phone1').val(response.data.Phone1);
                    $('#Phone2').val(response.data.Phone2);
                    $('#Cell1').val(response.data.Cell1);
                    $('#Cell2').val(response.data.Cell2);
                    $('#Fax').val(response.data.Fax);
                    $('#Email').val(response.data.Email);
                    $('#Website').val(response.data.Website);
                    $('#Address').val(response.data.Address);
                    $('#Type').val(response.data.Type);
                    $('#CreditDays').val(response.data.CreditDays);
                    $('#CreditLimit').val(response.data.CreditLimit);
                    $('#TaxType').val(response.data.TaxType);
                    $('#GST').val(response.data.GST);
                    $('#NTN').val(response.data.NTN);
                    $('#CNIC').val(response.data.CNIC);
                    $('#Remarks').val(response.data.Remarks);
                    $('#CityId').val(response.data.CityId).trigger('change');
                    $('#SalesmanID').val(response.data.SalesmanID).trigger('change');

                    $('#AdminUser').prop("disabled", false);
                    $('#AdminPassword').prop("disabled", false);
                    $('#AdminUser').val(response.data.AdminUser);
                    $('#AdminPassword').val(response.data.AdminPassword);
                    
                    $('#FirstName').val(response.data.FirstName);
                    $('#LastName').val(response.data.LastName);
                    $('#Position').val(response.data.Position);
                    $('#CommEmail').val(response.data.CommEmail);
                    $('#BookingEmail').val(response.data.BookingEmail);
                    $('#AccountName').val(response.data.AccountName);
                    $('#ACNumber').val(response.data.ACNumber);
                    $('#SortCode').val(response.data.SortCode);
                    $('#BankName').val(response.data.BankName);
                    $('#BankAddress').val(response.data.BankAddress);


                    if (response.data.Monday == "Y") {
                        $('#Monday').prop("checked", true);
                    }
                    else {
                        $('#Monday').prop("checked", false);
                    }

                    if (response.data.Tuesday == "Y") {
                        $('#Tuesday').prop("checked", true);
                    }
                    else {
                        $('#Tuesday').prop("checked", false);
                    }

                    if (response.data.Wednesday == "Y") {
                        $('#Wednesday').prop("checked", true);
                    }
                    else {
                        $('#Wednesday').prop("checked", false);
                    }

                    if (response.data.Thursday == "Y") {
                        $('#Thursday').prop("checked", true);
                    }
                    else {
                        $('#Thursday').prop("checked", false);
                    }

                    if (response.data.Friday == "Y") {
                        $('#Friday').prop("checked", true);
                    }
                    else {
                        $('#Friday').prop("checked", false);
                    }


                    if (response.data.Saturday == "Y") {
                        $('#Saturday').prop("checked", true);
                    }
                    else {
                        $('#Saturday').prop("checked", false);
                    }

                    if (response.data.Sunday == "Y") {
                        $('#Sunday').prop("checked", true);
                    }
                    else {
                        $('#Sunday').prop("checked", false);
                    }


                    if (response.data.WorkFrom != null) {
                        var milli = response.data.WorkFrom; //.replace(/\/Date\((-?\d+)\)\//, '$1');
                        var vhour = milli.Hours;
                        if (vhour.toString().length == 1) { vhour = '0' + vhour; }
                        var vmint = milli.Minutes;
                        if (vmint.toString().length == 1) { vmint = '0' + vmint; }
                        var currentTime = vhour + ':' + vmint;
                        $('#WorkFrom').val(currentTime);
                    }
                    
                    if (response.data.WorkUpTo != null) {
                        var tmilli = response.data.WorkUpTo; //.replace(/\/Date\((-?\d+)\)\//, '$1');
                        var tvhour = tmilli.Hours;
                        if (tvhour.toString().length == 1) { tvhour = '0' + tvhour; }
                        var tvmint = tmilli.Minutes;
                        if (tvmint.toString().length == 1) { tvmint = '0' + tvmint; }
                        var tcurrentTime = tvhour + ':' + tvmint;
                        $('#WorkUpTo').val(tcurrentTime);
                    }

                    
                    $('#UrgentPick').val(response.data.UrgentPick);
                    $('#UrgentPickTime').val(response.data.UrgentPickTime);
                    if (response.data.UrgentPick == "Yes") {
                        $('.UrgentTimeDiv').removeAttr("hidden");
                    } else {
                        $('.UrgentTimeDiv').attr("hidden", "hidden");
                    }


                    $('#IssueDate').val(getDate(response.data.IssueDate));
                    $('#ExpiryDate').val(getDate(response.data.ExpiryDate));

                    $('#Status').val(response.data.Status);

                    LoadReferenceComboForList(response.data.Type, response.data.AccountCode);
                    
                    $('#btnSaveAccountDetail').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }

                    getVehicleDetail(accountCode);
                    getModelDetail(accountCode);
                    getDocDetail(accountCode);
                    
                }
