        $('#accountDetailForm').on('submit', function (e) {
            if (!$("#accountDetailForm").valid()) {
                return false;
            }

            //       Status
            $('#btnSaveAccountDetail').prop('disabled', true);
            var isNewOrEdit = $('#IsNewOrEdit').val();
            var accountCode = $('#AccountCode').val();
            var detailName = $('#DetailName').val();
            var urduName = $('#UrduName').val();
            var description = $('#AcDescription').val();
            var taxType = $('#TaxType').val();
            var phone1 = $('#Phone1').val();
            var phone2 = $('#Phone2').val();
            var cell1 = $('#Cell1').val();
            var cell2 = $('#Cell2').val();
            var fax = $('#Fax').val();
            var email = $('#Email').val();
            var website = $('#Website').val();
            var address = $('#Address').val();
            var type = $('#Type').val();
            var thirdLevel = $('#ThirdLevelAccountCode').val();
            var creditDays = $('#CreditDays').val();
            var creditLimit = $('#CreditLimit').val();
            var salesmanId = $('#SalesmanID').val();
            var cityId = $('#CityId').val();
            var gst = $('#GST').val();
            var ntn = $('#NTN').val();
            var cnic = $('#CNIC').val();
            var remarks = $('#Remarks').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var detail =
            {
                IsNewOrEdit: isNewOrEdit,
                DetailCode: accountCode,
                Name: detailName,
                UrduName: urduName,
                AcDescription: description,
                TaxType: taxType,
                Phone1: phone1,
                Phone2: phone2,
                Cell1: cell1,
                Cell2: cell2,
                Fax: fax,
                Email: email,
                Website: website,
                Address: address,
                Type: type,
                AccountCode: thirdLevel,
                CreditDays: creditDays,
                CreditLimit: creditLimit,
                CityId: cityId,
                GST: gst,
                NTN: ntn,
                CNIC: cnic,
                Remarks: remarks,
                SalesmanID: salesmanId,
                Status: stringStatus
            }
            var url = $('#accountDetailForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'detail': detail }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Account Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveAccountDetail').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteAccountDetail').click(function () {
