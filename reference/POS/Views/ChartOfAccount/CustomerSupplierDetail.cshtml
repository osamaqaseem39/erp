@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ThirdLevelAccountCode').select2();
            $('#ThirdLevelAccountCode').val(null).trigger('change');
            $('#SalesmanID').select2();
            $('#CityId').select2();
            $('#CityId').val(null).trigger('change');
            $('#accountDetailForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    DetailName: {
                        required: true
                    },
                    ThirdLevelAccountCode: {
                        required: true
                    },
                    Type: {
                        required: true
                    },
                    CityId: {
                        required: true
                    },
                    Email:{
                        email: true
                    }
                },
                // Messages for form validation
                messages: {
                    DetailName: {
                        required: 'Account Name is required.'
                    },
                    ThirdLevelAccountCode: {
                        required: 'Reference is required.'
                    },
                    Type: {
                        required: 'Type is required.'
                    },
                    CityId: {
                        required: 'City is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#Type').change(function () {
            var type = $(this).val();
            LoadReferenceCombo(type);
        })
        function LoadReferenceCombo(type) {
                $.ajax({
                    type: "POST",
                    url: "/chartofaccount/getThirdLevelsList/",
                    dataType: "json",
                    data:{'type':type},
                    success: function (response) {
                        var select = $("#ThirdLevelAccountCode");
                        select.children().remove();
                        for (var key in response.data) {
                            select.append('<option value="' + response.data[key].AccountCode + '">' + response.data[key].Description + '</option>');
                        }
                        select.select2('val','');
                    }
                });
        }
        $('#btnAddAccountDetail').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#ThirdLevelAccountCode').select().enable(true);
            $('#ThirdLevelAccountCode').val(null).trigger('change');
            $('#CityId').select().enable(true);
            $('#CityId').val(null).trigger('change');
            $('#AccountNameTd').css("width", "100% !important");
            $('#AddPriceTd').attr("hidden", "hidden");
            $('#AddDetailSub').attr("hidden", "hidden");
            $('#DetailName').prop("disabled", false);
            $('#UrduName').prop("disabled", false);
            $('#AcDescription').prop("disabled", false);
            $('#Phone1').prop("disabled", false);
            $('#Phone2').prop("disabled", false);
            $('#Cell1').prop("disabled", false);
            $('#Cell2').prop("disabled", false);
            $('#Fax').prop("disabled", false);
            $('#Email').prop("disabled", false);
            $('#Website').prop("disabled", false);
            $('#Address').prop("disabled", false);
            $('#Type').prop("disabled", false);
            $('#CreditDays').prop("disabled", false);
            $('#CreditLimit').prop("disabled", false);
            $('#TaxType').prop("disabled", false);
            $('#GST').prop("disabled", false);
            $('#NTN').prop("disabled", false);
            $('#CNIC').prop("disabled", false);
            $('#Remarks').prop("disabled", false);
            $('#SalesmanID').select2().enable(true);
            $('#SalesmanID').val(null).trigger('change');

            $('#DetailName').val('');
            $('#UrduName').val('');
            $('#AcDescription').val('');
            $('#Phone1').val('');
            $('#Phone2').val('');
            $('#Cell1').val('');
            $('#Cell2').val('');
            $('#Fax').val('');
            $('#Email').val('');
            $('#Website').val('');
            $('#Address').val('');
