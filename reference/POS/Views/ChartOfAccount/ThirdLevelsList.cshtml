<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            tablet: 1024,
            phone: 380
        };

        $('#myTableThirdLevel').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableThirdLevel'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/chartofaccount/GetAllThirdLevels",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                 {
                     "data": "AccountCode", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                         if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                             return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ThirdLevelListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                         }
                         else {
                             return '';
                         }
                     }
                 },
                    { "data": "AccountCodeV", "name": "AccountCodeV", "width": "20%", "autoWidth": true, "orderable": true, "class": "Acenter" },
                     { "data": "Description", "name": "Description", "width": "40%", "orderable": true, "autoWidth": true },
                     { "data": "RefKey", "name": "RefKey", "width": "22%", "orderable": true, "autoWidth": true },
                     { "data": "Status", "name": "Status", "width": "13%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                   
            ]
        });
        oTable = $('#myTableThirdLevel').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var accountCode = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/chartofaccount/GetThirdLevelById/" + accountCode,
                dataType: 'json',
                success: function (response) {
                    //response.data.ReportType;
                    $('#SecondLevelAccountCode').select().enable(false);
                    $('#Description').prop("disabled", false);
                    $('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#SecondLevelAccountCode').val(response.data.RefKey).trigger('change');
                    $('#AccountCode').val(response.data.AccountCode);
                    $('#AccountCodeV').val(response.data.AccountCodeV);
                    $('#AccountCodeSpan').html(response.data.AccountCodeV);
                    
                    $('#Description').val(response.data.Description);
                    $('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveThirdLevel').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchThirdLevel').click(function () {
            SearchItem();
        });
        $('#txtSearchThirdLevel').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryThirdLevel");
            if (BElement.html().trim() == 'Account Code') {
                oTable.columns(0).search($('#txtSearchThirdLevel').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Reference Account') {
                oTable.columns(1).search($('#txtSearchThirdLevel').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Description') {
                oTable.columns(2).search($('#txtSearchThirdLevel').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(3).search($('#txtSearchThirdLevel').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshThirdLevel').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryThirdLevel").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryThirdLevel").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
