@model POS.Models.clsChartOfAccount
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="SecondLevelListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Second Levels List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="secondLevelListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Second Level </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("insertupdatesecondlevel", "chartofaccount", FormMethod.Post, new { id = "secondLevelForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Second Level" id="btnAddSecondLevel" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveSecondLevel" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img   src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Second Levels List" id="btnSecondLevelList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#SecondLevelListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshSecondLevel" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitSecondLevel" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveSecondLevel" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img  src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Second Levels List" id="btnSecondLevelList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#SecondLevelListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshSecondLevel" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitSecondLevel" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="col-md-12" id="accountCodeSection" style="padding-top: 15px;" hidden>
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <input type="hidden" id="IsNewOrEdit" value="" />
                                        <input type="hidden" id="AccountCode" value="0" />
                                        <input type="hidden" id="AccountCodeV" value="0" />
                                        <label class="" style="font-size:16px;">
                                            Account Code:
                                            <span class="badge bg-color-blue" id="AccountCodeSpan" style="font-size:16px;border-radius:4px;padding:5px;"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Select Reference Account</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.FirstLevelAccountCode, ViewBag.FirstLevel as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Description</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Description" name="Description" id="Description" required />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-3"></section>
                                    <section class="col col-md-6">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Second Level" id="btnDeleteSecondLevel" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#FirstLevelAccountCode').select2();
            $('#FirstLevelAccountCode').val(null).trigger('change');
            $('#secondLevelForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    FirstLevelAccountCode: {
                        required: true
                    },
                    Description: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    FirstLevelAccountCode: {
                        required: 'Reference Account is required.'
                    },
                    Description: {
                        required: 'Description is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddSecondLevel').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#FirstLevelAccountCode').select().enable(true);
            $('#Description').prop("disabled", false);
            $('#FirstLevelAccountCode').val(null).trigger('change');
            $('#Description').val('');
            $('#IsNewOrEdit').val("New");
            $('#AccountCode').val(0);
            $('#btnSaveSecondLevel').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('#accountCodeSection').attr("hidden", "hidden");
        }
        $('#FirstLevelAccountCode').change(function () {
            var reference = $(this).val();
            var accountCode = $('#FirstLevelAccountCode').val();
            if ($('#IsNewOrEdit').val() != "Edit"){
                $.ajax({
                    type: "POST",
                    url: "/chartofaccount/getMaxCodeForSecondLevel/",
                    dataType: 'json',
                    data: { 'reference': reference, 'accountCode': accountCode, },
                    success: function (response) {
                        $('#accountCodeSection').removeAttr("hidden");
                        $('#AccountCode').val(response.secondLevelCode);
                        $('#AccountCodeV').val(response.secondLevelCodeV);
                        $('#AccountCodeSpan').html(response.secondLevelCodeV);
                    }
                })
            }
        })
        $('#btnRefreshSecondLevel').click(function () {
            location.reload();
        })
        $('#btnSecondLevelList').click(function () {
            $('#secondLevelListDiv').load('@Url.Action("secondlevelslist", "chartofaccount")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#FirstLevelAccountCode').select().enable(false);
            $('#Description').prop("disabled", true);
            $('#FirstLevelAccountCode').val(null).trigger('change');
            $('#Description').val('');
            $('#btnSaveSecondLevel').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#accountCodeSection').attr("hidden", "hidden");
            $('#IsNewOrEdit').val("New");
            $('#AccountCode').val(0);
            $('#AccountCodeV').val(0);
            $('#AccountCodeSpan').html('0');
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
        }
        $('#secondLevelForm').on('submit', function (e) {
            if (!$("#secondLevelForm").valid()) {
                return false;
            }
            $('#btnSaveSecondLevel').prop('disabled', true);
            var isNewOrEdit = $('#IsNewOrEdit').val();
            var accountCode = $('#AccountCode').val();
            var accountCodeV = $('#AccountCodeV').val();
            var reference = $('#FirstLevelAccountCode').val();
            var description = $('#Description').val();
            var firstForm =
            {
                AccountCode: accountCode,
                AccountCodeV: accountCodeV,
                Description: description,
                IsNewOrEdit: isNewOrEdit,
                FirstLevelAccountCode: reference,
            }
            var url = $('#secondLevelForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'firstForm': firstForm }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Second Level Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveSecondLevel').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteSecondLevel').click(function () {
            var accCode = $('#AccountCode').val();
            DeleteSecondLevel(accCode);
        })
        function DeleteSecondLevel(id) {
            var a = $.confirm({
                title: 'Delete Second Level',
                content: 'Are you sure u want to delete this second level?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/chartofaccount/deletesecondlevel/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}