<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop:1366,
            tablet: 924,
            phone: 380
        };

        $('#myTableAccountDetail').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableAccountDetail'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/chartofaccount/GetAllAccountDetails",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "DetailCode", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#AccountDetailListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "Name", "name": "Name", "width": "38%", "orderable": true, "autoWidth": true },
                    { "data": "DetailCode", "name": "DetailCode", "width": "11%", "autoWidth": true, "orderable": true, "class": "Acenter" },
                     { "data": "AcDescription", "name": "AcDescription","orderable": true, "autoWidth": true },
                     { "data": "Reference", "name": "Reference", "width": "35%", "orderable": true, "autoWidth": true },
                     { "data": "Status", "name": "Status", "width": "11%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                     { "data": "UrduName", "name": "UrduName", "orderable": true, "autoWidth": true },
                    
            ]
        });
        oTable = $('#myTableAccountDetail').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var accountCode = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/chartofaccount/GetAccountDetailById/" + accountCode,
                dataType: 'json',
                success: function (response) {
                    $('#ThirdLevelAccountCode').select().enable(true);
                    $('#DetailName').prop("disabled", false);
                    $('#UrduName').prop("disabled", false);
                    $('#Description').prop("disabled", false);
                    $('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#AccountCode').val(response.data.DetailCode);
                    $('#AccountCodeSpan').html(response.data.DetailCode);
                    $('#ThirdLevelAccountCode').val(response.data.AccountCode).trigger('change');
                    $('#DetailName').val(response.data.Name);
                    $('#UrduName').val(response.data.UrduName);
                    $('#Description').val(response.data.AcDescription);
                    $('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveAccountDetail').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchAccountDetail').click(function () {
            SearchItem();
        });
        $('#txtSearchAccountDetail').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryAccountDetail");
            if (BElement.html() == 'Detail Code') {
                NumberPostive(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryAccountDetail");
            if (BElement.html().trim() == 'Code') {
                oTable.columns(0).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Account Name') {
                oTable.columns(1).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Description') {
                oTable.columns(2).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(3).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Reference') {
                oTable.columns(4).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Urdu Name') {
                oTable.columns(5).search($('#txtSearchAccountDetail').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshAccountDetail').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryAccountDetail").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryAccountDetail").html($this.data("value"));
            if ($("#btnSearchCategoryAccountDetail").html() == 'Detail Code') {
                $('#txtSearchAccountDetail').val('');
            }
        })
    });
    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
