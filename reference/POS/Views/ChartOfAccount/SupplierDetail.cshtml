        function DeleteAccountDetail(id) {
            var a = $.confirm({
                title: 'Delete Detail',
                content: 'Are you sure u want to delete this detail?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/chartofaccount/deleteaccountdetail/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        
        $("#CreditLimit").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $("#CreditDays").on('keypress', function (event) {
            NumberPostive(event, this);
        });
        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }

        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#IssueDate').val(today);
            $('#ExpiryDate').val(today);
                       


            var date = new Date();
            var vhour = date.getHours();
            if (vhour.toString().length == 1) { vhour = '0' + vhour; }
            var vmint = date.getMinutes();
            if (vmint.toString().length == 1) { vmint = '0' + vmint; }
            var currentTime = vhour + ':' + vmint;
            $("#WorkFrom").val(currentTime);
            $("#WorkUpTo").val(currentTime);
        }
