        function LoadReferenceCombo(type) {
                $.ajax({
                    type: "POST",
                    url: "/chartofaccount/getThirdLevelsList/",
                    dataType: "json",
                    data:{'type':type},
                    success: function (response) {
                        var select = $("#ThirdLevelAccountCode");
                        select.children().remove();
                        for (var key in response.data) {
                            select.append('<option value="' + response.data[key].AccountCode + '">' + response.data[key].Description + '</option>');
                        }
                        select.select2('val','');
                    }
                });
        }
