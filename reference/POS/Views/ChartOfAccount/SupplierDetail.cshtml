        function LoadDefaultVehicle(){   
            $.ajax({
                type: "POST",
                url: "/ChartOfAccount/GetAllCabType",
                dataType: 'json',
                success: function (data) {
                    var referencetab = $('#FleetDetailTable').DataTable();
                    referencetab.clear().draw();
                    for (var key in data) {
                        referencetab.row.add([
                                "<span style='text-align:left;' class='text-left'><input type='hidden' class='gCabType' value=" + data[key].CabTypeID + " /><center style='text-align:left;'>" + data[key].Description + "</center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='text' class='gQty'style='width: 65px;text-align:center;' value=0 /><center></span>",
                        ]).draw(false);
                    }
                }
            });
        }



        function LoadDefaultDocuments() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            
            

            $.ajax({
                type: "POST",
                url: "/ChartOfAccount/GetAllDocType",
                dataType: 'json',
                success: function (data) {
                    var referencetab = $('#DocDetailTable').DataTable();
                    referencetab.clear().draw();
                    for (var key in data) {

                        referencetab.row.add([
                                "<span style='text-align:left;' class='text-left'><input type='hidden' class='gdoctype' value=" + data[key].CabTypeID + " /><center style='text-align:left;'>" + data[key].Description + "</center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='text' class='gdocnumber'style='width: 100%;text-align:center;' value='' /><center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='date' class='gdocexpiry'style='width: 100%;' /><center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='checkbox' class='gdocstatus'style='width: 65px;' /><center></span>",
                        ]).draw(false);

                        $('.gdocexpiry').val(today);
                    }
                }
            });
        }
        

        
