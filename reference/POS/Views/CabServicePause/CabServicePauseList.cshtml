<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            tablet: 1024,
            phone: 380
        };

        $('#myTableContent').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableContent'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/CabServicePause/GetAllCabServicePauses",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "PauseID", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ContentListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                {
                    "data": "FromDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                        if (date != null) {
                            var date = new Date(parseInt(date.substr(6)));
                            var day = date.getDate();
                            var month = date.getMonth() + 1;
                            if (parseFloat(day) < 10) {
                                day = "0" + day;
                            }
                            if (parseFloat(month) < 10) {
                                month = "0" + month;
                            }
                            return day + "-" + month + "-" + date.getFullYear();
                        }
                        else {
                            return "";
                        }
                    }
                },
                { "data": "FromTimeString", "name": "FromTimeString", "autoWidth": true, "orderable": true, },
                {
                    "data": "ToDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                        if (date != null) {
                            var date = new Date(parseInt(date.substr(6)));
                            var day = date.getDate();
                            var month = date.getMonth() + 1;
                            if (parseFloat(day) < 10) {
                                day = "0" + day;
                            }
                            if (parseFloat(month) < 10) {
                                month = "0" + month;
                            }
                            return day + "-" + month + "-" + date.getFullYear();
                        }
                        else {
                            return "";
                        }
                    }
                },
                { "data": "ToTimeString", "name": "ToTimeString", "autoWidth": true, "orderable": true, },
                { "data": "Remarks", "name": "Remarks", "autoWidth": true, "orderable": true, },
                { "data": "Status", "name": "Status", "width": "15%", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    
            ]
        });
        oTable = $('#myTableContent').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var itemPauseID = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/CabServicePause/GetCabServicePauseById/" + itemPauseID,
                dataType: 'json',
                success: function (response) {
                    //response.data.ReportType;
                    $('#PauseID').val(response.data.PauseID);
                    $('#FromDate').val(getDate(response.data.FromDate));
                    $('#ToDate').val(getDate(response.data.ToDate));
                    $('#FromTime').val(response.data.FromTimeString);
                    $('#ToTime').val(response.data.ToTimeString);
                    $('#Remarks').val(response.data.Remarks);
                    $('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveContent').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchContent').click(function () {
            SearchItem();
        });
        $('#txtSearchContent').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchBrandContent");
            if (BElement.html().trim() == 'From Date') {
                oTable.columns(0).search($('#txtSearchContent').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(1).search($('#txtSearchContent').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshContent').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchBrandContent").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchBrandContent").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }

    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
