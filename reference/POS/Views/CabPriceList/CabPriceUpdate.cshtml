@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">


        $('#btnAddModelDetail').click(function () {

            var check = 0;
            var carmodel = $('#CarModel').val();
            if (carmodel == '' || carmodel == null) {
                check = 1;
            }
            if (check == 1) {
                return false;
            }

            var vtable = $('#ModelDetailTable').DataTable();
            if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                vtable.row.add([
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }
            else {
                $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
                $('#btnCancelModelDetail').hide();
                var tr = $('#HiddenTrM').val();
                vtable.row(tr).data([
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }

            $('#CarModel').val('');
        })
        $(document).on('click', '.deleteRowBtnM', function () {
            var vtable = $('#ModelDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#CarModel').val('');
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
        })


        $(document).ready(function () {
            $('.arrow-box-up-right').append('<li></li>');
            $('#CabOfferFrom').validate({
                ignore: [],
                // Rules for form validation
                //rules: {
                //    Description: {
                //        required: true
                //    },
                //},

                // Messages for form validation
                //messages: {
                //    Description: {
                //        required: 'From Location is required.'
                //    },
                //},
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });

            var responsiveHelper_dt_basic_mod = undefined;
            var responsiveHelper_datatable_fixed_column_mod = undefined;
            var responsiveHelper_datatable_col_reorder_mod = undefined;
            var responsiveHelper_datatable_tabletools_mod = undefined;

            var breakpointDefinition_mod = {
                tablet: 1024,
                phone: 480
            };
            $('#ModelDetailTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic_mod) {
                        responsiveHelper_dt_basic_mod = new ResponsiveDatatablesHelper($('#ModelDetailTable'), breakpointDefinition_mod);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic_mod.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic_mod.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });

            var vtablem = $('#ModelDetailTable').DataTable();
            vtablem.clear().draw();


            EnableFormFields();
        })



        $('#btnAddLuggage').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#LuggageID').val(0);
            $('#CarModel').val('');
            //$('#ToPostCode').val('');
            //$('#BasePrice').val('');
            

            $('#btnSaveLuggage').prop('disabled', false);
            //$('#saveTd').removeAttr("hidden");
            //$('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        
        
        $('#btnRefreshLuggage').click(function () {
            location.reload();
        })
        $('#btnLuggageList').click(function () {
            $('#LuggageListDiv').load('@Url.Action("CabPriceListList", "CabPriceList")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#LuggageID').val(0);
            $('#CarModel').val('');
            //$('#ToPostCode').val('');
            //$('#BasePrice').val('');


            $('#btnSaveLuggage').prop('disabled', true);
            //$('#addTd').removeAttr("hidden");
            //$('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            //if ($('#CanSave').val() == 0) {
            //    $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
            //    $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            //}
            $('.StatusSection').attr("hidden", "hidden");
        }


        function getAllDataModel() {
            var arrayData = [];
            var count = 0;
            $('#ModelDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#ModelDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();
                var carmodel = data[1].split('value=')[1].split('/>')[0].trim();
                var alldata = {
                    'CarModel': carmodel,
                }
                arrayData.push(alldata);
            }
            console.log(arrayData);
            return arrayData;
        }



        $('#CabOfferFrom').on('submit', function (e) {
            if (!$("#CabOfferFrom").valid()) {
                return false;
            }
            $('#btnSaveLuggage').prop('disabled', true);
            var ToPostCode = $('#ToPostCode').val();
            var vbaseprice = $('#BasePrice').val();
            if (vbaseprice == null || vbaseprice == "" || isNaN(vbaseprice)) { vbaseprice = 0; }

            var FairDetail = JSON.stringify(getAllDataModel());

            var url = $('#CabOfferFrom')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'ToPostCode': ToPostCode, vPers: vbaseprice, FareList: FairDetail }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Record Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveLuggage').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteLuggage').click(function () {
            var LuggageID = $('#LuggageID').val();
            DeleteLuggage(LuggageID);
        })
        function DeleteLuggage(id) {
            var a = $.confirm({
                title: 'Delete Record',
                content: 'Are you sure u want to delete this Record?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/CabPriceList/DeleteCabPriceList/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}