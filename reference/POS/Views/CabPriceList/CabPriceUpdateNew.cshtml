@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">


        $('#btnAddModelDetail').click(function () {
            $('#CabTypeID').select().enable(false);
            var vcabtypeid = $('#CabTypeID').val();
            if (vcabtypeid == null || vcabtypeid == "" || isNaN(vcabtypeid)) { vcabtypeid = 0; }
            LoadDefaultVehicle($('#CarModel').val(), vcabtypeid);
        })

        $('#btnSelectAll').click(function () {
            $('#ModelDetailTable tbody tr[role=row]').each(function () {              
                $(this).find('.gSelect').prop("checked", true);
            });
        })

        $('#btnUnSelectAll').click(function () {
            $('#ModelDetailTable tbody tr[role=row]').each(function () {
                $(this).find('.gSelect').prop("checked", false);
            });
        })
        

        function LoadDefaultVehicle(vpostcode, cabtypeid) {
            $.ajax({
                type: "POST",
                url: "/CabPriceList/GetAllPriceDetail",
                data: { vpostcode: vpostcode, cabtypeid: cabtypeid },
                dataType: 'json',
                success: function (data) {
                    var referencetab = $('#ModelDetailTable').DataTable();
                    referencetab.clear().draw();
                    for (var key in data) {
                        referencetab.row.add([
                                "<span style='text-align:center;' class='text-center'><input type='checkbox' class='gSelect'style='width: 65px;text-align:center;' /></span>",
                                "<span style='text-align:left;' class='text-left'><input type='hidden' class='gFromPostcode' value=" + data[key].FromPostCode + " /><center style='text-align:left;'>" + data[key].FromPostCode + "</center></span>",
                                "<span style='text-align:left;' class='text-left'><input type='hidden' class='gToPostcode' value=" + data[key].ToPostCode + " /><center style='text-align:left;'>" + data[key].ToPostCode + "</center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='hidden' class='gPers' value=" + data[key].BasePrice + " /><center style='text-align:center;'>" + data[key].BasePrice + "</center></span>",
                                "<span style='text-align:center;' class='text-center'><input type='text' class='gQty'style='width: 65px;text-align:center;' value=0 /></span>",
                        ]).draw(false);
                    }
                }
            });
        }

        $('#BasePrice').on('change', function (e) {
            e.preventDefault();
            var vpers = $('#BasePrice').val();
            if (vpers == null || vpers == "" || isNaN(vpers)) { vpers = 0; }

            $('#ModelDetailTable tbody tr[role=row]').each(function () {
                var vbaseprice = $(this).find('.gPers').val();
                if (vbaseprice == null || vbaseprice == "" || isNaN(vbaseprice)) { vbaseprice = 0; }
                var vprice = 0;
                
                vprice = parseFloat(vbaseprice) + ((parseFloat(vbaseprice) / 100) * vpers);
                vprice = parseFloat(vprice).toFixed(2);
                $(this).find('.gQty').val(vprice);
            });
        })

        $(document).ready(function () {
            $('#CabTypeID').select2();
            $('.arrow-box-up-right').append('<li></li>');
            $('#CabOfferFrom').validate({
                ignore: [],
                // Rules for form validation
                //rules: {
                //    Description: {
                //        required: true
                //    },
                //},

                // Messages for form validation
                //messages: {
                //    Description: {
                //        required: 'From Location is required.'
                //    },
                //},
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });

            var responsiveHelper_dt_basic_mod = undefined;
            var responsiveHelper_datatable_fixed_column_mod = undefined;
            var responsiveHelper_datatable_col_reorder_mod = undefined;
            var responsiveHelper_datatable_tabletools_mod = undefined;

            var breakpointDefinition_mod = {
                tablet: 1024,
                phone: 480
            };
            $('#ModelDetailTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic_mod) {
                        responsiveHelper_dt_basic_mod = new ResponsiveDatatablesHelper($('#ModelDetailTable'), breakpointDefinition_mod);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic_mod.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic_mod.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });

            var vtablem = $('#ModelDetailTable').DataTable();
            vtablem.clear().draw();


            EnableFormFields();
        })



        $('#btnAddLuggage').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#CabTypeID').val(null).trigger('change');
            $('#CabTypeID').select().enable(true);
            $('#LuggageID').val(0);
            $('#CarModel').val('');
            //$('#ToPostCode').val('');
            $('#BasePrice').val('');
            

            $('#btnSaveLuggage').prop('disabled', false);
            //$('#saveTd').removeAttr("hidden");
            //$('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        
        
        $('#btnRefreshLuggage').click(function () {
            location.reload();
        })
        $('#btnLuggageList').click(function () {
            $('#LuggageListDiv').load('@Url.Action("CabPriceListList", "CabPriceList")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#LuggageID').val(0);
            $('#CarModel').val('');
            //$('#ToPostCode').val('');
            //$('#BasePrice').val('');


            $('#btnSaveLuggage').prop('disabled', true);
            //$('#addTd').removeAttr("hidden");
            //$('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            //if ($('#CanSave').val() == 0) {
            //    $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
            //    $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            //}
            $('.StatusSection').attr("hidden", "hidden");
        }


        function getAllDataModel() {

            var vcabtypeid = $('#CabTypeID').val();
            if (vcabtypeid == null || vcabtypeid == "" || isNaN(vcabtypeid)) { vcabtypeid = 0; }

            var arrayData = [];
            var count = 0;
            $('#ModelDetailTable tbody tr[role=row]').each(function () {
                var vfrompostcode = $(this).find('.gFromPostcode').val();
                var vtopostcode = $(this).find('.gToPostcode').val();
                var vqty = $(this).find('.gQty').val();
                if (vqty == null || vqty == "" || isNaN(vqty)) { vqty = 0; }
                var vselect = $(this).find('.gSelect').is(":checked");
                if (vselect) {
                    var alldata = {
                        'FromPostCode': vfrompostcode,
                        'ToPostCode': vtopostcode,
                        'BasePrice': vqty,
                        'CabTypeID': vcabtypeid,
                    }
                    arrayData.push(alldata);
                }
               
            });
            console.log(arrayData);
            return arrayData;
        }



        $('#btnSaveLuggage').on('click', function (e) {
            e.preventDefault();
            //if (!$("#CabOfferFrom").valid()) {
            //    return false;
            //}
            $('#btnSaveLuggage').prop('disabled', true);

            var FairDetail = JSON.stringify(getAllDataModel());
            var url = '/CabPriceList/UpdateCabPriceNew'; //$('#CabOfferFrom')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ FareList: FairDetail }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Record Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        location.reload();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveLuggage').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        
    </script>
}