@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- widget content -->
@model List<POS.Models.clsSalary>
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        Salary Report
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> Salary Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="ItemsList" />
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">

                        <div id="printable-content" class="panel rpt" style=" float: center; min-width: 99.5%; font-family: Arial, Helvetica, sans-serif;">
                            <table style="padding: 30px" class="headingTable">
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: left;padding-left:12px;padding-top:0px;border-bottom:none;" colspan="12" class="pull-right"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    @*<th style="font-weight: bold; font-size: 20px; text-align: right; padding-bottom: 30px;padding-right:15px;padding-top:10px;" colspan="12" class="pull-right businssName">TradeHex</th>*@
                                    <th style="font-weight: bold; font-size: 24px; text-align: left; padding-left: 6px; padding-top: 10px; border-bottom: none;" colspan="12" class="pull-left">Salary Report</th>
                                </tr>
                                @if (Model.Count != 0)
                                {
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: left; padding-left: 6px; padding-top: 10px; border-bottom: none; " colspan="12" class="pull-left myMonthYearName"><strong><span style="font-size: 12px">Salary Month, Year:</span> </strong>@Convert.ToDateTime(Model[0].ForMonth).ToString("MMMM") , @Convert.ToDateTime(Model[0].ForMonth).ToString("yyyy")</th>
                                    </tr>

                                }
                            </table>
                            @if (Model.Count != 0)
                            {
                                <table class="mainTable" style="">
                                    <tr>
                                        <th style="text-align: center;font-size:12px">Sr#</th>
                                        <th style="text-align: left; font-size: 12px">Employee</th>
                                        <th style="text-align: center; font-size: 12px">Salary<br />Date</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />P</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />A</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />L</th>
                                        <th style="text-align: center; font-size: 12px">Total Working<br />Days</th>
                                        <th style="text-align: right; font-size: 12px">Gross<br />Pay</th>
                                        <th style="text-align: right; font-size: 12px">Advance</th>
                                        <th style="text-align: right; font-size: 12px; ">Advance<br />Deduction</th>
                                        <th style="text-align: right; font-size: 12px">Loan</th>
                                        <th style="text-align: right; font-size: 12px">Loan<br />Deduction</th>
                                        <th style="text-align: right; font-size: 12px">Add<br />Adjustment</th>
                                        <th style="text-align: right; font-size: 12px">Less<br />Deduction</th>
                                        <th class="borderRight" style="text-align: right; font-size: 12px">Net<br />Salary</th>
                                    </tr>
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        <tr>
                                            <td class="mainTd" style="text-align: center;font-size:11px">@(i + 1)</td>
                                            <td class="mainTd" style="text-align: left; font-size: 11px">@Model[i].EmployeeName</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Convert.ToDateTime(Model[i].RecordDate).ToString("dd/MM/yyyy")</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Model[i].TotalPresent</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Model[i].TotalAbsent</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Model[i].TotalLeaves</td>
                                            <td class="mainTd" style="text-align: center; font-size: 11px">@Model[i].TotalWorkingDays</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].GrossPay).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].Advance).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px; ">@Convert.ToDecimal(Model[i].AdvanceDeduction).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].Loan).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].LoanDeduction).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].AddAdjustment).ToString("#,##0.00")</td>
                                            <td class="mainTd" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].LessDeduction).ToString("#,##0.00")</td>
                                            <td class="mainTd borderRight" style="text-align: right; font-size: 11px">@Convert.ToDecimal(Model[i].NetSalary).ToString("#,##0.00")</td>
                                        </tr>
                                    }
                                </table>
                            }
                            else
                            {
                                <table class="mainTable" style="">
                                    <tr>
                                        <th style="text-align: center;font-size:12px">Sr#</th>
                                        <th style="text-align: left; font-size: 12px">Employee</th>
                                        <th style="text-align: center; font-size: 12px">Salary<br />Date</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />P</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />A</th>
                                        <th style="text-align: center; font-size: 12px">Total<br />L</th>
                                        <th style="text-align: center; font-size: 12px">Total Working<br />Days</th>
                                        <th style="text-align: right; font-size: 12px">Gross<br />Pay</th>
                                        <th style="text-align: right; font-size: 12px">Advance</th>
                                        <th style="text-align: right; font-size: 12px; ">Advance<br />Deduction</th>
                                        <th style="text-align: right; font-size: 12px">Loan</th>
                                        <th style="text-align: right; font-size: 12px">Loan<br />Deduction</th>
                                        <th style="text-align: right; font-size: 12px">Add<br />Adjustment</th>
                                        <th style="text-align: right; font-size: 12px">Less<br />Deduction</th>
                                        <th class="borderRight" style="text-align: right; font-size: 12px">Net<br />Salary</th>
                                    </tr>
                                    <tr>
                                        <td class="mainTd" colspan="15" style="text-align:center;padding:10px">No Record Found.</td>
                                    </tr>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script type="text/javascript">
            $(document).ready(function () {

            })
            $('#downloadForm').on("submit", function () {
                $("table").each(function () {
                    $(this).css("border-collapse", "collapse");
                    $('.mainTable').css("width", "99.8%");
                    //$('.mainTable').css("margin-top", "-15px");
                    //$('.tdd').css("border-right", "1px solid black");
                    var cssData = $('#CssData').html();
                    var htmlData = $('#HtmlData').html();
                    $('#DocumentName').val(cssData + htmlData);
                })
                $("table").each(function () {
                    $(this).css("border-collapse", "collapse");
                    $('.mainTable').css("width", "100%");
                    //$('.mainTable').css("margin-top", "-25px");
                    //$('.tdd').css("border-right", "0px");
                })
            })
            //$.get("ConvertServerDateIntoLocalDate", function (data) {
            //    $('.LocalDate').html(data);
            //});
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
