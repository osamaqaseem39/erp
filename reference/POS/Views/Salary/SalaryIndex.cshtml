@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            GetTodayDate();
            GetTodayMonth();
        });
        $('#btnSearch').click(function () {
            var recordDate = $('#Date').val();
            var month = $('#SalaryMonth').val();
            if (recordDate == '' || recordDate == null || month == '' || month == null) {
                if (recordDate == '' || recordDate == null) {
                    $('#Date').css('border-color', '#A90329');
                    $('#Date').css('background-color', '#FFF0F0');
                }
                if (month == '' || month == null) {
                    $('#SalaryMonth').css('border-color', '#A90329');
                    $('#SalaryMonth').css('background-color', '#FFF0F0');
                }
                return false;
            }
            $('.noRecordTr').html('<td colspan="15" class="dataTables_empty" rowspan="4" style="text-align: left;font-size:17px;"><i class="fa fa-refresh fa-spin"></i> &nbsp;Processing....</td>');
            $.ajax({
                type: "POST",
                url: "/salary/getEmployeesForSalary/",
                dataType: 'json',
                data: { 'salaryMonth': month },
                success: function (response) {
                    if (response.data.length == 0) {
                        $('.noRecordTr').html('<td class="NoRecordTd" colspan="15" style="text-align:center;padding:10px;background-color:#fff">No Record Found.</td>');
                    }
                    else {
                        var div = '';
                        var i = 0;
                        for (var key in response.data) {
                            
                            var totalWorkingDays = response.data[key].TotalPresent + response.data[key].TotalLeaves + response.data[key].TotalHolidays;
                            var grossPay = ((parseFloat(response.data[key].GrossPay) / parseFloat(response.data[key].TotalDaysOfMonth)) * totalWorkingDays).toFixed(2);
                            var netSalary = parseFloat(grossPay) - parseFloat(response.data[key].AdvanceDeduction) - parseFloat(response.data[key].LoanDeduction) + parseFloat(response.data[key].AddAdjustment) - parseFloat(response.data[key].LessDeduction);
                            div += '<tr class="newRows">' +
                                       '<td style="text-align: left;"><input type="hidden" class="EmployeeId" value = "' + response.data[key].EmployeeId + '" /><input type="hidden" class="SalaryId" value = "' + response.data[key].SalaryId + '" />' + response.data[key].EmployeeName + '</td>' +
                                       '<td style="text-align: center;">' + getDateForEdit(response.data[key].RecordDate) + '</td>' +
                                       '<td style="text-align: center;background-color:#F0FFF0;"><span class="TotalPresent">' + response.data[key].TotalPresent + '</span></td>' +
                                       '<td style="text-align: center;background-color:#F8A5A5;"><span class="TotalAbsent">' + response.data[key].TotalAbsent + '</span></td>' +
                                       '<td style="text-align: center;background-color:#F8ED62;"><span class="TotalLeaves">' + response.data[key].TotalLeaves + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><span class="TotalWorkingDays">' + totalWorkingDays + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><span class="GrossPay">' + ReplaceNumberWithCommas(grossPay) + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><span class="Advance">' + ReplaceNumberWithCommas(response.data[key].Advance) + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff"><input type="text" class="AdvanceDeduction" value="' + response.data[key].AdvanceDeduction + '" style="width:90px;text-align:right;padding-right:4px" /></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><span class="Loan">' + ReplaceNumberWithCommas(response.data[key].Loan) + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><input type="text" class="LoanDeduction" value="' + response.data[key].LoanDeduction + '" style="width:90px;text-align:right;padding-right:4px" /></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><input type="text" class="AddAdjustment" value="' + response.data[key].AddAdjustment + '" style="width:90px;text-align:right;padding-right:4px" /></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><input type="text" class="LessDeduction" value="' + response.data[key].LessDeduction + '" style="width:90px;text-align:right;padding-right:4px" /></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><span class="NetSalary">' + ReplaceNumberWithCommas(netSalary) + '</span></td>' +
                                       '<td style="text-align: center;background-color:#fff;"><input type="text" class="Remarks" value="' + response.data[key].Remarks + '" style="width:200px;text-align:left;padding-left:4px" /></td>' +
                                       '</tr>';
                            i++;
                        }
                        $('#TableBody').html(div);
                    }
                }
            })
        })
        $('#btnSave').click(function () {
            $('#btnSave').html("<i class='fa fa-refresh fa-spin'></i> Processing....");
            $('#btnSave').prop("disabled", true);
            $('#btnSaveAndPrint').prop("disabled", true);
            SaveSalary("");
        })
        $('#btnSaveAndPrint').click(function () {
            $('#btnSaveAndPrint').html("<i class='fa fa-refresh fa-spin'></i> Processing....");
            $('#btnSave').prop("disabled", true);
            $('#btnSaveAndPrint').prop("disabled", true);
            SaveSalary("Print");
        })
        function SaveSalary(print)
        {
            var check = 0;
            var recordDate = $('#Date').val();
            var month = $('#SalaryMonth').val();
            if (recordDate == '' || recordDate == null || month == '' || month == null) {
                if (recordDate == '' || recordDate == null) {
                    $('#Date').css('border-color', '#A90329');
                    $('#Date').css('background-color', '#FFF0F0');
                }
                if (month == '' || month == null) {
                    $('#SalaryMonth').css('border-color', '#A90329');
                    $('#SalaryMonth').css('background-color', '#FFF0F0');
                }
                return false;
            }
            var data = [];
            $('.newRows').each(function () {
                check++;
                var employeeId = $(this).find('.EmployeeId').val();
                var salaryId = $(this).find('.SalaryId').val();
                var totalPresent = $(this).find('.TotalPresent').html();
                var totalAbsent = $(this).find('.TotalAbsent').html();
                var totalLeaves = $(this).find('.TotalLeaves').html();
                var totalWorkingDays = $(this).find('.TotalWorkingDays').html();
                var grossPay = ReplaceCommas($(this).find('.GrossPay').html());
                var advance = ReplaceCommas($(this).find('.Advance').html());
                var advanceDeduction = $(this).find('.AdvanceDeduction').val();
                var loan = ReplaceCommas($(this).find('.Loan').html());
                var loanDeduction = $(this).find('.LoanDeduction').val();
                var addAdjustment = $(this).find('.AddAdjustment').val();
                var lessDeduction = $(this).find('.LessDeduction').val();
                var netSalary = ReplaceCommas($(this).find('.NetSalary').html());
                var remarks = $(this).find('.Remarks').val();
                var alldata = {
                    'SalaryId': salaryId,
                    'EmployeeId': employeeId,
                    'ForMonth': month,
                    'RecordDate': recordDate,
                    'Remarks': remarks,
                    'TotalPresent': totalPresent,
                    'TotalAbsent': totalAbsent,
                    'TotalLeaves': totalLeaves,
                    'TotalWorkingDays': totalWorkingDays,
                    'GrossPay': grossPay,
                    'Advance': advance,
                    'AdvanceDeduction': advanceDeduction,
                    'Loan': loan,
                    'LoanDeduction': loanDeduction,
                    'AddAdjustment': addAdjustment,
                    'LessDeduction': lessDeduction,
                    'NetSalary': netSalary,
                }
                data.push(alldata);
            });
            if (check == 0) {
                alert("There is no salary record to be saved.");
                $('#btnSave').html("Save");
                $('#btnSaveAndPrint').html("Save & Print");
                $('#btnSave').prop("disabled", false);
                $('#btnSaveAndPrint').prop("disabled", false);
                return false;
            }
            var allData = JSON.stringify(data);
            $.ajax({
                type: "POST",
                url: "/salary/InsertUpdateSalary/",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'data': allData, 'print': print }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == "Print")
                        {
                            window.location.href = "/salary/salaryreport";
                        }
                        else
                        {
                            $('.alertDiv').html('<div class="alert alert-success success-alert2" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Salary Saved Succesfully.' +
                                            '</div>');
                            $(".success-alert2").fadeTo(1000, 500).slideUp(500, function () {
                                $(".success-alert2").slideUp(500);
                                location.reload();
                            });
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSave').html("Save");
                        $('#btnSaveAndPrint').html("Save & Print");
                        $('#btnSave').prop("disabled", false);
                        $('#btnSaveAndPrint').prop("disabled", false);
                    }
                }
            })
        }
        $(document).on('keyup', '.AdvanceDeduction', function (event) {
            var reference = $(this);
            getNetSalary(reference);
        });
        $(document).on('keyup', '.LoanDeduction', function (event) {
            var reference = $(this);
            getNetSalary(reference);
        });
        $(document).on('keyup', '.AddAdjustment', function (event) {
            var reference = $(this);
            getNetSalary(reference);
        });
        $(document).on('keyup', '.LessDeduction', function (event) {
            var reference = $(this);
            getNetSalary(reference);
        });
        function getNetSalary(e)
        {
            var grossPay = e.closest('tr').find('.GrossPay').html();
            var advanceDeduction = e.closest('tr').find('.AdvanceDeduction').val();
            var loanDeduction = e.closest('tr').find('.LoanDeduction').val();
            var addAdjustment = e.closest('tr').find('.AddAdjustment').val();
            var lessDeduction = e.closest('tr').find('.LessDeduction').val();
            if (grossPay == null || grossPay == '')
            {
                grossPay = 0;
            }
            if (advanceDeduction == null || advanceDeduction == '') {
                advanceDeduction = 0;
            }
            if (loanDeduction == null || loanDeduction == '') {
                loanDeduction = 0;
            }
            if (addAdjustment == null || addAdjustment == '') {
                addAdjustment = 0;
            }
            if (lessDeduction == null || lessDeduction == '') {
                lessDeduction = 0;
            }
            var netPay = parseFloat(grossPay) - parseFloat(advanceDeduction) - parseFloat(loanDeduction) + parseFloat(addAdjustment) - parseFloat(lessDeduction);
            netPay = netPay.toFixed(2);
            e.closest('tr').find('.NetSalary').html(ReplaceNumberWithCommas(netPay));
        }
        $('#Date').keydown(function () {
            $('#Date').css('border-color', '#bdbdbd');
            $('#Date').css('background-color', '#fff');
        }).mousedown(function () {
            $('#Date').css('border-color', '#bdbdbd');
            $('#Date').css('background-color', '#fff');
        })
        $('#SalaryMonth').keydown(function () {
            $('#SalaryMonth').css('border-color', '#bdbdbd');
            $('#SalaryMonth').css('background-color', '#fff');
        }).mousedown(function () {
            $('#SalaryMonth').css('border-color', '#bdbdbd');
            $('#SalaryMonth').css('background-color', '#fff');
        })
        $('#btnRefresh').click(function () {
            location.reload();
        })
        function ReplaceCommas(yourNumber) {
            var noCommas = yourNumber.replace(/,/g, ''),
                asANumber = +noCommas;
            return noCommas;
        }
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#Date').val(today);
        }
        function GetTodayMonth() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm;
            $('#SalaryMonth').val(today);
        }
        function getDateForEdit(date) {
            if (date == null) {
                return '';
            }
            else {
                var newdate = new Date(parseInt(date.substr(6)));
                var day = newdate.getDate();
                var month = newdate.getMonth() + 1;
                if (day < 10) {
                    day = "0" + day;
                }
                if (month < 10) {
                    month = "0" + month;
                }
                var year = newdate.getFullYear();
                var today = day + '-' + month + '-' + year;
                    return today;
            }
        }
        //AdvanceDeduction LoanDeduction AddAdjustment LessDeduction
        $(document).on('keypress', '.AdvanceDeduction', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $(document).on('keypress', '.LoanDeduction', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $(document).on('keypress', '.AddAdjustment', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $(document).on('keypress', '.LessDeduction', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
}