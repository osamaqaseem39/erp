        $('#chequeDepositForm').on('submit', function (e) {
            if (!$("#chequeDepositForm").valid()) {
                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }
            $('#btnSaveChequeDeposit').prop('disabled', true);
            var isNewOrEdit = $('#IsNewOrEdit').val();
            var paymentNo = $('#PaymentNo').val();
            var salaryId = $('#SalaryId').val();
            var employeeId = $('#EmployeeId').val();
            var balance = ReplaceCommas($('#Balance').val());
            var date = $('#Date').val();
            var detailCode = $('#DetailCode').val();
            var amount = $('#Amount').val();
            var remarks = $('#Remarks').val();
            if (parseFloat(amount) > parseFloat(balance))
            {
                alert("Amount cannot be greater than balance.");
                $('#btnSaveChequeDeposit').prop('disabled', false);
                return false;
            }
            else if (parseFloat(amount) == 0)
            {
                alert("Amount cannot be zero.");
                $('#btnSaveChequeDeposit').prop('disabled', false);
                return false;
            }
            var formData =
            {
                NewOrEdit: isNewOrEdit,
                PaymentNo: paymentNo,
                RecordDate: date,
                EmployeeId: employeeId,
                Remarks: remarks,
                PaidFromDetailCode: detailCode,
                Amount: amount,
                SalaryId: salaryId,
                Balance: balance,
            }
            var url = $('#chequeDepositForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'formData': formData }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == 1) {
                            window.location.href = "/salarypayment/salarypaymentreport/" + data.voucherNo;
                        }
                        else {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Salary Paid Succesfully.' +
                                            '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            ClearFormFields();
                            oTable = $('#myTableChequeDeposit').DataTable();
                            oTable.ajax.reload(null, false);
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveChequeDeposit').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
