@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DetailCode').select2();
            $('#DetailCode').val(null).trigger('change');
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 924,
                phone: 380
            };

            $('#myTableChequeDeposit').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableChequeDeposit'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": false,
                "processing": true,
                "serverSide": true,
                //"scrollX": false,
                "scrollY": 150,
                "ajax": {
                    "url": "/salarypayment/GetAllPendingSalaries",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                    {
                        "data": "SalaryId", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                            if ($('#CanSave').val() == 1) {
                                return '<a href="javascript:void(0);" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:2px;margin-top:4px"></i></a>';
                            }
                            else {
                                return '';
                            }
                        }
                    },
                        { "data": "MonthYear", "name": "MonthYear", "class": "Acenter", "autoWidth": true, "orderable": true },
                         { "data": "EmployeeId", "name": "EmployeeId", "orderable": true, "autoWidth": true, "class": "NoDisplay EmployeeIdList" },
                         { "data": "EmployeeName", "name": "EmployeeName", "orderable": true, "autoWidth": true, "class": "EmployeeNameList" },
                         {
                             "data": "TotalSalary", "name": "TotalSalary", "orderable": true, "autoWidth": true, "class": "Amount", "render": function (data) {
                                 return ReplaceNumberWithCommas(data);
                             }
                         },
                         {
                             "data": "Paid", "name": "Paid", "orderable": true, "autoWidth": true, "class": "Amount", "render": function (data) {
                                 return ReplaceNumberWithCommas(data);
                             }
                         },
                         {
                             "data": "Balance", "name": "Balance", "orderable": true, "autoWidth": true, "class": "Amount BalanceList", "render": function (data) {
                                 return ReplaceNumberWithCommas(data);
                             }
                         }
                ]
            })
            oTable = $('#myTableChequeDeposit').DataTable();
            //DetailCode Amount
            $('#chequeDepositForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    DetailCode: {
                        required: true
                    },
                    Amount: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    DetailCode: {
                        required: 'Paid From Account is required.'
                    },
                    Amount: {
                        required: 'Amount is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            ClearFormFields();
        })
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var salaryId = $(this).attr("data-value");
            var employeeId = $(this).closest('tr').find('.EmployeeIdList').text();
            var employeeName = $(this).closest('tr').find('.EmployeeNameList').text();
            var balance = $(this).closest('tr').find('.BalanceList').text();
            $('#EmployeeId').val(employeeId);
            $('#SalaryId').val(salaryId);
            $('#EmployeeName').val(employeeName);
            $('#Balance').val(ReplaceNumberWithCommas(parseFloat(balance).toFixed(2)));
            $('#DetailCode').select().enable(true);
            $('#DetailCode').val(null).trigger('change');
            $('#Date').prop("disabled", false);
            $('#Remarks').prop("disabled", false);
            $('#Amount').prop("disabled", false);
            GetTodayDate();
            $('#Remarks').val('');
            $('#Amount').val('');
            $('#btnSaveChequeDeposit').prop('disabled', false);
            if ($('#CanChange').val() == 1) {
                $('#saveTd').removeAttr("hidden");
                $('#saveAndPrintTd').removeAttr("hidden");
                $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            else {
                $('#saveTd').attr("hidden", "hidden");
                $('#saveAndPrintTd').attr("hidden", "hidden");
                if ($('#CanSave').val() == 0) {
                    $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                }
                else {
                    $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                }
            }


            if ($('#CanSave').val() == 0) {
                $('#saveTd').css({ 'width': '44%', 'text-align': 'right' });
            }
            else {
                $('#addTd').removeAttr("hidden");
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }


            if ($('#CanDelete').val() == 1) {
            }
            $.ajax({
