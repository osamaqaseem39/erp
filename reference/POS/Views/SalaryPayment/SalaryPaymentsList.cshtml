<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 924,
            phone: 380
        };

        $('#myTableChequeDeposit2').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableChequeDeposit2'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/salarypayment/GetAllSalaryPayments",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "PaymentNo", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);" class="btn btn-primary selectBtn2" data-toggle="modal" data-target="#ChequeDepositListModal" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;margin-top:-1px"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                        {
                            "data": "ForMonth", "class": "Acenter", "orderable": false, 'render': function (date) {
                                if (date != null) {
                                    return getDateForEdit(date);
                                }
                                else {
                                    return "";
                                }
                            }
                        },
                         { "data": "EmployeeName", "name": "EmployeeName", "orderable": true, "autoWidth": true },
                         
                         {
                             "data": "RecordDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                                 if (date != null) {
                                     var date = new Date(parseInt(date.substr(6)));
                                     var day = date.getDate();
                                     var month = date.getMonth() + 1;
                                     if (parseFloat(day) < 10) {
                                         day = "0" + day;
                                     }
                                     if (parseFloat(month) < 10) {
                                         month = "0" + month;
                                     }
                                     return day + "-" + month + "-" + date.getFullYear();
                                 }
                                 else {
                                     return "";
                                 }
                             }
                         },
                         { "data": "DetailName", "name": "DetailName", "orderable": true, "autoWidth": true},
                         {
                             "data": "Amount", "name": "Amount", "orderable": true, "autoWidth": true, "class": "Amount", "render": function (data) {
                                 return ReplaceNumberWithCommas(data);
                             }
                         },
                         { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true },
            ]
        });
        oTable = $('#myTableChequeDeposit2').DataTable();
        $(document).on('click', '.selectBtn2', function (e) {
            e.preventDefault();
            var infoId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/salarypayment/GetSalaryPaymentById/" + infoId,
                dataType: 'json',
                success: function (response) {
                    $('#DetailCode').select().enable(true);
                    $('#Date').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#Amount').prop("disabled", false);
                    $('#EmployeeId').val(response.data.EmployeeId);
                    $('#SalaryId').val(response.data.SalaryId);
                    $('#EmployeeName').val(response.data.EmployeeName);
                    $('#Balance').val(ReplaceNumberWithCommas(parseFloat(response.data.Balance).toFixed(2)));
                    $('#invoiceNoSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#PaymentNo').val(response.data.PaymentNo);
                    $('#PaymentNoSpan').html(response.data.PaymentNo);

                    $('#DetailCode').val(response.data.PaidFromDetailCode).trigger('change');
                    $('#Date').val(getDate(response.data.RecordDate));
                    $('#Remarks').val(response.data.Remarks);
                    $('#Amount').val(response.data.Amount);
                    $('#btnSaveChequeDeposit').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        
                        $('#saveTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '44%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchChequeDeposit').click(function () {
            SearchItem();
        });
        $('#txtSearchChequeDeposit').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryChequeDeposit");
            if (BElement.html().trim() == 'Cheque No.') {
                NumberPostive(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryChequeDeposit");
            if (BElement.html().trim() == 'Employee') {
                oTable.columns(0).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'MonthYear') {
                oTable.columns(1).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshChequeDeposit').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryChequeDeposit").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryChequeDeposit").html($this.data("value"));
            if ($("#btnSearchCategoryChequeDeposit").html() == 'Cheque No.') {
                $('#txtSearchChequeDeposit').val('');
            }
        })
    });
    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function getDateForEdit(date) {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            var monthName = GetMonthName(month);
            var year = newdate.getFullYear();
            var today = monthName + ' , ' + year;
            return today;
    }
    function GetMonthName(monthNumber) {
        var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        return months[monthNumber - 1];
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
