@model POS.Models.clsCabOfferDetail
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="LuggageListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Offers List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="LuggageListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Special Offers To Location </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("InsertUpdateCabOfferDetail", "CabOfferDetail", FormMethod.Post, new { id = "CabOfferFrom", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Luggage" id="btnAddLuggage" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveLuggage" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Offers List" id="btnLuggageList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#LuggageListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshLuggage" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitLuggage" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveLuggage" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Offers List" id="btnLuggageList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#LuggageListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshLuggage" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitLuggage" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>From Location</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.OfferID, ViewBag.OfferList as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Cab Type</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.CabTypeID, ViewBag.CabTypeList as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>To Location</label>
                                        <input type="hidden" id="LuggageID" value="0" />
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="To Location" name="Description" id="Description" required />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>To Post Code</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Post Code" name="PostCode" id="PostCode"  />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Price</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Price" name="Price" id="Price" />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Sequence No.</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Sequence No." name="Sequence" id="Sequence" />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-3"></div>
                                    <div class="col-md-6">
                                        <label>Remarks</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Remarks" name="Remarks" id="Remarks" />
                                        </label>
                                    </div>
                                    <div class="col-md-3"></div>
                                </div>
                                <div class="col-md-12 StatusSection" style="" hidden>
                                    <section class="col col-md-3"></section>
                                    <section class="col col-md-6">
                                        <label class="checkbox pull-right" style="margin-right:-20px;margin-top:-12px">
                                            <input id="Status" type="checkbox" name="Status"><i></i>
                                            Active
                                        </label>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-3"></section>
                                    <section class="col col-md-6">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Luggage" id="btnDeleteLuggage" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.arrow-box-up-right').append('<li></li>');

            $('#OfferID').select2();
            $('#OfferID').val(null).trigger('change');
            $('#CabTypeID').select2();
            $('#CabTypeID').val(null).trigger('change');

            $('#CabOfferFrom').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    OfferID: {
                        required: true
                    },
                    CabTypeID: {
                        required: true
                    },
                    Description: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    OfferID: {
                        required: 'From Location is required.'
                    },
                    CabTypeID: {
                        required: 'Cab Type is required.'
                    },
                    Description: {
                        required: 'To Location is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddLuggage').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#LuggageID').val(0);
            $('#Description').prop("disabled", false);
            $('#Description').val('');

            $('#PostCode').prop("disabled", false);
            $('#PostCode').val('');
            $('#Remarks').prop("disabled", false);
            $('#Remarks').val('');

            $('#Price').prop("disabled", false);
            $('#Price').val('');
            $('#Sequence').prop("disabled", false);
            $('#Sequence').val('');           

            $('#OfferID').select().enable(true);
            $('#OfferID').val(null).trigger('change');
            $('#CabTypeID').select().enable(true);
            $('#CabTypeID').val(null).trigger('change');

            $('#btnSaveLuggage').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#btnRefreshLuggage').click(function () {
            location.reload();
        })
        $('#btnLuggageList').click(function () {
            $('#LuggageListDiv').load('@Url.Action("CabOfferDetailList", "CabOfferDetail")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#LuggageID').val(0);
            $('#Description').prop("disabled", true);
            $('#Description').val('');


            $('#PostCode').prop("disabled", true);
            $('#PostCode').val('');
            $('#Remarks').prop("disabled", true);
            $('#Remarks').val('');

            $('#Price').prop("disabled", true);
            $('#Price').val('');
            $('#Sequence').prop("disabled", true);
            $('#Sequence').val('');
            $('#OfferID').select().enable(false);
            $('#OfferID').val(null).trigger('change');
            $('#CabTypeID').select().enable(false);
            $('#CabTypeID').val(null).trigger('change');

            $('#btnSaveLuggage').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#CabOfferFrom').on('submit', function (e) {
            if (!$("#CabOfferFrom").valid()) {
                return false;
            }
            $('#btnSaveLuggage').prop('disabled', true);
            var PromotionID = $('#LuggageID').val();
            var ToLocation = $('#Description').val();
            var ToPostCode = $('#PostCode').val();
            var Price = $('#Price').val();
            var Sequence = $('#Sequence').val();
            var Remarks = $('#Remarks').val();

            var OfferID = $('#OfferID').val();
            var CabTypeID = $('#CabTypeID').val();
            

            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var CabOfferFrom =
            {
                PromotionID:PromotionID,
                OfferID: OfferID,
                CabTypeID: CabTypeID,
                ToLocation: ToLocation,
                ToPostCode: ToPostCode,
                Remarks: Remarks,
                Price: Price,
                SequenceNo: Sequence,
                Status: stringStatus
            }
            var url = $('#CabOfferFrom')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'CabOffer': CabOfferFrom }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Record Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveLuggage').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteLuggage').click(function () {
            var LuggageID = $('#LuggageID').val();
            DeleteLuggage(LuggageID);
        })
        function DeleteLuggage(id) {
            var a = $.confirm({
                title: 'Delete Record',
                content: 'Are you sure u want to delete this Record?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/CabOfferDetail/DeleteCabOfferDetail/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}