@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- widget content -->
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-print fa-fw "></i>
                Reports
            </h1>
        </div>
    </div>
    <!-- widget options:
                    usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
                    data-widget-colorbutton="false"
                    data-widget-editbutton="false"
                    data-widget-togglebutton="false"
                    data-widget-deletebutton="false"
                    data-widget-fullscreenbutton="false"
                    data-widget-custombutton="false"
                    data-widget-collapsed="true"
                    data-widget-sortable="false"

                    -->
    <section>
        <div class="modal fade" id="MainModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog modal-lg mainDialog width">
                <div class="modal-content">
                    <!-- Modal Header -->
                    <div class="modal-header defaultBackgroundColor" style="height:50px;">
                        <h4 class="modal-title" style="color:white;margin-top:-4px;" id="mainModalTitle"></h4>
                        <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                    </div>
                    <!-- Modal body -->
                    <div class="modal-body">
                        <div id="mainModalDiv"></div>
                    </div>
                    <!-- Modal footer -->
                </div>
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                <div style="margin-bottom:10px">
                    <span>
                        Reports
                    </span>
                </div>
            </div>
            <div class="panel-body">
                <table style="width: 100%">
                    <tbody>
                        <tr>
                            <td style="width: 50%; padding-right: 10px; vertical-align: top">
                                <div class="panel panel-default" id="GeneralLedgerPanel">
                                    <div class="panel-heading" style="background-color:#F2F2F2">
                                        <div style="text-align:left; color: #ccc;font-size: 14px; font-weight: bold;">Ledger</div>
                                    </div>
                                    <div class="list-group">
                                        <a href="javascript:void(0)" class="list-group-item" id="btnLedger" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Ledger</a>
                                        <a href="javascript:void(0)" class="list-group-item" id="btnLedgerThirdLevel" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Ledger Third Level</a>
                                        <a href="javascript:void(0)" class="list-group-item" id="btnTrialBalance" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Account Trial Balance</a>
                                        <a href="javascript:void(0)" class="list-group-item" id="btnRunningTrialBalance" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Account Running Trial Balance</a>
                                        <a href="javascript:void(0)" class="list-group-item" id="btnChartOfAccount"  style="font-weight: bold; font-size: 12px;color:#5090CD">Chart of Account</a>
                                        <a href="javascript:void(0)" class="list-group-item" id="btnChartOfAccountWithDetail" style="font-weight: bold; font-size: 12px;color:#5090CD">Chart of Account With Detail Accounts</a>
                                        @*<a href="javascript:void(0)" class="list-group-item" id="btnCustomerDetail" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Customer/Supplier Detail</a>*@
                                        <a href="javascript:void(0)" class="list-group-item" id="btnDaybook" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Daybook</a>
                                    </div>
                                </div>
                                <div class="panel panel-default" id="ItemPanel">
                                    <div class="panel-heading" style="background-color:#F2F2F2">
                                        <div style="text-align:left; color: #ccc;font-size: 14px; font-weight: bold;">Bookings</div>
                                    </div>
                                    <div class="list-group">
                                        <a href="javascript:void(0)" class="list-group-item" id="btnItemslist" data-toggle="modal" data-target="#MainModal" style="font-weight: bold; font-size: 12px;color:#5090CD">Booking/Invoices</a>                                        
                                    </div>
                                </div>
                            </td>
                            
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
<!-- END MAIN CONTENT -->
