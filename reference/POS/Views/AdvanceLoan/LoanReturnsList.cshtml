<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 924,
            phone: 380
        };

        $('#myTableAdvanceLoan').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableAdvanceLoan'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/advanceloan/GetAllLoanReturns",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ComputerNo", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#AdvanceLoanListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "ComputerNo", "name": "ComputerNo", "class": "Acenter", "orderable": true, "autoWidth": true },
                    { "data": "EmployeeName", "name": "EmployeeName", "autoWidth": true, "orderable": true },
                     {
                         "data": "RecordDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "Type", "name": "Type", "orderable": true, "autoWidth": true, "class": "Acenter" },
                     { "data": "Amount", "name": "Amount", "orderable": true, "autoWidth": true, "class": "Amount" },
                     { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true },

            ]
        });
        oTable = $('#myTableAdvanceLoan').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var accountCode = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/advanceloan/GetLoanReturnById/" + accountCode,
                dataType: 'json',
                success: function (response) {
                    $('#EmployeeId').select().enable(true);
                    $('#DetailCode').select().enable(true);
                    $('#Type').prop("disabled", false);
                    $('#RecordDate').prop("disabled", false);
                    $('#Amount').prop("disabled", false);
                    $('#ApprovedBy').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#AdvanceLoanCode').val(response.data.ComputerNo);
                    $('#AdvanceLoanCodeSpan').html(response.data.ComputerNo);
                    $('#EmployeeId').val(response.data.EmployeeId).trigger('change');
                    $('#DetailCode').val(response.data.PaidFromDetailCode).trigger('change');
                    $('#RecordDate').val(getDate(response.data.RecordDate));
                    $('#Type').val(response.data.Type);
                    $('#Amount').val(response.data.Amount);
                    $('#ApprovedBy').val(response.data.ApprovedBy);
                    $('#Remarks').val(response.data.Remarks);
                    $('#btnSaveAdvanceLoan').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchAdvanceLoan').click(function () {
            SearchItem();
        });
        $('#txtSearchAdvanceLoan').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryAdvanceLoan");
            if (BElement.html().trim() == 'Code') {
                oTable.columns(0).search($('#txtSearchAdvanceLoan').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Employee') {
                oTable.columns(1).search($('#txtSearchAdvanceLoan').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshAdvanceLoan').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryAdvanceLoan").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryAdvanceLoan").html($this.data("value"));
        })
    });
    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
