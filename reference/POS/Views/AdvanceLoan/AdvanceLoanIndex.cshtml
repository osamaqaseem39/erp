                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="padding-bottom: 15px;">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-8" style="padding:3px">
                                        <label>Remarks</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
