@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#EmployeeId').select2();
            $('#EmployeeId').val(null).trigger('change');
            $('#DetailCode').select2();
            $('#DetailCode').val(null).trigger('change');
            $('#advanceLoanForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    EmployeeId: {
                        required: true
                    },
                    Type: {
                        required: true
                    },
                    Amount: {
                        required: true
                    },
                    RecordDate: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    EmployeeId: {
                        required: 'Employee is required.'
                    },
                    Type: {
                        required: 'Type is required.'
                    },
                    Amount: {
                        required: 'Amount is required.'
                    },
                    RecordDate: {
                        required: 'Date is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableDisableFields();
        })
        function EnableDisableFields() {
            $('#EmployeeId').select().enable(true);
            $('#DetailCode').select().enable(true);
            $('#EmployeeId').val(null).trigger('change');
            $('#DetailCode').val(null).trigger('change');
            $('#Type').prop("disabled", false);
            $('#RecordDate').prop("disabled", false);
            $('#Amount').prop("disabled", false);
            $('#ApprovedBy').prop("disabled", false);
            $('#Remarks').prop("disabled", false);
            GetTodayDate();
            $('#Type').val('');
            $('#Amount').val('');
            $('#ApprovedBy').val('');
            $('#Remarks').val('');
            $('#btnSaveAdvanceLoan').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $.ajax({
                type: "POST",
                url: "/advanceloan/getMaxCodeForAdvanceLoan/",
                dataType: 'json',
                success: function (response) {
                    $('#accountCodeSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("New");
                    $('#AdvanceLoanCode').val(response);
                    $('#AdvanceLoanCodeSpan').html(response);
                }
            })
            $('.deleteRow').attr("hidden", "hidden");
        }
        $('#btnAddAdvanceLoan').click(function () {
            EnableDisableFields();
        })
        $('#btnRefreshAdvanceLoan').click(function () {
            location.reload();
        })
        $('#btnAdvanceLoanList').click(function () {
            $('#advanceLoanListDiv').load('@Url.Action("advanceloanslist", "advanceloan")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#EmployeeId').select().enable(false);
            $('#DetailCode').select().enable(false);
            $('#EmployeeId').val(null).trigger('change');
            $('#DetailCode').val(null).trigger('change');
            $('#Type').prop("disabled", true);
            $('#RecordDate').prop("disabled", true);
            $('#Amount').prop("disabled", true);
            $('#ApprovedBy').prop("disabled", true);
            $('#Remarks').prop("disabled", true);
            GetTodayDate();
            $('#AdvanceLoanCode').val(0);
            $('#Type').val('');
            $('#Amount').val('');
            $('#ApprovedBy').val('');
            $('#Remarks').val('');
            $('#btnSaveAdvanceLoan').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#accountCodeSection').attr("hidden", "hidden");
            $('#IsNewOrEdit').val("New");
            
            $('#AdvanceLoanCodeSpan').html('0');
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
        }
        //AdvanceLoanCode Type RecordDate Amount ApprovedBy Remarks EmployeeId DetailCode
        $('#advanceLoanForm').on('submit', function (e) {
            if (!$("#advanceLoanForm").valid()) {
                return false;
            }
            $('#btnSaveAdvanceLoan').prop('disabled', true);
            var isNewOrEdit = $('#IsNewOrEdit').val();
            var accountCode = $('#AdvanceLoanCode').val();
            var employeeId = $('#EmployeeId').val();
            var detailCode = $('#DetailCode').val();
            var type = $('#Type').val();
            var recordDate = $('#RecordDate').val();
            var amount = $('#Amount').val();
            var approvedBy = $('#ApprovedBy').val();
            var remarks = $('#Remarks').val();
            var advance =
            {
                IsNewOrEdit: isNewOrEdit,
                ComputerNo: accountCode,
                EmployeeId: employeeId,
                Type: type,
                RecordDate: recordDate,
                Amount: amount,
                Remarks: remarks,
                ApprovedBy: approvedBy,
                PaidFromDetailCode: detailCode
            }
            var url = $('#advanceLoanForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'advance': advance }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Advance Loan Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableDisableFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveAdvanceLoan').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteAdvanceLoan').click(function () {
            var accCode = $('#AdvanceLoanCode').val();
            DeleteAdvanceLoan(accCode);
        })
        function DeleteAdvanceLoan(id) {
            var a = $.confirm({
                title: 'Delete Advance Loan',
                content: 'Are you sure u want to delete this advance loan?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/advanceloan/DeleteAdvanceLoan/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#RecordDate').val(today);
        }
        $("#Amount").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
}