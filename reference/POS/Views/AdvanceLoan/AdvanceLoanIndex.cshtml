                                                <button title="Save" class="btnUpSave" id="btnSaveAdvanceLoan" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Advance Loans List" id="btnAdvanceLoanList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#AdvanceLoanListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshAdvanceLoan" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitAdvanceLoan" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="col-md-12" id="accountCodeSection" style="padding-top: 15px;" hidden>
                                    <div class="col-md-2"></div>
                                    <div class="col-md-8">
                                        <input type="hidden" id="IsNewOrEdit" value="" />
                                        <input type="hidden" id="AdvanceLoanCode" value="0" />
                                        <label class="" style="font-size:16px;">
                                            Code:
                                            <span class="badge bg-color-blue" id="AdvanceLoanCodeSpan" style="font-size:16px;border-radius:4px;padding:5px;"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="padding-top: 10px;">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Employee</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.EmployeeId, ViewBag.Employee as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Type</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="Type" name="Type">
                                                <option value="Advance">Advance</option>
                                                <option value="Loan">Loan</option>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Date</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-calendar"></i>
                                            <input type="date" name="RecordDate" id="RecordDate" min="@ViewBag.FromDate" max="@ViewBag.ToDate" required />
                                        </label>
                                    </div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Amount</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-money-bill-alt"></i>
                                            <input type="text" placeholder="Amount" name="Amount" id="Amount" />
                                        </label>
                                    </div>
                                    <div class="col-md-2"></div>
                                </div>
                                <div class="col-md-12" style="">
                                    <div class="col-md-2"></div>
                                    <div class="col-md-4" style="padding:3px">
                                        <label>Paid From</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
