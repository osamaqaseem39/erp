                                                <a title="Refresh" id="btnRefreshCabZone" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitCabZone" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveCabZone" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Zones List" id="btnCabZoneList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#CabZoneListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshCabZone" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitCabZone" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="col-md-12" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col-md-2">
                                    </div>
                                    <div class="col-md-3">
                                        <div style="padding: 3px">
                                            <label>Zone</label>
                                            <input type="hidden" id="CabZoneID" value="0" />
                                            <input type="hidden" id="HiddenTr" value="0" />
                                            <input type="hidden" id="HiddenTrM" value="0" />
                                            <label class="input">
                                                <i class="icon-prepend fa fa-info"></i>
                                                <input type="text" placeholder="Zone" name="Description" id="Description" required />
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div style="padding: 3px">
                                            <label>Remarks</label>
                                            <label class="input">
                                                <i class="icon-prepend fa fa-info"></i>
                                                <input type="text" placeholder="Remarks" name="Remarks" id="Remarks" />
                                            </label>
                                        </div>
                                    </div>
                                    <section class="col col-md-2 StatusSection">
                                        <label class="checkbox" style="margin-right:-20px;margin-top:15x;">
                                            <input id="Status" type="checkbox" name="Status"><i></i>
                                            Active
                                        </label>
                                    </section>
                                    <div class="col-md-2">
                                    </div>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-3"></section>
                                    <section class="col col-md-6">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Zone" id="btnDeleteCabZone" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>


                                <div class="col-md-12">
                                    <div class="col-md-3">

                                    </div>
                                    <div class="col-md-6">
                                        <h1 class="heading-1" style="margin-top: 10px;margin-bottom:5px; color: #03386C;font-weight:bold "><span>Area Detail</span></h1>
                                        <div class="row" style="padding-top: 15px; padding-bottom: 15px;padding-left:10px;padding-right:10px">
                                            <div class="col-md-12">
                                                <div class="col-md-6">
                                                    <div style="padding: 3px">
                                                        <label>Area Code</label>
                                                        <label class="input">
                                                            <input type="text" name="CarModel" id="CarModel" placeholder="Area Code" autocomplete="off" />
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <center>
                                            <a title="Add Detail" id="btnAddModelDetail" href="javascript:void(0)" class="btn btn-primary" style="width:95px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                <i class="fa fa-plus"></i> Add
                                            </a>
                                            <a title="Cancel" id="btnCancelModelDetail" href="javascript:void(0)" class="btn btn-default" style="width:75px; height:28px;color:#333; margin-bottom:8px;line-height:26px;border-radius:5px;" hidden>
                                                Cancel
                                            </a>
                                        </center>
                                        <div class="col-md-12" style="margin-top:10px;margin-bottom:40px">
                                            <table id="ModelDetailTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                                <thead>
                                                    <tr>
                                                        <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center;border-right:none "></th>
                                                        <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center; border-left: none; "></th>
                                                        <th data-hide="" style="width: 250px; background-color: #03386C; color: white; padding: 7px; text-align: left; ">Car Model</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-md-3">

                                    </div>
                                </div>
                                
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">

        
        $('#btnAddModelDetail').click(function () {

            var check = 0;
            var carmodel = $('#CarModel').val();
            if (carmodel == '' || carmodel == null) {
                check = 1;
            }
            if (check == 1) {
                return false;
            }

            var vtable = $('#ModelDetailTable').DataTable();
            if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                vtable.row.add([
                "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }
            else {
                $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
                $('#btnCancelModelDetail').hide();
                var tr = $('#HiddenTrM').val();
                vtable.row(tr).data([
                "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }

            $('#CarModel').val('');
        })
        $('#btnCancelDetail').click(function () {
            $('#btnCancelModelDetail').hide();
            $('#CarModel').val('');
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
        })
        $(document).on('click', '.editRowBtnM', function () {
            var vtable = $('#ModelDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#HiddenTrM').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var carmodel = data[2].split('value=')[1].split('/>')[0].trim();

            $('#CarModel').val(carmodel);

            $('#btnAddModelDetail').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelModelDetail').removeAttr("hidden");
            $('#btnCancelModelDetail').show();
        })
        $(document).on('click', '.deleteRowBtnM', function () {
            var vtable = $('#ModelDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#btnCancelModelDetail').hide();
            $('#CarModel').val('');
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
        })

        $(document).ready(function () {
            $('.arrow-box-up-right').append('<li></li>');
            $('#CabZoneForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    Description: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    Description: {
                        required: 'Description is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });

            
            var responsiveHelper_dt_basic_mod = undefined;
            var responsiveHelper_datatable_fixed_column_mod = undefined;
            var responsiveHelper_datatable_col_reorder_mod = undefined;
            var responsiveHelper_datatable_tabletools_mod = undefined;

            var breakpointDefinition_mod = {
                tablet: 1024,
                phone: 480
            };
            $('#ModelDetailTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic_mod) {
                        responsiveHelper_dt_basic_mod = new ResponsiveDatatablesHelper($('#ModelDetailTable'), breakpointDefinition_mod);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic_mod.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic_mod.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });

            
            var vtablem = $('#ModelDetailTable').DataTable();
            vtablem.clear().draw();

            EnableFormFields();
        })
        $('#btnAddCabZone').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#CabZoneID').val(0);
            $('#Description').prop("disabled", false);
            $('#Description').val('');
            $('#Remarks').val('');

            $('#CarModel').val('');
            $('#btnCancelModelDetail').hide();
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');

            var vtablem = $('#ModelDetailTable').DataTable();
            vtablem.clear().draw();

            $('#btnSaveCabZone').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            //$('.StatusSection').attr("hidden", "hidden");
        }
        $('#btnRefreshCabZone').click(function () {
            location.reload();
        })
        $('#btnCabZoneList').click(function () {
            $('#CabZoneListDiv').load('@Url.Action("CabZonelist", "CabZone")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#CabZoneID').val(0);
            $('#Description').prop("disabled", true);
            $('#Description').val('');
            $('#Remarks').val('');
            
            $('#CarModel').val('');
            $('#btnCancelModelDetail').hide();
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
            
            var vtablem = $('#ModelDetailTable').DataTable();
            vtablem.clear().draw();


            $('#btnSaveCabZone').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            //$('.StatusSection').attr("hidden", "hidden");
        }


        function getAllDataModel() {
            var arrayData = [];
            var count = 0;
            $('#ModelDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#ModelDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();
                var carmodel = data[2].split('value=')[1].split('/>')[0].trim();
                var alldata = {
                    'AreaCode': carmodel,
                }
                arrayData.push(alldata);
            }
            console.log(arrayData);
            return arrayData;
        }

        $('#CabZoneForm').on('submit', function (e) {
            if (!$("#CabZoneForm").valid()) {
                return false;
            }

            var ModelDetail = JSON.stringify(getAllDataModel());

            $('#btnSaveCabZone').prop('disabled', true);
            var CabZoneID = $('#CabZoneID').val();
            var description = $('#Description').val();
            var remk = $('#Remarks').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var CabZoneForm =
            {
                CabZoneID: CabZoneID,
                Description: description,
                Remarks: remk,
                Status: stringStatus,
            }
            var url = $('#CabZoneForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ CabForm: CabZoneForm, ModelList: ModelDetail }),

                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Zone Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        location.reload();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveCabZone').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteCabZone').click(function () {
            var CabZoneID = $('#CabZoneID').val();
            DeleteCabZone(CabZoneID);
        })
        function DeleteCabZone(id) {
            var a = $.confirm({
                title: 'Delete Zone',
                content: 'Are you sure u want to delete this Zone?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/CabZone/DeleteCabZone/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}