@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $('#FooterImage').change(function (e) {
            $('.fileDiv').removeClass('state-error');
            $('.invalid-File').remove();
            var ext = $('#FooterImage').val().split('.').pop().toLowerCase();
            var size = document.getElementById('FooterImage').files[0].size;
            var filename = $('input[type=file]').val().replace(/C:\\fakepath\\/i, '');
            if ($.inArray(ext, ['jpeg', 'jpg', 'png']) == -1) {
                $('#FooterImage').val('');
                $('#AttachDocumentFooter').val('');
                $('#ImageRow').attr("hidden", "hidden");
                alert('Error! File type allowed : jpeg, jpg, png');
            }
            else if (size > (5000 * 1024)) {
                $('#FooterImage').val('');
                $('#AttachDocumentFooter').val('');
                $('#ImageRow').attr("hidden", "hidden");
                alert('Error! Maximum File size must be 5 mb');
            }
            else {

                //Get count of selected files
                var countFiles = $(this)[0].files.length;

                var imgPath = $(this)[0].value;
                var extn = imgPath.substring(imgPath.lastIndexOf('.') + 1).toLowerCase();
                if (extn == "png" || extn == "jpg" || extn == "jpeg") {
                    $('#ImageRow').removeAttr("hidden");
                    $('#AttachDocumentFooter').val(filename);
                    if (typeof (FileReader) != "undefined") {

                        //loop for each file selected for uploaded.
                        for (var i = 0; i < countFiles; i++) {

                            var reader = new FileReader();
                            reader.onload = function (e) {
                                $("#DisplayImage").prop("src", e.target.result);
                            }
                            //image_holder.show();
                            reader.readAsDataURL($(this)[0].files[i]);
                        }

                    }
                    else {
                        alert("This browser does not support FileReader.");
                    }
                }
                else {
                    //$('.ImageDisplayRow').hide();
                    //$('#AttachDocument').val(filename);
                    @*$("#imgItemstdreg").prop("height", "100");
                    $("#imgItemstdreg").prop("width", "100");
                    //$("#imgItemstdreg").prop("src", '@Url.Content("~/Content/Images/noimage.jpg")');

                    $("#imgItemstdreg").prop("src", '@Url.Content("~/Content/Images/noimage.jpg")');*@
                }
            }
        });
        $(document).ready(function () {
            $('.arrow-box-up-right').append('<li></li>');
            $('#footerForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    FooterName: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    FooterName: {
                        required: 'Footer Name is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableDisableFields();
        })
        $('#btnAddFooter').click(function () {
            EnableDisableFields();
        })
        function EnableDisableFields() {
            $('#FooterId').val(0);
            $('#FooterName').prop("disabled", false);
            $('#FooterName').val('');
            $('#Description').prop("disabled", false);
            $('#Description').val('');
            $('#ListFooterId').select2();
            $('#btnSaveFooter').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('#ImageRow').attr("hidden", "hidden");
            $('#FooterImage').val('');
            $('#AttachDocumentFooter').val('');
            getDefaultFooterImage();
            getFootersList();
        }
        function getDefaultFooterImage()
        {
            $.ajax({
                type: "POST",
                url: "/footer/getActiveFooter/",
                dataType: 'json',
                success: function (response) {
                    $("#ListDisplayImage").prop("src", "/FormsDocuments/SaleFooter/" + response.footerId + ".jpg");
                }
            })
        }
        function getFootersList() {
            $.ajax({
                type: "POST",
                url: "/footer/getFootersList/",
                dataType: 'json',
                success: function (response) {
                    var select = $("#ListFooterId");
                    select.children().remove();
                    var footerId = 0;
                    for (var key in response.data) {
                        if (response.data[key].Status == 'Active')
                        {
                            footerId = response.data[key].FooterId;
                        }
                        select.append('<option value="' + response.data[key].FooterId + '">' + response.data[key].FooterName + '</option>');
                    }
                    select.val(footerId).trigger("change");
                }
            })
        }
        $('#btnRefreshFooter').click(function () {
            location.reload();
        })
        $('#btnFooterList').click(function () {
            $('#footerListDiv').load('@Url.Action("footerslist", "footer")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#FooterId').val(0);
            $('#FooterName').prop("disabled", true);
            $('#FooterName').val('');
            $('#Description').prop("disabled", true);
            $('#Description').val('');
            $('#btnSaveFooter').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#ImageRow').attr("hidden", "hidden");
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('#FooterImage').val('');
            $('#AttachDocumentFooter').val('');
        }
        $('#footerForm').on('submit', function (e) {
            if (!$("#footerForm").valid()) {
                return false;
            }
            var document = $('#FooterImage').get(0).files;
            var documentFile = document[0];
            if ($('#FooterId').val() == 0) {
            if (documentFile == '' || documentFile == undefined) {
                $('.fileDiv').removeClass('state-error');
                $('.invalid-File').remove();
                $('.fileDiv').addClass('state-error');
                $('.fileDiv').append('<label style="color:#cf564a;font-size:11px" for="Document" class="invalid-File">Image is required.</label>');
                return false;
            }
            else {
                $('.fileDiv').removeClass('state-error');
                $('.invalid-File').remove();
            }
        }
            $('#btnSaveFooter').prop('disabled', true);
            var footerId = $('#FooterId').val();
            var footerName = $('#FooterName').val();
            var description = $('#Description').val();
            var footerForm =
            {
                FooterId: footerId,
                FooterName: footerName,
                Description: description
            }
            var url = $('#footerForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'footer': footerForm }),
                success: function (data) {
                    if (data.status == true) {
                        var bannerImage = $("#FooterImage").val();
                        var file = $('#FooterImage').get(0).files;
                        var documentFile = file[0];
                        var extension = $('#FooterImage').val().split('.').pop().toLowerCase();
                        var invoiceNoWithExtension = data.footerId + "|" + extension;
                        var formData = new FormData();
                        formData.append(file.name, documentFile);
                        formData.append("DocumentName", $("#FooterImage").text());

                        var xhr = new XMLHttpRequest();
                        var url = '/footer/AttachFooter/' + invoiceNoWithExtension;
                        xhr.open('POST', url, true);

                        xhr.onload = function (e) {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                            '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                            ' <strong>Success! </strong>' +
                                            'Footer Saved Succesfully.' +
                                        '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            //$.notify("First Level Saved Successfully.", "success");
                            EnableDisableFields();
                        };
                        xhr.send(formData);  // multipart/form-data
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveFooter').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('.btnSetDefaultFooter').click(function () {
            var listFooterId = $('#ListFooterId').val();
            $.ajax({
                url: '/footer/SetDefaultFooter/' + listFooterId,
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    if (data.status == true) {
                        getDefaultFooterImage();
                        getFootersList();
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        })
        $('#btnDeleteFooter').click(function () {
            var footerId = $('#FooterId').val();
            DeleteFooter(footerId);
        })
        function DeleteFooter(id) {
            var a = $.confirm({
                title: 'Delete Footer',
                content: 'Are you sure u want to delete this footer?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/footer/deletefooter/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}