<!-- widget content -->
@model POS.Models.clsInvoice
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        Items Stock Resgister Overall
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> Items Stock Resgister Overall Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="ItemStockRegisterOverall" />
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content" class="panel rpt" style=" float: left;width: 800px; font-family: Arial, Helvetica, sans-serif;">
                            <table style="padding: 30px;padding-top:0px" id="myTable">
                                <tr>
                                    <th style="font-weight: bold; font-size: 12px; text-align: right;font-weight:normal" colspan="12"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 20px; text-align: center; padding-bottom: 5px;padding-top:15px" colspan="6">@System.Web.HttpContext.Current.Application["BusinessName"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: normal; font-size: 14px; text-align: center; padding-bottom: 5px;" colspan="6">@System.Web.HttpContext.Current.Application["BusinessAddress"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 18px; text-align: center;" colspan="6">Items Stock Resgister Overall Report</th>
                                </tr>
                                @if (Model.InvoicesList.Count != 0)
                                {
                                    <tr>
                                        <th style="font-weight: bold; font-size: 14px; text-align: center;" colspan="6"><strong><span style="font-size: 13px">From:</span> </strong>@Convert.ToDateTime(Model.InvoicesList[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size:16px">To:</span></strong>@Convert.ToDateTime(Model.InvoicesList[0].ToDate).ToString("dd/MM/yyyy")</th>
                                    </tr>
                                }
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 16px; text-align: center; padding-bottom: 10px" colspan="12">&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="12">
                                            @{
                                                decimal grandInQty1 = 0;
                                                decimal grandOutQty1 = 0;
                                                decimal grandBalance1 = 0;
                                            }
                                            @if (Model.InvoicesList.Count != 0)
                                            {
                                                for (int i = 0; i < Model.InvoicesList2.Count; i++)
                                                {
                                                    decimal stock = Convert.ToDecimal(Model.InvoicesList2[i].PreviousStock1);
                                                    decimal itemId = Convert.ToDecimal(Model.InvoicesList2[i].ItemID);
                                                    int j = 0;
                                                    string marginTop = "";
                                                    if (i == 0)
                                                    {
                                                        marginTop = "-15px";
                                                    }
                                                    else
                                                    {
                                                        marginTop = "-45px";
                                                    }
                                                    if (Model.InvoicesList.Where(x => x.ItemID == itemId).Count() != 0)
                                                    {
                                                        <table class="mainTable" style="margin-top:@marginTop">
                                                            <thead>
                                                                <tr>
                                                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 13px;border:none;border-bottom:1px solid black" colspan="12">&nbsp;</th>
                                                                </tr>
                                                            </thead>
                                                            <tr>
                                                                <th style="text-align: center; border: 1px solid black !important; border-bottom: 0px !important; font-size: 14px; padding-bottom: 5px;" colspan="11">
                                                                    @Model.InvoicesList2[i].ItemName
                                                                </th>
                                                            </tr>
                                                            <tr>
                                                                <th style="text-align: left; border-bottom: 0px !important; font-size: 13px; border-right: 1px solid black; padding-bottom: 5px; font-weight: normal" colspan="11">
                                                                    <div>
                                                                        <span style="margin-left: 106px">
                                                                            Category : <b>@Model.InvoicesList2[i].CategoryName</b>
                                                                        </span>

                                                                        <span style="margin-left: 106px">
                                                                            Brand : <b>@Model.InvoicesList2[i].BrandName</b>
                                                                        </span>
                                                                        <span style="margin-left: 106px">
                                                                            UOM : <b>@Model.InvoicesList2[i].UnitName</b>
                                                                        </span>
                                                                    </div>
                                                                    <div class="pull-right" style="margin-top:5px;float:right">
                                                                        @if (Model.InvoicesList2[i].PreviousStock1 == null)
                                                                        {
                                                                            <span style="">
                                                                                Previous Stock : <b>0.00</b>
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span style="">
                                                                                Previous Stock : <b>@Model.InvoicesList2[i].PreviousStock1</b>
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </th>
                                                            </tr>
                                                            <tr class="mainTr">
                                                                <th style="text-align: center; width: 35px;font-size:11px">Sr#</th>
                                                                <th style="text-align: center; width: 70px;font-size: 11px; ">Date</th>
                                                                <th style="text-align: center; width: 100px; font-size: 11px; ">Invoice No.</th>
                                                                <th style="text-align: center; width: 50px; font-size: 11px; ">Ref<br />No.</th>
                                                                <th style="text-align: left; font-size: 11px">Account</th>
                                                                <th style="text-align: right; width: 50px; font-size: 11px; ">In<br />Qty</th>
                                                                <th style="text-align: right; width: 50px; font-size: 11px; ">Out<br />Qty</th>
                                                                <th class="borderRight" style="text-align: right; width: 50px; font-size: 11px; ">Balance</th>
                                                            </tr>
                                                            <tbody>
                                                                @{
                                                                        decimal totalInQty1 = 0;
                                                                        decimal totalOutQty1 = 0;
                                                                        decimal totalBalance1 = 0;
                                                                        decimal balance1 = stock;
                                                                }

                                                                @foreach (clsInvoice s in Model.InvoicesList.Where(x => x.ItemID == itemId))
                                                                {
                                                                    if (Convert.ToDecimal(s.InQty) == 0 && Convert.ToDecimal(s.OutQty)==0){
                                                                        j = j;
                                                                    }
                                                                    else
                                                                    {
                                                                        j++;
                                                                        balance1 = balance1 + Convert.ToDecimal(s.InQty) - Convert.ToDecimal(s.OutQty);
                                                                        totalInQty1 += Convert.ToDecimal(s.InQty);
                                                                        totalOutQty1 += Convert.ToDecimal(s.OutQty);
                                                                        totalBalance1 += Convert.ToDecimal(balance1);
                                                                        <tr class="mainTr">
                                                                            <td style="text-align: center; font-size: 11px">@(j)</td>
                                                                            <td style="text-align: center; font-size: 11px">@Convert.ToDateTime(s.RecordDate).ToString("dd-MM-yy")</td>
                                                                            <td style="text-align: center; font-size: 11px">@s.ComputerNo</td>
                                                                            <td style="text-align: center; font-size: 11px">@s.RefrenceNo</td>
                                                                            <td style="text-align: left; font-size: 11px">@s.DetailName</td>
                                                                            @if (s.InQty == Convert.ToInt32(s.InQty))
                                                                            {
                                                                                <td style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(s.InQty), 0)</td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(s.InQty), 2)</td>
                                                                            }
                                                                            @if (s.OutQty == Convert.ToInt32(s.OutQty))
                                                                            {
                                                                                <td style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(s.OutQty), 0)</td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(s.OutQty), 2)</td>
                                                                            }
                                                                            @if (balance1 == Convert.ToInt32(balance1))
                                                                            {
                                                                                <td class="borderRight" style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(balance1), 0)</td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td class="borderRight" style="text-align: right; font-size: 11px">@Math.Round(Convert.ToDecimal(balance1), 2)</td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                }
                                                                <tr class="mainTr">
                                                                    <td class="tdd" style="text-align: right; border: 1px solid #fff; font-weight: bold; font-size: 11px" colspan="5">Total: </td>
                                                                    @if (totalInQty1 == Convert.ToInt32(totalInQty1))
                                                                    {
                                                                        <td style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(totalInQty1), 0)</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(totalInQty1), 2)</td>
                                                                    }
                                                                    @if (totalOutQty1 == Convert.ToInt32(totalOutQty1))
                                                                    {
                                                                        <td style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(totalOutQty1), 0)</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(totalOutQty1), 2)</td>
                                                                    }
                                                                    @if (balance1 == Convert.ToInt32(balance1))
                                                                    {
                                                                        <td class="borderRight" style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(balance1), 0)</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td class="borderRight" style="text-align: right; font-weight: bold; font-size: 11px">@Math.Round(Convert.ToDecimal(balance1), 2)</td>
                                                                    }
                                                                </tr>

                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 10px;  border: none;" colspan="12">&nbsp;</th>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                        <br />
                                                        <br />
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <table class="mainTable" style="margin-top:5px">
                                                    <tr class="mainTr">
                                                        <th style="text-align: center; width: 35px;font-size:11px">Sr#</th>
                                                        <th style="text-align: center; width: 70px;font-size: 11px; ">Date</th>
                                                        <th style="text-align: center; width: 100px; font-size: 11px; ">Invoice No.</th>
                                                        <th style="text-align: center; width: 50px; font-size: 11px; ">Ref<br />No.</th>
                                                        <th style="text-align: left; font-size: 11px">Account</th>
                                                        <th style="text-align: right; width: 50px; font-size: 11px; ">In<br />Qty</th>
                                                        <th style="text-align: right; width: 50px; font-size: 11px; ">Out<br />Qty</th>
                                                        <th class="borderRight" style="text-align: right; width: 50px; font-size: 11px; ">Balance</th>
                                                    </tr>
                                                    <tbody>
                                                        <tr class="mainTr">
                                                            <td class="borderRight" colspan="8" style="text-align:center;padding:10px">No Record Found.</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script src="~/Scripts/CustomJs/ResponsivePrintScreen.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {

            })
            $('#downloadForm').on("submit", function () {
                $("table").each(function () {
                    $(this).css("border-collapse", "collapse");
                    $('.mainTable').css("width", "99.8%");
                    $('.mainTable').css("margin-top", "-15px");
                    $('.tdd').css("border-right", "1px solid black");
                    var cssData = $('#CssData').html();
                    var htmlData = $('#HtmlData').html();
                    $('#DocumentName').val(cssData + htmlData);
                })
                $("table").each(function () {
                    $(this).css("border-collapse", "separate");
                    $('.mainTable').css("width", "100%");
                    $('.mainTable').css("margin-top", "-25px");
                    $('.tdd').css("border-right", "0px");
                })
            })
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
