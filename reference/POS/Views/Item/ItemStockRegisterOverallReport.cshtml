<style>
    .set-img {
        font-family: "Open Sans",Arial,Helvetica,Sans-Serif;
    }

    .table tr td {
        border: 0 !important;
    }

    .custome-class-form h4 {
        font-weight: bold;
        color: #000;
    }

    .custome-class-form label {
        font-weight: bold !important;
        color: #000;
    }

    .table tr .V__align {
        vertical-align: bottom !important;
    }

    imgs {
        opacity: 0.5;
        filter: alpha(opacity=50); /* For IE8 and earlier */
    }

    .dropwidth {
        width: 100%;
    }

    .btn-primary {
        background-color: #03386C !important;
        border-color: #03386C !important;
    }

        .btn-primary:hover {
            background-color: #03386C !important;
        }
</style>
@model POS.Models.clsItem
@{
    Layout = null;
}
<div class="widget-body no-padding" style="overflow-x:hidden;">
    @using (Html.BeginForm("printitemstockregisteroverall", "item", FormMethod.Post, new { id = "itemsRegisterForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
    {
        <fieldset id="myField1">
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Item Name</label>
                    <div id="ItemIDDiv">
                        @Html.DropDownListFor(model => model.ItemID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtItemID", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Category</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(m => m.CategoryID, ViewBag.Category as SelectList, new { @id = "CategoryID", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Brand</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(m => m.BrandID, ViewBag.Brand as SelectList, new { @id = "BrandID", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Item</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(model => model.UrduName, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtCode", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <div class="row">
                <section class="col col-md-12">
                    <label class="checkbox pull-right checkBoxLbl">
                        <input id="DateCheckbox" type="checkbox" name="DateCheckbox"><i></i>
                        <span style="">Date</span>
                    </label>
                </section>
            </div>
            <section class="col-md-6 dateSection" hidden>
                <div style="padding:3px;">
                    <label>From</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="FromDate" name="FromDate" required />
                    </label>
                </div>
            </section>
            <section class="col-md-6 dateSection" hidden>
                <div style="padding:3px;">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="ToDate" name="ToDate" required />
                    </label>
                </div>
            </section>
        </fieldset>
        <footer>
            <button formtarget="_blank" type="submit" class="btn btn-labeled btn-primary pull-right">
                GENERATE REPORT
            </button>
        </footer>
    }
</div>
<script type="text/javascript">

    function formatItemList(repo) {
        if (repo.loading) {
            return repo.text;
        }
        var $container = $(
            "<div class='select2-result-repository clearfix'>" +
                "<span style='font-weight:bold'>" + repo.text + "</span> <span style='padding-left:10px;color:blue'>" + repo.description + "</span>" +
             "</div>"
        );
        return $container;
    }

    $('#DateCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('.dateSection').removeAttr("hidden");
        }
        else {
            $('.dateSection').attr("hidden", "hidden");
        }
    })
    $(document).ready(function () {
        $('#CategoryID').select2();
        $('#BrandID').select2();
        var pageSize = 20;
        var optionListUrl = '@Url.Action("GetOptionList", "ItemComboListName")';
        $('#txtItemID').select2({
            ajax: {
                delay: 150,
                url: optionListUrl,
                dataType: 'json',

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        searchTerm: params.term,
                        pageSize: pageSize,
                        pageNumber: params.page
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.Results,
                        pagination: {
                            more: (params.page * pageSize) < data.Total
                        }
                    };
                }
            },
            //placeholder: "-- Select Item--",
            minimumInputLength: 0,
            allowClear: true,
        });
        //////////////////////Code///////////////////////////
        var pageSizeCode = 20;
        var optionListUrlCode = '@Url.Action("GetOptionList", "ItemComboList")';
        $('#txtCode').select2({
            ajax: {
                delay: 150,
                url: optionListUrlCode,
                dataType: 'json',

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        searchTerm: params.term,
                        pageSize: pageSizeCode,
                        pageNumber: params.page
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.Results,
                        pagination: {
                            more: (params.page * pageSizeCode) < data.Total
                        }
                    };
                }
            },
            //placeholder: "-- Select Item--",
            minimumInputLength: 0,
            allowClear: true, templateResult: formatItemList,
        });
        GetTodayDate();
    });
    function GetTodayDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        $('#FromDate').val(today);
        $('#ToDate').val(today);
    }
    //$('#DetailCode').change(function () {
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('border-color', '#CCCCCC');
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('color', 'black');
    //})
    $('#itemsRegisterForm').on('submit', function (e) {
        var check = 0;
        $("#txtItemID :selected").map(function (i, el) {
            check += 1;
        });
        $("#txtCode :selected").map(function (i, el) {
            check += 1;
        });
        if (check == 0) {
            alert("Please select item or code.");
            return false;
        }
    })
</script>
