@model POS.Models.clsItem
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="ItemListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Items List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="itemListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Item </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("insertupdateitem", "item", FormMethod.Post, new { id = "itemForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Item" id="btnAddItem" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveItem" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Items List" id="btnItemList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ItemListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshItem" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitItem" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveItem" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Items List" id="btnItemList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ItemListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshItem" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitItem" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="row" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>Item Name</label>
                                        <input type="hidden" id="ItemID" value="0" />
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Item Name" name="ItemName" id="ItemName" required />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Item Code</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Item Code" name="UrduName" id="UrduName" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Unit of Measure</label>
                                        <label class="select">
                                            <div id="UomIdDiv">
                                                @Html.DropDownListFor(model => model.UomId, ViewBag.Unit as SelectList, new { @style = "width:100%" })
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>Urdu Description</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-barcode"></i>
                                            <input type="text" placeholder="Urdu Description" name="Barcode" id="Barcode" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Brand</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.BrandID, ViewBag.Brand as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>Category</label>
                                        <label class="select">
                                            <div id="CategoryIdDiv">
                                                @Html.DropDownListFor(model => model.CategoryID, ViewBag.Category as SelectList, new { @style = "width:100%" })
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Sub-Category</label>
                                        <label class="select">
                                            <div id="CategoryIdDiv">
                                                @Html.DropDownListFor(model => model.SubCategoryID, ViewBag.SubCategory as SelectList, new { @style = "width:100%" })
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-2" id="CostPriceDiv">
                                        <label>Cost Price</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-money-bill-alt"></i>
                                            <input type="text" placeholder="Cost Price" name="CostPrice" id="CostPrice" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Sale Price</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-money-bill-alt"></i>
                                            <input type="text" placeholder="Sale Price" name="SalePrice" id="SalePrice" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Min Sale Price</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-flash"></i>
                                            <input type="text" placeholder="Min Sale Price" name="MinSalePrice" id="MinSalePrice" />
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-2">
                                        <label>Min Level</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-flash"></i>
                                            <input type="text" placeholder="Min Level" name="MinLevel" id="MinLevel" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Max Level</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-flash"></i>
                                            <input type="text" placeholder="Max Level" name="MaxLevel" id="MaxLevel" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Min Order</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-flash"></i>
                                            <input type="text" placeholder="Min Order" name="MinOrder" id="MinOrder" />
                                        </label>
                                    </div>
                                    <section class="col col-2 StatusSection">
                                        <label class="checkbox pull-left" style="margin-top:22px">
                                            <input id="Status" type="checkbox" name="Status"><i></i>
                                            Active
                                        </label>
                                    </section>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-2"></section>
                                    <section class="col col-md-8">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Item" id="btnDeleteItem" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-2"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        //$(document).on('focus', '.select2', function (e) {
        //    if (e.originalEvent) {
        //        $(this).siblings('select').select2('open');
        //    }
        //});
        //$(document).on("select2:close", '.select2-hidden-accessible', function () {  $(this).focus(); });
        $(document).ready(function () {
            $('#UomId').select2();
            $('#CategoryID').select2();
            $('#SubCategoryID').select2();
            $('#BrandID').select2();
            $('#UomId').val(null).trigger('change');
            $('#CategoryID').val(null).trigger('change');
            $('#SubCategoryID').val(null).trigger('change');
            $('#BrandID').val(null).trigger('change');
            $('#itemForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    ItemName: {
                        required: true
                    },
                    UomId: {
                        required: true
                    },
                    CategoryID: {
                        required: true
                    },
                    SubCategoryID: {
                        required: true
                    },
                    BrandID: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    ItemName: {
                        required: 'Item Name is required.'
                    },
                    UomId: {
                        required: 'Unit of Measure is required.'
                    },
                    CategoryID: {
                        required: 'Category is required.'
                    },
                    SubCategoryID: {
                        required: 'Sub-Category is required.'
                    },
                    BrandID: {
                        required: 'Brand is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddItem').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#ItemID').val(0);
            $('#UomId').select().enable(true);
            $('#CategoryID').select().enable(true);
            $('#SubCategoryID').select().enable(true);
            $('#BrandID').select().enable(true);
            $('#ItemName').prop("disabled", false);
            $('#UrduName').prop("disabled", false);
            $('#Barcode').prop("disabled", false);
            $('#CostPrice').prop("disabled", false);
            $('#SalePrice').prop("disabled", false);
            $('#MinSalePrice').prop("disabled", false);
            $('#MinLevel').prop("disabled", false);
            $('#MaxLevel').prop("disabled", false);
            $('#MinOrder').prop("disabled", false);
            $('#UomId').val(null).trigger('change');
            $('#CategoryID').val(null).trigger('change');
            $('#SubCategoryID').val(null).trigger('change');
            $('#BrandID').val(null).trigger('change');
            $('#ItemName').val('');
            $('#UrduName').val('');
            $('#Barcode').val('');
            $('#CostPrice').val('');
            $('#SalePrice').val('');
            $('#MinSalePrice').val('');
            $('#MinLevel').val('');
            $('#MaxLevel').val('');
            $('#MinOrder').val('');
            $('#btnSaveItem').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");

            if ($('#CanDelete').val() == 1) {
                $('#CostPriceDiv').show();
            } else {
                $('#CostPriceDiv').hide();
            }
        }
        $('#btnRefreshItem').click(function () {
            location.reload();
        })
        $('#btnItemList').click(function () {
            $('#itemListDiv').load('@Url.Action("itemslist", "item")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#ItemID').val(0);
            $('#UomId').select().enable(false);
            $('#CategoryID').select().enable(false);
            $('#SubCategoryID').select().enable(false);
            $('#BrandID').select().enable(false);
            $('#ItemName').prop("disabled", true);
            $('#UrduName').prop("disabled", true);
            $('#Barcode').prop("disabled", true);
            $('#CostPrice').prop("disabled", true);
            $('#SalePrice').prop("disabled", true);
            $('#MinSalePrice').prop("disabled", true);
            $('#MinLevel').prop("disabled", true);
            $('#MaxLevel').prop("disabled", true);
            $('#MinOrder').prop("disabled", true);
            $('#UomId').val(null).trigger('change');
            $('#CategoryID').val(null).trigger('change');
            $('#SubCategoryID').val(null).trigger('change');
            $('#BrandID').val(null).trigger('change');
            $('#ItemName').val('');
            $('#UrduName').val('');
            $('#Barcode').val('');
            $('#CostPrice').val('');
            $('#SalePrice').val('');
            $('#MinSalePrice').val('');
            $('#MinLevel').val('');
            $('#MaxLevel').val('');
            $('#MinOrder').val('');
            $('#btnSaveItem').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
             $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            if ($('#CanDelete').val() == 1) {
                $('#CostPriceDiv').show();
            } else {
                $('#CostPriceDiv').hide();
            }

            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#itemForm').on('submit', function (e) {
            if (!$("#itemForm").valid()) {
                return false;
            }
            $('#btnSaveItem').prop('disabled', true);
            var itemId = $('#ItemID').val();
            var itemName = $('#ItemName').val();
            var urduName = $('#UrduName').val();
            var barcode = $('#Barcode').val();
            var uomId = $('#UomId').val();
            var categoryId = $('#CategoryID').val();
            var subcategoryId = $('#SubCategoryID').val();
            var brandId = $('#BrandID').val();
            var costPrice = $('#CostPrice').val();
            var salePirce = $('#SalePrice').val();
            var minsalePirce = $('#MinSalePrice').val();
            var minLevel = $('#MinLevel').val();
            var maxLevel = $('#MaxLevel').val();
            var minOrder = $('#MinOrder').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var itemForm =
            {
                ItemID: itemId,
                ItemName: itemName,
                UrduName: urduName,
                Barcode: barcode,
                UomId: uomId,
                CategoryID: categoryId,
                SubCategoryID: subcategoryId,
                BrandID: brandId,
                CostPrice: costPrice,
                SalePrice: salePirce,
                MinSalePrice:minsalePirce,
                MinLevel: minLevel,
                MaxLevel: maxLevel,
                MinOrder: minOrder,
                Status: stringStatus
            }
            var url = $('#itemForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'item': itemForm }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Item Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveItem').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteItem').click(function () {
            var itemId = $('#ItemID').val();
            DeleteItem(itemId);
        })
        function DeleteItem(id) {
            var a = $.confirm({
                title: 'Delete Item',
                content: 'Are you sure u want to delete this item?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/item/deleteitem/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}