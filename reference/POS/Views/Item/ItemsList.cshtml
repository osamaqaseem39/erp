<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableItem').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableItem'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/item/GetAllItems",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ItemID", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ItemListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "ItemName", "name": "ItemName", "autoWidth": true, "orderable": true, },
                    { "data": "UrduName", "name": "UrduName", "autoWidth": true, "orderable": true, },
                    { "data": "Barcode", "name": "Barcode", "autoWidth": true, "orderable": true, },
                    { "data": "UnitName", "name": "UnitName", "autoWidth": true, "orderable": true, },
                    { "data": "CategoryName", "name": "CategoryName", "autoWidth": true, "orderable": true, },
                    { "data": "SubCategoryName", "name": "SubCategoryName", "autoWidth": true, "orderable": true, },
                    { "data": "BrandName", "name": "BrandName", "autoWidth": true, "orderable": true, },
                    { "data": "CostPrice", "name": "CostPrice", "autoWidth": true, "orderable": true, },
                    { "data": "SalePrice", "name": "SalePrice", "autoWidth": true, "orderable": true, },
                    { "data": "MinSalePrice", "name": "MinSalePrice", "autoWidth": true, "orderable": true, },
                    { "data": "MinLevel", "name": "MinLevel", "autoWidth": true, "orderable": true, },
                    { "data": "MaxLevel", "name": "MaxLevel", "autoWidth": true, "orderable": true, },
                    { "data": "MinOrder", "name": "MinOrder", "autoWidth": true, "orderable": true, },
                    { "data": "Status", "name": "Status", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    
            ]
        });
        oTable = $('#myTableItem').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var itemId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/item/GetItemById/" + itemId,
                dataType: 'json',
                success: function (response) {
                    $('#UomId').select().enable(true);
                    $('#CategoryID').select().enable(true);
                    $('#BrandID').select().enable(true);
                    $('#ItemName').prop("disabled", false);
                    $('#UrduName').prop("disabled", false);
                    $('#Barcode').prop("disabled", false);
                    $('#CostPrice').prop("disabled", false);
                    $('#SalePrice').prop("disabled", false);
                    $('#MinSalePrice').prop("disabled", false);
                    $('#MinLevel').prop("disabled", false);
                    $('#MaxLevel').prop("disabled", false);
                    $('#MinOrder').prop("disabled", false);

                    $('#UomId').val(response.data.UomId).trigger('change');
                    $('#CategoryID').val(response.data.CategoryID).trigger('change');
                    $('#SubCategoryID').val(response.data.SubCategoryID).trigger('change');
                    $('#BrandID').val(response.data.BrandID).trigger('change');
                    $('#ItemID').val(response.data.ItemID);
                    $('#ItemName').val(response.data.ItemName);
                    $('#UrduName').val(response.data.UrduName);
                    $('#Barcode').val(response.data.Barcode);
                    $('#CostPrice').val(response.data.CostPrice);
                    $('#SalePrice').val(response.data.SalePrice);
                    $('#MinSalePrice').val(response.data.MinSalePrice);
                    $('#MinLevel').val(response.data.MinLevel);
                    $('#MaxLevel').val(response.data.MaxLevel);
                    $('#MinOrder').val(response.data.MinOrder);
                    $('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveItem').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('#CostPriceDiv').show();
                        $('.deleteRow').removeAttr("hidden");
                    } else {
                        $('#CostPriceDiv').hide();
                    }
                }
            })
        })
        $('#btnSearchItemMain').click(function () {
            SearchItem();
        });
        $('#txtSearchItem').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchItem");
            if (BElement.html().trim() == 'Item Name') {
                oTable.columns(0).search($('#txtSearchItem').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Urdu Name') {
                oTable.columns(1).search($('#txtSearchItem').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Unit') {
                oTable.columns(2).search($('#txtSearchItem').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Category') {
                oTable.columns(3).search($('#txtSearchItem').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Brand') {
                oTable.columns(4).search($('#txtSearchItem').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(5).search($('#txtSearchItem').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshItem').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchItem").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchItem").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
