@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        function EnableDisableFields() {
            //$('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.DeleteSection').attr("hidden", "hidden");
        }
        $(document).ready(function () {
            EnableDisableFields();
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };

            $('#myTableOpeningBalance').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableOpeningBalance'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/smshistory/GetAllActiveSms",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                    {
                        "data": "SmsLogId", "width": "60px", "class": "Acenter", "orderable": false, "render": function (data) {
                            if ($('#CanSave').val() == 1) {
                                return '<a href="javascript:void(0);"  class="btn btn-primary sendSingleMessageBtn" data-value="' + data + '"  title="Resend" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-envelope" style="margin-left:1px;margin-top:5px"></i></a>&nbsp;' +
                                        '<a href="javascript:void(0);"  class="btn btn-danger deleteMessageBtn" data-value="' + data + '"  title="Cancel" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;border-radius:2px "><i class="fa fa-times" style="margin-left:1px;margin-top:5px"></i></a>';
                            }
                            else {
                                return '';
                            }
                        }
                    },
                    {
                        "data": "SaveDateTime", "class": "Acenter", "orderable": false, 'render': function (date) {
                            if (date != null) {
                                var date = new Date(parseInt(date.substr(6)));
                                var day = date.getDate();
                                var month = date.getMonth() + 1;
                                if (parseFloat(day) < 10) {
                                    day = "0" + day;
                                }
                                if (parseFloat(month) < 10) {
                                    month = "0" + month;
                                }
                                return day + "-" + month + "-" + date.getFullYear();
                            }
                            else {
                                return "";
                            }
                        }
                    },
                        { "data": "CellNo", "name": "CellNo", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        { "data": "DetailName", "name": "DetailName", "autoWidth": true, "orderable": true, },
                        { "data": "ComputerNo", "name": "ComputerNo", "class": "Acenter", "autoWidth": true, "orderable": true, },
                        { "data": "SmsMessage", "name": "SmsMessage", "autoWidth": true, "orderable": true, },

                ]
            });
            oTable = $('#myTableOpeningBalance').DataTable();
        });

        $(document).on('click', '.sendSingleMessageBtn', function (e) {
            e.preventDefault();
            var smsLogId = $(this).attr("data-value");
                $.ajax({
                    url: '/sms/SendSmsFromHistory/',
                    type: "POST",
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ 'smsLogId': smsLogId }),
                    success: function (data) {
                        if (data.status == true) {
                            oTable.ajax.reload(null, false);
                        }
                        else {
                            alert(data.message);
                        }
                    }
                })
        })
        $(document).on('click', '.deleteMessageBtn', function (e) {
            e.preventDefault();
            var smsLogId = $(this).attr("data-value");
            $.ajax({
                url: '/smshistory/CancelMessage/',
                type: "POST",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'smsLogId': smsLogId }),
                success: function (data) {
                    if (data.status == true) {
                        oTable.ajax.reload(null, false);
                    }
                    else {
                        alert(data.message);
                    }
                }
            })
        })
        $('#btnSendAll').on('click', function (e) {
            $('#btnSendAll').prop('disabled', true);
            $.ajax({
                type: "POST",
                url: "/sms/SendSmsFromHistory",
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'smsLogId': 0 }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Sms Sent Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                            oTable.ajax.reload(null, false);
                        });
                    }
                    else {
                        alert(data.message);
                        $('#btnSendAll').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnSearchOpeningBalance').click(function () {
            SearchItem();
        });
        $('#txtSearchOpeningBalance').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchOpeningBalanceOpeningBalance");
            if (BElement.html().trim() == 'Account Name') {
                oTable.columns(0).search($('#txtSearchOpeningBalance').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        $("#ulSearchOpeningBalanceOpeningBalance").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchOpeningBalanceOpeningBalance").html($this.data("value"));
        })//
        $('#btnRefreshDefaultDetail').click(function () {
            location.reload();
        })
        $('#btnRefreshOpeningBalance').click(function () {
            oTable.ajax.reload(null, false);
        })
        $(document).on('keypress', '.Debit', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $(document).on('keypress', '.Credit', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
}