@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#userForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    UserName: {
                        required: true
                    },
                    Password: {
                        required: true
                    },
                    Email: {
                        email: true,
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    UserName: {
                        required: 'User Name is required.'
                    },
                    Password: {
                        required: 'Password is required.'
                    },
                    Email: {
                        email: 'Please enter a valid email address.',
                        required: 'Email is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddUser').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#UserID').val(0);
            $('#UserName').prop("disabled", false);
            $('#Password').prop("disabled", false);
            $('#Description').prop("disabled", false);
            $('#Email').prop("disabled", false);
            //$('#Secure').prop("disabled", false);
            $('#UserName').val('');
            $('#Password').val('');
            $('#Description').val('');
            $('#Email').val('');
            //$('#Secure').prop("checked", false);
            $('#btnSaveUser').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#roleTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '44%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
            $('.ChangePasswordCheckbox').attr("hidden", "hidden");
        }
        function ClearFormFields() {
            $('#UserID').val(0);
            $('#UserName').prop("disabled", true);
            $('#Password').prop("disabled", true);
            $('#Description').prop("disabled", true);
            $('#Email').prop("disabled", true);
            //$('#Secure').prop("disabled", true);
            $('#UserName').val('');
            $('#Password').val('');
            $('#Description').val('');
            $('#Email').val('');
            //$('#Secure').prop("checked", false);
            $('#btnSaveUser').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#roleTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.StatusSection').attr("hidden", "hidden");
            $('.ChangePasswordCheckbox').attr("hidden", "hidden");
        }
        $('#ChangePassword').change(function () {
            if ($(this).is(":checked")) {
                $('#Password').prop("disabled", false);
            }
            else {
                $('#Password').prop("disabled", true);
            }
        })
        $('#btnRefreshUser').click(function () {
            location.reload();
        })
        $('#btnUserList').click(function () {
            $('#userListDiv').load('@Url.Action("userslist", "user")')
        })
        $('#btnAddRole').click(function () {
            var userId = $('#UserID').val();
            $('#assignRoleDiv').load('@Url.Action("assignuserrole", "user")?userId=' + userId)
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });

        $('#userForm').on('submit', function (e) {
            if (!$("#userForm").valid()) {
                return false;
            }
            $('#btnSaveUser').prop('disabled', true);
            var userId = $('#UserID').val();
            var userName = $('#UserName').val();
            var password = $('#Password').val();
            var email = $('#Email').val();
            var description = $('#Description').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            //var secureInt = 0;
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            //var secure = $('#Secure').is(':checked');
            //if (secure == true) {
            //    secureInt = 1;
            //}
            //else {
            //    secureInt = 0;
            //}
            var changePasswod = $('#ChangePassword').is(':checked');
            var changePasswordInt = 0;
            if (changePasswod == true) {
                changePasswordInt = 1;
            }
            else {
                changePasswordInt = 0;
            }
            var userForm =
            {
                UserID: userId,
                UserName: userName,
                Password: password,
                Email: email,
                Description: description,
                Status: stringStatus,
                ChangePassword: changePasswordInt,
                //Secure: secureInt
            }
            var url = $('#userForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'user': userForm }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'User Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveUser').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteUser').click(function () {
            var userId = $('#UserID').val();
            DeleteUser(userId);
        })
        function DeleteUser(id) {
            var a = $.confirm({
                title: 'Delete User',
                content: 'Are you sure u want to delete this user?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/user/deleteuser/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}