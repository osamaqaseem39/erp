<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableUser').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableUser'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/user/GetAllUsers",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "UserID", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#UserListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "Username", "name": "Username", "autoWidth": true, "orderable": true, },
                    { "data": "Email", "name": "Email", "autoWidth": true, "orderable": true, },
                    { "data": "Description", "name": "Description", "autoWidth": true, "orderable": true, },
                    { "data": "Status", "name": "Status", "class": "Acenter", "autoWidth": true, "orderable": true, },

            ]
        });
        oTable = $('#myTableUser').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var userId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/user/GetUserById/" + userId,
                dataType: 'json',
                success: function (response) {
                    //response.data.ReportType;
                    $('#UserName').prop("disabled", false);
                    //$('#Password').prop("disabled", false);
                    $('#Description').prop("disabled", false);
                    $('#Email').prop("disabled", false);
                    //$('#Secure').prop("disabled", false);
                    $('#UserID').val(response.data.UserID);
                    $('#UserName').val(response.data.Username);
                    $('#Description').val(response.data.Description);
                    $('#Password').val(response.data.Password);
                    $('#Email').val(response.data.Email);
                    $('.StatusSection').removeAttr("hidden");
                    $('.ChangePasswordCheckbox').removeAttr("hidden");
                    $('#ChangePassword').prop("checked", false);
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    //if (response.data.Secure == 1) {
                    //    $('#Secure').prop("checked", true);
                    //}
                    //else {
                    //    $('#Secure').prop("checked", false);
                    //}
                    $('#btnSaveUser').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#roleTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#roleTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '44%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchUser').click(function () {
            SearchItem();
        });
        $('#txtSearchUser').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryUser");
            if (BElement.html().trim() == 'Username') {
                oTable.columns(0).search($('#txtSearchUser').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Email') {
                oTable.columns(1).search($('#txtSearchUser').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Description') {
                oTable.columns(2).search($('#txtSearchUser').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(3).search($('#txtSearchUser').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshUser').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchUser").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryUser").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
