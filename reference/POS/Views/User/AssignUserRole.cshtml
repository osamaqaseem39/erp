<script type="text/javascript">
    $('.selectAllBtn').click(function () {
        $('.roleRows').find('input[type=checkbox]').prop('checked', true);
    })
    $('.clearAllBtn').click(function () {
        $('.roleRows').find('input[type=checkbox]').prop('checked', false);
    })
    $('.saveRoleBtn').click(function () {
        var data = [];
        $('.roleRows').each(function () {
            var menuName = $(this).find('.MenuName').val();
            var userId = $(this).find('.RoleUserID').val();
            var showMain = $(this).find('.ShowMain').is(':checked');
            var showSave = $(this).find('.ShowSave').is(':checked');
            var showChange = $(this).find('.ShowChange').is(':checked');
            var showDelete = $(this).find('.ShowDelete').is(':checked');
            var showMainInt = 0;
            var showSaveInt = 0;
            var showChangeInt = 0;
            var showDeleteInt = 0;
            if (showMain == true) {
                showMainInt = 1;
            }
            else {
                showMainInt = 0;
            }
            if (showSave == true) {
                showSaveInt = 1;
            }
            else {
                showSaveInt = 0;
            }
            if (showChange == true) {
                showChangeInt = 1;
            }
            else {
                showChangeInt = 0;
            }
            if (showDelete == true) {
                showDeleteInt = 1;
            }
            else {
                showDeleteInt = 0;
            }
            var alldata = {
                'UserID': userId,
                'MenuName': menuName,
                'showMain': showMainInt,
                'showSave': showSaveInt,
                'showChange': showChangeInt,
                'showDelete': showDeleteInt
            }
            data.push(alldata);
        });
        var allData = JSON.stringify(data);
        $.ajax({
            type: "POST",
            url: "/user/InsertUpdateUserRole/",
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ 'data': allData }),
            success: function (data) {
                if (data.status == true) {
                    $('.alertDiv2').html('<div class="alert alert-success success-alert2" style="margin-top:15px;">' +
                                            '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                            ' <strong>Success! </strong>' +
                                            'Roles Assigned Succesfully.' +
                                        '</div>');
                    $(".success-alert2").fadeTo(1000, 500).slideUp(500, function () {
                        $(".success-alert2").slideUp(500);
                        $('.alertDiv2').html('');
                    });
                }
                else {
                    alert(data.message);
                }
            }
        })
    })
</script>
