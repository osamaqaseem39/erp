                                            </table>
                                        </div>
                                        <div class="col col-md-4">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 20%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="BrandCheckbox" type="checkbox" name="BrandCheckbox"><i></i>
                                                            <span style="font-size:12px">Brand</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 80%; padding-left: 3px; " id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            @Html.DropDownListFor(model => model.BrandID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtBrandID", @disabled = "disabled" })
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row" style="margin-top:10px">
                                        <div class="col col-md-3">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 7%; padding-right: 3px; padding-left: 7px" id=""></td>
                                                    <td style="width: 10%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="DateCheckbox" type="checkbox" name="DateCheckbox"><i></i>
                                                            <span style="font-size:11px">&nbsp;</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 83%; padding-right: 3px; padding-left: 0px" id="">
                                                       
                                                        <label style="font-size:13px">Date</label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-5">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 19.5%; padding-right: 3px; padding-left: 7px" id="">
                                                        <label class="checkbox pull-left" style="margin-top:2px">
                                                            <input id="CodeCheckbox" type="checkbox" name="CodeCheckbox"><i></i>
                                                            <span style="font-size: 12px">Code</span>
                                                        </label>
                                                    </td>
                                                    <td style="width: 80.5%; padding-left: 3px; " id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            @Html.DropDownListFor(model => model.UrduName, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtCode", @disabled = "disabled" })
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-4">
                                        </div>
                                    </div>
                                    <div class="row" style="margin-top:10px;padding-left:40px" id="DatesRow" hidden>
                                        <div class="col col-md-3">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 10%; padding-right: 3px; padding-left: 7px" id=""></td>
                                                    <td style="width: 90%; padding-right: 3px; padding-left: 7px" id="">
