                                                                <option value="Sale">Sale</option>
                                                                <option value="Sale Return">Sale Return</option>
                                                            </select>
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col col-md-5">
                                            <table class="" style="">
                                                <tr>
