@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DetailCode').select2();
            $('#DetailCode').val(null).trigger('change');
            $('#CashCreditType').val('');
            var pageSize = 20;
            var optionListUrl = '@Url.Action("GetOptionList", "ItemComboList")';

            $('#txtItemID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrl,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSize,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSize) < data.Total
                            }
                        };
                    }
                },
                minimumInputLength: 0,
                allowClear: true,
            });
            ///////////////////////Item///////////////////////////////
            var pageSizeCashCustomer = 20;
            var optionListUrlCashCustomer = '@Url.Action("GetOptionList", "CashCustomerComboList")';
            $('#txtCashCustomerName').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlCashCustomer,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeCashCustomer,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeCashCustomer) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Brand///////////////////////////
            var pageSizeBrand = 20;
            var optionListUrlBrand = '@Url.Action("GetOptionList", "BrandComboList")';
            $('#txtBrandID').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlBrand,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeBrand,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeBrand) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            //////////////////////Code///////////////////////////
            var pageSizeCode = 20;
            var optionListUrlCode = '@Url.Action("GetOptionList", "CodeComboList")';
            $('#txtCode').select2({
                ajax: {
                    delay: 150,
                    url: optionListUrlCode,
                    dataType: 'json',

                    data: function (params) {
                        params.page = params.page || 1;
                        return {
                            searchTerm: params.term,
                            pageSize: pageSizeCode,
                            pageNumber: params.page
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.Results,
                            pagination: {
                                more: (params.page * pageSizeCode) < data.Total
                            }
                        };
                    }
                },
                //placeholder: "-- Select Item--",
                minimumInputLength: 0,
                allowClear: true,
            });
            GetTodayDate();
        });
        $('#CustomerCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#DetailCode').prop("disabled", false);
            }
            else {
                $('#DetailCode').prop("disabled", true);
                $('#DetailCode').val(null).trigger('change');
            }
        })
        $('#ItemCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtItemID').prop("disabled", false);
            }
            else {
                $('#txtItemID').prop("disabled", true);
                $('#txtItemID').val(null).trigger('change');
            }
        })
        $('#CashCustomerNameCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtCashCustomerName').prop("disabled", false);
            }
            else {
                $('#txtCashCustomerName').prop("disabled", true);
                $('#txtCashCustomerName').val('');
            }
        })
        $('#CodeCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtCode').prop("disabled", false);
            }
            else {
                $('#txtCode').prop("disabled", true);
                $('#txtCode').val('');
            }
        })
        $('#BrandCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#txtBrandID').prop("disabled", false);
            }
            else {
                $('#txtBrandID').prop("disabled", true);
                $('#txtBrandID').val('');
            }
        })
        $('#CashCreditTypeCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#CashCreditType').prop("disabled", false);
            }
            else {
                $('#CashCreditType').prop("disabled", true);
                $('#CashCreditType').val('');
            }
        })
        $('#DateCheckbox').change(function () {
            if ($(this).is(":checked")) {
                $('#DatesRow').removeAttr("hidden");
            }
            else {
                $('#DatesRow').attr("hidden", "hidden");
            }
        })
        $('#btnSearch').click(function () {
            var type = $('#Type').val();
            var customerCheckbox = $('#CustomerCheckbox').is(":checked");
            var customerId = $('#DetailCode').val();
            var itemCheckbox = $('#ItemCheckbox').is(":checked");
            var itemId = $('#txtItemID').val();
            var cashCustomerNameCheckbox = $('#CashCustomerNameCheckbox').is(":checked");
            var cashCustomerName = $('#txtCashCustomerName').val();

            var cashCreditTypeCheckbox = $('#CashCreditTypeCheckbox').is(":checked");
            var cashCreditType = $('#CashCreditType').val();

            var brandCheckbox = $('#BrandCheckbox').is(":checked");
            var brand = $('#txtBrandID').val();

            var codeCheckbox = $('#CodeCheckbox').is(":checked");
            var code = $('#txtCode').val();

            var dateCheckbox = $('#DateCheckbox').is(":checked");
            var fromDate = $('#FromDate').val();
            var toDate = $('#ToDate').val();
            $.ajax({
                type: "POST",
                url: "/salepurchase/SetSessions/",
                dataType: 'json',
                data: {
                    'type': type, 'customerCheckbox': customerCheckbox, 'customerId': customerId,
                    'itemCheckbox': itemCheckbox, 'itemId': itemId, 'dateCheckbox': dateCheckbox,
                    'fromDate': fromDate, 'toDate': toDate, 'cashCustomerCheckbox': cashCustomerNameCheckbox,
                    'cashCustomerName': cashCustomerName, 'cashCreditTypeCheckbox': cashCreditTypeCheckbox, 'cashCreditType': cashCreditType,
                    'brandCheckbox': brandCheckbox, 'brandId': brand, 'codeCheckbox': codeCheckbox, 'code': code,
                },
                success: function (response) {
                    getItems();
                    $('.showItemsBtn').prop("disabled", true);
                }
            })
        })
        $('#btnPrint').click(function () {
            var type = $('#Type').val();
            var customerCheckbox = $('#CustomerCheckbox').is(":checked");
            var customerId = $('#DetailCode').val();
            var itemCheckbox = $('#ItemCheckbox').is(":checked");
            var itemId = $('#txtItemID').val();
            var cashCustomerNameCheckbox = $('#CashCustomerNameCheckbox').is(":checked");
            var cashCustomerName = $('#CashCustomerName').val();

            var cashCreditTypeCheckbox = $('#CashCreditTypeCheckbox').is(":checked");
            var cashCreditType = $('#CashCreditType').val();

            var brandCheckbox = $('#BrandCheckbox').is(":checked");
            var brand = $('#Brand').val();

            var codeCheckbox = $('#CodeCheckbox').is(":checked");
            var code = $('#Code').val();

            var dateCheckbox = $('#DateCheckbox').is(":checked");
            var fromDate = $('#FromDate').val();
            var toDate = $('#ToDate').val();
            $.ajax({
                type: "POST",
                url: "/salepurchase/SetSessions/",
                dataType: 'json',
                data: {
                    'type': type, 'customerCheckbox': customerCheckbox, 'customerId': customerId,
                    'itemCheckbox': itemCheckbox, 'itemId': itemId, 'dateCheckbox': dateCheckbox,
                    'fromDate': fromDate, 'toDate': toDate, 'cashCustomerCheckbox': cashCustomerNameCheckbox,
                    'cashCustomerName': cashCustomerName, 'cashCreditTypeCheckbox': cashCreditTypeCheckbox, 'cashCreditType': cashCreditType,
                    'brandCheckbox': brandCheckbox, 'brand': brand, 'codeCheckbox': codeCheckbox, 'code': code,
                },
                success: function (response) {
                    window.open("/salepurchase/printSaleHistorylookup", "_blank");
                    //getItems();
                    //$('.showItemsBtn').prop("disabled", true);
                }
            })
        })
        $('#btnRefresh').click(function () {
            location.reload();
        })
        function getItems() {
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };
            $('#myTableMinStockLevel').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableMinStockLevel'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "pageLength": 20,
                "bInfo": true,
                "bDestroy": true,
                "stateSave": true,
                "lengthMenu": [[10, 20, 50,100,200, -1], [10, 20, 50,100,200, "All"]],
                "ajax": {
                    "url": "/salepurchase/GetAllItems",
                    "type": "POST",
                    "datatype": "json",
