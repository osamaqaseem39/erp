                                            <th data-class="expand" style="text-align: center; width: 90px"><i class="fa fa-fw fa-calendar text-muted"></i> Date</th>
                                            <th data-hide="" style="text-align: center; width: 160px"><i class="fa fa-fw fa-hashtag text-muted"></i> Item Name</th>
                                            <th data-hide="phone" style="text-align: right; width: 50px"><i class="fa fa-fw fa-sort-amount-up text-muted"></i> Qty</th>
                                            <th data-hide="" style="text-align: right; width: 50px; "><i class="fa fa-fw fa-sort-amount-up text-muted"></i> Rate</th>
                                            <th data-hide="phone" style="text-align:right;width:110px"><i class="fa fa-fw fa-sort-amount-up text-muted"></i> Gross Value</th>
