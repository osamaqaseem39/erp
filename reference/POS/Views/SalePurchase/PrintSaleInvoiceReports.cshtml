<!-- widget content -->
@model List<POS.Models.clsInvoice>
    @{
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-shopping-cart fa-fw "></i>
                    Sale Invoice
                    <span>
                        >
                        Sale Invoice Report
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> Sale Invoice Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
    <input type="hidden" name="FileName" id="FileName" value="SaleInvoicesReport" />
                        <a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("salereportindex", "salepurchase")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                            Back
                        </a>
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
@for (int k = 0; k < Model.Count; k++)
{
                        <div id="printable-content" class="panel rpt" style="width:800px;padding: 1px; border-radius: 0px; ">
                            <table style="padding-top: 37px;padding-left: 37px;padding-right: 37px;font-size:18px !important" class="headTable oldCss">
                                <tr>
                                    <td colspan="99">
                                        @if (!(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessName"].ToString()))
                                        || !(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessAddress"].ToString())))
                                        {
                                            <table class="purchaseHeading oldCss">
                                                <tbody>
                                                    <tr>
                                                        <th style="  text-align: left; padding-bottom: 15px;padding-right:15px;padding-top:10px;" colspan="12" class="pull-left businssName businssName22">
                                                            <div style="font-weight: bold;font-size: 20px;">@System.Web.HttpContext.Current.Application["BusinessName"]</div>
                                                            <div style="font-size: 16px;margin-left:2px">
                                                                @System.Web.HttpContext.Current.Application["BusinessAddress"]
                                                            </div>
                                                        </th>
                                                        @*
                                                            <th style="font-weight: bold; font-size: 20px; text-align: right;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-right">
                                                                <img src="@Url.Action(" getbusinesslogo", "Sale" , new { id=Convert.ToInt32(Model.SaleInvoice[0].BusinessId) })" style="height:70px;width:70px" alt="Business Logo">
                                                            </th>*@
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <table style="" class="borderLineTable oldCss">
                                                <tr>
                                                    <td style="border-bottom:1px solid black;"></td>
                                                </tr>
                                            </table>
                                        }
                                        <table style="margin-bottom: 30px;margin-top:3px;" class="purchaseHeading oldCss">
                                            <tbody>
                                                <tr>
                                                    @if (Model[k].InvoicesList[0].InvoiceType == 1)
                                                    {
                                                        <th class="Font18 accountName" style="font-weight: bold; font-size: 14px; text-align: left;width:50%">@Model[k].InvoicesList[0].DetailName</th>
                                                    }
                                                    else
                                                    {
                                                        <th class="Font18 accountName" style="font-weight: bold; font-size: 14px; text-align: left; width: 50%">@Model[k].InvoicesList[0].CashCustomerName</th>
                                                    }
                                                    <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Invoice No: </th>
                                                    <th class="Font17" style="font-weight: normal; text-align: left; width: 18%; font-size: 16px; padding-left: 15px; ">@Model[k].InvoicesList[0].ComputerNo</th>
                                                </tr>
                                                <tr>
                                                    @if (!(string.IsNullOrEmpty(Model[k].InvoicesList[0].Address)))
                                                    {
                                                        <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">@Html.Raw(HttpUtility.HtmlEncode(Model[k].InvoicesList[0].Address).Replace("\n", "<br />"))</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="font-size: 15px; text-align: left; width: 50%; " class="businssName RouteName Font17"></th>
                                                    }
                                                    <th class="Font17" style="font-weight: bold; text-align: right; font-size: 14px">Date: </th>
                                                    <th class="Font17" style="font-weight: normal; text-align: left; width: 18%; font-size: 14px; padding-left: 15px; ">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model[k].InvoicesList[0].RecordDate))</th>
                                                </tr>
                                                <tr>
                                                    <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">@Model[k].InvoicesList[0].Phone</th>
                                                    <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Ref No: </th>
                                                    <th class="Font17" style="text-align: left; width: 18%; font-size: 14px; font-weight: normal; padding-left: 16px">
                                                        @Model[k].InvoicesList[0].RefrenceNo
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th style="font-size: 14px; text-align: left; width: 50%; " class="businssName RouteName Font17">&nbsp;</th>
                                                    @if (Model[k].InvoicesList[0].InvoiceType != 0 && Model[k].InvoicesList[0].ShowBalance == 1)
                                                    {
                                                        <th class="Font17" style="font-weight:bold;text-align:right;font-size:14px">Previous Balance: </th>
                                                        <th class="Font18" style="text-align: left; width: 18%; font-size: 14px;font-weight:bold; padding-left: 16px">
                                                            @Convert.ToDecimal(Model[k].InvoicesList[0].PreviousBalance).ToString("#,##0.00")
                                                        </th>
                                                    }
                                                </tr>
                                            </tbody>
                                        </table>
                                        @if (!string.IsNullOrEmpty(Model[k].InvoicesList[0].Remarks))
                                        {
                                            <table style="margin-bottom:15px;margin-top:-22px" class="description oldCss">
                                                <tr>
                                                    <td class="Font17" style="font-size: 14px"><b><span style="font-size: 17px">Remarks:</span></b> @Model[k].InvoicesList[0].Remarks</td>
                                                </tr>
                                            </table>
                                        }
                                        <table class="mainTable oldCss" id="" style="margin-top:-12px">
                                            <tr>
                                                <th class="Font17" style="text-align: center; border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; width: 30px;padding:3px ">Sr#</th>
                                                <th class="Font17" style="padding-left: 8px; border-top: 1px solid black; border-bottom: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: left; padding: 3px; ">Item Name</th>
                                                <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 70px; padding: 3px; ">Qty</th>
                                                <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 70px; padding: 3px; ">Rate</th>
                                                <th class="Font17" style="border-bottom: 1px solid black; border-top: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; text-align: center; width: 90px; padding: 3px; ">Disc</th>
                                                <th class="Font17" align="center" style="text-align: center; border-top: 1px solid black; border-bottom: 1px solid black; border-right: 1px solid black; font-size: 14px; font-weight: bold; width: 100px; padding: 3px; ">Amount</th>
                                            </tr>
                                            <tbody>
                                                @{decimal totalQty = 0;
                                                decimal totalAmount = 0;}
                                                @for (int i = 0; i < Model[k].InvoicesList.Count; i++)
                                                {
                                                    totalQty += Convert.ToDecimal(Model[k].InvoicesList[i].Qty);
                                                    totalAmount += Convert.ToDecimal(Model[k].InvoicesList[i].LineNetAmount);
                                                    <tr class="">
                                                        <td class="Font17" align="center" style="text-align: center; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; ">@(i + 1)</td>

                                                        <td class="Font17" align="left" style="padding-left: 8px; border-bottom: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; ">@Model[k].InvoicesList[i].ItemName</td>
                                                        @if (Model[k].InvoicesList[i].Qty == Convert.ToInt32(Model[k].InvoicesList[i].Qty))
                                                        {
                                                            <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(Model[k].InvoicesList[i].Qty), 0) @Model[k].InvoicesList[i].UnitName</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(Model[k].InvoicesList[i].Qty), 2) @Model[k].InvoicesList[i].UnitName</td>
                                                        }
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[k].InvoicesList[i].Rate).ToString("#,##0.00")</td>
                                                        @if (Convert.ToDecimal(Model[k].InvoicesList[i].LineDiscount) == 0)
                                                        {
                                                            <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">-</td>
                                                        }
                                                        else
                                                        {
                                                            if (Model[k].InvoicesList[i].LineDiscountType == "%")
                                                            {
                                                                <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[k].InvoicesList[i].LineDiscount).ToString("#,##0.00")%</td>
                                                            }
                                                            else
                                                            {
                                                                <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">Rs. @Convert.ToDecimal(Model[k].InvoicesList[i].LineDiscount).ToString("#,##0.00")</td>
                                                            }
                                                        }

                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Convert.ToDecimal(Model[k].InvoicesList[i].LineNetAmount).ToString("#,##0.00") </td>
                                                    </tr>
                                                }
                                                <tr class="">
                                                    <td class="Font17" align="right" style="text-align: right; padding-right: 10px; font-weight: bold; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; padding-top: 4px; font-size: 14px; padding: 3px; " colspan="2">Total Qty:</td>
                                                    @if (totalQty == Convert.ToInt32(totalQty))
                                                    {
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; font-weight: bold; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(totalQty), 0)</td>
                                                    }
                                                    else
                                                    {
                                                        <td class="Font17" align="center" style="border-bottom: 1px solid black; font-weight: bold; padding-top: 4px; border-right: 1px solid black; font-size: 14px; padding: 3px; ">@Math.Round(Convert.ToDecimal(totalQty), 2)</td>
                                                    }
                                                    <td class="Font17" style="border-bottom: 1px solid black;text-align:right; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight:bold" colspan="2">Total Amount</td>
                                                    <td class="Font17" style="border-bottom: 1px solid black; text-align: center; padding-top: 3px; border-right: 1px solid black; font-size: 14px; padding: 3px; font-weight: bold">@Convert.ToDecimal(totalAmount).ToString("#,##0.00")</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <table style="margin-top:10px" class="AccountNameTable oldCss">
                                            @if (Model[k].InvoicesList[0].NetDiscount != 0 && Model[k].InvoicesList[0].NetDiscount != null)
                                            {
                                                <tr>
                                                    <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; border-top: 1px solid black; width: 230px; text-align: right;padding-right:3px "><span style="font-size: 14px; font-weight: bold" class="Font17">Gross Total:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[k].InvoicesList[0].GrossTotal).ToString("#,##0.00")</th>
                                                </tr>
                                                <tr>
                                                    @if (Model[k].InvoicesList[0].DiscountType == "%")
                                                    {
                                                        <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Discount:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[k].InvoicesList[0].NetDiscount).ToString("#,##0.00")%</th>
                                                    }
                                                    else
                                                    {
                                                        <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Discount:&nbsp;&nbsp; </span>Rs. @Convert.ToDecimal(Model[k].InvoicesList[0].NetDiscount).ToString("#,##0.00")</th>
                                                    }
                                                </tr>
                                            }
                                            <tr>
                                                <th class="pull-right Font17" style="font-size: 14px; border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Net Total:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[k].InvoicesList[0].NetAmount).ToString("#,##0.00")</th>
                                            </tr>
                                            @if (Model[k].InvoicesList[0].ReceivedAmount != 0 && Model[k].InvoicesList[0].ReceivedAmount != null)
                                            {
                                                <tr>
                                                    <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold" class="Font17">Received:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[k].InvoicesList[0].ReceivedAmount).ToString("#,##0.00")</th>
                                                </tr>
                                                <tr>
                                                    <th class="pull-right Font17" style="font-size: 14px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; width: 230px; text-align: right; padding-right: 3px"><span style="font-size: 14px; font-weight: bold; " class="Font17">Balance Amount:&nbsp;&nbsp; </span>@Convert.ToDecimal(Model[k].InvoicesList[0].BalanceAmount).ToString("#,##0.00")</th>
                                                </tr>
                                            }
                                            @if (Model[k].InvoicesList[0].InvoiceType != 0 && Model[k].InvoicesList[0].ShowBalance == 1)
                                            {
                                                <tr>
                                                    <th class="pull-right Font18" style="font-size: 14px; font-weight: bold; width: 230px; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black; text-align: right; padding-right: 3px">
                                                        <span style="font-size:14px;" class="Font17">Net Balance:&nbsp;&nbsp; </span>@((Convert.ToDecimal(Model[k].InvoicesList[0].PreviousBalance) + Convert.ToDecimal(Model[k].InvoicesList[0].BalanceAmount)).ToString("#,##0.00"))
                                                    </th>
                                                </tr>
                                            }
                                        </table>
                                        <br />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="PageEnd"></div>
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script src="~/Scripts/CustomJs/ResponsivePrintScreenForInvoices.js?v=2"></script>
        <script type="text/javascript">
            $(document).ready(function () {

            })
            $('#downloadForm').on("submit", function () {
                $("table").each(function () {
                    $(this).removeClass("oldCss");
                    $(this).addClass("newCss");
                    var cssData = $('#CssData').html();
                    var htmlData = $('#HtmlData').html();
                    $('#DocumentName').val(cssData + htmlData);
                })
                $("table").each(function () {
                    $(this).removeClass("newCss");
                    $(this).addClass("oldCss");
                })
            })
            //function getPaymentDetail() {
            //    $.ajax({
            //        type: "POST",
            //        url: "/sale/getPaymentDetail/" + $('.SaleInvoiceId').val(),
            //        dataType: "json",
            //        success: function (data) {
            //            if (data.RemainingDays > 0) {
            //                var append = '<tr  ><td colspan="99" ><div style="text-align: center; margin-top: 40px;margin-bottom:35px;"><span style="color: #FF0000; border-width: 5px; border-color: #FF0000; padding: 10px; font-size: 20px">OVERDUE</span></div></td></tr>';
            //                $('.mainTableBody').append(append);
            //            }
            //        }
            //    })
            //}
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
