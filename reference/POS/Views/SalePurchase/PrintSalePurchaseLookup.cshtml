<!-- widget content -->
@model List<POS.Models.clsInvoice>
<div id="content" class="tablecontainer" style="padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-home fa-fw "></i>
                Report
                <span>
                    >
                    History Report
                </span>
            </h1>
        </div>
    </div>
    <section>
        <div class="panel">
            <div class="panel-heading">
                @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                {
                    <span class="header"> History Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                    <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                    <input type="hidden" name="FileName" id="FileName" value="SaleSummaryItem" />
                    @*<a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("saleorderindex", "sale")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                            Back
                        </a>*@
                    <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                        Print
                    </button>
                    <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                }
            </div>
            <div class="panel-body">
                <div id="HtmlData">

                    <div id="printable-content" class="panel rpt" style=" float: left;width: 800px; font-family: Arial, Helvetica, sans-serif;">
                        <table style="padding: 5px" class="heading oldCss">
                            <thead>
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: left;padding-right:12px;padding-top:0px;border-bottom:none;" colspan="12" class="pull-right"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 20px; text-align: center; padding-bottom: 5px;padding-top:15px" colspan="6">@System.Web.HttpContext.Current.Application["BusinessName"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: normal; font-size: 14px; text-align: center; padding-bottom: 5px;" colspan="6">@System.Web.HttpContext.Current.Application["BusinessAddress"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 18px; text-align: center;" colspan="6">History Report</th>
                                </tr>
                                @if (Model.Count != 0)
                                {
                                    if (Model[0].DateFilter != 0)
                                    {
                                        <tr>
                                            <th style="font-size: 12px; text-align: center; padding-bottom: 25px; font-weight: normal" colspan="6"><strong><span style="font-size: 12px">From:</span> </strong>@Convert.ToDateTime(Model[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size: 12px">To:&nbsp;</span></strong>@Convert.ToDateTime(Model[0].ToDate).ToString("dd/MM/yyyy")</th>
                                        </tr>
                                    }
                                }
                            </thead>
                            <tbody class="report_body"></tbody>
                        </table>
                        <table class="mainTable oldCss">
                            <tr class="mainTr">
                                <th style="text-align: center; width: 40px"> Sr#</th>
                                <th style="text-align: center; width: 90px"> Date</th>
                                <th style="text-align: center; width: 140px"> Item Name</th>
                                <th style="text-align: center; width: 50px"> Qty</th>
                                <th style="text-align: right; width: 50px; "> Rate</th>
                                <th style="text-align:right;width:110px"> Gross Value</th>
                                <th class="borderRight"> Customer / Supplier</th>
                            </tr>
                            @if (Model.Count != 0)
                            {
                                <tbody>
                                    @for (var i = 0; i < Model.Count; i++)
                                    {
                                        int a = i + 1;
                                        <tr class="mainTr">
                                            <td style="text-align:center">@(a)</td>
                                            <td style="text-align: center">@Convert.ToDateTime(Model[i].RecordDate).ToString("dd/MM/yyyy")</td>
                                            <td style="text-align: center">@Model[i].ItemName</td>
                                            <td style="text-align: center">@Model[i].Qty</td>
                                            <td style="text-align:right">@Convert.ToDecimal(Model[i].Rate).ToString("#,##0.00")</td>
                                            <td style="text-align: right; ">@Convert.ToDecimal(Model[i].GrossValue).ToString("#,##0.00")</td>
                                            <td class="borderRight" style="text-align: left; ">@Model[i].DetailName</td>
                                        </tr>
                                    }
                                    @*<tr class="mainTr">
                        <td style="text-align: right; border: 1px solid #fff;font-weight:bold" colspan="2">Total: </td>
                        <td class="borderRight" style="text-align: right; font-weight: bold; ">@Convert.ToDecimal(totatlQuantity).ToString("#,##0.00")</td>
                        <td style="text-align: right; border: 1px solid #fff;font-weight:bold"></td>
                        <td class="borderRight" style="text-align: right; font-weight: bold;">@Convert.ToDecimal(totatlGrossValue).ToString("#,##0.00")</td>
                    </tr>*@
                                </tbody>
                            }
                            else
                            {
                                <tbody>
                                    <tr class="mainTr">
                                        <td class="borderRight" colspan="7" style="text-align:center;padding:10px">No Record Found.</td>
                                    </tr>
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- END MAIN CONTENT -->
@section pagespecific {
               <script src="~/Scripts/CustomJs/ResponsivePrintScreen.js"></script>
    <script type="text/javascript">
        $('#downloadForm').on("submit", function () {
            $("table").each(function () {
                $(this).css("border-collapse", "collapse");
                $('.mainTable').css("width", "99.8%");
                //$('.mainTable').css("margin-top", "-15px");
                //$('.tdd').css("border-right", "1px solid black");
                var cssData = $('#CssData').html();
                var htmlData = $('#HtmlData').html();
                $('#DocumentName').val(cssData + htmlData);
            })
            $("table").each(function () {
                $(this).css("border-collapse", "separate");
                $('.mainTable').css("width", "100%");
                //$('.mainTable').css("margin-top", "-25px");
                //$('.tdd').css("border-right", "0px");
            })
        })
        function PrintElem(elem) {
            var mywindow = window.open('', 'PRINT', 'height=400,width=500');

            mywindow.document.write('<html><head><title></title>');
            mywindow.document.write('</head><body>');
            //mywindow.document.write('<h1></h1>');
            mywindow.document.write(document.getElementById(elem).innerHTML);
            mywindow.document.write('</body></html>');

            mywindow.document.close(); // necessary for IE >= 10
            mywindow.focus(); // necessary for IE >= 10*/

            mywindow.print();
            mywindow.close();

            return true;
        }
        $('.report_body tr td').each(function () {
            if (parseFloat($(this).html()) > 0) {
                $(this).html(ReplaceNumberWithCommas($(this).html()));
            }
        });
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
    </script>
}