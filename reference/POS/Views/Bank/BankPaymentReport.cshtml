<!-- widget content -->
@*@model List<POS.Models.clsVoucher>*@
@model List<POS.Models.clsVoucher>
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        Bank Payment Report
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> Bank Payment Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="@Model[0].VoucherNo" />
                        <a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("bankpaymentindex", "bank")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                            Back
                        </a>
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content" class="panel rpt" style=" float: left; width: 800px; font-family: Arial, Helvetica, sans-serif;">
                            <table style="padding: 5px" class="heading">
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: left;padding-right:12px;padding-top:0px;border-bottom:none;" colspan="12" class="pull-right"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 20px; text-align: center; padding-bottom: 5px;padding-top:15px" colspan="6">@System.Web.HttpContext.Current.Application["BusinessName"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: normal; font-size: 14px; text-align: center; padding-bottom: 5px;" colspan="6">@System.Web.HttpContext.Current.Application["BusinessAddress"]</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 18px; text-align: center;" colspan="6">Bank Payment Voucher</th>
                                </tr>
                                <tbody class="report_body"></tbody>
                            </table>
                            <table style="" class="purchaseHeading">
                                <tbody>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: left;width:27%" class="accountName">Bank Account (Paid Through) :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 23%; border-bottom: 1px solid black; font-weight: normal;" class="accountName">@Model[0].DetailName</th>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right;width:30%" class="accountName">Date :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 20%; border-bottom: 1px solid black; font-weight: normal;" class="accountName">@Convert.ToDateTime(Model[0].VoucherDate).ToString("dd/MM/yyyy")</th>
                                    </tr>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: left;width:27%;padding-top:7px" class="accountName">BPV No  :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 23%; border-bottom: 1px solid black; padding-top: 7px; font-weight: normal;" class="accountName">@Model[0].VoucherNo</th>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right; width: 30%; padding-top: 7px; " class="accountName">Ref No  :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 20%; border-bottom: 1px solid black; padding-top: 7px; font-weight: normal;" class="accountName">@Model[0].RefrenceNo</th>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="mainTable">
                                <tr>
                                    <th style="text-align:left;border:none !important;font-size:15px" colspan="3"></th>
                                    <th style="text-align: right; border: none !important; font-size: 13px;font-weight:normal " colspan="3">Amount Paid: <span style="font-weight:bold;font-size:15px">@Convert.ToDecimal(Model[0].Credit).ToString("#,##0.00")</span></th>
                                </tr>
                                <tr class="mainTr">
                                    <th style="text-align: center; width: 45px">Sr#</th>
                                    <th style="text-align: left; width: 200px">Paid To Account</th>
                                    <th style="text-align: left; width: 110px">Cheque No.</th>
                                    <th style="text-align: left;">Remarks</th>
                                    <th style="text-align: right; width: 50px">Debit</th>
                                    <th class="borderRight" style="text-align: right; width: 50px">Credit</th>
                                </tr>
                                <tbody>
                                    @{
                                        int j = 0;
                                        decimal totatlDebit = 0;
                                        decimal totatlCredit = 0;
                                    }
                                    @foreach (clsVoucher s in Model)
                                    {
                                        totatlDebit += Convert.ToDecimal(s.LineDebit);
                                        totatlCredit += Convert.ToDecimal(s.LineCredit);
                                        j++;
                                        <tr class="mainTr">
                                            <td style="text-align:center">@(j)</td>
                                            <td style="text-align: left">@s.LineDetailName</td>
                                            <td style="text-align: left; ">@s.LineChequeNo</td>
                                            <td style="text-align: left; ">@s.LineRemarks</td>
                                            @if (s.LineDebit == 0)
                                            {
                                                <td style="text-align: center">-</td>
                                            }
                                            else
                                            {
                                                <td style="text-align: right">@Convert.ToDecimal(s.LineDebit).ToString("#,##0.00")</td>
                                            }
                                            @if (s.LineCredit == 0)
                                            {
                                                <td class="borderRight" style="text-align: center">-</td>
                                            }
                                            else
                                            {
                                                <td class="borderRight" style="text-align: right">@Convert.ToDecimal(s.LineCredit).ToString("#,##0.00")</td>
                                            }
                                        </tr>
                                    }
                                    <tr class="mainTr">
                                        <td class="tdd" style="text-align: right; border: 1px solid #fff;font-weight:bold" colspan="4">Total: </td>
                                        <td style="text-align: right; font-weight: bold">@Convert.ToDecimal(totatlDebit).ToString("#,##0.00")</td>
                                        <td class="borderRight" style="text-align: right; font-weight: bold">@Convert.ToDecimal(totatlCredit).ToString("#,##0.00")</td>
                                    </tr>
                                </tbody>
                            </table>
                            <table style="padding-right:0px;margin-left:13px;width:100%" class="purchaseHeading2">
                                <tbody>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right; width: 40%" class="accountName">Amount in Words :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 60%; border-bottom: 1px solid black;font-weight:normal " class="accountName">@Model[0].AmountInString</th>
                                    </tr>
                                </tbody>
                            </table>
                            <table style="padding-right:0px;margin-left:13px;width:100%;margin-top:-10px" class="purchaseHeading2">
                                <tbody>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right; width: 40%" class="accountName">Remarks :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 60%; border-bottom: 1px solid black; font-weight: normal; " class="accountName">@Model[0].Remarks</th>
                                    </tr>
                                </tbody>
                            </table>
                            <table style="padding-right:0px;margin-left:13px;width:100%;margin-top:-10px" class="purchaseHeading2">
                                <tbody>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right;width:60%" class="accountName">Received By :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 15%; border-bottom: 1px solid black; font-weight: normal;" class="accountName">&nbsp;</th>
                                        <th style="font-weight: bold; font-size: 12px; text-align: right; width: 10%" class="accountName">Paid By :&nbsp;&nbsp;</th>
                                        <th style="font-size: 12px; text-align: left; width: 15%; border-bottom: 1px solid black; font-weight: normal; " class="accountName">&nbsp;</th>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
               <script src="~/Scripts/CustomJs/ResponsivePrintScreen.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {

            })
            $('#downloadForm').on("submit", function () {
                $("table").each(function () {
                    $(this).css("border-collapse", "collapse");
                    $('.mainTable').css("width", "99.8%");
                    $('.tdd').css("border-right", "1px solid black");
                    var cssData = $('#CssData').html();
                    var htmlData = $('#HtmlData').html();
                    $('#DocumentName').val(cssData + htmlData);
                })
                $("table").each(function () {
                    $(this).css("border-collapse", "separate");
                    $('.mainTable').css("width", "100%");
                    $('.tdd').css("border-right", "0px");
                })
            })
            function PrintElem(elem) {
                var mywindow = window.open('', 'PRINT', 'height=400,width=500');

                mywindow.document.write('<html><head><title></title>');
                mywindow.document.write('</head><body>');
                //mywindow.document.write('<h1></h1>');
                mywindow.document.write(document.getElementById(elem).innerHTML);
                mywindow.document.write('</body></html>');

                mywindow.document.close(); // necessary for IE >= 10
                mywindow.focus(); // necessary for IE >= 10*/

                mywindow.print();
                mywindow.close();

                return true;
            }
            $('.report_body tr td').each(function () {
                if (parseFloat($(this).html()) > 0) {
                    $(this).html(ReplaceNumberWithCommas($(this).html()));
                }
            });
            function ReplaceNumberWithCommas(yourNumber) {
                if (yourNumber != "0") {
                    //Seperates the components of the number
                    var n = yourNumber.toString().split(".");
                    //Comma-fies the first part
                    n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                    if (n.length == 1) {
                        n[0] = n[0] + ".00";
                    }
                    else {
                        if (n[1].toString().length == 1) {
                            n[1] = n[1] + "0";
                        }
                    }
                    //Combines the two sections
                    n = n.join(".");
                }
                else {
                    n = yourNumber;
                }
                return n;
            }
        </script>
    }
