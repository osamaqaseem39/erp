<script type="text/javascript">
    $(document).ready(function () {
        
    });

    $('#closepanel').click(function () {
        var infoId = $("#BookID").val();
        $('#detaildiv' + infoId).empty();
        //$(this).empty();
    });
    function ConvertDate(dateStr) {
        var parts = dateStr.split("-");
        //return new Date(parts[2], parts[1] - 1 , parts[0]);
        return parts[1] + "/" + parts[0] + "/" + parts[2];
    }

    
    $('#btnConfirm').click(function () {

        var bookid = $('#BookID').val();
        var vremk = $('#BidRemarks').val();       
        ConfirmBidFunction(bookid);
    })

    function ConfirmBidFunction(id) {
        var a = $.confirm({
            title: 'Confirm for Email',
            content: 'Are you sure u want to send to Confirm for Email this Bid?',
            type: 'green',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/ConfirmedJobForEmail/',
                            data: { id: id, remk: "" },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }


    $('#btnCancelBid').click(function () {
        
        var bookid = $('#BookID').val();
        var vremk = $('#BidRemarks').val();
        if (vremk == null || vremk == "") {
            alert("Enter Cancel Remarks");
            return false
        } else {
            CancelBidFunction(bookid, vremk);
        }
    })


    function CancelBidFunction(id, vremk) {
        var a = $.confirm({
            title: 'Cancel Bid',
            content: 'Are you sure u want to Cancel this Bid?',
            type: 'red',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/CancelBidOnly/',
                            data: { id: id, remk: vremk},
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }


    
    $('#btnConfirmBidDone').click(function () {
        var bookid = $('#BookID').val();
        ConfirmFunctionDone(bookid, "");
    })
    function ConfirmFunctionDone(id, vremk) {
        var a = $.confirm({
            title: 'Complete Job',
            content: 'Are you sure u want to Compelte this Job?',
            type: 'red',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/ConfirmedJobDone/',
                            data: { id: id, remk: vremk },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }

    $('#btnConfirmBid').click(function () {
        var bookid = $('#BookID').val();
        ConfirmFunction(bookid, "");
    })


    function ConfirmFunction(id, vremk) {
        var a = $.confirm({
            title: 'Confirmed Job',
            content: 'Are you sure u want to Confirm this Job?',
            type: 'red',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/ConfirmedJob/',
                            data: { id: id, remk: vremk },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
