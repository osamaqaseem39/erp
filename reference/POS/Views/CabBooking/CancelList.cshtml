        //var data = vtableCust.row($(this).parents('tr')).data();
        //$('#CustomerSpan').html(data.Name);


    })


    $('#btnSearchCustomer').click(function () {
        SearchCustomer2();
    });
    $('#txtSearchCustomer').on('keypress', function (event) {

        var BElement = $("#btnSearchCustomerUL");
        if (event.keyCode == 13) {
            event.preventDefault();
            SearchCustomer2();
        }
    });
    function SearchCustomer2() {
        var BElement = $("#btnSearchCustomerUL");

        if (BElement.html().trim() == 'First Name') {
            oTableCust.columns(0).search($('#txtSearchCustomer').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Cell') {
            oTableCust.columns(1).search($('#txtSearchCustomer').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Email') {
            oTableCust.columns(2).search($('#txtSearchCustomer').val().trim()).draw();
        }
        else if (BElement.html().trim() == 'Pickup Address') {
            oTableCust.columns(3).search($('#txtSearchCustomer').val().trim()).draw();
        }
        else {
            alert("Error! try again.");
        }
    }

    $('#btnRefreshStore').click(function () {
        location.reload();
    })

    $('#btnAttachDocument').click(function () {
        var AgreementNo = $('#AgreementID').val();
        $('#documentsDiv').load('@Url.Action("attachdocument", "documents")?type=Agreement&id=' + AgreementNo + '');
    })
    $('.btnUpSave').mouseover(function () {
        $(this).find('img').css({ 'height': '50px', 'width': '50px' });
    }).mouseleave(function () {
        $(this).find('img').css({ 'height': '43px', 'width': '43px' });
    });



    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 127) &&
            (charCode != 8) &&
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function GetTodayDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        //$('#Date').val(today);
    }
    function ReplaceCommas(yourNumber) {
        var noCommas = yourNumber.replace(/,/g, ''),
            asANumber = +noCommas;
        return noCommas;
    }
    function ReplaceNumberWithCommas(yourNumber) {
        if (yourNumber != "0") {
            //Seperates the components of the number
            var n = yourNumber.toString().split(".");
            //Comma-fies the first part
            n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

            if (n.length == 1) {
                n[0] = n[0] + ".00";
            }
            else {
                if (n[1].toString().length == 1) {
                    n[1] = n[1] + "0";
                }
            }
            //Combines the two sections
            n = n.join(".");
        }
        else {
            n = yourNumber;
        }
        return n;
    }
