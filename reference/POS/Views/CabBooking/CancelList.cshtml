    function loadTableData() {
        var oTableCust = $('#myTableCustomer').DataTable();
        oTableCust.ajax.reload();
    }

    $(document).on('click', '.selectBtnCust', function (e) {
        e.preventDefault();
        var infoId = $(this).attr("data-value");

        //$('#DetailCode').val(infoId);

        @*$('#mainModalDiv').html('');
        $('#mainModalDiv').load('@Url.Action("BookingDetail", "CabBooking")?id=' + infoId)*@

        //var vtableCust = $('#myTableCustomer').DataTable();
