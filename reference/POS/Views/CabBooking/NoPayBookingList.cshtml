    function PaymentStatus(vpaymentstatus) {
        if (vpaymentstatus.toLowerCase() == "paid") {
            return '<span style="font-weight:normal;font-size:20px;background-color: #025071 !important">' + vpaymentstatus + '</span>' + '<br/>';
        } else {
            return '<span style="font-weight:normal;font-size:20px;">' + vpaymentstatus + '</span>' + '<br/>';
        }
    }

    function paidvia(vpaymentstatus,vpaymentno,creditcardno) {
        if (vpaymentstatus.toLowerCase() == "paid") {
            if (vpaymentno.toLowerCase() == "credit card") {
                if (creditcardno != null) {
                    if (creditcardno.length >= 4) {
                        return '<span style="font-weight:normal">Paid By : </span>' + '<span style="font-weight:bold;">' + vpaymentno + '&nbsp; xxxx-xxxx-xxxx-' + creditcardno + '</span>';
                    } else {
                        return '';
                    }
                } else {
                    return '';
                }

            } else {
                return '<span style="font-weight:normal">Paid Via : </span>' + '<span style="font-weight:bold">' + vpaymentno + '</span>';
            }
        } else {
            return '';
        }
    }


    function ReturnPickupTimeStatus(date, time) {

        if (time != null) {
            var d = new Date();
            var n = d.getTimezoneOffset();
            var serverdatetime = new Date(d.getTime() + n * 60 * 1000);

            var vdate = new Date(parseInt(date.substr(6)));
            var vhour = time.substr(0, 2);
            var vmint = time.substr(3, 2);
            var vsec = "00";

            var confdate = new Date(vdate.getFullYear(), vdate.getMonth(), vdate.getDate(), vhour, vmint, 0, 0);
            var confdatetime = new Date(confdate.getTime() + n * 60 * 1000);

            //return serverdatetime + '<br/>' + confdate + '<br/>' + vhour + '<br/>' + vmint + '<br/>' + nconf;
            if (confdate >= serverdatetime) {
                return '<span style="font-size:16px;"></span>';
            } else {
                return '<span style="color:red;font-size:16px;">Expired</span>';
            }
        } else {
            return '<span style="font-size:16px;"></span>';
        }
    }

