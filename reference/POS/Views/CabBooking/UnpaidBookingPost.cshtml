<script type="text/javascript">

    $('#closepanel').click(function () {
        var infoId = $("#BookID").val();
        $('#detaildiv' + infoId).empty();
        //$(this).empty();
    });
    $(document).ready(function () {
        
    });

    function ConvertDate(dateStr) {
        var parts = dateStr.split("-");
        //return new Date(parts[2], parts[1] - 1 , parts[0]);
        return parts[1] + "/" + parts[0] + "/" + parts[2];
    }

    $('#btnCancelBid').click(function () {

        var bookid = $('#BookID').val();
        var vremk = $('#CancelRemarks').val();
        if (vremk == null || vremk == "") {
            alert("Enter Cancel Remarks");
            return false
        } else {
            CancelBidFunction(bookid, vremk);
        }
    })


    function CancelBidFunction(id, vremk) {
        var a = $.confirm({
            title: 'Cancel Booking',
            content: 'Are you sure u want to Cancel this booking?',
            type: 'red',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/CancelBid/',
                            data: { id: id, remk: vremk },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }


    $('#btnSaveBid').click(function () {
        
        var bookid = $('#BookID').val();
        var creditcardno = $('#CreditCardNo').val();
        var paypalemail = $('#PaypalEmail').val();
        if (creditcardno == null) { creditcardno == ""; }
        if (paypalemail == null) { paypalemail == ""; }

        if (creditcardno == "" && paypalemail == "") {
            alert("Enter Credit Card No or Paypal Email");
            return false
        } else if (creditcardno != "" && paypalemail != "") {
            alert("Enter Only Credit Card No or Paypal Email");
            return false
        } else {
            SaveBidFunction(bookid, creditcardno, paypalemail);
        }
    })


    function SaveBidFunction(id, creditcardno, paypalemail) {
        var a = $.confirm({
            title: "Paid Booking" ,
            content: 'Are you sure u want to Paid this booking?',
            type: 'white',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/PaidBooking/',
                            data: { id: id, creditcardno: creditcardno, paypalemail: paypalemail },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    //$('#MainModal').modal('toggle');
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }

    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
