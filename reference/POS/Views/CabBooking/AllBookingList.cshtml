    function datatabledate(date) {
        if (date != null) {
            var date = new Date(parseInt(date.substr(6)));
            var day = date.getDate();
            var month = date.getMonth() + 1;
            if (parseFloat(day) < 10) {
                day = "0" + day;
            }
            if (parseFloat(month) < 10) {
                month = "0" + month;
            }
            return day + "-" + month + "-" + date.getFullYear();
        }
        else {
            return "";
        }
    }

    function ReturnTripShow(type, date, time) {
        if (type == "Y") {
            return '<div class="row">' +
                        '<span style="font-weight:bold;">Return Date - Time : </span>' + datatabledate(date) + '  ' + time +
                    '</div>';
        } else {
            return "";
        }
    }

