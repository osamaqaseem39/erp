<!-- widget content -->
@model POS.Models.clsBooking
    <div id="content" class="tablecontainer" style="padding: 12px 30px;">

        <div class="row">
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <h1 class="page-title txt-color-blueDark">
                    <i class="fa fa-home fa-fw "></i>
                    Report
                    <span>
                        >
                        S.P Booking Detail
                    </span>
                </h1>
            </div>
        </div>
        <section>
            <div class="panel">
                <div class="panel-heading">
                    @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                    {
                        <span class="header"> S.P Booking Detail Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                        <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                        <input type="hidden" name="FileName" id="FileName" value="SPBookingDetail" />
                        <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                            Print
                        </button>
                        <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                        <button id="btnExport" class="btn btn-primary" style="background-color: #286606; border-color: #286606 !important; color: white; height: 32px; width: 110px; "> Export to Excel</button>
                        @*<button id="btnExportWord" class="btn btn-primary" style="background-color: #03386C !important; border-color: #03386C !important; color: white; height: 32px; width: 140px;padding:5.5px "> Export to Word</button>*@
                    }
                </div>
                <div class="panel-body">
                    <div id="HtmlData">
                        <div id="printable-content1" class="panel rpt" style=" float: center; width: 800px; font-family: Arial, Helvetica, sans-serif; overflow-x: scroll !important;">
                            <table style="padding: 30px;" class="headingTable">
                                <tr>
                                    <th style="font-weight: normal; font-size: 11px; text-align: right;padding-left:12px;padding-top:0px;border-bottom:none;" colspan="12"><strong>Print Date:&nbsp;</strong>@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                                </tr>
                                <tr>
                                    <th style="font-weight: bold; font-size: 24px; text-align: left;padding-left:12px;padding-top:10px;border-bottom:none;" colspan="12" class="pull-left">S.P Booking Detail</th>
                                </tr>
                                @if (Model.BookingList.Count != 0)
                                {
                                    if (Convert.ToInt32(Model.showDate) == 1)
                                    {
                                        <tr>
                                            <td style="font-size: 13px; text-align: left; padding-bottom: 30px; border-bottom: none; padding-left: 12px; font-weight: normal" colspan="12" class="routeData pull-left"><strong><span style="font-size: 13px">From:</span> </strong>@Convert.ToDateTime(Model.FromDateTime).ToString("dd-MMM-yyyy hh:mm")&nbsp; <strong><span style="font-size:16px">To:</span></strong>@Convert.ToDateTime(Model.ToDateTime).ToString("dd-MMM-yyyy hh:mm")</td>
                                        </tr>
                                    }
                                }
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold; font-size: 16px; text-align: center; padding-bottom: 10px" colspan="12">&nbsp;</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="12">
                                            @if (Model.BookingList.Count != 0)
                                            {
                                                int i = 0;
                                                decimal total1 = 0;

                                                <table class="mainTable" style="margin-top:0px;">
                                                
                                                @foreach (clsBooking smain in Model.BookingList1.ToList())
                                                {
                                                    decimal subtotal1 = 0;
                                                    i = 0;
                                                    
                                                        <thead>
                                                            <tr>
                                                                <th style="text-align: left; font-size:14px;font-weight:bold;" colspan="6"> @smain.ServierProviderName</th>
                                                            </tr>
                                                            <tr>
                                                                <th style="text-align: center; width: 45px;"> Sr No.</th>
                                                                <th style="text-align: center; width: 80px;"> Ref. No.</th>
                                                                <th style="text-align: center; width: 100px;"> Pickup<br /> Date</th>
                                                                <th style="text-align: center; width: 100px;"> Pickup<br />Time</th>
                                                                <th style="text-align: center; width: 80px;">  Fare</th>
                                                                
                                                            </tr>
                                                        </thead>
                                                        
                                                        foreach (clsBooking sm in Model.BookingList.Where(x=>x.ServiceProviderID == smain.ServiceProviderID).ToList())
                                                        {
                                                            i++;
                                                            total1 += Convert.ToDecimal(sm.SPAmount);
                                                            subtotal1 += Convert.ToDecimal(sm.SPAmount);
                                                            
                                                            <tr>
                                                                <td style="text-align: center;">@(i)</td>
                                                                <td style="text-align: left;">@sm.SPRefNo</td>
                                                                <td style="text-align: center;">@Convert.ToDateTime(sm.PickupDateTime).ToString("dd-MM-yy")</td>
                                                                <td style="text-align: center;">@sm.PickupTimeString</td>
                                                                <td style="text-align: right;">@Convert.ToDecimal(sm.SPAmount).ToString("#,##0.00")</td>
                                                                
                                                            </tr>
                                                        }
                                                        
                                                            <tr>
                                                                <td class="mainTd" style="text-align: right;font-weight: bold; " colspan="4">Total :</td>
                                                                <td class="mainTd" style="text-align: right; font-weight: bold;">@Convert.ToDecimal(subtotal1).ToString("#,##0.00")</td>
                                                            </tr>
                                                    }

                                                        <tr>
                                                            <td class="mainTd" style="text-align: right;font-weight: bold; " colspan="4">Total :</td>
                                                            <td class="mainTd" style="text-align: right; font-weight: bold;">@Convert.ToDecimal(total1).ToString("#,##0.00")</td>
                                                        </tr>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 36.9px;  border: none;" colspan="12">&nbsp;</th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            }
                                            
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <!-- END MAIN CONTENT -->
    @section pagespecific {
        <script src="~/Scripts/CustomJs/ResponsivePrintScreen.js"></script>
        <script type="text/javascript">

            var reportfilename = "SPBookingDetail";
            $(document).on('click', '#btnExportWord', function (e) {
                e.preventDefault();
                var filename = reportfilename + ".doc";
                var tab_text = "";
                var textRange; var j = 0;
                //tab = document.getElementsByClassName('headingTable'); // id of table

                Array.from(document.getElementsByClassName("headingTable")).forEach(
                    function (element, index, array) {
                        tab_text = tab_text + "<table border='2px'><tr bgcolor='#87AFC6'>";
                        for (j = 0; j < element.rows.length; j++) {
                            tab_text = tab_text + element.rows[j].innerHTML + "</tr>";
                            //tab_text=tab_text+"</tr>";
                        }

                        tab_text = tab_text + "</table>";
                        tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");//remove if u want links in your table
                        tab_text = tab_text.replace(/<img[^>]*>/gi, ""); // remove if u want images in your table
                        tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, ""); // reomves input params

                        tab_text = tab_text + "<br/><br/><br/>";
                    }
                );

                var ua = window.navigator.userAgent;
                var msie = ua.indexOf("MSIE ");

                if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))      // If Internet Explorer
                {
                    txtArea1.document.open("txt/html", "replace");
                    txtArea1.document.write(tab_text);
                    txtArea1.document.close();
                    txtArea1.focus();
                    sa = txtArea1.document.execCommand("SaveAs", true, filename);
                }
                else                 //other browser not tested on IE 11
                    //sa = window.open('data:application/vnd.ms-excel,' + encodeURIComponent(tab_text));

                    var a = document.createElement('a');
                var data_type = 'data:application/msword';
                a.href = data_type + ', ' + encodeURIComponent(tab_text);
                a.download = filename;
                a.click();
                e.preventDefault();

                return (sa);
            })


