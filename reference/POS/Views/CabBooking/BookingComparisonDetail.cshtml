<script type="text/javascript">


    function ConvertToDateLocal(dateStr, timestr) {
        var parts = dateStr.split("-");
        var vyear = parseFloat(parts[2]);
        var vmonth = parseFloat(parts[1]) - 1;
        var vday = parseFloat(parts[0]);
        var partstime = timestr.split(":");
        var vhour = parseFloat(partstime[0]);
        var vmint = parseFloat(partstime[1]);

        return new Date(vyear, vmonth, vday, vhour, vmint, 0, 0);
    }

    $('#closepanel').click(function () {
        var infoId = $("#BookID").val();
        $('#detaildiv' + infoId).empty();
        //$(this).empty();
    });

    $(document).ready(function () {

        var formtype = $("#formtype").val();
        if (formtype == "compare") {
            $("#CloseDate").datepicker({ dateFormat: "dd-mm-yy" });
            var vdate = getFormattedDate(new Date());
            $("#CloseDate").val(vdate);
            var date = new Date();
            var vhour = date.getHours();
            if (vhour.toString().length == 1) { vhour = '0' + vhour; }
            var vmint = date.getMinutes();
            if (vmint.toString().length == 1) { vmint = '0' + vmint; }
            var currentTime = vhour + ':' + vmint;
            $("#CloseTime").val(currentTime);
        }
    });

    function ConvertDate(dateStr) {
        var parts = dateStr.split("-");
        //return new Date(parts[2], parts[1] - 1 , parts[0]);
        return parts[1] + "/" + parts[0] + "/" + parts[2];
    }

    function AssignBookingConf(vrecordid) {
        var bookid = vrecordid;
        if (bookid == null || bookid == "" || isNaN(bookid) || bookid == "0") {
            alert("Select Supplier");
            return false
        } else {
            SaveBidFunctionConf(bookid);
        }
    }

    function SaveBidFunctionConf(id) {
        var a = $.confirm({
            title: 'Confirmed To Supplier',
            content: 'Are you sure u want to Confirm this booking?',
            type: 'green',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/FinalBidConfirm/',
                            data: { id: id },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }

    function AssignBooking(vrecordid) {
        var bookid = vrecordid;
        var vclosedate = ConvertDate($('#CloseDate').val());
        var vclosetime = $('#CloseTime').val();

        var jobdatetime = ConvertToDateLocal('@Model.PickupDateTimeStr', '@Model.PickupTimeString');
        var bidclosedatetime = new Date(vclosedate + " " + vclosetime);
        var diff = (bidclosedatetime - jobdatetime) / 1000 / 60 / 60;
        var vServerDateTime = ConvertToDateLocal('@ViewBag.ServerDate', '@ViewBag.ServerTime');
        var diffnow = (bidclosedatetime - vServerDateTime) / 1000 / 60 / 60;
        if (diff >= 0) {
            alert('Close Date Should be Less Than Job Date');
        } else if (diffnow <= 0) {
            alert('Close Date Should be greater than Current Time');
        } else if (bookid == null || bookid == "" || isNaN(bookid) || bookid == "0") {
            alert("Select Supplier");
            return false
        }else if (vclosedate == null || vclosedate == "") {
            alert("Enter Confirm Upto Date");
            return false
        } else if (vclosetime == null || vclosetime == "") {
            alert("Enter Confirm Upto Time");
            return false
        } else {
            SaveBidFunction(bookid, vclosedate, vclosetime);
        }
    }


    function SaveBidFunction(id, vclosedate, vclosetime) {
        var a = $.confirm({
            title: 'Assigned To Supplier' ,
            content: 'Are you sure u want to Assigned this booking?',
            type: 'green',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/FinalBid/',
                            data: { id: id, closedate: vclosedate, closetime: vclosetime },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }

    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
