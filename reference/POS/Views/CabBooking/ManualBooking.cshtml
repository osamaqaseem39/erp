                        }

                    }
                })

                //if (i == 0) {
                //    if (vNum == 0) {
                //        $('#' + vTextType).val(place.address_components[0].long_name);
                //    } else {
                //        $('#' + vTextType + vNum).val(place.address_components[0].long_name);
                //    }
