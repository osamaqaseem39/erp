        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }



        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#PickUpDate').val(today);
            $('#ReturnDate').val(today);
        }




        function calcRoute(showfare) {
            var vret = 0;
            var tdist = 0;
            var geocoder = new google.maps.Geocoder();


            //var start = document.getElementById('startfrom').value;
            //var start1 = document.getElementById('startfrom1').value;
            //var start2 = document.getElementById('startfrom2').value;
            //var start3 = document.getElementById('startfrom3').value;

            //var end = document.getElementById('endposition').value;
            //var end1 = document.getElementById('endposition1').value;
            //var end2 = document.getElementById('endposition2').value;
            //var end3 = document.getElementById('endposition3').value;


            var start = document.getElementById('PostCodeStart').value;
            var start1 = document.getElementById('PostCodeStart1').value;
            var start2 = document.getElementById('PostCodeStart2').value;
            var start3 = document.getElementById('PostCodeStart3').value;

            var end = document.getElementById('PostCodeEnd').value;
            var end1 = document.getElementById('PostCodeEnd1').value;
            var end2 = document.getElementById('PostCodeEnd2').value;
            var end3 = document.getElementById('PostCodeEnd3').value;

            var waypts = [];

            geocoder.geocode({ 'address': start }, function (results, status) {
                if (status == google.maps.GeocoderStatus.OK) {
                    document.getElementById('LatStart').value = results[0].geometry.location.lat().toString();
                    document.getElementById('LonStart').value = results[0].geometry.location.lng().toString();
                }
            });

            geocoder.geocode({ 'address': end }, function (results, status) {
                if (status == google.maps.GeocoderStatus.OK) {
                    document.getElementById('LatEnd').value = results[0].geometry.location.lat().toString();
                    document.getElementById('LonEnd').value = results[0].geometry.location.lng().toString();
                }
            });



            if (start1 != null && start1 != "") {
                waypts.push({
                    location: start1,
                    stopover: true
                });

                geocoder.geocode({ 'address': start1 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatStart1').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonStart1').value = results[0].geometry.location.lng().toString();
                    }
                });
            }

            if (start2 != null && start2 != "") {
                waypts.push({
                    location: start2,
                    stopover: true
                });

                geocoder.geocode({ 'address': start2 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatStart2').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonStart2').value = results[0].geometry.location.lng().toString();
                    }
                });
            }

            if (start3 != null && start3 != "") {
                waypts.push({
                    location: start3,
                    stopover: true
                });

                geocoder.geocode({ 'address': start3 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatStart3').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonStart3').value = results[0].geometry.location.lng().toString();
                    }
                });
            }

            if (end1 != null && end1 != "") {
                waypts.push({
                    location: end1,
                    stopover: true
                });

                geocoder.geocode({ 'address': end1 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatEnd1').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonEnd1').value = results[0].geometry.location.lng().toString();
                    }
                });
            }

            if (end2 != null && end2 != "") {
                waypts.push({
                    location: end2,
                    stopover: true
                });


                geocoder.geocode({ 'address': end2 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatEnd2').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonEnd2').value = results[0].geometry.location.lng().toString();
                    }
                });
            }

            if (end3 != null && end3 != "") {
                waypts.push({
                    location: end3,
                    stopover: true
                });

                geocoder.geocode({ 'address': end3 }, function (results, status) {
                    if (status == google.maps.GeocoderStatus.OK) {
                        document.getElementById('LatEnd3').value = results[0].geometry.location.lat().toString();
                        document.getElementById('LonEnd3').value = results[0].geometry.location.lng().toString();
                    }
                });
            }


            var request = {
                origin: start,
                destination: end,
                waypoints: waypts,
                //optimizeWaypoints: true,
                //transit_routing_preference: less_driving,
                provideRouteAlternatives: true,
                travelMode: google.maps.DirectionsTravelMode.DRIVING
            };

            directionsService.route(request, function (response, status) {
                if (status == google.maps.DirectionsStatus.OK) {

                    var fastest = Number.MAX_VALUE, shortest = Number.MAX_VALUE;
                    var routeno = 0;
                    response.routes.forEach(function (rou, index) {
                        //console.log("distance of route " + index + ": ", rou.legs[0].distance.value);
                        //console.log("duration of route " + index + ": ", rou.legs[0].duration.value);
                        if (rou.legs[0].distance.value < shortest) {
                            shortest = rou.legs[0].distance.value;
                            routeno = index;
                        }
                        if (rou.legs[0].duration.value < fastest) {
                            fastest = rou.legs[0].duration.value;
                        }
                        //alert(rou.legs[0].distance.value);
                        //alert(rou.legs[0].duration.value);

                    })

                    directionsDisplay = new google.maps.DirectionsRenderer({
                        routeIndex: routeno
                    });

                    var mapOptions = {
                        zoom: 10
                    }
                    map = new google.maps.Map(document.getElementById('map-canvas'), mapOptions);
                    directionsDisplay.setMap(map);
                    directionsDisplay.setDirections(response);


                    var route = response.routes[routeno];
                    var vtotal = 0;
                    for (var i = 0; i < route.legs.length; i++) {
                        var routeSegment = i + 1;
                        var subdist = parseFloat(route.legs[i].distance.value) / 1000;
                        subdist = parseFloat(subdist).toFixed(2);
                        vtotal = parseFloat(vtotal) + parseFloat(subdist);
                    }
                    tdist = parseFloat(vtotal) * 0.62137;

                    tdist = parseFloat(tdist).toFixed(2);


                    if (showfare == 0) {
                        document.getElementById('vdistance').value = tdist;
                        var cabtypeid = $('#CabTypeID').val();
                        $.ajax({
                            type: "POST",
                            url: "/CabBooking/CalcCabFare/",
                            dataType: 'json',
                            data: { 'CabTypeID': cabtypeid, 'vDistance': tdist },
                            success: function (response) {
                                $('#EstimateFareNet').val(response.vFare);
                            }
                        })
                    }
                    
                }

                

                //$('#divmile').show();
                //$('#spTotalMiles').html(tdist);


                //$('.carlist').show();

                @*$('#carlistdetail').load('@Url.Action("CabList", "Home")?vdistance=' + tdist);*@
                //$('html,body').animate({ scrollTop: $(".carlist").offset().top - 100 }, 'slow');



                //$("#lbldistance").html(tdist + " Miles");
                //$(".fareclass").each(function () {
                //    var vcabid = $(this).attr("data-val");
                //    EstimateFare(vcabid, tdist, this);
                //});
            });
        }



