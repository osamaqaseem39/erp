        function fillAddress(vautocomplete, vNum, vTextType) {
            var place = vautocomplete.getPlace();
            var place_id = place.place_id;

            //var geocoder = new google.maps.Geocoder();
            //geocoder.geocode({ 'placeId': place.place_id }, function (results, status) {
            //    debugger
            //    if (status == google.maps.GeocoderStatus.OK) {
            //        console.log(results);
            //    } else {
            //        alert('Geocode was not successful for the following reason: ' + status);
            //    }
            //});

            for (var i = 0; i < place.address_components.length; i++) {
                var addressType = place.address_components[i].types[0];
                var vlat = place.geometry.location.lat();
                var vlng = place.geometry.location.lng();


                //var vgeocode = getGeoCodeFromLonLat(vlng, vlat);
                //alert(vgeocode);


                if (vTextType == "PostCodeStart") {
                    if (vNum == 0) {
                        $('#LatStart').val(vlat);
                        $('#LonStart').val(vlng);
                    } else {
                        $('#LatStart' + vNum).val(vlat);
                        $('#LonStart' + vNum).val(vlng);
                    }
                } else {
                    if (vNum == 0) {
                        $('#LatEnd').val(vlat);
                        $('#LonEnd').val(vlng);
                    } else {
                        $('#LatEnd' + vNum).val(vlat);
                        $('#LonEnd' + vNum).val(vlng);
                    }
