    $('.BidOption').click(function () {
        $(".BidOption").removeClass("BidOptionActive");
        var radioValue = $(this).attr("id");
        if (radioValue == 'DriverBid') {
            $("#DriverBid").addClass("BidOptionActive");
            $('#divDriverOpen').hide();
            $('#supplierbiddiv').hide();
            $('#driverbiddiv').show();
            $('.biddatediv').show();
            $('#divDriver').hide();

        } else if (radioValue == 'SupplierBid') {
            $("#SupplierBid").addClass("BidOptionActive");
            $('#divDriverOpen').hide();
            $('#supplierbiddiv').show();
            $('.biddatediv').show();
            $('#driverbiddiv').hide();
            $('#divDriver').hide();

        } else if (radioValue == 'DriverOpen') {
            $("#DriverOpen").addClass("BidOptionActive");
            $('#divDriverOpen').show();
            $('#supplierbiddiv').hide();
            $('#driverbiddiv').hide();
            $('.biddatediv').show();
            $('#divDriver').hide();

        } else {
            $("#Driver").addClass("BidOptionActive");
            $('#divDriverOpen').hide();
            $('#supplierbiddiv').hide();
            $('#driverbiddiv').hide();
            $('.biddatediv').hide();
            $('#divDriver').show();
        }

    });


