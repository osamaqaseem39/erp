        if (vmaxamount == null || vmaxamount == "" || isNaN(vmaxamount)) { vmaxamount = 0; }
        var vremk = $('#BidRemarks').val();
        var vclosedate = ConvertDate($('#CloseDate').val());
        var vclosetime = $('#CloseTime').val();

        var vdetailcode = 0;

        var jobdatetime = ConvertToDateLocal('@Model.PickupDateTimeStr', '@Model.PickupTimeString');
        var bidclosedatetime = new Date(vclosedate + " " + vclosetime);
        var diff = (bidclosedatetime - jobdatetime) / 1000 / 60 / 60;
        var vServerDateTime = ConvertToDateLocal('@ViewBag.ServerDate', '@ViewBag.ServerTime');
        var diffnow = (bidclosedatetime - vServerDateTime) / 1000 / 60 / 60;
        if (diff >= 0) {
            alert('Bid Close Date Should be Less Than Job Date');
        } else if (diffnow <= 0) {
            alert('Bid Close Date Should be greater than Current Time');
        } else if (vamount == null || vamount == "" || isNaN(vamount) || vamount == "0") {
            alert("Enter Max Bid Amount");
            return false
        } else if (parseFloat(vamount) > parseFloat(vmaxamount)) {
            alert("Bid Amount Cannot Exceed from Fare Amount");
            return false
        } else if (vclosedate == null || vclosedate == "") {
            alert("Enter Close Date");
            return false
        } else if (vclosetime == null || vclosetime == "") {
            alert("Enter Close Time");
            return false
        } else {
            //getSelectedZone();
            var vSelectedZone = JSON.stringify(getSelectedZone());
            SaveBidFunction(bookid, vamount, vremk, "Bid", "Post for Supplier", vclosedate, vclosetime, vdetailcode, vSelectedZone, "Bid Supplier");
        }
    })

    function getSelectedZone() {
        var arrayData = [];
        var count = 0;
        $('#myTableCabZone tbody tr[role=row]').each(function () {

            var vzonevalue = $(this).find('.zone').prop('checked');
            //alert(vzonevalue);
            var vzoneid = $(this).find('.zone')[0].id;
            vzoneid = vzoneid.toString().replace("zone_", "");
            if (vzonevalue == true || vzonevalue == "true") {
                var alldata = {
                    ZoneID: vzoneid
                }
                arrayData.push(alldata);
            }
        });
        return arrayData;
    }

    function SaveBidFunction(id, vamount, vremk, vstatus, vTitle, vclosedate, vclosetime, vdetailcode, vSelectedZone, bidtype) {
        var a = $.confirm({
            title: vTitle ,
            content: 'Are you sure u want to ' +  vTitle + ' this booking?',
            type: 'white',
            buttons: {
                ok: {
                    text: "Yes",
                    btnClass: 'btnConfirm',
                    keys: ['enter'],
                    action: function () {
                        $.ajax({
                            url: '/CabBooking/PostBid/',
                            data: { id: id, amount: vamount, closedate: vclosedate, closetime: vclosetime, remk: vremk, bidstatus: vstatus, vdetailcode: vdetailcode, data: vSelectedZone, bidtype: bidtype },
                            type: "POST",
                            dataType: 'json',
                            success: function (data) {
                                if (data.status == true) {
                                    //$('#MainModal').modal('toggle');
                                    location.reload();
                                }
                                else {
                                    alert(data.message);
                                }
                            }
                        })
                    }
                },
                cancel: {
                    text: "No",
                    btnClass: 'btn-default',
                    keys: ['esc'],
                    action: function () {
                        a.close();
                    }
                },
            }
        });
    }




    $('#btnSaveDriverBid').click(function () {
        var bookid = $('#BookID').val();
        var vamount = $('#BidAmount').val();
        var vmaxamount = $('#MaxFare').val();
        if (vmaxamount == null || vmaxamount == "" || isNaN(vmaxamount)) { vmaxamount = 0; }
        var vremk = $('#BidRemarks').val();
        var vclosedate = ConvertDate($('#CloseDate').val());
        var vclosetime = $('#CloseTime').val();
        var vdetailcode = 0;
        if (vamount == null || vamount == "" || isNaN(vamount) || vamount == "0") {
            alert("Enter Max Bid Amount");
