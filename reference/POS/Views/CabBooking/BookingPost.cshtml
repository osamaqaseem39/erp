            return false
        } else if (vdetailcode == null || vdetailcode == "" || vdetailcode == 0) {
            alert("Enter Driver");
            return false
        } else {
            var vSelectedZone = "";
            SaveBidFunction(bookid, vamount, vremk, "Confirm", "Assign to Driver", vclosedate, vclosetime, vdetailcode, vSelectedZone,"Driver");
        }
    })


