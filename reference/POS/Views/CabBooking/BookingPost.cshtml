        }
    })


    function ConvertToDateLocal(dateStr,timestr) {
        var parts = dateStr.split("-");
        var vyear = parseFloat(parts[2]);
        var vmonth = parseFloat(parts[1]) - 1;
        var vday = parseFloat(parts[0]);
        var partstime = timestr.split(":");
        var vhour = parseFloat(partstime[0]);
        var vmint = parseFloat(partstime[1]);

        return new Date(vyear, vmonth, vday, vhour, vmint, 0, 0);
    }

