        } else if (parseFloat(vamount) > parseFloat(vmaxamount)) {
            alert("Bid Amount Cannot Exceed from Fare Amount");
            return false
        } else if (vclosedate == null || vclosedate == "") {
            alert("Enter Close Date");
            return false
        } else if (vclosetime == null || vclosetime == "") {
            alert("Enter Close Time");
            return false
        } else {
            //getSelectedZone();
            var vSelectedZone = JSON.stringify(getSelectedDrivers());
            SaveBidFunction(bookid, vamount, vremk, "Bid", "Post for Drivers", vclosedate, vclosetime, vdetailcode, vSelectedZone, "Bid Driver");
        }
    })


