<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 924,
            phone: 380
        };

        $('#myTableEmployee').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableEmployee'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/employee/GetAllEmployees",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "EmployeeId", "class": "Acenter", "width": "30px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#EmployeeListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                { "data": "FullName", "name": "FullName",  "autoWidth": true, "orderable": true },
                {
                    "data": "DateOfBirth", "orderable": false, "class": "Acenter", 'render': function (date) {
                        if (date != null) {
                            var date = new Date(parseInt(date.substr(6)));
                            var day = date.getDate();
                            var month = date.getMonth() + 1;
                            if (parseFloat(day) < 10) {
                                day = "0" + day;
                            }
                            if (parseFloat(month) < 10) {
                                month = "0" + month;
                            }
                            return day + "-" + month + "-" + date.getFullYear();
                        }
                        else {
                            return "";
                        }
                    }
                },
                    { "data": "CNIC", "name": "CNIC", "class": "Acenter" ,"autoWidth": true, "orderable": true },
                     { "data": "CountryName", "name": "CountryName", "orderable": true, "autoWidth": true },
                     { "data": "DepartmentName", "name": "DepartmentName", "orderable": true, "autoWidth": true },
                     { "data": "WorkNatureName", "name": "WorkNatureName","orderable": true, "autoWidth": true },
            ]
        });
        oTable = $('#myTableEmployee').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var employeeId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/employee/GetEmployeeById/" + employeeId,
                dataType: 'json',
                success: function (response) {
                    $('.NewRow').remove();
                    $('#EmployeeRefId').prop("disabled", false);
                    $('#FullName').prop("disabled", false);
                    $('#LastNameType').prop("disabled", false);
                    $('#LastName').prop("disabled", false);
                    $('#DateOfBirth').prop("disabled", false);
                    $('#Gender').prop("disabled", false);
                    $('#ReligionId').prop("disabled", false);
                    $('#MaritalStatus').prop("disabled", false);
                    $('#CountryId').prop("disabled", false);
                    $('#CityId').prop("disabled", false);
                    $('#CNIC').prop("disabled", false);
                    $('#EmployeeProfilePicture').prop("disabled", false);
                    $('#Contact1').prop("disabled", false);
                    $('#Contact2').prop("disabled", false);
                    $('#PresentAddress').prop("disabled", false);
                    $('#PermanentAddressSame').prop("disabled", false);
                    $('#PermanentAddress').prop("disabled", false);
                    $('#EmgContactNo').prop("disabled", false);
                    $('#EmgContactName').prop("disabled", false);
                    $('#RelationId').prop("disabled", false);
                    $('#AdditionalNote').prop("disabled", false);
                    $('#DepartmentId').prop("disabled", false);
                    $('#WorkNatureId').prop("disabled", false);
                    $('#Email').prop("disabled", false);
                    $('#GrossSalary').prop("disabled", false);
                    $('#DailyAllowance').prop("disabled", false);
                    $('#TimeRecord').prop("disabled", false);
                    $('#Qualification').prop("disabled", false);
                    $('#JobDescription').prop("disabled", false);
                    $('#Organization').prop("disabled", false);
                    $('#FromDate').prop("disabled", false);
                    $('#ToDate').prop("disabled", false);

                    $('#EmployeeId').val(response.data.EmployeeId);
                    $('#EmployeeProfilePicture').val("");
                    $('#AttachDocument').val("");
                    $('#EmployeeRefId').val(response.data.EmployeeRefId);
                    $('#FullName').val(response.data.FullName);
                    $('#LastNameType').val(response.data.LastNameType);
                    $('#LastName').val(response.data.LastName);
                    $('#DateOfBirth').val(getDate(response.data.DateOfBirth));
                    $('#Gender').val(response.data.Gender);
                    $('#ReligionId').val(response.data.ReligionId);
                    $('#MaritalStatus').val(response.data.MaritalStatus);
                    $('#CountryId').val(response.data.CountryId);
                    $('#CNIC').val(response.data.CNIC);
                    $('#Contact1').val(response.data.ContactNo1);
                    $('#Contact2').val(response.data.ContactNo2);
                    $('#PresentAddress').val(response.data.PresentAddress);
                    if (response.data.PermanentAddressSame == "Y") {
                        $('#PermanentAddressSame').prop('checked', true);
                    }
                    else{
                        $('#PermanentAddressSame').prop('checked', false);
                    }
                    $('#PermanentAddress').val(response.data.PermanentAddress);
                    $('#EmgContactNo').val(response.data.EmgContactNo);
                    $('#EmgContactName').val(response.data.EmgContactName);
                    $('#RelationId').val(response.data.RelationId);
                    $('#AdditionalNote').val(response.data.AdditionalNote);
                    $('#DepartmentId').val(response.data.DepartmentId);
                    $('#WorkNatureId').val(response.data.WorkNatureId);
                    $('#Email').val(response.data.Email);
                    $('#GrossSalary').val(response.data.GrossSalary);
                    $('#DailyAllowance').val(response.data.DailyAllowance);
                    $('#TimeRecord').val(response.data.TimeRecord);
                    $('#Qualification').val(response.data.Qualification);
                    $('#ImmediateBossId').val(response.data.ImmediateBossId);
                    $('#ImmediateBoss').val(response.data.ImmediateBossName);

                    getCities(response.data.CountryId, response.data.CityId);
                    getWorkExperienceDetail(response.data.EmployeeId);
                    $('#btnSaveEmployee').prop('disabled', false);
                    $('#btnSaveAndPrintEmployee').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '41%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '41%', 'text-align': 'right' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        function getWorkExperienceDetail(EmployeeId) {
            $.ajax({
                type: 'POST',
                url: "/employee/GetWorkExperienceByEmployeeId/" + EmployeeId,
                dataType: 'json',
                success: function (response) {
                    var i = 0;
                    $('.NewRow').remove();
                    for (var key in response.data) {
                        if (i == 0) {
                            $('#JobDescription').val(response.data[key].JobDescription);
                            $('#Organization').val(response.data[key].Organization);
                            $('#FromDate').val(getDate(response.data[key].FromDate));
                            $('#ToDate').val(getDate(response.data[key].ToDate));
                        }
                        else {
                            var rowCount = $('.LineRow').length + 1;
                            var div = '<div class="row LineRow NewRow" style="margin-top:10px;">' +
                                                        '<div class="col col-md-3">' +
                                                            '<label>Job Description</label>' +
                                                            '<label class="input">' +
                                                                '<input type="text" name="JobDescription" id="JobDescription' + rowCount + '" value = "' + response.data[key].JobDescription + '" class="JobDescription" placeholder="Job Description" />' +
                                                            '</label>' +
                                                        '</div>' +
                                                        '<div class="col col-md-3">' +
                                                            '<label>Organization</label>' +
                                                            '<label class="input">' +
                                                                '<input type="text" name="Organization" id="Organization' + rowCount + '" value = "' + response.data[key].Organization + '" class="Organization" placeholder="Organization" />' +
                                                            '</label>' +
                                                        '</div>' +
                                                        '<div class="col col-md-3">' +
                                                            '<label>From</label>' +
                                                            '<label class="input">' +
                                                                '<input type="date" name="FromDate" id="FromDate' + rowCount + '" value = "' + getDate(response.data[key].FromDate) + '" class="FromDate" />' +
                                                            '</label>' +
                                                        '</div>' +
                                                        '<div class="col col-md-3">' +
                                                            '<table class="" style="">' +
                                                                '<tr>' +
                                                                    '<td style="width: 98%;" id="">' +
                                                                            '<label>To</label>' +
                                                                            '<label class="input">' +
                                                                                '<input type="date" name="ToDate" id="ToDate' + rowCount + '" value = "' + getDate(response.data[key].ToDate) + '" class="ToDate" />' +
                                                                            '</label>' +
                                                                    '</td>' +
                                                                    '<td style="width: 2%;padding-left: 3px;padding-top:7px " id="">' +
                                                                        '<a href="javascript:void(0);" class="btn btn-danger btn-circle btnDeleteWorkExperience" style="margin-top:10px;" title="Delete this Work Experience">' +
                                                                            '<i class="fa fa-times"  style="margin-top:-10px;margin-left:1px"></i>' +
                                                                        '</a>' +
                                                                    '</td>' +
                                                                '</tr>' +
                                                            '</table>' +
                                                        '</div>' +
                                                    '</div>';
                            $('#RowsDiv').append(div);
                        }
                        i++;
                    }
                },
            });
        }
        $('#btnSearchEmployee').click(function () {
            SearchItem();
        });
        $('#txtSearchEmployee').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryEmployee");
            if (BElement.html().trim() == 'Employee No.') {
                NumberPostive(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryEmployee");
            if (BElement.html().trim() == 'Full Name') {
                oTable.columns(0).search($('#txtSearchEmployee').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Country') {
                oTable.columns(1).search($('#txtSearchEmployee').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Department') {
                oTable.columns(2).search($('#txtSearchEmployee').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Work Nature') {
                oTable.columns(3).search($('#txtSearchEmployee').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshEmployee').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryEmployee").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryEmployee").html($this.data("value"));
            if ($("#btnSearchCategoryEmployee").html() == 'Employee No.') {
                $('#txtSearchEmployee').val('');
            }
        })
    });
    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
