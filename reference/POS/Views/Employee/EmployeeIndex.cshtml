        function getCities(countryId, cityId) {
            $.ajax({
                type: "POST",
                url: "/employee/getCities/" + countryId,
                dataType: "json",
                success: function (response) {
                    var select = $("#CityId");
                    select.children().remove();
                    $('#CityId').append('<option  value="0" disabled selected style="display:none;">Select City</option>');
                    $('#CityId').css('color', 'gray');
                    if ($('#EmployeeId').val() > 0) {
                        for (var key in response.data) {
                            if (cityId == response.data[key].CityId) {
                                select.append('<option value="' + response.data[key].CityId + '" selected>' + response.data[key].CityName + '</option>');
                            }
                            else {
                                select.append('<option value="' + response.data[key].CityId + '">' + response.data[key].CityName + '</option>');
                            }
                        }
                    }
                    else {
                        for (var key in response.data) {
                            select.append('<option value="' + response.data[key].CityId + '">' + response.data[key].CityName + '</option>');
                        }
                    }
                }
            });
        }
