        $('#employeeForm').on('submit', function (e) {
            if (!$("#employeeForm").valid()) {
                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }
            $('#btnSaveEmployee').prop('disabled', true);
            $('#btnSaveAndPrintEmployee').prop('disabled', true);
            var myFormData = JSON.stringify(getAllData());
            var url = $('#employeeForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'data': myFormData }),
                success: function (data) {
                    if (data.status == true) {
                        var extension = $('#EmployeeProfilePicture').val().split('.').pop().toLowerCase();
                        if (extension != '') {
                            var typeId = data.employeeId;
                            var documentType = "Employee";
                            var documentId = 0;
                            var date = $("#DateOfBirth").val();
                            var remarks = "Profile Image";
                            var extension = $('#EmployeeProfilePicture').val().split('.').pop().toLowerCase();
                            var document = {
                                DocumentId: documentId,
                                DocumentType: documentType,
                                TypeId: typeId,
                                Date: date,
                                Remarks: remarks,
                                DocumentExtension: extension,
                            }
                            $.ajax({
                                type: "POST",
                                url: '/documents/AttachDocumentsForPost/',
                                dataType: 'json',
                                contentType: 'application/json; charset=utf-8',
                                data: JSON.stringify({ 'doc': document }),
                                success: function (data) {
                                    if (data.status == true) {
                                        var bannerImage = $("#EmployeeProfilePicture").val();
                                        var file = $('#EmployeeProfilePicture').get(0).files;
                                        var documentFile = file[0];
                                        var extension = $('#EmployeeProfilePicture').val().split('.').pop().toLowerCase();
                                        var documentIdWithDocumentTypeWithExtension = data.documentId + "_" + data.documentType + "_" + data.typeId + "_" + extension;
                                        var formData = new FormData();
                                        formData.append(file.name, documentFile);
                                        formData.append("DocumentName", $("#EmployeeProfilePicture").text());

                                        var xhr = new XMLHttpRequest();
                                        var url = '/documents/UploadDocument/' + documentIdWithDocumentTypeWithExtension;
                                        xhr.open('POST', url, true);

                                        xhr.onload = function (e) {
                                            var response = $.parseJSON(e.target.response);
                                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                    '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                    ' <strong>Success! </strong>' +
                                                    'Employee Saved Succesfully.' +
                                                '</div>');
                                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                                $("#success-alert").slideUp(500);
                                                $('.alertDiv').html('');
                                            });
                                            EnableDisableFields();
                                        };
                                        xhr.send(formData);  // multipart/form-data
                                    }
                                    else {
                                        alert("Error! Please try again.");
                                    }
                                }
                            })
                        }
                        else {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                    '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                    ' <strong>Success! </strong>' +
                                                    'Employee Saved Succesfully.' +
                                                '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            EnableDisableFields();
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveEmployee').prop('disabled', false);
                        $('#btnSaveAndPrintEmployee').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteEmployee').click(function () {
