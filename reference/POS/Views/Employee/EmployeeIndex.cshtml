@model POS.Models.clsEmployee
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="EmployeeListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Employees List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="employeeListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="DocumentModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Attach Documents</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="documentsDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="BossModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Employees List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="bossDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Employee </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("insertupdateemployee", "employee", FormMethod.Post, new { id = "employeeForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 42%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Employee" id="btnAddEmployee" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveEmployee" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveAndPrintTdd" hidden>
                                                <button title="Save and Print" class="btnUpSave" id="btnSaveAndPrintEmployee" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/Print.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="documentTd" hidden>
                                                <a title="Attach Document" id="btnAttachDocument" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#DocumentModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/Document2.png" style="width: 42px; height: 42px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Employees List" id="btnEmployeeList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#EmployeeListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshEmployee" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 43%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitEmployee" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveEmployee" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveAndPrintTdd" hidden>
                                                <button title="Save and Print" class="btnUpSave" id="btnSaveAndPrintEmployee" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/Print.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="documentTd" hidden>
                                                <a title="Attach Document" id="btnAttachDocument" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#DocumentModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/Document2.png" style="width: 42px; height: 42px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 41%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Employees List" id="btnEmployeeList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#EmployeeListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshEmployee" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitEmployee" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>

                                <div class="row" style="">
                                    <div class="col col-3">
                                        <label>Employee Ref. Id</label>
                                        <label class="input">
                                            <input type="hidden" id="EmployeeId" value="0" />
                                            <i class="icon-prepend fa fa-hashtag"></i>
                                            <input type="text" name="EmployeeRefId" id="EmployeeRefId" placeholder="Employee Ref. Id" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Full Name</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-user"></i>
                                            <input type="text" name="FullName" id="FullName" placeholder="Full Name" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <div style="">
                                            <label>Last Name</label>
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 30%; padding-right: 3px; padding-left: 3px" id="">
                                                        <label class="select">
                                                            <i class="append fa fa-caret-down"></i>
                                                            <select id="LastNameType" name="LastNameType">
                                                                <option value="s/o">s/o</option>
                                                                <option value="d/o">d/o</option>
                                                                <option value="w/o">w/o</option>
                                                            </select>
                                                        </label>
                                                    </td>
                                                    <td style="width: 70%; padding-left: 3px; " id="">
                                                        <label class="input">
                                                            <input type="text" name="LastName" id="LastName" placeholder="Last Name" autocomplete="off" />
                                                        </label>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col col-3">
                                        <label>Date of Birth</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-calendar"></i>
                                            <input type="date" name="DateOfBirth" id="DateOfBirth" />
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-3">
                                        <label>Gender</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="Gender" name="Gender">
                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Religion</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.ReligionId, ViewBag.Religion as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Marital Status</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="MaritalStatus" name="MaritalStatus">
                                                <option value="Single">Single</option>
                                                <option value="Married">Married</option>
                                                <option value="Widowed">Widowed</option>
                                                <option value="Separated">Separated</option>
                                                <option value="Divorced">Divorced</option>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Nationality</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.CountryId, ViewBag.Country as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                </div>


                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-3">
                                        <label>City</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="CityId" name="CityId" style="width:100%"></select>
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>CNIC</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-id-card"></i>
                                            <input type="text" name="CNIC" id="CNIC" placeholder="CNIC" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Contact1</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-phone"></i>
                                            <input type="text" name="Contact1" id="Contact1" placeholder="Contact1" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Contact2</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-phone"></i>
                                            <input type="text" name="Contact2" id="Contact2" placeholder="Contact2" />
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-md-12">
                                        <label>Present Address</label>
                                        <label class="input">
                                            <textarea id="PresentAddress" name="PresentAddress" style="width: 99%; padding: 5px"></textarea>
                                        </label>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-md-12 pull-right" style="text-align:right">
                                        <label class="checkbox pull-right" style="margin-top:2px;">
                                            <input id="PermanentAddressSame" type="checkbox" name="PermanentAddressSame"><i></i>
                                            <span style="font-size: 11px">Same Permanent Address</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-md-12">
                                        <label>Permanent Address</label>
                                        <label class="input">
                                            <textarea id="PermanentAddress" name="PermanentAddress" style="width: 99%; padding: 5px"></textarea>
                                        </label>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-3">
                                        <label>Emg Contact No</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-phone"></i>
                                            <input type="text" name="EmgContactNo" id="EmgContactNo" placeholder="Emg Contact No" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Emg Contact Name</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-user"></i>
                                            <input type="text" name="EmgContactName" id="EmgContactName" placeholder="Emg Contact Name" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Emg Contact Relation</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.RelationId, ViewBag.Relation as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Additional Note</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" name="AdditionalNote" id="AdditionalNote" placeholder="Additional Note" />
                                        </label>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-3">
                                        <label>Department</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.DepartmentId, ViewBag.Department as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Work Nature</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.WorkNatureId, ViewBag.WorkNature as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Email</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-envelope"></i>
                                            <input type="text" name="Email" id="Email" placeholder="Email" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Gross Salary</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-money-bill-alt"></i>
                                            <input type="text" name="GrossSalary" id="GrossSalary" placeholder="Gross Salary" />
                                        </label>
                                    </div>
                                </div>


                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-3">
                                        <label>Daily Allowance</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-envelope"></i>
                                            <input type="text" name="DailyAllowance" id="DailyAllowance" placeholder="Daily Allowance" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Time Record</label>
                                        <label class="select">
                                            <i class="append fa fa-clock"></i>
                                            <select id="TimeRecord" name="TimeRecord">
                                                <option value="Y">Y</option>
                                                <option value="N">N</option>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <label>Qualification</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" name="Qualification" id="Qualification" placeholder="Qualification" />
                                        </label>
                                    </div>
                                    <div class="col col-3">
                                        <table class="" style="">
                                            <tr>
                                                <td style="width: 100%;" id="">
                                                    <div style="padding: 3px">
                                                        <label>Immediate Boss</label>
                                                        <label class="input">
                                                            <input type="hidden" id="ImmediateBossId" value="0" />
                                                            <i class="icon-prepend fa fa-user"></i>
                                                            <input type="text" name="ImmediateBoss" id="ImmediateBoss" placeholder="Immediate Boss" disabled />
                                                        </label>
                                                    </div>
                                                </td>
                                                <td style="width: 2%;padding-left: 3px;padding-top:7px " id="">
                                                    <a href="javascript:void(0);" class="btn btn-primary btn-circle btnSelectImmediateBoss" style="margin-top:10px;" title="Show Item Stock Warehouse Base">
                                                        <i class="glyphicon glyphicon-user" style="margin-top:-10px;margin-left:1px"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:10px;">
                                    <div class="col col-md-12">
                                        <label>Select Profile Picture</label>
                                        <div class="input input-file">
                                            <span class="button"><input type="file" id="EmployeeProfilePicture" name="EmployeeProfilePicture" onchange="this.parentNode.nextSibling.value = this.value">Browse</span><input type="text" id="AttachDocument" placeholder="Attach Document" readonly="readonly">
                                        </div>
                                    </div>
                                </div>
                                <div id="RowsDiv" style="padding: 10px; border: 1px solid #BDBDBD; background-color: #F2F2F2;margin-top:10px">
                                    <center><h3>Work Experience</h3></center>
                                    <div class="row LineRow" style="margin-top:10px;">
                                        <div class="col col-md-3">
                                            <label>Job Description</label>
                                            <label class="input">
                                                <input type="text" name="JobDescription" id="JobDescription" class="JobDescription" placeholder="Job Description" />
                                            </label>
                                        </div>
                                        <div class="col col-md-3">
                                            <label>Organization</label>
                                            <label class="input">
                                                <input type="text" name="Organization" id="Organization" class="Organization" placeholder="Organization" />
                                            </label>
                                        </div>
                                        <div class="col col-md-3">
