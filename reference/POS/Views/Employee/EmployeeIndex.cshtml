                dd = "0" + dd;
            }
            if (parseFloat(mm) < 10) {
                mm = "0" + mm;
            }
            var yyyy = today.getFullYear();
            var today = yyyy + '-' + mm + '-' + dd;
            $('#FromDate' + counter).val(today);
            $('#ToDate' + counter).val(today);
        }
