    @RenderSection("scripts", required: false)

    <script type="text/javascript">
        $(document).ready(function () {
            ChangeScreenwidth();
        });
        $(window).resize(function () {
            // This will execute whenever the window is resized
            ChangeScreenwidth();
        });
        function ChangeScreenwidth() {
            // This function will be used for make responsive app name in header
            if ($(window).width() <= 420) {
                $('.AppName').css('margin-top', '16px');
                $('.AppName').css('font-size', '10px');
            }
            else {
                $('.AppName').css('margin-top', '11px');
                $('.AppName').css('font-size', '24px');
            }
        }


        function getFormattedDate(date) {
            var year = date.getFullYear();

            var month = (1 + date.getMonth()).toString();
            month = month.length > 1 ? month : '0' + month;

            var day = date.getDate().toString();
            day = day.length > 1 ? day : '0' + day;

            return day + '-' + month + '-' + year;
        }




        function getDueNotif() {
            $.ajax({
                type: 'POST',
                url: '/cabbooking/getNewBooking/',
                dataType: 'json',
                success: function (response) {
                    var duenotif = response.result;
                    if (duenotif == null) { duenotif = ""; }
                    if (duenotif == "0") { duenotif = ""; }
                    if (duenotif == "") {
                        $("#DueNotificationSpan").hide();
                        $("#DueNotificationSpan").html(duenotif);
                    } else {
                        $("#DueNotificationSpan").show();
                        $("#DueNotificationSpan").html(duenotif);
                    }


                }
            });
        }

        function getUnpaidNotif() {
            $.ajax({
                type: 'POST',
                url: '/cabbooking/getUnpaidNewBooking/',
                dataType: 'json',
                success: function (response) {
                    var duenotif = response.result;
                    if (duenotif == null) { duenotif = ""; }
                    if (duenotif == "0") { duenotif = ""; }
                    if (duenotif == "") {
                        $("#UnPaidNotificationSpan").hide();
                        $("#UnPaidNotificationSpan").html(duenotif);
                    } else {
                        $("#UnPaidNotificationSpan").show();
                        $("#UnPaidNotificationSpan").html(duenotif);
                    }


                }
            });
        }



        function getNoPayNotif() {
            $.ajax({
                type: 'POST',
                url: '/cabbooking/getNoPayNewBooking/',
                dataType: 'json',
                success: function (response) {
                    var duenotif = response.result;
                    if (duenotif == null) { duenotif = ""; }
                    if (duenotif == "0") { duenotif = ""; }
                    if (duenotif == "") {
                        $("#NoPayNotificationSpan").hide();
