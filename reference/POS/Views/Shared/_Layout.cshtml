                    } else {
                        $("#NoPayNotificationSpan").show();
                        $("#NoPayNotificationSpan").html(duenotif);
                    }


                }
            });
        }



        function getNotifForEmail() {
            $.ajax({
                type: 'POST',
                url: '/cabbooking/getNewConfirmForAvail/',
                dataType: 'json',
                success: function (response) {
                    var duenotif = response.result;
                    if (duenotif == null) { duenotif = ""; }
                    if (duenotif == "0") { duenotif = ""; }
                    if (duenotif == "") {
                        $("#DueNotificationForEmail").hide();
                        $("#DueNotificationForEmail").html(duenotif);
                    } else {
                        $("#DueNotificationForEmail").show();
                        $("#DueNotificationForEmail").html(duenotif);
                    }
                }
            });
        }
        
        $(document).ready(function () {
            //setTimeout(allnotif(), 10000);//5*60*1000
            allnotif();
            var interval = setInterval(function () { allnotif(); }, 120000);
        })

        function allnotif() {
            getDueNotif();
            getUnpaidNotif();
            getNoPayNotif();
            getNotifForEmail();
        }


    </script>
