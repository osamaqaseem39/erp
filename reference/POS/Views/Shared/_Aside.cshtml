<!-- Note: This width of the aside area can be adjusted through LESS variables -->
<style>
    nav ul ul {
        background: rgb(243,113,1);
    }

    em {
        color: white;
    }

    .minifyme {
        border-bottom: 1px solid #999999;
        background: #fff;
    }

        .minifyme:hover {
            border-bottom: 1px solid #999999;
            background: #ffffff;
        }

    .minified nav > ul > li > a > .menu-item-parent {
        left: 45px;
        top: -1px;
        background-color: rgb(243,113,1);
        height: 35px;
        border-bottom: 1px solid #ccc;
    }

    .minified nav > ul > li > ul {
        left: 45px;
        top: 39px;
        width: 201px;
        background: rgb(243,113,1);
    }

    .minified nav > ul > li {
        border-bottom: 1px solid #ffffff;
        border-top: 1px solid #ffffff;
    }

        .minified nav > ul > li > ul > li {
            background-color: rgb(243,113,1);
        }

    .minified nav ul ul ul li {
        background-color: rgb(243,113,1) !important;
    }

    nav ul .active {
        background-color: #293955;
    }

    #DueNotificationSpan {
        padding: .2em;
        border-radius: 50%;
        line-height: 1em;
        color: white;
        background-color: #ca0707;
        text-align: center;
