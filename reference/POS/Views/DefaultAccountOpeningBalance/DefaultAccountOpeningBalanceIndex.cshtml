<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Default Opening Balance </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            <div class="widget-body">
                                <div class="row">
                                    <div class="col-lg-2">
                                        @if (User.Save == 1)
                                        {
                                            <input type="hidden" id="CanSave" value="1" />
                                        }
                                        else
                                        {
                                            <input type="hidden" id="CanSave" value="0" />
                                        }
                                        @if (User.Change == 1)
                                        {
                                            <input type="hidden" id="CanChange" value="1" />
                                        }
                                        else
                                        {
                                            <input type="hidden" id="CanChange" value="0" />
                                        }
                                        @if (User.Delete == 1)
                                        {
                                            <input type="hidden" id="CanDelete" value="1" />
                                        }
                                        else
                                        {
                                            <input type="hidden" id="CanDelete" value="0" />
                                        }
                                    </div>
                                    <div class="col-lg-10">
                                        <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right" style="padding-right:15px;padding-bottom:0px">
                                            <div class="input-group-btn">
                                                <button id="btnSearchOpeningBalanceOpeningBalance" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Account Name</button>
                                                <ul class="dropdown-menu" id="ulSearchOpeningBalanceOpeningBalance" style="cursor:pointer">
                                                    <li data-value="Account Name">
                                                        <a class="ListItem">Account Name</a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <input class="form-control" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchOpeningBalance" style="height:18px;">
                                            <div class="input-group-btn">
                                                <button type="button" id="btnSearchOpeningBalance" class="btn btn-default" style="margin-left:20px">
                                                    &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-search fa-lg"></i>&nbsp;&nbsp;&nbsp;
                                                </button>
                                                <button type="button" id="btnRefreshOpeningBalance" class="btn btn-default">
                                                    &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-refresh fa-lg"></i>&nbsp;&nbsp;&nbsp;
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <table id="myTableOpeningBalance" class="table table-striped table-bordered table-hover" width="100%">
                                    <thead>
                                        <tr>
                                            <th data-class="expand"><i class="fa fa-fw fa-info text-muted"></i> Account</th>
                                            <th data-hide="phone"><i class="fa fa-fw fa-money-bill-alt text-muted"></i> Debit</th>
                                            <th data-hide="phone"><i class="fa fa-fw fa-money-bill-alt text-muted"></i> Credit</th>
                                            <th data-hide="">Update</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop:1366,
                tablet: 1024,
                phone: 380
            };

            $('#myTableOpeningBalance').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableOpeningBalance'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/DefaultAccountOpeningBalance/GetAllDefaultAccountOpeningBalances",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                        { "data": "DetailName", "name": "DetailName", "width": "71%", "autoWidth": true, "orderable": true, },
                        {
                            "data": "Debit", "width": "10%", "class": "Amount", "orderable": false, "render": function (data) {
                                return '<input type="text" class="Debit" value="' + data + '" style="width:100%;text-align:right;padding-right:6px;font-weight:bold;font-size:14px;margin-right:3px" />';
                            }
                        },
                        {
                            "data": "Credit", "width": "10%", "class": "Amount", "orderable": false, "render": function (data) {
                                return '<input type="text" class="Credit" value="' + data + '" style="width:100%;text-align:right;padding-right:6px;font-weight:bold;font-size:14px;margin-right:3px" />';
                            }
                        },
                        {
                            "data": "DetailCode", "width": "9%", "class": "Acenter", "orderable": false, "render": function (data) {
                                if ($('#CanChange').val() == 1) {
                                    return '<a href="javascript:void(0);"  class="btn btn-primary updateBtn" data-value="' + data + '"  title="Update" style=" text-align: center;font-size: 12px;width:100%;padding:4px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px ">Update</a>';
                                }
                                else {
                                    return '';
                                }
                            }
                        },

                ]
            });
            oTable = $('#myTableOpeningBalance').DataTable();
        });

        $(document).on('click', '.updateBtn', function (e) {
            e.preventDefault();
            var detailCode = $(this).attr("data-value");
            var debit = $(this).closest("tr").find(".Debit").val();
            var credit = $(this).closest("tr").find(".Credit").val();
            var currentBalance = 0;
            if (debit != 0 && debit != '' && credit != 0 && credit != '') {
                alert("Please give only debit or credit.");
            }
            else {
                if (debit == '') {
                    debit = 0;
                }
                if (credit == '') {
                    credit = 0;
                }
                currentBalance = parseFloat(debit) - parseFloat(credit);
                var defaultData = {
                    DetailCode: detailCode,
                    Debit: debit,
                    Credit: credit,
                    CurrentBalance: currentBalance
                }
                $.ajax({
                    url: '/defaultaccountopeningbalance/insertupdatedefaultaccountopeningbalance/',
                    type: "POST",
                    dataType: 'json',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ 'd': defaultData }),
                    success: function (data) {
                        if (data.status == true) {
                            oTable.ajax.reload(null, false);
                        }
                        else {
                            alert(data.message);
                        }
                    }
                })
            }
        })
        $('#btnSearchOpeningBalance').click(function () {
            SearchItem();
        });
        $('#txtSearchOpeningBalance').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchOpeningBalanceOpeningBalance");
            if (BElement.html().trim() == 'Account Name') {
                oTable.columns(0).search($('#txtSearchOpeningBalance').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        $("#ulSearchOpeningBalanceOpeningBalance").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchOpeningBalanceOpeningBalance").html($this.data("value"));
        })
        $('#btnRefreshOpeningBalance').click(function () {
            oTable.ajax.reload(null, false);
        })
        $(document).on('keypress', '.Debit', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $(document).on('keypress', '.Credit', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
}