<script type="text/javascript">
    $(document).ready(function () {
        
        $('#SearchDetailCode').select2({
            dropdownParent: $("#CashPaymentListModal")
        });
        $('#SearchDetailCode').val(null).trigger('change');
        $('#SearchAllDetailCode').select2({
            dropdownParent: $("#CashPaymentListModal")
        });
        $('#SearchAllDetailCode').val(null).trigger('change');
        GetTodayDateSearch();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var voucherNo = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/cash/GetCashPaymentById/" + voucherNo,
                dataType: 'json',
                success: function (response) {
                    $('#DisableOrNot').val(1);
                    $('#MainDetailCode').select().enable(true);

                    $('#LineDetailCode').select().enable(true);
                    $('#TaxID').prop("disable",false)
                    $('#Date').prop("disabled", false);
                    $('#ReferenceNo').prop("disabled", false);
                    $('#Credit').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#PaidBy').prop("disabled", false);
                    $('#ReceivedBy').prop("disabled", false);
                    $('#DefaultVoucher').prop("disabled", false);
                    $('#TaxCheckbox').prop("disabled", false);
                    $('#TaxCheckbox').prop("checked", false);
                    $('#LineRemarks').prop("disabled", false);
                    $('#ChequeNo').prop("disabled", false);
                    $('#LineDebit').prop("disabled", false);
                    $('#LineCredit').prop("disabled", false);
                    $('#taxRow').attr("hidden", "hidden");
                    $('#PreviousBalance').html("0.00");
                    $('#voucherNoSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#VoucherNo').val(response.data.VoucherNo);
                    $('#VoucherNoSpan').html(response.data.VoucherNo);
                    $('#MainDetailCode').val(response.data.DetailCode).trigger('change');
                    $('#Date').val(getDate(response.data.VoucherDate));
                    $('#ReferenceNo').val(response.data.RefrenceNo);
                    $('#Credit').val(response.data.Credit);
                    $('#Remarks').val(response.data.Remarks);
                    $('#PaidBy').val(response.data.PaidBy);
                    $('#ReceivedBy').val(response.data.ReceivedBy);
                    if (response.data.DefaultVoucher == 1) {
                        $('#DefaultVoucher').prop("checked", true);
                    }
                    else {
                        $('#DefaultVoucher').prop("checked", false);
                    }

                    $('#LineDetailCode').val(null).trigger('change');
                    $('#TaxID').val(null).trigger('change');
                    $('#TaxRate').val('');
                    $('#TaxValue').html('0.00');
                    $('#NetLbl').html('Net Debit:');
                    $('#Net').html('0.00');
                    $('.StatusSection').removeAttr("hidden");
                    $('.TotalDebitRow').removeAttr("hidden");
                    $('.TotalCreditRow').removeAttr("hidden");
                    var vtable = $('#voucherDetailTable').DataTable();
                    vtable.clear().draw();
                    $('#btnSaveCashPayment').prop('disabled', false);
                    $('#btnSaveAndPrintCashPayment').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '41%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '41%', 'text-align': 'right' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                    getVoucherDetail(voucherNo);
                }
            })
        })
        function getVoucherDetail(voucherNo) {
            $.ajax({
                type: "POST",
                url: "/cash/GetCashPaymentDetailById/" + voucherNo,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#voucherDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                       "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                        "<span><input type='hidden' class='LineDetailCode01' value=" + response.data[key].LineDetailCode + " />" + response.data[key].DetailName + "</span>",
                        "<span><input type='hidden' class='LineRemarks01' value=" + response.data[key].LineRemarks + " />" + response.data[key].LineRemarks + "</span>",
                        "<span style='text-align:right' class='pull-right'><input type='hidden' class='LineDebit01' value=" + response.data[key].LineDebit + " />" + ReplaceNumberWithCommas(parseFloat(response.data[key].LineDebit).toFixed(2)) + "</span>",
                        "<span style='text-align:right' class='pull-right'><input type='hidden' class='LineCredit01' value=" + response.data[key].LineCredit + " />" + ReplaceNumberWithCommas(parseFloat(response.data[key].LineCredit).toFixed(2)) + "</span>",
                        "<span><input type='hidden' class='LineCheque01' value=" + response.data[key].ChequeNo + " />" + response.data[key].ChequeNo + "</span>",
                        "<span><input type='hidden' class='TaxId01' value=" + response.data[key].TaxID + " />" + response.data[key].TaxName + "</span>",
                        "<span class='pull-right'><input type='hidden' class='TaxRate01' value=" + response.data[key].TaxRate + " />" + response.data[key].TaxRate + "</span>",
                        "<span class='pull-right'><input type='hidden' class='TaxValue01' value=" + response.data[key].TaxValue + " />" + response.data[key].TaxValue + "</span>",
                        "<span class='pull-right'><input type='hidden' class='NetDebit01' value=" + response.data[key].NetDebit + " />" + ReplaceNumberWithCommas(parseFloat(response.data[key].NetDebit).toFixed(2)) + "</span>",
                        "<span class='pull-right'><input type='hidden' class='NetCredit01' value=" + response.data[key].NetCredit + " />" + ReplaceNumberWithCommas(parseFloat(response.data[key].NetCredit).toFixed(2)) + "</span>",
                        ]).draw(false);
                    }
                    getGrandTotal();
                }
            })
        }
    });
    
    $('#CashCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchDetailCode').prop("disabled", false);
        }
        else {
            $('#SearchDetailCode').prop("disabled", true);
            $('#SearchDetailCode').val(null).trigger('change');
        }
    })
    $('#AllAccountCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchAllDetailCode').prop("disabled", false);
        }
        else {
            $('#SearchAllDetailCode').prop("disabled", true);
            $('#SearchAllDetailCode').val(null).trigger('change');
        }
    })
    $('#voucherNoCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchVoucherNo').prop("disabled", false);
        }
        else {
            $('#SearchVoucherNo').prop("disabled", true);
            $('#SearchVoucherNo').val('');
        }
    })
    $('#ReferenceNoCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchReferenceNo').prop("disabled", false);
        }
        else {
            $('#SearchReferenceNo').prop("disabled", true);
            $('#SearchReferenceNo').val('');
        }
    })
    $('#DateCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#DatesRow').removeAttr("hidden");
        }
        else {
            $('#DatesRow').attr("hidden", "hidden");
        }
    })
    //     
    //  
    $('#btnSearchMain').click(function () {
        var customerCheckbox = $('#CashCheckbox').is(":checked");
        var cashCustomerId = $('#SearchDetailCode').val();

        var detailAccountCheckbox = $('#AllAccountCheckbox').is(":checked");
        var detailAccountId = $('#SearchAllDetailCode').val();

        var voucherNoCheckbox = $('#voucherNoCheckbox').is(":checked");
        var voucherNo = $('#SearchVoucherNo').val();

        var referenceNoCheckbox = $('#ReferenceNoCheckbox').is(":checked");
        var referenceNo = $('#SearchReferenceNo').val();

        var dateCheckbox = $('#DateCheckbox').is(":checked");
        var fromDate = $('#SearchFromDate').val();
        var toDate = $('#SearchToDate').val();
        $('#btnSearchMain').prop("disabled", true);
        $.ajax({
            type: "POST",
            url: "/cash/SetSessionsForCashList/",
            dataType: 'json',
            data: {
                'cashCheckbox': customerCheckbox, 'cashCustomerId': cashCustomerId, 'detailCheckbox': detailAccountCheckbox,
                'detailAccountId': detailAccountId, 'dateCheckbox': dateCheckbox, 'fromDate': fromDate,
                'toDate': toDate, 'voucherNoCheckbox': voucherNoCheckbox, 'voucherNo': voucherNo,
                'referenceNoCheckbox': referenceNoCheckbox, 'referenceNo': referenceNo,
            },
            success: function (response) {
                getVouchers();

            }
        })
    })
    function getVouchers() {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableCashPayment').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableCashPayment'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "bDestroy": true,
            //"scrollX": true,
            "ajax": {
                "url": "/cash/GetAllCashPayments",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "VoucherNo", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#CashPaymentListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "VoucherNo", "name": "VoucherNo", "width": "20%", "autoWidth": true, "orderable": true, "class": "Acenter" },
                     {
                         "data": "VoucherDate", "class": "Acenter", "width": "15%", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "DetailName", "name": "DetailName", "width": "25%", "autoWidth": true, "orderable": true },
                     { "data": "Credit", "name": "Credit", "width": "14%", "orderable": true, "autoWidth": true, "class": "Aright" },
                     { "data": "Remarks", "name": "Remarks", "width": "26%", "orderable": true, "autoWidth": true },
                     { "data": "RefrenceNo", "name": "RefrenceNo", "width": "120px", "orderable": true, "autoWidth": true },
                     { "data": "PaidBy", "name": "PaidBy", "width": "150px", "autoWidth": true, "orderable": true },
                     { "data": "ReceivedBy", "name": "ReceivedBy", "width": "150px", "orderable": true, "autoWidth": true },

            ]
        });
        $('#btnSearchMain').prop("disabled", false);
    }
    function GetTodayDateSearch() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        var dt = new Date(today);
        dt.setDate(dt.getDate() - 7);
        var dd2 = dt.getDate();
        var mm2 = dt.getMonth() + 1; //January is 0!

        var yyyy2 = dt.getFullYear();
        if (dd2 < 10) {
            dd2 = '0' + dd2;
        }
        if (mm2 < 10) {
            mm2 = '0' + mm2;
        }
        var today2 = yyyy2 + '-' + mm2 + '-' + dd2;
        $('#SearchFromDate').val(today2);
        $('#SearchToDate').val(today);
    }
    function NumberPostiveWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            charCode != 8 && charCode != 127 &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
