@model POS.Models.clsVoucher
@{
    Layout = null;
}
<div class="widget-body no-padding" style="overflow-x:hidden;">
    @using (Html.BeginForm("printvouchersdaybookreport", "cash", FormMethod.Post, new { id = "voucherDaybookForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
    {

        <fieldset id="myField1">
            <div class="row">
                <section class="col col-md-12">
                    <label>Select Voucher Type</label>
                    <div id="DetailCodeDiv">
                        @Html.DropDownListFor(m => m.VoucherType, ViewBag.VoucherType as SelectList, new { @id = "VoucherType", @style = "width:100%", @multiple = "multiple" })
                    </div>
                </section>
            </div>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>From</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="FromDate" name="FromDate" required />
                    </label>
                </div>
            </section>
            <section class="col-md-6">
                <div style="padding:3px;">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-calendar"></i>
                        <input type="date" id="ToDate" name="ToDate" required />
                    </label>
                </div>
            </section>
        </fieldset>
        <footer>
            <button formtarget="_blank" type="submit" class="btn btn-labeled btn-primary pull-right">
                GENERATE REPORT
            </button>
        </footer>
    }
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#VoucherType').select2();
        GetTodayBetweenDate();
    });
    //$('#DetailCode').change(function () {
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('border-color', '#CCCCCC');
    //    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-choices').css('color', 'black');
    //})
    function GetTodayBetweenDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        $('#FromDate').val(today);
        $('#ToDate').val(today);
    }
