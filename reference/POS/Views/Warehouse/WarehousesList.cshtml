<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop:1366,
            tablet: 1024,
            phone: 380
        };

        $('#myTableWarehouse').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableWarehouse'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/warehouse/GetAllWarehouses",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "WarehouseID", "class": "Acenter", "width": "20px", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#WarehouseListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "WarehouseName", "name": "WarehouseName", "autoWidth": true, "orderable": true, },
                    { "data": "WarehouseAbb", "name": "WarehouseAbb", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    { "data": "Address", "name": "Address", "autoWidth": true, "orderable": true, },
                    { "data": "Phone1", "name": "Phone1",  "autoWidth": true, "orderable": true, },
                    { "data": "Phone2", "name": "Phone2",  "autoWidth": true, "orderable": true, },
                    { "data": "Cell1", "name": "Cell1",  "autoWidth": true, "orderable": true, },
                    { "data": "Cell2", "name": "Cell2",  "autoWidth": true, "orderable": true, },
                    { "data": "Email", "name": "Email",  "autoWidth": true, "orderable": true, },
                    { "data": "WarehouseIncharge", "name": "WarehouseIncharge", "autoWidth": true, "orderable": true, },
                    { "data": "Status", "name": "Status", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    
            ]
        });
        oTable = $('#myTableWarehouse').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var warehouseId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/warehouse/GetWarehouseById/" + warehouseId,
                dataType: 'json',
                success: function (response) {
                    //response.data.ReportType;
                    $('#WarehouseName').prop("disabled", false);
                    $('#WarehouseAbb').prop("disabled", false);
                    $('#Phone1').prop("disabled", false);
                    $('#Phone2').prop("disabled", false);
                    $('#Cell1').prop("disabled", false);
                    $('#Cell2').prop("disabled", false);
                    $('#Email').prop("disabled", false);
                    $('#WarehouseIncharge').prop("disabled", false);
                    $('#Address').prop("disabled", false);
                    $('#WarehouseID').val(response.data.WarehouseID);
                    $('#WarehouseName').val(response.data.WarehouseName);
                    $('#WarehouseAbb').val(response.data.WarehouseAbb);
                    $('#Phone1').val(response.data.Phone1);
                    $('#Phone2').val(response.data.Phone2);
                    $('#Cell1').val(response.data.Cell1);
                    $('#Cell2').val(response.data.Cell2);
                    $('#Email').val(response.data.Email);
                    $('#WarehouseIncharge').val(response.data.WarehouseIncharge);
                    $('#Address').val(response.data.Address);
                    $('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveWarehouse').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchWarehouse').click(function () {
            SearchItem();
        });
        $('#txtSearchWarehouse').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryWarehouse");
            if (BElement.html().trim() == 'Name') {
                oTable.columns(0).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Abbreviation') {
                oTable.columns(1).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Address') {
                oTable.columns(2).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Email') {
                oTable.columns(3).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Incharge') {
                oTable.columns(4).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(5).search($('#txtSearchWarehouse').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshWarehouse').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchWarehouse").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryWarehouse").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
