                    $('#PurchaseInvoiceNoSpan').html(response);
                }
            })
            $('.deleteRow').attr("hidden", "hidden");
            $('.DeleteSection').attr("hidden", "hidden");
        }
        $('#txtItemID').change(function () {
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
        })
        $('#WarehouseID').change(function () {
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');
        })

        
        $('#MainDetailCode').change(function () {
            var detailCode = $(this).val();
            var code = $('#PurchaseInvoiceNo').val();
            var voucherNo = code;
            $.ajax({
                type: "POST",
                url: "/purchase/getCreditDaysAndPreviousBalance/",
                dataType: 'json',
                data: { 'detailCode': detailCode, 'code': code, 'voucherNo': voucherNo },
                success: function (response) {
                    $('#CreditDays').val(response.creditDays);
                    $('#PreviousBalance').html(ReplaceNumberWithCommas(parseFloat(response.previousBalance).toFixed(2)));
                }
            })
        })
        $('#txtItemID').change(function () {
            getItemInfo();
