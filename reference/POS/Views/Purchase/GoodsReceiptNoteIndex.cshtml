                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }

            var radioValue = $("input[name='InvoiceType']:checked").val();
            if (radioValue == "Cash") {
                var cashCustomerName = $("#CashCustomerName").val();
                if (cashCustomerName == '' || cashCustomerName == null) {
                    alert("Supplier is required.");
