@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="PurchaseListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Goods Receipt Note List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="purchaseListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="DocumentModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Attach Documents</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="documentsDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>

    <div class="modal fade" id="ItemStockListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Item Stock List (Warehouse Base) </h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="itemStockListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="ItemListNewModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Items List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="itemListNewDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>

    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Goods Receipt Note</h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("InsertUpdateGoodsReceiptNote", "purchase", FormMethod.Post, new { id = "purchaseForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                <input type="hidden" id="DefaultWarehouseId" value="@User.WarehouseId" />
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <input type="hidden" id="DisableOrNot" value="0" />
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 42%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Purchase Invoice" id="btnAddPurchase" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSavePurchase" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveAndPrintTd" hidden>
                                                <button title="Save and Print" class="btnUpSave" id="btnSaveAndPrintPurchase" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/Print.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="documentTd" hidden>
                                                <a title="Attach Document" id="btnAttachDocument" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#DocumentModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/Document2.png" style="width: 42px; height: 42px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Goods Receipt Note List" id="btnPurchaseList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#PurchaseListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshPurchase" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 43%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitPurchase" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSavePurchase" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveAndPrintTd" hidden>
                                                <button title="Save and Print" class="btnUpSave" id="btnSaveAndPrintPurchase" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/Print.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="documentTd" hidden>
                                                <a title="Attach Document" id="btnAttachDocument" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#DocumentModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/Document2.png" style="width: 42px; height: 42px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 41%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Goods Receipt Note List" id="btnPurchaseList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#PurchaseListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshPurchase" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitPurchase" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="row" style="padding-left: 10px; padding-right: 10px; ">
                                <div class="col-md-12" id="" style="padding-top: 15px; padding-bottom: 15px;" >
                                    <div class="col-md-6" id="invoiceNoSection" hidden>
                                        <input type="hidden" id="IsNewOrEdit" value="" />
                                        <input type="hidden" id="HiddenTr" value="0" />
                                        <input type="hidden" id="PurchaseInvoiceNo" value="0" />
                                        <input type="hidden" id="LineNetRateHidden" value="0" />
                                        <input type="hidden" id="RateHidden" value="0" />
                                        <input type="hidden" id="IsEdit" value="0" />
                                        <input type="hidden" id="ItemName" value="0" />
                                        <label class="" style="font-size:16px;">
                                            GRN No:
                                            <span class="badge bg-color-blue" id="PurchaseInvoiceNoSpan" style="font-size:16px;border-radius:4px;padding:5px;"></span>
                                        </label>
                                    </div>
                                    <div class="col-md-1 pull-left">
                                        <label>
                                            <input type="radio" value="Credit" class="radiobox style-0" checked="checked" name="InvoiceType">
                                            <span>Credit</span>
                                        </label>
                                    </div>
                                    <div class="col-md-1 pull-left">
                                        <label>
                                            <input type="radio" value="Cash" class="radiobox style-0" name="InvoiceType">
                                            <span>Cash</span>
                                        </label>
                                    </div>
                                    <div class="col-md-4 PreviousBalance" hidden>
                                        <label class="pull-right" hidden>
                                            <span style="font-size: 16px" id="PreviousBalanceLbl">Previous Balance:</span>
                                            <span style="font-size: 17px; margin-left: 8px; color: green;" id="PreviousBalance">0.00</span>
                                        </label>
                                    </div>
                                </div>
                                </div>
                                <div class="row" style="padding-left: 10px; padding-right: 10px; ">
                                    <div class="col-md-12" style="padding-top: 15px; padding-bottom: 15px;">
                                        <div class="col-md-4">
                                            <div style="padding: 3px">
                                                <label>Select Supplier</label>
                                                <label class="select" id="MainDetailSelect">
                                                    <i class="append fa fa-caret-down"></i>
                                                    @Html.DropDownListFor(model => model.DetailCode, ViewBag.DetailCode as SelectList, new { @style = "width:100%", @id = "MainDetailCode" })
                                                </label>
                                                <label class="input" id="CashCustomerNameLbl" hidden>
                                                    <i class="icon-prepend fa fa-user"></i>
                                                    <select id="CashCustomerName" name="CashCustomerName" style="width:100%"></select>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div style="padding: 3px">
                                                <label>Date</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-calendar"></i>
                                                    <input type="date" name="Date" id="Date" min="@ViewBag.FromDate" max="@ViewBag.ToDate" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div style="padding: 3px; ">
                                                <label>Reference No.</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-hashtag"></i>
                                                    <input type="text" name="ReferenceNo" id="ReferenceNo" placeholder="Reference No." autocomplete="off" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-2" hidden>
                                            <div style="padding: 3px; ">
                                                <label>Credit Days</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-money-bill-alt"></i>
                                                    <input type="text" name="CreditDays" id="CreditDays" class="CreditDays" placeholder="Credit Days" autocomplete="off" />
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <h1 class="heading-1" style="margin-top: 10px;margin-bottom:5px; color: #03386C;font-weight:bold "><span>Invoice Detail</span></h1>
                                <div class="row" style="padding-bottom:15px;" >
                                    <div class="col col-3">
                                        <label>Select Warehouse</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <div id="WarehouseIDDiv">
                                                @Html.DropDownListFor(model => model.WarehouseID, ViewBag.Warehouse as SelectList, new { @style = "width:100%", @id = "WarehouseID" })
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col col-5">
                                    </div>
                                    <div class="col col-2" hidden>
                                        <label class="checkbox pull-right" style="">
                                            <input id="LineDiscountCheckbox" type="checkbox" name="LineDiscountCheckbox" checked><i></i>
                                            <span style="font-size:11px;">Discount</span>
                                        </label>
                                    </div>
                                    <div class="col col-1" hidden>
                                        <label class="checkbox" style="">
                                            <input id="LineTax1Checkbox" type="checkbox" name="LineTax1Checkbox" checked><i></i>
                                            <span style="font-size:11px">Tax1</span>
                                        </label>
                                    </div>
                                    <div class="col col-1" hidden>
                                        <label class="checkbox" style="">
                                            <input id="LineTax2Checkbox" type="checkbox" name="LineTax2Checkbox" checked><i></i>
                                            <span style="font-size:11px">Tax2</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="padding-top: 15px; padding-bottom: 15px;padding-left:10px;padding-right:10px">
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 100%;" id="AccountNameTd">
                                                        <div style="padding: 3px">
                                                            <label>Select Item</label>
                                                            @*@Html.DropDownListFor(model => model.ItemID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtItemID" })*@
                                                            <label class="select">
                                                                <i class="append fa fa-caret-down"></i>
                                                                <div id="ItemIDDiv">
                                                                    @Html.DropDownListFor(model => model.ItemID, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "txtItemID" })
                                                                </div>
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td style="width: 2%;padding-left: 3px;padding-top:7px " id="ItemsListNewTd">
                                                        <a href="javascript:void(0);" class="btn btn-primary btn-circle btnItemListNew" data-toggle="modal" data-target="#ItemListNewModal" style="margin-top:10px;" title="Select Item From Items List">
                                                            <i class="glyphicon glyphicon-edit" style="margin-top:-10px;margin-left:1px"></i>
                                                        </a>
                                                    </td>
                                                    <td style="width: 2%;padding-left: 3px;padding-top:7px " id="ItemStockListTd" hidden>
                                                        <a href="javascript:void(0);" class="btn btn-primary btn-circle btnItemStockList" style="margin-top:10px;" title="Show Item Stock Warehouse Base">
                                                            <i class="glyphicon glyphicon-list" style="margin-top:-10px;margin-left:1px"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-md-2">
                                            <div style="padding: 3px">
                                                <label>Qty</label>
                                                <label class="input">
                                                    <input type="text" name="Quantity" id="Quantity" placeholder="Qty" autocomplete="off" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-7">
                                            <div style="padding: 3px">
                                                <label>Item Note</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-info"></i>
                                                    <input type="text" name="ItemNote" id="ItemNote" placeholder="Item Note" autocomplete="off" />
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" id="ItemInfoDiv" style="padding-left:15px;padding-right:15px;padding-bottom:15px" hidden>

                                </div>

                                <center>
                                    <a title="Add Detail" id="btnAddInvoiceDetail" href="javascript:void(0)" class="btn btn-primary" style="width:95px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                        <i class="fa fa-plus"></i> Add
                                    </a>
                                    <a title="Cancel" id="btnCancelDetail" href="javascript:void(0)" class="btn btn-default" style="width:75px; height:28px;color:#333; margin-bottom:8px;line-height:26px;border-radius:5px;" hidden>
                                        Cancel
                                    </a>
                                </center>
                                <div class="col-md-12" style="margin-top:10px;margin-bottom:40px">
                                    <table id="invoiceDetailTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center;border-right:none "></th>
                                                <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center; border-left: none; "></th>
                                                <th style="width: 40px; background-color: #03386C; color: white; padding: 7px; text-align: center;">Sr#</th>
                                                <th data-hide="" style="width: 150px; background-color: #03386C; color: white; padding: 7px; text-align: left; ">Item Code</th>
                                                <th data-hide="" style="width: 300px; background-color: #03386C; color: white; padding: 7px; text-align: left; ">Item Name</th>
