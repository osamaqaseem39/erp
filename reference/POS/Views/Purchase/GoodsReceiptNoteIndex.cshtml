            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("Error! Please add invoice detail");
                return false;
            }
            var netAmount = 0;
            var paidAmount = 0;
            
            $('#btnSavePurchase').prop('disabled', true);
            $('#btnSaveAndPrintPurchase').prop('disabled', true);
            var invoiceDetailData = JSON.stringify(getAllData());
