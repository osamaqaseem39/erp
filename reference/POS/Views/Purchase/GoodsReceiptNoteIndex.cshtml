    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">

        $('input[type=radio][name=InvoiceType]').change(function () {
            var radioValue = $("input[name='InvoiceType']:checked").val();
            if (radioValue == 'Cash') {
                $('#CashCustomerNameLbl').removeAttr("hidden");
                $('#MainDetailSelect').attr("hidden", "hidden");
                $('#CashCustomerNameLbl').show();
                $('#MainDetailSelect').hide();
                $('#MainDetailCode').val(null).trigger('change');
                $('#CashCustomerName').val("");
            }
            else {
                $('#MainDetailSelect').removeAttr("hidden");
                $('#CashCustomerNameLbl').attr("hidden", "hidden");
                $('#CashCustomerNameLbl').hide();
                $('#MainDetailSelect').show();
                $('#MainDetailCode').val(null).trigger('change');
                $('#CashCustomerName').val("");
            }
        });

        $('#togglePannel').click(function () {
            if ($('#DisableOrNot').val() == 1) {

                if ($('#iconToggle').hasClass('fa-plus')) {
                    $('#iconToggle').removeClass('fa-plus');
                    $('#iconToggle').addClass('fa-minus');
                    $('#ExtraInfoOrNot').val(1);
                    $('#ExtraInformation').slideDown().removeAttr("hidden");
                }
                else {
                    $('#iconToggle').removeClass('fa-minus');
                    $('#iconToggle').addClass('fa-plus');
                    $('#ExtraInfoOrNot').val(0);
                    $('#Transporter').val('');
                    $('#BiltyNo').val('');
                    $('#Packing').val('');
                    $('#SalesmanID').val(null).trigger('change');
                    $('#BiltyPending').prop('checked', false);
                    $('#ExtraInformation').slideUp(function () { $('#ExtraInformation') });
                }
            }
            return false;
        })
        $('#btnAddInvoiceDetail').click(function () {

            if ($('#DisableOrNot').val() == 1) {
                $('#IsEdit').val(0);
                var itemId = $('#txtItemID option:selected').val();
                var warehouseId = $('#WarehouseID option:selected').val();
                var check = 0;
                if (itemId == '' || itemId == null || itemId == 0) {
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#cf564a');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', '#cf564a');
                    check = 1;
                }
                if (warehouseId == '' || warehouseId == null || warehouseId == 0) {
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#cf564a');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', '#cf564a');
                    check = 1;
                }
                var quantity = $('#Quantity').val();
                if (quantity == '' || quantity == null) {
                    $('#Quantity').css('border-color', '#A90329');
                    $('#Quantity').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (check == 1) {
                    return false;
                }
                
                var itemNote = $('#ItemNote').val();
                var vtable = $('#invoiceDetailTable').DataTable();
                var itemName = $('#txtItemID option:selected').text();
                var warehouseName = $('#WarehouseID option:selected').text();
                var itemDesc = $('#ItemName').val();

                if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                    vtable.row.add([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<center><span class='SrNo'><input type='hidden' class='SR01' value='' /></span></center>",
                    "<span><input type='hidden' class='ItemID01' value=" + itemId + " />" + itemName + "</span>",
                    "<span><input type='hidden' class='ItemName01' value=" + itemDesc + " />" + itemDesc + "</span>",
                    "<span><input type='hidden' class='WarehouseID01' value=" + warehouseId + " />" + warehouseName + "</span>",
                    "<span style='text-align:center;' class='text-center'><input type='hidden' class='Quantity01' value=" + quantity + " /><center>" + quantity + "</center></span>",
                    "<span><input type='hidden' class='ItemNote01' value=" + itemNote + " />" + itemNote + "</span>",
                    ]).draw(false);
                }
                else {
                    $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
                    $('#btnCancelDetail').hide();
                    var tr = $('#HiddenTr').val();
                    vtable.row(tr).data([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<center><span class='SrNo'><input type='hidden' class='SR01' value='' /></span></center>",
                    "<span><input type='hidden' class='ItemID01' value=" + itemId + " />" + itemName + "</span>",
                    "<span><input type='hidden' class='ItemName01' value=" + itemDesc + " />" + itemDesc + "</span>",
                    "<span><input type='hidden' class='WarehouseID01' value=" + warehouseId + " />" + warehouseName + "</span>",
                    "<span style='text-align:center;float:center' class=''><input type='hidden' class='Quantity01' value=" + quantity + " /><center>" + quantity + "</center></span>",
                    "<span><input type='hidden' class='ItemNote01' value=" + itemNote + " />" + itemNote + "</span>",
                    ]).draw(false);
                }
                getSerialNo();
                /////////
                //$('#WarehouseID').val(null).trigger('change');
                //$('#txtItemID').val(null).trigger('change');
                $('#txtItemID').val(null).trigger('change');
                //$('#Stock').val('');
                $('#Quantity').val('');
                $('#ItemNote').val('');
                $('#ItemName').val('');
                $('#ItemInfoDiv').attr("hidden", "hidden");
                $('#txtItemID').select2('open');
            }
        })
        function getSerialNo() {
            var i = 0;
            $('.SrNo').each(function () {
                i++;
                $(this).html(i);
            })
        }
        $('#WarehouseID').on('select2:select', function (e) {
            $('#txtItemID').select2('open');
        });
        $('#txtItemID').on('select2:select', function (e) {
            $('#Quantity').focus();
        });
        $('#btnCancelDetail').click(function () {
            $('#IsEdit').val(0);
            $('#btnCancelDetail').hide();
            //$('#WarehouseID').val(null).trigger('change');
            $('#txtItemID').val(null).trigger('change');
            $('#Quantity').val('');
            $('#ItemNote').val('');
            $('#ItemName').val('');
            $('#ItemInfoDiv').attr("hidden", "hidden");

            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');
        })
        $(document).on('click', '.editRowBtn', function () {
            var vtable = $('#invoiceDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#HiddenTr').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var itemId = data[3].split('value=')[1].split('/>')[0].trim();
            var itemDesc = data[4].split('value=')[1].split('/>')[0].trim();
            var warehouseId = data[5].split('value=')[1].split('/>')[0].trim();
            var quantity = data[6].split('value=')[1].split('/>')[0].trim();
            var itemNote = data[7].split('value=')[1].split('/>')[0].trim();

            if ($('#txtItemID').find("option[value='" + itemId + "']").length) {
                $('#txtItemID').val(itemId).trigger('change');
            } else {
                // Create a DOM Option and pre-select by default
                var itemName = data[3].split('/>')[1].split('</span>')[0].trim();
                var newOption = new Option(itemName, itemId, true, true);
                // Append it to the select
                $('#txtItemID').append(newOption).trigger('change');
            }
            $('#IsEdit').val(1);
            $('#WarehouseID').val(warehouseId).trigger('change');
            $('#Quantity').val(quantity);
            $('#ItemNote').val(itemNote);
            $('#ItemName').val(itemDesc);
            $('#btnAddInvoiceDetail').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelDetail').removeAttr("hidden");
            $('#btnCancelDetail').show();           
            getItemInfo();
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');
        })
        $(document).on('click', '.deleteRowBtn', function () {
            $('#IsEdit').val(0);
            var vtable = $('#invoiceDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            getSerialNo();
            $('#btnCancelDetail').hide();
            //$('#WarehouseID').val(null).trigger('change');
            $('#txtItemID').val(null).trigger('change');
            $('#Quantity').val('');
            $('#ItemNote').val('');
            $('#ItemInfoDiv').attr("hidden", "hidden");
            
            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
        })

        $('#Quantity').keydown(function () {
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
        }).mousedown(function () {
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
        })

        function ClearFormFields() {
            $('#CashCustomerNameLbl').hide();
            $('#MainDetailSelect').show();
            $("input[type='radio']").prop("disabled", true);
            $('.PreviousBalance').attr("hidden", "hidden");
            $('#IsEdit').val(0);
            $('#PreviousBalance').html('0.00');

            $('#DisableOrNot').val(0);
            $('#MainDetailCode').select2().enable(false);
            $('#MainDetailCode').val(null).trigger('change');
            $('#SalesmanID').select2().enable(false);
            $('#SalesmanID').val(null).trigger('change');
            $('#WarehouseID').select2().enable(false);
            $('#WarehouseID').val($('#DefaultWarehouseId').val()).trigger('change');
            $("#txtItemID").prop("disabled", true);
            //$('#txtItemID').val(null).trigger('change');
            $('#txtItemID').val(null).trigger('change');
            $('#ItemName').val('');

            $('#documentTd').attr("hidden", "hidden");
            $('#Date').prop("disabled", true);
            $('#ReferenceNo').prop("disabled", true);
            $('#CreditDays').prop("disabled", true);
            $('#Remarks').prop("disabled", true);

            $('#Transporter').prop("disabled", true);
            $('#BiltyNo').prop("disabled", true);
            $('#BiltyDate').prop("disabled", true);
            $('#BiltyPending').prop("disabled", true);
            $('#Packing').prop("disabled", true);

            $('#Quantity').prop("disabled", true);
            $('#ItemNote').prop("disabled", true);

            $('#btnCancelDetail').hide();
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
            $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');

            GetTodayDate();
            $('#ReferenceNo').val('');
            $('#CreditDays').val('');
            $('#Remarks').val('');
            $('#ExtraInfoOrNot').val(0);
            $('#Transporter').val('');
            $('#BiltyNo').val('');
            $('#Packing').val('');
            $('#BiltyPending').prop('checked', false);
            $('#ExtraInformation').attr("hidden", "hidden");

            $('#ItemInfoDiv').attr("hidden", "hidden");
            //$('#Stock').val('');
            $('#Quantity').val('');
            //$('#ItemNote').val('');

            var vtable = $('#invoiceDetailTable').DataTable();
            vtable.clear().draw();
            
            $('#btnSavePurchase').prop('disabled', true);
            $('#btnSaveAndPrintPurchase').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('#saveAndPrintTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#invoiceNoSection').attr("hidden", "hidden");
            $('#IsNewOrEdit').val("New");
            $('#PurchaseInvoiceNo').val(0);
            $('#PurchaseInvoiceNoSpan').html('0');
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.DeleteSection').attr("hidden", "hidden");
        }
        $('#btnAddPurchase').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('.PreviousBalance').removeAttr("hidden");
            $('#IsEdit').val(0);
            $('#CashCustomerNameLbl').hide();
            $('#MainDetailSelect').show();
            $("input[type='radio']").prop("disabled", false);

            $('#DisableOrNot').val(1);
            $('#MainDetailCode').select2().enable(true);
            $('#MainDetailCode').val(null).trigger('change');
