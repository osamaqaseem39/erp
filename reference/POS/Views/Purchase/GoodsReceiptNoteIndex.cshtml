            $('#ReferenceNo').prop("disabled", false);
            $('#CreditDays').prop("disabled", false);
            $('#Remarks').prop("disabled", false);

            $('#Transporter').prop("disabled", false);
            $('#BiltyNo').prop("disabled", false);
            $('#BiltyDate').prop("disabled", false);
            $('#BiltyPending').prop("disabled", false);
            $('#Packing').prop("disabled", false);
            $('#ExtraInformation').attr("hidden", "hidden");
            $('#Quantity').prop("disabled", false);
            $('#ItemNote').prop("disabled", false);
            
            $('#btnCancelDetail').hide();
            $('#Quantity').css('border-color', '#bdbdbd');
            $('#Quantity').css('background-color', '#fff');
            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
            $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
