<!-- widget content -->
@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style="padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-home fa-fw "></i>
                Report
                <span>
                    >
                    Purchase Summary Item
                </span>
            </h1>
        </div>
    </div>
    <section>
        <div class="panel">
            <div class="panel-heading">
                @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @id = "downloadForm", @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                {
                    <span class="header"> Purchase Summary Item Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                    <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                    <input type="hidden" name="FileName" id="FileName" value="PurchaseSummaryItem" />
                    <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                        Print
                    </button>
                    <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                }
            </div>
            <div class="panel-body">
                <div id="HtmlData">
                    <div id="printable-content" class="panel rpt" style=" float: left;width: 800px; font-family: Arial, Helvetica, sans-serif;">
                        <table style="padding: 30px;padding-top:0px" id="myTable">
                            <tr>
                                <th style="font-weight: bold; font-size: 12px; text-align: right;font-weight:normal" colspan="12"><strong>Print Date:&nbsp;</strong>@*<span class="LocalDate"></span>*@@Convert.ToDateTime(DateTime.Now).ToString("dd/MM/yyyy hh:mm tt")</th>
                            </tr>
                            <tr>
                                <th style="font-weight: bold; font-size: 20px; text-align: center; padding-bottom: 5px;padding-top:15px" colspan="6">@System.Web.HttpContext.Current.Application["BusinessName"]</th>
                            </tr>
                            <tr>
                                <th style="font-weight: normal; font-size: 14px; text-align: center; padding-bottom: 5px;" colspan="6">@System.Web.HttpContext.Current.Application["BusinessAddress"]</th>
                            </tr>
                            <tr>
                                <th style="font-weight: bold; font-size: 18px; text-align: center;" colspan="6">Purchase Summary Item Report</th>
                            </tr>
                            @if (Model.InvoicesList2.Count != 0)
                            {
                                <tr>
                                    <th style="font-weight: bold; font-size: 14px; text-align: center;" colspan="6"><strong><span style="font-size: 12px">From:</span> </strong>@Convert.ToDateTime(Model.InvoicesList[0].FromDate).ToString("dd/MM/yyyy")&nbsp; <strong><span style="font-size: 12px">To:&nbsp;</span></strong>@Convert.ToDateTime(Model.InvoicesList[0].ToDate).ToString("dd/MM/yyyy")</th>
                                </tr>
                            }
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding-bottom: 10px" colspan="12">&nbsp;</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="12">
                                        @{
                                            string marginTop = "5px";
                                            if (Model.InvoicesList2.Count != 0)
                                            {
                                                marginTop = "-25px";
                                            }
                                        }
                                        <table class="mainTable" style="margin-top:@marginTop">
                                            <thead>
                                                <tr>
                                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 13px;border:none;border-bottom:1px solid black" colspan="12">&nbsp;</th>
                                                </tr>
                                            </thead>
                                            <tr class="mainTr">
                                                <th style="text-align: center; width: 45px">Sr#</th>
                                                <th style="text-align:left">Item Name</th>
                                                <th style="text-align: right; width: 50px">Qty</th>
                                                <th style="text-align: center;width:50px">UOM</th>
                                                <th class="borderRight" style="text-align: right; width: 100px">Gross Value</th>
                                            </tr>
                                            @if (Model.InvoicesList2.Count != 0)
                                            {
                                                <tbody>
                                                    @{
                                                int j = 0;
                                                Model.InvoicesList2 = Model.InvoicesList2.OrderBy(x => x.ItemName).ToList();
                                                decimal totatlQuantity = 0;
                                                decimal totatlGrossValue = 0;
                                                    }
                                                    @foreach (clsInvoice s in Model.InvoicesList2)
                                                    {
                                                        totatlQuantity += Convert.ToDecimal(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.Qty));
                                                        totatlGrossValue += Convert.ToDecimal(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.GrossValue));
                                                        j++;
                                                        <tr class="mainTr">
                                                            <td style="text-align:center">@(j)</td>
                                                            <td style="text-align: left">@s.ItemName</td>
                                                            @if (Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.Qty) == Convert.ToInt32(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.Qty)))
                                                            {
                                                                <td style="text-align:right">@Math.Round(Convert.ToDecimal(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.Qty)), 0)</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="text-align:right">@Math.Round(Convert.ToDecimal(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.Qty)), 2)</td>
                                                            }
                                                            <td style="text-align: center">@s.UnitName</td>
                                                            <td class="borderRight" style="text-align: right; ">@Convert.ToDecimal(Model.InvoicesList.Where(x => x.ItemID == s.ItemID).Sum(x => x.GrossValue)).ToString("#,##0.00")</td>
                                                        </tr>
                                                    }
                                                    <tr class="mainTr">
                                                        <td style="text-align: right; border: 1px solid #fff;font-weight:bold" colspan="2">Total: </td>
                                                        @if (totatlQuantity == Convert.ToInt32(totatlQuantity))
                                                        {
                                                            <td class="borderRight" style="text-align: right; font-weight: bold; ">@Math.Round(Convert.ToDecimal(totatlQuantity), 0)</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="borderRight" style="text-align: right; font-weight: bold; ">@Math.Round(Convert.ToDecimal(totatlQuantity), 2)</td>
                                                        }
                                                        <td style="text-align: right; border: 1px solid #fff;font-weight:bold"></td>
                                                        <td class="borderRight" style="text-align: right; font-weight: bold;">@Convert.ToDecimal(totatlGrossValue).ToString("#,##0.00")</td>
                                                    </tr>
                                                </tbody>
                                            }
                                            else
                                            {
                                                <tbody>
                                                    <tr class="mainTr">
                                                        <td class="borderRight" colspan="5" style="text-align:center;padding:10px">No Record Found.</td>
                                                    </tr>
                                                </tbody>
                                            }
                                            <tfoot>
                                                <tr>
                                                    <th style="font-weight: bold; font-size: 16px; text-align: center; padding: 10px;  border: none;" colspan="12">&nbsp;</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- END MAIN CONTENT -->
@section pagespecific {
    <script src="~/Scripts/CustomJs/ResponsivePrintScreen.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {

        })
        $('#downloadForm').on("submit", function () {
            $("table").each(function () {
                $(this).css("border-collapse", "collapse");
                $('.mainTable').css("width", "99.8%");
                $('.mainTable').css("margin-top", "-15px");
                $('.tdd').css("border-right", "1px solid black");
                var cssData = $('#CssData').html();
                var htmlData = $('#HtmlData').html();
                $('#DocumentName').val(cssData + htmlData);
            })
            $("table").each(function () {
                $(this).css("border-collapse", "separate");
                $('.mainTable').css("width", "100%");
                $('.mainTable').css("margin-top", "-25px");
                $('.tdd').css("border-right", "0px");
            })
        })
        function PrintElem(elem) {
            var mywindow = window.open('', 'PRINT', 'height=400,width=500');

            mywindow.document.write('<html><head><title></title>');
            mywindow.document.write('</head><body>');
            //mywindow.document.write('<h1></h1>');
            mywindow.document.write(document.getElementById(elem).innerHTML);
            mywindow.document.write('</body></html>');

            mywindow.document.close(); // necessary for IE >= 10
            mywindow.focus(); // necessary for IE >= 10*/

            mywindow.print();
            mywindow.close();

            return true;
        }
        $('.report_body tr td').each(function () {
            if (parseFloat($(this).html()) > 0) {
                $(this).html(ReplaceNumberWithCommas($(this).html()));
            }
        });
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
    </script>
}
