@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $('#Paid').click(function () {
            if ($(this).is(':checked')) {
                $('#PaidRow').removeAttr("hidden");
            }
            else {
                $('#PaidRow').attr("hidden", "hidden");
                $('#ReceivedDetailCode').val(null).trigger('change');
                $('#PaidAmount').val('');
                $('#PaidRemarks').val('');
                getPaidBalanceAmount();
            }
        })
        $('#LineDiscountCheckbox').click(function () {
            if ($(this).is(':checked')) {
                $('#LineDiscountDiv').removeAttr("hidden");
            }
            else {
                $('#LineDiscountDiv').attr("hidden", "hidden");
                $('#LineDiscountType').val('%');
                $('#LineDiscount').val('');
                getLineTotals();
            }
        })
        $('#LineTax1Checkbox').click(function () {
            if ($(this).is(':checked')) {
                $('#tax1Row').removeAttr("hidden");
            }
            else {
                $('#tax1Row').attr("hidden", "hidden");
                $('#Tax1ID').val(null).trigger('change');
                $('#Tax1Rate').val('');
                $('#Tax1Value').val('');
                getTax1Value();
                getTax2Value();
            }
        })
        $('#LineTax2Checkbox').click(function () {
            if ($(this).is(':checked')) {
                $('#tax2Row').removeAttr("hidden");
            }
            else {
                $('#tax2Row').attr("hidden", "hidden");
                $('#Tax2ID').val(null).trigger('change');
                $('#Tax2Rate').val('');
                $('#Tax2Value').val('');
                getTax1Value();
                getTax2Value();
            }
        })
        $('#togglePannel').click(function () {
            if ($('#DisableOrNot').val() == 1) {

                if ($('#iconToggle').hasClass('fa-plus')) {
                    $('#iconToggle').removeClass('fa-plus');
                    $('#iconToggle').addClass('fa-minus');
                    $('#ExtraInfoOrNot').val(1);
                    $('#ExtraInformation').slideDown().removeAttr("hidden");
                }
                else {
                    $('#iconToggle').removeClass('fa-minus');
                    $('#iconToggle').addClass('fa-plus');
                    $('#ExtraInfoOrNot').val(0);
                    $('#Transporter').val('');
                    $('#BiltyNo').val('');
                    $('#Packing').val('');
                    $('#SalesmanID').val(null).trigger('change');
                    $('#BiltyPending').prop('checked', false);
                    $('#ExtraInformation').slideUp(function () { $('#ExtraInformation') });
                }
            }
            return false;
        })
        $('#btnAddInvoiceDetail').click(function () {

            if ($('#DisableOrNot').val() == 1) {
                var itemId = $('#txtItemID option:selected').val();
                var warehouseId = $('#WarehouseID option:selected').val();
                var check = 0;
                if (itemId == '' || itemId == null || itemId == 0) {
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#cf564a');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', '#cf564a');
                    check = 1;
                }
                if (warehouseId == '' || warehouseId == null || warehouseId == 0) {
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#cf564a');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', '#cf564a');
                    check = 1;
                }
                var rate = $('#Rate').val();
                var quantity = $('#Quantity').val();
                if (rate == '' || rate == null) {
                    $('#Rate').css('border-color', '#A90329');
                    $('#Rate').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (quantity == '' || quantity == null) {
                    $('#Quantity').css('border-color', '#A90329');
                    $('#Quantity').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (check == 1) {
                    return false;
                }
                //var itemNote = $('#ItemNote').val();
                var discountType = '%';
                var discount = 0;
                var tax1Id = null;
                var tax1Name = '';
                var tax1Rate = 0;
                var tax1Value = 0;
                var tax2Id = null;
                var tax2Name = '';
                var tax2Rate = 0;
                var tax2Value = 0;

                if ($('#LineDiscountCheckbox').is(':checked')) {
                    discountType = $('#LineDiscountType').val();
                    discount = $('#LineDiscount').val();
                    if (discount == '' || discount == null) {
                        discount = 0;
                    }
                }
                if ($('#LineTax1Checkbox').is(':checked') && $('#Tax1ID').val() != null && $('#Tax1ID').val() != '' && $('#Tax1ID').val() != 0) {
                    tax1Id = $('#Tax1ID').val();
                    tax1Rate = $('#Tax1Rate').val();
                    tax1Value = $('#Tax1Value').val();
                    if (tax1Rate == '' || tax1Rate == null) {
                        tax1Rate = 0;
                    }
                    if (tax1Value == '' || tax1Value == null) {
                        tax1Value = 0;
                    }
                    tax1Name = $('#Tax1ID option:selected').text();
                }
                if ($('#LineTax2Checkbox').is(':checked') && $('#Tax2ID').val() != null && $('#Tax2ID').val() != '' && $('#Tax2ID').val() != 0) {
                    tax2Id = $('#Tax2ID').val();
                    tax2Rate = $('#Tax2Rate').val();
                    tax2Value = $('#Tax2Value').val();
                    if (tax2Rate == '' || tax2Rate == null) {
                        tax2Rate = 0;
                    }
                    if (tax2Value == '' || tax2Value == null) {
                        tax2Value = 0;
                    }
                    tax2Name = $('#Tax2ID option:selected').text();
                }
                //LineGrossTotal LineNetRate LineNetAmount
                var vtable = $('#purchaseReturnDetailTable').DataTable();
                var itemName = $('#txtItemID option:selected').text();
                var warehouseName = $('#WarehouseID option:selected').text();
                var netRate = ReplaceCommas($('#LineNetRate').html());
                netRate = parseFloat(netRate).toFixed(2);

                var grossTotal = ReplaceCommas($('#LineGrossTotal').html());
                grossTotal = parseFloat(grossTotal).toFixed(2);

                var netAmount = ReplaceCommas($('#LineNetAmount').html());
                netAmount = parseFloat(netAmount).toFixed(2);

                if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                    vtable.row.add([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='ItemID01' value=" + itemId + " />" + itemName + "</span>",
                    "<span><input type='hidden' class='WarehouseID01' value=" + warehouseId + " />" + warehouseName + "</span>",
                    "<span style='text-align:right' class='pull-right'><input type='hidden' class='Rate01' value=" + rate + " />" + ReplaceNumberWithCommas(rate) + "</span>",
                    "<span style='text-align:center;' class='text-center'><input type='hidden' class='Quantity01' value=" + quantity + " /><center>" + quantity + "</center></span>",
                    //"<span><input type='hidden' class='ItemNote01' value=" + itemNote + " />" + itemNote + "</span>",
                    //"<span><input type='hidden' class='LineDiscountType01' value=" + discountType + " />" + discountType + "</span>",
                    //"<span style='text-align:right' class='pull-right'><input type='hidden' class='LineDiscount01' value=" + discount + " />" + discount + "</span>",
                    // "<span><input type='hidden' class='Tax1Id01' value=" + tax1Id + " />" + tax1Name + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax1Rate01' value=" + tax1Rate + " />" + tax1Rate + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax1Value01' value=" + tax1Value + " />" + tax1Value + "</span>",
                    //  "<span><input type='hidden' class='Tax2Id01' value=" + tax2Id + " />" + tax2Name + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax2Rate01' value=" + tax2Rate + " />" + tax2Rate + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='Tax2Value01' value=" + tax2Value + " />" + tax2Value + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='NetRate01' value=" + netRate + " />" + netRate + "</span>",
                    "<span class='pull-right'><input type='hidden' class='GrossTotal01' value=" + grossTotal + " />" + ReplaceNumberWithCommas(grossTotal) + "</span>",
                    //"<span class='pull-right'><input type='hidden' class='NetAmount01' value=" + netAmount + " />" + netAmount + "</span>",
                    ]).draw(false);
                }
                else {
                    $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
                    $('#btnCancelDetail').hide();
                    var tr = $('#HiddenTr').val();
                    vtable.row(tr).data([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='ItemID01' value=" + itemId + " />" + itemName + "</span>",
