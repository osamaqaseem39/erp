        $('#purchaseForm').on('submit', function (e) {
            if (!$("#purchaseForm").valid()) {
                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }
            var count = 0;
            $('#purchaseReturnDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("Error! Please add invoice detail");
                return false;
            }
            var netAmount = ReplaceCommas($('#NetAmount').html());
            var paidAmount = $('#PaidAmount').val();
            if (parseFloat(paidAmount) != 0 && parseFloat(paidAmount) > parseFloat(netAmount))
            {
                alert("Error! Paid amount cannot be greater than net amount.");
                return false;
            }
            $('#btnSavePurchase').prop('disabled', true);
            $('#btnSaveAndPrintPurchase').prop('disabled', true);
            var invoiceDetailData = JSON.stringify(getAllData());
            var url = $('#purchaseForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'data': invoiceDetailData }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == 1) {
                            window.location.href = "/purchase/purchasereturnreport/" + data.invoiceNo;
                        }
                        else {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                 '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                 ' <strong>Success! </strong>' +
                                                 'Purchase Return Saved Succesfully.' +
                                             '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            //$.notify("First Level Saved Successfully.", "success");
                            ClearFormFields();
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSavePurchase').prop('disabled', false);
                        $('#btnSaveAndPrintPurchase').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
