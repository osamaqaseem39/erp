                            </td>
                            <td style=" width:60%;padding-left: 3px; " id="">
                                <label class="input">
                                    <input type="text" id="SearchComputerNo" value="" style="width:100%" disabled />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col col-md-3">
                    <table class="" style="">
                        <tr>
                            <td style="width: 80px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="DateCheckbox" type="checkbox" name="DateCheckbox" checked /><i></i>
                                    <span style="font-size:11px">&nbsp;</span>
                                </label>
                            </td>
                            <td style="width: 85%; padding-right: 3px; padding-left: 0px" id="">

