        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var invoiceNo = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/purchase/GetGoodsReceiptNoteById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    $('#DisableOrNot').val(1);
                    $('#MainDetailCode').select2().enable(true);
                    $('#SalesmanID').select2().enable(true);
                    $('#WarehouseID').select2().enable(true);
                    $('#txtItemID').prop("disabled", false);
                    $("input[type='radio']").prop("disabled", false);
                    $('#Date').prop("disabled", false);
                    $('#ReferenceNo').prop("disabled", false);
                    $('#CreditDays').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#Transporter').prop("disabled", false);
                    $('#BiltyNo').prop("disabled", false);
                    $('#BiltyDate').prop("disabled", false);
                    $('#BiltyPending').prop("disabled", false);
                    $('#Packing').prop("disabled", false);
                    $('#HiddenStock').val(0);
                    $('#Quantity').prop("disabled", false);
                    $('#ItemNote').prop("disabled", false);

                    $('#invoiceNoSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    $('#IsEdit').val(0);
                    $('#PurchaseInvoiceNo').val(response.data.ComputerNo);
                    $('#PurchaseInvoiceNoSpan').html(response.data.ComputerNo);
                    var invoiceType = response.data.InvoiceType;
                    if (invoiceType == 0) {
                        $('#CashCustomerNameLbl').removeAttr("hidden");
                        $('#MainDetailSelect').attr("hidden", "hidden");
                        $('#CashCustomerNameLbl').show();
                        $('#MainDetailSelect').hide();
                        $('#MainDetailCode').val(null).trigger('change');
                        //$('#CashCustomerName').val(response.data.CashCustomerName);
                        if ($('#CashCustomerName').find("option[value='" + response.data.CashCustomerName + "']").length) {
                            $('#CashCustomerName').val(response.data.CashCustomerName).trigger('change');
                        } else {
                            // Create a DOM Option and pre-select by default
                            var newOption = new Option(response.data.CashCustomerName, response.data.CashCustomerName, true, true);
                            // Append it to the select
                            $('#CashCustomerName').append(newOption).trigger('change');
                        }
                        $("input[value='Cash']").prop("checked",true);
                    }
                    else {
                        $('#MainDetailSelect').removeAttr("hidden");
                        $('#CashCustomerNameLbl').attr("hidden", "hidden");
                        $('#CashCustomerNameLbl').hide();
                        $('#MainDetailSelect').show();
                        $('#MainDetailCode').val(response.data.DetailCode).trigger('change');
                        $('#CashCustomerName').val("");
                        $("input[value='Credit']").prop("checked", true);
                    }

                    $('#Date').val(getDate(response.data.RecordDate));
                    $('#ReferenceNo').val(response.data.RefrenceNo);
                    $('#CreditDays').val(response.data.CreditDays);
                    $('#Remarks').val(response.data.Remarks);
                    $('#PreviousBalance').html(ReplaceNumberWithCommas(parseFloat(response.data.PreviousBalance).toFixed(2)));
                    if (response.data.ExtraOrNot == 1) {
                        $('#ExtraInfoOrNot').val(1);
                        $('#ExtraInformation').removeAttr("hidden");
                    }
                    else {
                        $('#ExtraInfoOrNot').val(0);
                        $('#ExtraInformation').attr("hidden", "hidden");
                    }
                    $('#Transporter').val(response.data.Transporter);
                    $('#BiltyNo').val(response.data.BiltyNo);
                    $('#Packing').val(response.data.BiltyPacking);
                    $('#BiltyDate').val(getDate(response.data.BiltyDate));
                    $('#SalesmanID').select2('val', response.data.SalesmanID);
                    if (response.data.BiltyPending == 1) {
                        $('#BiltyPending').prop("checked",true);
                    }
                    else {
                        $('#BiltyPending').prop("checked", false);
                    }

                    $('#btnCancelDetail').hide();
                    $('#WarehouseID').val(null).trigger('change');
                    $('#txtItemID').val(null).trigger('change');
                    $('#txtItemName').val('');
                    $('#Quantity').val('');
                    $('#ItemNote').val('');
                    $('#ItemInfoDiv').attr("hidden", "hidden");
                    $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
                    $('#Quantity').css('border-color', '#bdbdbd');
                    $('#Quantity').css('background-color', '#fff');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
                    $('#ItemIDDiv').closest('#ItemIDDiv').find('.select2-choice').css('color', 'black');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('border-color', '#CCCCCC');
                    $('#WarehouseIDDiv').closest('#WarehouseIDDiv').find('.select2-choice').css('color', 'black');

                    $('#DocumentGallaryPanel').attr("hidden", "hidden");
                    $('#DisplayImage').prop("src", '');

                    $('.DeleteSection').removeAttr("hidden");
                    $('.PreviousBalance').removeAttr("hidden");
                    var vtable = $('#invoiceDetailTable').DataTable();
                    vtable.clear().draw();

                    $('#btnSavePurchase').prop('disabled', false);
                    $('#btnHold').prop('disabled', false);
                    $('#btnSaveAndPrintPurchase').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#holdTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#holdTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '41%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '41%', 'text-align': 'right' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                    getInvoiceDetail(invoiceNo);
                }
            })
        })
        function getInvoiceDetail(invoiceNo) {
            $.ajax({
                type: "POST",
                url: "/purchase/GetGoodsReceiptNoteDetailById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#invoiceDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                       "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<center><span class='SrNo'><input type='hidden' class='SR01' value='' /></span></center>",
                    "<span><input type='hidden' class='ItemID01' value=" + response.data[key].ItemID + " />" + response.data[key].ItemName + "</span>",
                    "<span><input type='hidden' class='ItemName01' value=" + response.data[key].ItemDescription + " />" + response.data[key].ItemDescription + "</span>",
                    "<span><input type='hidden' class='WarehouseID01' value=" + response.data[key].WarehouseID + " />" + response.data[key].WarehouseName + "</span>",
                    "<span style='text-align:center;float:center' class=''><input type='hidden' class='Quantity01' value=" + response.data[key].Qty + " /><center>" + response.data[key].Qty + "</center></span>",
                    "<span><input type='hidden' class='ItemNote01' value=" + response.data[key].ItemNote + " />" + response.data[key].ItemNote + "</span>",
                  ]).draw(false);
                    }
                    getSerialNo();
                }
            })
        }

    });
