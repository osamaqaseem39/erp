                                    <input type="text" id="SearchCashCustomerName" value="" style="width:100%" disabled />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 300px; padding-right: 3px; padding-left: 7px" id="">
