                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 300px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="CashCustomerNameCheckbox" type="checkbox" name="CashCustomerNameCheckbox"><i></i>
                                    <span style="font-size:11px">Cash Supplier</span>
                                </label>
                            </td>
                            <td style=" width:60%;padding-left: 3px; " id="">
