    function getInvoices() {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableSale').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableSale'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "bDestroy": true,
            //"scrollX": true,
            "ajax": {
                "url": "/purchase/GetAllGoodsReceiptNote",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ComputerNo", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#PurchaseListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "ComputerNo", "name": "ComputerNo", "autoWidth": true, "orderable": true },
                    { "data": "DetailName", "name": "DetailName", "autoWidth": true, "orderable": true },
                     { "data": "RefrenceNo", "name": "RefrenceNo", "orderable": true, "autoWidth": true },
                     {
                         "data": "RecordDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                      { "data": "InvoiceTypeName", "name": "InvoiceTypeName", "autoWidth": true, "orderable": true },
                     { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true }
            ]
        });
        $('#btnSearchSale').prop("disabled", false);
    }
    function NumberPostiveWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            charCode != 8 && charCode != 127 &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function GetTodayDateSearch() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        var dt = new Date(today);
        dt.setDate(dt.getDate() - 7);
        var dd2 = dt.getDate();
        var mm2 = dt.getMonth() + 1; //January is 0!

        var yyyy2 = dt.getFullYear();
        if (dd2 < 10) {
            dd2 = '0' + dd2;
        }
        if (mm2 < 10) {
            mm2 = '0' + mm2;
        }
        var today2 = yyyy2 + '-' + mm2 + '-' + dd2;
        $('#SearchFromDate').val(today2);
        $('#SearchToDate').val(today);
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
