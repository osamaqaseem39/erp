        function getAllData() {
            var arrayData = [];
            var count = 0;
            $('#voucherDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#voucherDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();

                var isNewOrEdit = $('#IsNewOrEdit').val();
                var voucherNo = $('#VoucherNo').val();
                var date = $('#Date').val();
                var referenceNo = $('#ReferenceNo').val();
                var mainRemarks = $('.Remarks').val();
                var detailCode = data[2].split('value=')[1].split('/>')[0].trim();
                var remarks = data[3].split('value=')[1].split('/>')[0].trim();
                var debit = data[4].split('value=')[1].split('/>')[0].trim();
                var credit = data[5].split('value=')[1].split('/>')[0].trim();
                var cheque = data[6].split('value=')[1].split('/>')[0].trim();
                var taxId = data[7].split('value=')[1].split('/>')[0].trim();
                var taxRate = data[8].split('value=')[1].split('/>')[0].trim();
                var taxValue = data[9].split('value=')[1].split('/>')[0].trim();
                var netDebit = data[10].split('value=')[1].split('/>')[0].trim();
                var netCredit = data[11].split('value=')[1].split('/>')[0].trim();
                if (taxId == "null") {
                    taxId = 0;
                }
                else {
                    taxId = parseInt(taxId);
                }
                var alldata = {
                    'IsNewOrEdit': isNewOrEdit,
                    'VoucherNo': voucherNo,
                    'VoucherDate': date,
                    'RefrenceNo': referenceNo,
                    'Remarks': mainRemarks,
                    'LineDetailCode': detailCode,
                    'LineDebit': debit,
                    'LineCredit': credit,
                    'LineRemarks': remarks,
                    'LineChequeNo': cheque,
                    'LineChequeComputerNo': 0,
                    'TaxID': taxId,
                    'TaxRate': taxRate,
                    'TaxValue': taxValue,
                    'NetDebit': netDebit,
                    'NetCredit': netCredit,
                }
                arrayData.push(alldata);
            }
            console.log(arrayData);
            return arrayData;
        }
        $('#journalVoucherPaymentForm').on('submit', function (e) {
            e.preventDefault();
            if (!$("#journalVoucherPaymentForm").valid()) {
                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }
            var count = 0;
            $('#voucherDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("Error! Please add voucher detail");
                return false;
            }
            var totalDebit = ReplaceCommas($('#TotalDebit').html());
            var totalCredit = ReplaceCommas($('#TotalCredit').html());
            if (parseFloat(totalDebit) != parseFloat(totalCredit)) {
                alert("Error! Total debit and total credit should be equal.");
                return false;
            }
            
            $('#btnSaveJournalVoucher').prop('disabled', true);
            $('#btnSaveAndPrintJournalVoucher').prop('disabled', true);
            var voucherDetailData = JSON.stringify(getAllData());
            var url = $('#journalVoucherPaymentForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'data': voucherDetailData }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == 1) {
                            window.location.href = "/journalvoucher/journalvoucherreport/" + data.voucherNo;
                        }
                        else {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Voucher Saved Succesfully.' +
                                            '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            //$.notify("First Level Saved Successfully.", "success");
                            EnableFormFields();
                        }
                    }
                    else {
                        alert(data.message); 
                        $('#btnSaveJournalVoucher').prop('disabled', false);
                        $('#btnSaveAndPrintJournalVoucher').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteJournalVoucher').click(function () {
            var voucherNo = $('#VoucherNo').val();
            DeleteJournalVoucher(voucherNo);
        })
        function DeleteJournalVoucher(id) {
            var a = $.confirm({
                title: 'Delete Voucher',
                content: 'Are you sure u want to delete this voucher?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/journalVoucher/DeleteJournalVoucher/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        $("#LineDebit").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $("#LineCredit").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $("#TaxRate").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#Date').val(today);
        }
        function ReplaceCommas(yourNumber) {
            var noCommas = yourNumber.replace(/,/g, ''),
                asANumber = +noCommas;
            return noCommas;
        }
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
    </script>
