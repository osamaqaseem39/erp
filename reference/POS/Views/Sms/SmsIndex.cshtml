@model POS.Models.clsSms
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="ProductionListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Sms List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="productionListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Sms </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("InsertUpdateSms", "sms", FormMethod.Post, new { id = "productionForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <input type="hidden" id="DisableOrNot" value="0" />
                               <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveDefaultDetail" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Sms List" id="btnDefaultDetailList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ProductionListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshDefaultDetail" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitDefaultDetail" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                    </tr>
                                </table>
                                <div class="row" style="padding-left: 10px; padding-right: 10px; ">
                                    <div class="col-md-12" id="" style="padding-bottom: 15px;">
                                        <div class="col-md-12" id="invoiceNoSection" hidden>
                                            <input type="hidden" id="SizeHiddenTr" value="0" />
                                            <input type="hidden" id="FashionHiddenTr" value="0" />
                                            <input type="hidden" id="SmsId" value="0" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="padding-left: 10px; padding-right: 10px; ">
                                    <div class="col-md-12" style="padding-bottom: 5px;">
                                        <div class="col-md-2">
                                            <label class="" style="font-size:16px;margin-top:25px">
                                                Type:
                                                <span class="badge bg-color-blue" id="TypeSpan" style="font-size:16px;border-radius:4px;padding:5px;">-</span>
                                            </label>
                                        </div>
                                        <div class="col-md-2">
                                            <div style="padding: 3px; ">
                                                <label class="checkbox" style="margin-top:22px">
                                                    <input id="Status" type="checkbox" name="Status"><i></i>
                                                    Active
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div style="padding: 3px; ">
                                                <label class="checkbox" style="margin-top:22px">
                                                    <input id="ToCustomer" type="checkbox" name="ToCustomer"><i></i>
                                                    To Customer
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div style="padding: 3px; ">
                                                <label class="checkbox pull-left" style="margin-top:22px">
                                                    <input id="ToUser" type="checkbox" name="ToUser"><i></i>
                                                    To User
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @*Start of In Qty*@
                                <h1 class="heading-1" style="margin-top: 0px;margin-bottom:5px; color: #03386C;font-weight:bold "><span>Sms User</span></h1>
                                <div class="row" style="padding-top: 15px; padding-bottom: 15px;padding-left:10px;padding-right:10px">
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                        </div>
                                        <div class="col-md-6">
                                            <div style="padding: 3px">
                                                <label style="margin-top:2px">Select Sms User</label>
                                                <label class="select">
                                                    <i class="append fa fa-caret-down"></i>
                                                    <div id="SmsUserIdDiv">
                                                        @Html.DropDownListFor(model => model.SmsUserId, ViewBag.SmsUser as SelectList, new { @style = "width:100%", @id = "SmsUserId" })
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                        </div>
                                    </div>
                                </div>
                                <center>
                                    <a title="Add Detail" id="btnAddSize" href="javascript:void(0)" class="btn btn-primary" style="width:95px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                        <i class="fa fa-plus"></i> Add
                                    </a>
                                    <a title="Cancel" id="btnCancelSize" href="javascript:void(0)" class="btn btn-default" style="width:75px; height:28px;color:#333; margin-bottom:8px;line-height:26px;border-radius:5px;" hidden>
                                        Cancel
                                    </a>
                                </center>
                                <div class="col-md-12" style="margin-top:10px;margin-bottom:10px">
                                    <table id="sizeTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center;border-right:none "></th>
                                                <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center; border-left: none; "></th>
                                                <th data-hide="" style="width: 855px; background-color: #03386C; color: white; padding: 7px; text-align: left; ">Sms User</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                @*End of In Qty*@

                                @*Start of Out Qty*@
                                <h1 class="heading-1 outQtyHeading" style="margin-top: 120px;margin-bottom:0px; color: #03386C;font-weight:bold "><span>Sms Field</span></h1>
                               
                                <div class="col-md-12" style="margin-top:10px;margin-bottom:10px">
                                    <table id="fashionTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th data-hide="" style="width: 430px; background-color: #03386C; color: white; padding: 7px; text-align: left;">Field Title</th>
                                                <th data-hide="" style="width: 70px; background-color: #03386C; color: white; padding: 7px; text-align: left;">Sequence No</th>
                                                <th style="width: 120px; background-color: #03386C; color: white; padding: 7px; text-align: left;">New Line</th>
                                                <th style="width: 120px; background-color: #03386C; color: white; padding: 7px; text-align: left;">To Customer</th>
                                                <th style="width: 120px; background-color: #03386C; color: white; padding: 7px; text-align: left;">To User</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                @*End of Out Qty*@

                                <div class="col-md-12 DeleteSection" style="padding-bottom: 15px;padding-top:10px" hidden>
                                    <section class="col col-md-6"></section>
                                    <section class="col col-md-6 deleteRow">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Voucher" id="btnDeleteWorkOrder" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $('#btnAddSize').click(function () {
            if ($('#DisableOrNot').val() == 1) {
                var smsUserId = $('#SmsUserId').val();
                var check = 0;
                if (smsUserId == '' || smsUserId == null || smsUserId == 0) {
                    $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#A90329');
                    $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (check == 1) {
                    return false;
                }
                var vtable = $('#sizeTable').DataTable();
                var smsUserName = $('#SmsUserId option:selected').text();

                if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                    vtable.row.add([
                    "<a href='javascript:void(0);' class='btn btn-success editRowSizeBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='SmsUserID01' value=" + smsUserId + " />" + smsUserName + "</span>",
                    ]).draw(false);
                }
                else {
                    $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
                    $('#btnCancelSize').hide();
                    var tr = $('#SizeHiddenTr').val();
                    vtable.row(tr).data([
                    "<a href='javascript:void(0);' class='btn btn-success editRowSizeBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='SmsUserID01' value=" + smsUserId + " />" + smsUserName + "</span>",
                    ]).draw(false);
                }
                $('#SmsUserId').val(null).trigger('change');
            }
        })
        $('#btnCancelSize').click(function () {
            $('#btnCancelSize').hide();
            $('#SmsUserId').val(null).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $(document).on('click', '.editRowSizeBtn', function () {
            var vtable = $('#sizeTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#SizeHiddenTr').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var smsUserId = data[2].split('value=')[1].split('/>')[0].trim();
            $('#SmsUserId').val(smsUserId).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelSize').removeAttr("hidden");
            $('#btnCancelSize').show();
            $('#btnAddSize').show();
            $('#btnAddSize').removeAttr("hidden");
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $(document).on('click', '.deleteRowSizeBtn', function () {
            $('#EditHidden').val(0);
            var vtable = $('#sizeTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#btnCancelSize').hide();
            $('#SmsUserId').val(null).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $('#SmsUserId').change(function () {
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        function ClearFormFields() {
            $('#DisableOrNot').val(0);
            $('#SmsUserId').select2().enable(false);
            $('#SmsUserId').val(null).trigger('change');
            //Status ToCustomer ToUser SmsUserId
            $('#Status').prop("disabled", true);
            $('#ToCustomer').prop("disabled", true);
            $('#ToUser').prop("disabled", true);

            $('#SmsId').val(0);
            $("#Status").prop("checked", false);
            $("#ToCustomer").prop("checked", false);
            $("#ToUser").prop("checked", false);
            $('#btnCancelSize').hide();
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');

            var vtable = $('#sizeTable').DataTable();
            vtable.clear().draw();

            var vtable2 = $('#fashionTable').DataTable();
            vtable2.clear().draw();


            $('#btnSaveWorkOrder').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#invoiceNoSection').attr("hidden", "hidden");
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.DeleteSection').attr("hidden", "hidden");
        }
        function EnableDisableFields() {
            $('#DisableOrNot').val(0);
            $('#SmsUserId').select2().enable(false);
            $('#SmsUserId').val(null).trigger('change');
            //Status ToCustomer ToUser SmsUserId
            $('#Status').prop("disabled", true);
            $('#ToCustomer').prop("disabled", true);
            $('#ToUser').prop("disabled", true);

            $('#SmsId').val(0);
            $("#Status").prop("checked", false);
            $("#ToCustomer").prop("checked", false);
            $("#ToUser").prop("checked", false);
            $('#btnCancelSize').hide();
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');

            var vtable = $('#sizeTable').DataTable();
            vtable.clear().draw();

            var vtable2 = $('#fashionTable').DataTable();
            vtable2.clear().draw();


            $('#btnSaveWorkOrder').prop('disabled', true);
            //$('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#documentTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.DeleteSection').attr("hidden", "hidden");
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        }
        $('#btnAddProduction').click(function () {
            EnableDisableFields();
        })

        $(document).ready(function () {
            $('#btnCancelSize').hide();
            $('#SmsUserId').select2();
            //$('#Tax1ID').select2();
            //$('#Tax2ID').select2();

            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var responsiveHelper_dt_basic2 = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                tablet: 1024,
                phone: 480
            };
            $('#sizeTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#sizeTable'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });

            $('#fashionTable').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic2) {
                        responsiveHelper_dt_basic2 = new ResponsiveDatatablesHelper($('#fashionTable'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic2.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic2.respond();
                },
                "bPaginate": false,
                "serverSide": false,
                "bLengthChange": false,
                "processing": false,
                "searching": false,
                "bInfo": false,
                "ordering": false,
                "scrollX": true,
                //"scrollY": 200
            });
            EnableDisableFields();
        })
        $('#btnRefreshProduction').click(function () {
            location.reload();
        })
        $('#btnDefaultDetailList').click(function () {
            $('#productionListDiv').load('@Url.Action("smslist", "sms")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function getAllUserData() {
            var arrayData = [];
            var count = 0;
            $('#sizeTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#sizeTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {

                var data = vtable.row(irow).data();
                var smsUserId = data[2].split('value=')[1].split('/>')[0].trim();
                var alldata = {
                    'SmsUserId': smsUserId,
                }
                arrayData.push(alldata);
            }
            return arrayData;
        }
        function getAllFieldData() {
            var arrayData = [];
            var count = 0;
            $('#fashionTable tr[role="row"]').each(function () {
                if (count != 0) {
                    var fieldTitle = $(this).find('.HiddenFieldTitle01').val();
                    var fieldDbName = $(this).find('.HiddenFieldDbName01').val();
                    var sequenceNo = $(this).find('.HiddenSequenceNo01').val();
                    var newLine = $(this).find('.HiddenNewLine01').is(":checked");
                    var toCustomer = $(this).find('.HiddenToCustomer01').is(":checked");
                    var toUser = $(this).find('.HiddenToUser01').is(":checked");
                    var customer = 'N';
                    if (toCustomer == true)
                    {
                        customer = 'Y';
                    }
                    var user = 'N';
                    if (toUser == true) {
                        user = 'Y';
                    }
                    var newLineString = 'N';
                    if (newLine == true) {
                        newLineString = 'Y';
                    }
                    var alldata = {
                        'FieldTitle': fieldTitle,
                        'FieldDbName': fieldDbName,
                        'SequenceNo': sequenceNo,
                        'NewLine': newLineString,
                        'ToCustomer': customer,
                        'ToUser': user,
                    }
                    arrayData.push(alldata);
                }
                count++;
            });

            return arrayData;
        }
        $('#productionForm').on('submit', function (e) {
            if (!$("#productionForm").valid()) {
                return false;
            }
            var count = 0;
            $('#sizeTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            if (rowsCount == 0) {
                alert("Error! Please add Sms User");
                return false;
            }

            var count2 = 0;
            $('#fashionTable tr[role="row"]').each(function () {
                count2++;
            });
            var rowsCount2 = count2 - 1;
            if (rowsCount2 == 0) {
                alert("Error! Sms Field cannot be empty.");
                return false;
            }

            $('#btnSaveWorkOrder').prop('disabled', true);

            //Status ToCustomer ToUser
            var smsId = $('#SmsId').val();
            var status = $('#Status').is(":checked");
            var stringStatus = 'In-Active';
            if (status == true)
            {
                stringStatus = "Active";
            }
            var toCustomer = $('#ToCustomer').is(":checked");
            var toUser = $('#ToUser').is(":checked");
            var customer = 'N';
            if (toCustomer == true) {
                customer = 'Y';
            }
            var user = 'N';
            if (toUser == true) {
                user = 'Y';
            }
            var smsForm =
            {
                SmsId: smsId,
                Status: stringStatus,
                ToCustomer: customer,
                ToUser: user,
            }
            var userData = JSON.stringify(getAllUserData());
            var fieldData = JSON.stringify(getAllFieldData());
            var url = $('#productionForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'sms': smsForm, 'userData': userData, 'fieldData': fieldData }),
                success: function (data) {
                    if (data.status == true) {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Sms Saved Succesfully.' +
                                            '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                                location.reload();
                            });
                            //$.notify("First Level Saved Successfully.", "success");
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveWorkOrder').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteWorkOrder').click(function () {
            var invoiceNo = $('#SmsId').val();
            DeleteProduction(invoiceNo);
        })
        function DeleteProduction(id) {
            var a = $.confirm({
                title: 'Delete Work Order',
                content: 'Are you sure u want to delete this work order?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/workorder/Deleteworkorder/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        //SequenceNo01
        $(document).on('keypress','.SequenceNo01', function (event) {
            NumberPostive(event, this);
        });
        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function ReplaceCommas(yourNumber) {
            var noCommas = yourNumber.replace(/,/g, ''),
                asANumber = +noCommas;
            return noCommas;
        }
        function ReplaceNumberWithCommas(yourNumber) {
            if (yourNumber != "0") {
                //Seperates the components of the number
                var n = yourNumber.toString().split(".");
                //Comma-fies the first part
                n[0] = n[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");

                if (n.length == 1) {
                    n[0] = n[0] + ".00";
                }
                else {
                    if (n[1].toString().length == 1) {
                        n[1] = n[1] + "0";
                    }
                }
                //Combines the two sections
                n = n.join(".");
            }
            else {
                n = yourNumber;
            }
            return n;
        }
    </script>
}