@model POS.Models.clsVoucher
<center>
    @for (int i = 0; i < Model.DetailList.Count; i++)
    {
        decimal detailCode = Model.DetailList[i].DetailCode;
        decimal balance = 0;

        <div class="myBorderDiv" style="border: 1px solid black; padding: 5px; width: 96%; border-radius: 10px; margin-top: 10px; padding-bottom: 20px; margin-bottom: 10px; ">
            <table style="margin-bottom: 30px;margin-top:3px;" class="purchaseHeading">
                <tbody>
                    <tr>
                        <th style="font-weight: bold; font-size: 18px; text-align: left;width:50%;padding-left:14px" class="accountName" colspan="2">@Model.DetailList[i].Name</th>
                        <th style="font-size: 15px; text-align: right; width: 50%; padding-right: 14px; " class="businssName RouteName" colspan="1"><span style="font-weight:normal">Previous Balance:</span> <span style="font-weight:bold;font-size:16px">@Convert.ToDecimal(Model.DetailList[i].PreviousBalance).ToString("#,##0.00")</span></th>
                    </tr>
                </tbody>
            </table>
            @if (Model.VouchersList.Where(x => x.DetailCode == detailCode).Count() != 0)
            {
                int j = 0;
                decimal total= 0;
                <div class="chequeTable2">
                    <table class="mainTable" style="margin-top:2px">
                        <tbody>
                            <tr class="mainTr">
                                <th style="text-align: center; width: 25px">Sr#</th>
                                <th style="text-align:center;width:120px">Date</th>
                                <th style="text-align: left;">Voucher No.</th>
                                <th class="borderRight" style="text-align: right; width: 100px">Amount</th>
                            </tr>
                            @foreach (clsVoucher v in Model.VouchersList.Where(x => x.DetailCode == detailCode))
                            {
                                j++;
                                decimal previousBalance = Convert.ToDecimal(Model.DetailList[i].PreviousBalance);
                                string href = "";
                                //total += Convert.ToDecimal(v.Debit) + Convert.ToDecimal(v.Credit);
                                if (j == 1)
                                {
                                    balance = previousBalance + Convert.ToDecimal(v.Debit) - Convert.ToDecimal(v.Credit);
                                }
                                else
                                {
                                    balance = balance + Convert.ToDecimal(v.Debit) - Convert.ToDecimal(v.Credit);
                                }
                                <tr class="mainTr">
                                    <td style="text-align: center;">@j</td>
                                    <td style="text-align:center">@Convert.ToDateTime(v.VoucherDate).ToString("dd/MM/yy")</td>
                                    <td style="text-align: left;">@v.VoucherNo</td>
                                    @if (v.Debit == 0 && v.Credit == 0)
                                    {
                                        <td class="borderRight" style="text-align: center;font-size:18px">-</td>
                                    }
                                    else if (v.Debit == 0)
                                    {
                                        <td class="borderRight" style="text-align: right;">-@Convert.ToDecimal(v.Credit).ToString("#,##0.00")</td>
                                    }
                                    else if (v.Credit == 0)
                                    {
                                        <td class="borderRight" style="text-align: right;">@Convert.ToDecimal(v.Debit).ToString("#,##0.00")</td>
                                    }
                                    else
                                    {
                                        <td class="borderRight" style="text-align: right;">@Convert.ToDecimal(v.Debit).ToString("#,##0.00")</td>
                                    }
                                </tr>
                            }
                            <tr class="mainTr">
                              <td class="borderRight" style="text-align: right; font-size: 15px; font-weight: bold; border: 1px solid #fff;" colspan="4"><span style="font-weight:normal">Closing Balance:&nbsp;</span> <span style="font-weight:bold;font-size:16px">@Convert.ToDecimal(balance).ToString("#,##0.00")</span> </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <table class="mainTable">
                    <tr class="mainTr">
                        <th style="text-align: center; width: 25px">Sr#</th>
                        <th style="text-align:center;width:90px">Date</th>
                        <th style="text-align: center;width:100px">Voucher No.</th>
                        <th class="borderRight" style="text-align: right; width: 60px">Amount</th>
                    </tr>
                    <tbody>
                        <tr class="mainTr">
                            <td class="borderRight" colspan="4" style="text-align:center;padding:10px">No Record Found.</td>
                        </tr>
                    </tbody>
                </table>
            }
        </div>
    }
</center>
<script type="text/javascript">
    $(document).ready(function () {
        $('#btnSearch').html("Search");
    })
</script>