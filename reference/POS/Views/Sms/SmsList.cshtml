<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic112 = undefined;
        var responsiveHelper_datatable_fixed_column112 = undefined;
        var responsiveHelper_datatable_col_reorder112 = undefined;
        var responsiveHelper_datatable_tabletools112 = undefined;

        var breakpointDefinition112 = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableProduction').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic112) {
                    responsiveHelper_dt_basic112 = new ResponsiveDatatablesHelper($('#myTableProduction'), breakpointDefinition112);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic112.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic112.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            //"scrollX": true,
            "ajax": {
                "url": "/sms/GetAllSms",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "SmsId", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ProductionListModal" class="btn btn-primary selectBtn2" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "Type", "name": "Type", "autoWidth": true, "orderable": true, "class": "Acenter" },
                     { "data": "FormReportName", "name": "FormReportName", "orderable": true, "autoWidth": true },
                    { "data": "Status", "name": "Status", "autoWidth": true, "orderable": true, "class": "Acenter" },
                    { "data": "ToCustomer", "name": "ToCustomer", "autoWidth": true, "orderable": true, "class": "Acenter" },
                    { "data": "ToUser", "name": "ToUser", "autoWidth": true, "orderable": true, "class": "Acenter" },
            ]
        });
        oTable = $('#myTableProduction').DataTable();
        $(document).on('click', '.selectBtn2', function (e) {
            e.preventDefault();
            var invoiceNo = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/sms/GetSmsById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    $('#DisableOrNot').val(1);
                    $('#SmsUserId').select2().enable(true);
                    //Status ToCustomer ToUser SmsUserId
                    $('#Status').prop("disabled", false);
                    $('#ToCustomer').prop("disabled", false);
                    $('#ToUser').prop("disabled", false);
                    $('#TypeSpan').html(response.data.Type);
                    $('#SmsId').val(response.data.SmsId);
                    if (response.data.Status == "Active") {
                        $("#Status").prop("checked", true);
                    }
                    else {
                        $("#Status").prop("checked", false);
                    }
                    if (response.data.ToCustomer == "Y")
                    {
                        $("#ToCustomer").prop("checked", true);
                    }
                    else {
                        $("#ToCustomer").prop("checked", false);
                    }
                    if (response.data.ToUser == "Y") {
                        $("#ToUser").prop("checked", true);
                    }
                    else {
                        $("#ToUser").prop("checked", false);
                    }
                    $('#invoiceNoSection').removeAttr("hidden");
                    $('#SmsId').val(response.data.SmsId);
                    $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
                    $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
                    $('#btnCancelSize').hide();
                    $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
                    //$('.DeleteSection').removeAttr("hidden");

                    $('#btnSaveWorkOrder').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                        $('#listTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    //if ($('#CanSave').val() == 0) {
                    //    $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    //}
                    //else {
                    //    $('#addTd').removeAttr("hidden");
                    //    $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    //}


                    if ($('#CanDelete').val() == 1) {
                        //$('.deleteRow').removeAttr("hidden");
                    }
                    getSmsUser(invoiceNo);
                }
            })
        })
        //response.data[key].ItemID response.data[key].ItemName response.data[key].WarehouseID
        function getSmsUser(invoiceNo) {
            $.ajax({
                type: "POST",
                url: "/sms/GetSmsUserById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#sizeTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                         "<a href='javascript:void(0);' class='btn btn-success editRowSizeBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='SmsUserID01' value=" + response.data[key].SmsUserId + " />" + response.data[key].SmsUserName + "</span>",
                        ]).draw(false);
                    }
                    getFieldDetail(invoiceNo);
                }
            })
        }
        function getFieldDetail(invoiceNo) {
            $.ajax({
                type: "POST",
                url: "/sms/GetSmsFieldById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#fashionTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        var newLine = "";
                        if (response.data[key].NewLine == "Y")
                        {
                            newLine = "checked";
                        }
                        var toCustomer = "";
                        if (response.data[key].ToCustomer == "Y") {
                            toCustomer = "checked";
                        }
                        var toUser = "";
                        if (response.data[key].ToUser == "Y") {
                            toUser = "checked";
                        }
                        vtable.row.add([
                     "<span><input type='hidden' class='HiddenFieldTitle01' value='" + response.data[key].FieldTitle +"' /><input type='hidden' class='HiddenFieldDbName01' value='" + response.data[key].FieldDbName + "' />" + response.data[key].FieldTitle + "</span>",
                     "<span><input type='text' class='HiddenSequenceNo01' style='padding:7px;width:70px' value=" + response.data[key].SequenceNo + " /></span>",
                     "<span class='NewLineSpan'><label class='checkbox' style='margin-top:0px;'><input class='HiddenNewLine01' type='checkbox' name='' " + newLine + "><i></i></label></span>",
                     "<span class='ToCustomerSpan'><label class='checkbox' style='margin-top:0px'><input class='HiddenToCustomer01' type='checkbox' name='' " + toCustomer + "><i></i></label></span>",
                     "<span class='ToUserSpan'><label class='checkbox' style='margin-top:0px'><input class='HiddenToUser01' type='checkbox' name='' " + toUser + "><i></i></label></span>",
                        ]).draw(false);
                    }
                }
            })
        }
        $('#btnSearchProduction').click(function () {
            SearchItem();
        });
        $('#txtSearchProduction').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryProduction");
            if (BElement.html() == 'Amount') {
                NumberPostiveWithDecimal(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryProduction");
            if (BElement.html().trim() == 'Type') {
                oTable.columns(0).search($('#txtSearchProduction').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshProduction').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryProduction").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryProduction").html($this.data("value"));
            if ($("#btnSearchCategoryProduction").html() == 'Amount') {
                $('#txtSearchProduction').val('');
            }
        })
    });
    function NumberPostiveWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            charCode != 8 && charCode != 127 &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
