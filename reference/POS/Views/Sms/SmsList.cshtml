            <div class="col-lg-10">
                <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right">
                    <div class="input-group-btn">
                        <button id="btnSearchCategoryProduction" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Type</button>
                        <ul class="dropdown-menu" id="ulSearchCategoryProduction" style="cursor:pointer">
                            <li data-value="Type">
                                <a class="ListItem">Type</a>
                            </li>
                        </ul>
                    </div>
                    <input class="form-control input-lg" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchProduction">
                    <div class="input-group-btn">
