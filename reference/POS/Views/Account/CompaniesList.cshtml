                ]
            });

            //Apply Custom search on jQuery DataTables here
            oTable = $('#myTable').DataTable();
            $('#btnSearch').click(function () {
                var BElement = $("#btnSearchCategory");
                if (BElement.html() == 'Company Name') {
                    oTable.columns(0).search($('#txtSearch').val().trim()).draw();
                }
                else if (BElement.html() == 'Person Name') {
                    oTable.columns(1).search($('#txtSearch').val().trim()).draw();
                }
                else if (BElement.html() == 'City') {
                    oTable.columns(6).search($('#txtSearch').val().trim()).draw();
                }
                else
                {
                    alert("Error! try again.");
                }
            });
            $('#btnRefresh').click(function () {
                location.reload();
            });
