            function OpenPopup(pageUrl) {
                var $pageContent = $('<div/>');
                $pageContent.load(pageUrl, function () {
                });

                $dialog = $('<div id="dialog_simple" title="Dialog Simple Title"></div>')
                          .html($pageContent)
                          .dialog({
                              draggable: false,
                                  autoOpen: false,
                                  width: 600,
                                  height: 500,
                                  resizable: false,
                                  modal: true,
                                  title: "<div class='widget-header'><h4><i class='fa fa-list'></i> Companies List</h4></div>",
                                  close: function () {
                                      $dialog.dialog('destroy').remove();
                                  }
                                  
                          })

                $('#dialog_simple').on('submit', '#popupForm', function (e) {
                    var url = $('#popupForm')[0].action;
                    $.ajax({
                        type: "POST",
                        url: url,
                        data: $('#popupForm').serialize(),
                        success: function (data) {
                            if (data.status) {
                                $dialog.dialog('close');
                                oTable.ajax.reload();
                            }
                        }
                    })

                    e.preventDefault();
                })
                $dialog.dialog('open');
            }


