                                <div class="col-md-12" style="margin-top:10px;margin-bottom:10px">
                                    <table id="sizeTable" class="display nowrap cell-border table table-bordered table-striped" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th data-class="" style="width: 20px; background-color: #03386C; color: white; padding: 7px; text-align: center; border-left: none; "></th>
                                                <th data-hide="" style="width: 677px; background-color: #03386C; color: white; padding: 7px; text-align: left; ">Account Name</th>
                                                <th data-hide="" style="width: 200px; background-color: #03386C; color: white; padding: 7px; text-align: center; ">Cell No</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                                @*End of In Qty*@
                                <div class="col-md-12 DeleteSection" style="padding-bottom: 15px;padding-top:10px" hidden>
                                    <section class="col col-md-6"></section>
                                    <section class="col col-md-6 deleteRow">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Voucher" id="btnDeleteWorkOrder" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-3"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $('#Specific').click(function () {
            if ($(this).is(':checked')) {
                $('.SpecificRow').removeAttr("hidden");
                $('#DetailCode').val(null).trigger('change');
                $('#Specific').prop("disabled", true);
                $('#Specific').prop("checked", true);

                $('.CustomRow').attr("hidden", "hidden");
                $('#CellNo').val("");
                $('#Custom').prop("disabled", false);
                $('#Custom').prop("checked", false);

                $('#IsSpecific').val(1);
                $('#IsCustom').val(0);
            }
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('background-color', '#fff');
            $('#CellNo').css('border-color', '#bdbdbd');
            $('#CellNo').css('background-color', '#fff');
        })
        $('#Custom').click(function () {
            if ($(this).is(':checked')) {
                $('.SpecificRow').attr("hidden", "hidden");
                $('#DetailCode').val(null).trigger('change');
                $('#Specific').prop("disabled", false);
                $('#Specific').prop("checked", false);

                $('.CustomRow').removeAttr("hidden");
                $('#CellNo').val("");
                $('#Custom').prop("disabled", true);
                $('#Custom').prop("checked", true);

                $('#IsSpecific').val(0);
                $('#IsCustom').val(1);
            }
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('background-color', '#fff');
            $('#CellNo').css('border-color', '#bdbdbd');
            $('#CellNo').css('background-color', '#fff');
        })
        $('#btnAllCustomersAndSuppliers').click(function () {
            $(this).prop("disabled", true);
            $(this).html("<i class='fa fa-refresh fa-spin'></i> Processing...");
            $.ajax({
                type: "POST",
                url: "/smslog/GetAllCustomersAndSuppliers/",
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#sizeTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='DetailCode01' value=" + response.data[key].DetailCode + " />" + response.data[key].Name + "</span>",
                    "<center><span><input type='hidden' class='Cell01' value=" + response.data[key].Cell1 + " />" + response.data[key].Cell1 + "</span></center>",
                        ]).draw(false);
                    }
                    $('#btnAllCustomersAndSuppliers').prop("disabled", true);
                    $('#btnAllCustomersAndSuppliers').html("All Customers and Suppliers");
                }
            })
        })
        $('#btnAddSize').click(function () {
            var detailCode = 0;
            var accountName = '';
            var cellNo = '';
            if ($('#IsSpecific').val() == 1) {
                detailCode = $('#DetailCode').val();
                accountName = $('#DetailCode option:selected').text();
                cellNo = $('#HiddenCellNo').val();
                var check = 0;
                if (detailCode == '' || detailCode == null || detailCode == 0) {
                    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('border-color', '#A90329');
                    $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (cellNo == '' || cellNo == null || cellNo == 0) {
                    check = 1;
                }
                if (check == 1) {
                    return false;
                }
                var vtable = $('#sizeTable').DataTable();
                var smsUserName = $('#SmsUserId option:selected').text();

                vtable.row.add([
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                        "<span><input type='hidden' class='DetailCode01' value=" + detailCode + " />" + accountName + "</span>",
                        "<center><span><input type='hidden' class='Cell01' value=" + cellNo + " />" + cellNo + "</span></center>",
                ]).draw(false);
            }
            else {
                detailCode = 0;
                accountName = '';
                cellNo = $('#CellNo').val();
                if (cellNo == '' || cellNo == null) {
                    $('#CellNo').css('border-color', '#A90329');
                    $('#CellNo').css('background-color', '#FFF0F0');
                    check = 1;
                }
                if (check == 1) {
                    return false;
                }
                var vtable = $('#sizeTable').DataTable();
                var smsUserName = $('#SmsUserId option:selected').text();

                vtable.row.add([
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowSizeBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                        "<span><input type='hidden' class='DetailCode01' value=" + detailCode + " />" + accountName + "</span>",
                        "<center><span><input type='hidden' class='Cell01' value=" + cellNo + " />" + cellNo + "</span></center>",
                ]).draw(false);
            }
            $('#DetailCode').val(null).trigger('change');
            $('#CellNo').val('');
        })
        function getCellNo(detailCode) {
            $.ajax({
                type: "POST",
                url: "/smslog/GetSellNo/" + detailCode,
                dataType: 'json',
                success: function (response) {
                    $('#HiddenCellNo').val(response.data);
                }
            })
        }
        $('#btnCancelSize').click(function () {
            $('#btnCancelSize').hide();
            $('#SmsUserId').val(null).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $(document).on('click', '.editRowSizeBtn', function () {
            var vtable = $('#sizeTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#SizeHiddenTr').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var smsUserId = data[2].split('value=')[1].split('/>')[0].trim();
            $('#SmsUserId').val(smsUserId).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelSize').removeAttr("hidden");
            $('#btnCancelSize').show();
            $('#btnAddSize').show();
            $('#btnAddSize').removeAttr("hidden");
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $(document).on('click', '.deleteRowSizeBtn', function () {
            $('#EditHidden').val(0);
            var vtable = $('#sizeTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#btnCancelSize').hide();
            $('#SmsUserId').val(null).trigger('change');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#SmsUserIdDiv').closest('#SmsUserIdDiv').find('.select2-selection').css('background-color', '#fff');
        })
        $('#DetailCode').change(function () {
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('background-color', '#fff');
            getCellNo($(this).val());
        })
        $('#CellNo').keydown(function () {
            $('#CellNo').css('border-color', '#bdbdbd');
            $('#CellNo').css('background-color', '#fff');
        }).mousedown(function () {
            $('#CellNo').css('border-color', '#bdbdbd');
            $('#CellNo').css('background-color', '#fff');
        })
        function ClearFormFields() {
            $('#DisableOrNot').val(0);
            $('.SpecificRow').removeAttr("hidden");
            $('#DetailCode').val(null).trigger('change');
            $('#Specific').prop("disabled", true);
            $('#Specific').prop("checked", true);

            $('.CustomRow').attr("hidden", "hidden");
            $('#CellNo').val("");
            $('#Custom').prop("disabled", false);
            $('#Custom').prop("checked", false);
            $('#SmsLogId').val(0);
            $('#IsSpecific').val(1);
            $('#IsCustom').val(0);
            $('#btnCancelSize').hide();
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#btnAddSize').html('<i class="fa fa-plus"></i> Add');
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('border-color', '#ddd');
            $('#DetailCodeDiv').closest('#DetailCodeDiv').find('.select2-selection').css('background-color', '#fff');
            $('#CellNo').css('border-color', '#bdbdbd');
            $('#CellNo').css('background-color', '#fff');
            var vtable = $('#sizeTable').DataTable();
            vtable.clear().draw();

            $('#btnSaveWorkOrder').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#invoiceNoSection').attr("hidden", "hidden");
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.DeleteSection').attr("hidden", "hidden");
        }
        function EnableDisableFields() {
            $('#DisableOrNot').val(0);
            $('.SpecificRow').removeAttr("hidden");
            $('#DetailCode').val(null).trigger('change');
            $('#Specific').prop("disabled", true);
            $('#Specific').prop("checked", true);
