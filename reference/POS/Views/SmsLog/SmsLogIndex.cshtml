                                <div class="row SpecificRow" style="padding-top: 15px; padding-bottom: 15px;padding-left:10px;padding-right:10px">
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                        </div>
                                        <div class="col-md-6">
                                            <div style="padding: 3px">
                                                <label style="margin-top:2px">Select Account</label>
                                                <label class="select">
                                                    <i class="append fa fa-caret-down"></i>
                                                    <div id="DetailCodeDiv">
                                                        @Html.DropDownListFor(model => model.DetailCode, Enumerable.Empty<SelectListItem>(), new { @style = "width:100%", @id = "DetailCode" })
