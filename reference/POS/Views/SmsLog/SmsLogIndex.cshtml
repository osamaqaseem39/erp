                                        <div class="col-md-12" id="invoiceNoSection" hidden>
                                            <input type="hidden" id="SizeHiddenTr" value="0" />
                                            <input type="hidden" id="SmsLogId" value="0" />
                                            <input type="hidden" id="IsSpecific" value="0" />
                                            <input type="hidden" id="IsCustom" value="0" />
                                            <input type="hidden" id="HiddenCellNo" value="" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="padding-left: 10px; padding-right: 10px; ">
                                    <div class="col-md-12" style="padding-bottom: 5px;">
                                        <div class="col-md-12">
                                            <center>
                                                <button type="button" id="btnAllCustomersAndSuppliers" class="btn btn-success" title="All Customers and Suppliers" style="padding:5px">All Customers and Suppliers</button> 
                                            </center>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="padding-left: 10px; padding-right: 10px;margin-top:5px ">
                                    <div class="col col-md-12"  style="padding-bottom: 5px;">
                                        <label>Message</label>
                                            <textarea id="SmsMessage" style="padding:5px;width:100%;font-weight:normal"></textarea>
                                    </div>
                                </div>
                                @*Start of In Qty*@
                                <h1 class="heading-1" style="margin-top: 0px;margin-bottom:5px; color: #03386C;font-weight:bold "><span>Custom</span></h1>
                                <div class="row">
                                    <div class="col col-md-12">
                                        <center>
                                            <table class="" style="">
                                                <tr>
                                                    <td style="width: 50%; padding-right: 10px; padding-left: 3px" id="">
                                                        <label class="checkbox" style="margin-top:22px">
                                                            <input id="Specific" type="checkbox" name="Specific" checked ><i></i>
                                                            Specific
                                                        </label>
                                                    </td>
                                                    <td style="width: 50%;; padding-left: 10px; " id="">
                                                        <label class="checkbox" style="margin-top:22px">
                                                            <input id="Custom" type="checkbox" name="Custom"><i></i>
                                                            Custom
