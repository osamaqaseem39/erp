                                <div class="row CustomRow" style="padding-top: 15px; padding-bottom: 15px;padding-left:10px;padding-right:10px" hidden>
                                    <div class="col-md-12">
                                        <div class="col-md-3">
                                        </div>
                                        <div class="col-md-6">
                                            <div style="padding: 3px">
                                                <label style="text-align:left">Cell No.</label>
                                                <label class="input">
                                                    <i class="icon-prepend fa fa-mobile-alt"></i>
