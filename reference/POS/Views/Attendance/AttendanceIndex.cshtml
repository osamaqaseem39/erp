                                       '<td style="text-align: center;"><label class="select"><i class="append fa fa-caret-down"></i><select class="Attendance" id="Attendance' + i + '"><option value="P" ' + present + '>P</option><option value="A" ' + absent + '>A</option><option value="L" ' + leave + '>L</option><option value="H" ' + holiday + '>H</option></select></label></td>' +
                                       '<td style="width: 110px;">' + inTime + '</td>' +
                                       '<td style="text-align: center;">' + outTime + '</td>';

                            for (var key2 in response.data[key].DateList)
                            {
                                var bgColor = '';
                                if (response.data[key].DateList[key2].Attendance == 'P')
