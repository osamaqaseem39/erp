        $('#btnSave').click(function () {
            $('#btnSave').html("<i class='fa fa-refresh fa-spin'></i> Processing....");
            $('#btnSave').prop("disabled", true);
            $('#btnSaveAndPrint').prop("disabled", true);
            SaveAttendance("");
        })
        $('#btnSaveAndPrint').click(function () {
