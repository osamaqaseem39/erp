<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 924,
            phone: 380
        };

        $('#myTableChequeDeposit').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableChequeDeposit'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/cheque/GetAllChequeDepositListForEdit",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ChequeInfoId", "class": "Acenter", "width": "5%", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#ChequeDepositListModal" class="btn btn-primary selectBtn2" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "Bank", "name": "Bank", "width": "27%", "autoWidth": true, "orderable": true },
                     { "data": "ChequeNo", "name": "ChequeNo", "width": "18%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                     { "data": "PaidTo", "name": "PaidTo", "width": "21%", "orderable": true, "autoWidth": true },
                     { "data": "Amount", "name": "Amount", "width": "14%", "orderable": true, "autoWidth": true, "class": "Amount" },
                     {
                         "data": "ChequeDate", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     {
                         "data": "DueDate", "width": "15%", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "ChequeType", "name": "ChequeType", "orderable": true, "autoWidth": true },
                     { "data": "Status", "name": "Status", "orderable": true, "autoWidth": true },
                     { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true },
                     { "data": "PaidBy", "name": "PaidBy", "orderable": true, "autoWidth": true },
                     { "data": "ReceivedBy", "name": "ReceivedBy", "orderable": true, "autoWidth": true },
                     { "data": "DetailName", "name": "DetailName", "orderable": true, "autoWidth": true },
                     {
                         "data": "DepositDate", "class": "Acenter", "width": "15%", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "DepositRemarks", "name": "DepositRemarks", "orderable": true, "autoWidth": true },
                     
            ]
        });
        oTable = $('#myTableChequeDeposit').DataTable();
        $(document).on('click', '.selectBtn2', function (e) {
            e.preventDefault();
            var infoId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/cheque/GetChequeDepositDetailByIdForEdit/" + infoId,
                dataType: 'json',
                success: function (response) {
                    $('#DepositStatus').prop("disabled", false);
                    $('#DepositDate').prop("disabled", false);
                    $('#DepositRemarks').prop("disabled", false);
                    $('#PaidToDetailCode').select().enable(true);
                    $('#Bank').val(response.data.Bank);
                    $('#ChequeNo').val(response.data.ChequeNo);
                    $('#ReceivedFrom').val(response.data.PaidTo);
                    $('#ChequeType').val(response.data.ChequeType);
                    $('#Amount').val(response.data.Amount);
                    $('#ReceivedBy').val(response.data.ReceivedBy);
                    $('#PaidBy').val(response.data.PaidBy);
                    $('#Remarks').val(response.data.Remarks);
                    $('#ChequeInfoId').val(response.data.ChequeInfoId);
                    $('#ChequeDate').val(getDate(response.data.ChequeDate));
                    $('#DueDate').val(getDate(response.data.DueDate));
                    $('#DepositStatus').val(response.data.Status);
                    $('#DepositRemarks').val(response.data.DepositRemarks);
                    $('#DepositDate').val(getDate(response.data.DepositDate));
                    $('#PaidToDetailCode').val(response.data.CDetailCode).trigger('change');
                    $('#btnSaveChequeDeposit').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                }
            })
        })
        $('#btnSearchChequeDeposit').click(function () {
            SearchItem();
        });
        $('#txtSearchChequeDeposit').on('keypress', function (event) {
            var BElement = $("#btnSearchCategoryChequeDeposit");
            if (BElement.html().trim() == 'Cheque No.') {
                NumberPostive(event, this);
            }
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchCategoryChequeDeposit");
            if (BElement.html().trim() == 'Cheque No.') {
                oTable.columns(0).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Bank') {
                oTable.columns(1).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Received From') {
                oTable.columns(2).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Remarks') {
                oTable.columns(3).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Paid By') {
                oTable.columns(4).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Received By') {
                oTable.columns(5).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(6).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Credit Account') {
                oTable.columns(7).search($('#txtSearchChequeDeposit').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshChequeDeposit').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchCategoryChequeDeposit").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchCategoryChequeDeposit").html($this.data("value"));
            if ($("#btnSearchCategoryChequeDeposit").html() == 'Cheque No.') {
                $('#txtSearchChequeDeposit').val('');
            }
        })
    });
    function NumberPostive(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
