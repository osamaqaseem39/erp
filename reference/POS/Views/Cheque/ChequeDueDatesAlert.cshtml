<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Cheque Due Date Alert </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            <div class="widget-body">
                                <div class="row">
                                    <div class="col-lg-2">
                                    </div>
                                    <div class="col-lg-10">
                                        <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right" style="padding-right:15px;padding-bottom:0px">
                                            <div class="input-group-btn">
                                                <button id="btnSearchChequeDueDateChequeDueDate" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Cheque No.</button>
                                                <ul class="dropdown-menu" id="ulSearchChequeDueDateChequeDueDate" style="cursor:pointer">
                                                    <li data-value="Cheque No.">
                                                        <a class="ListItem">Cheque No.</a>
                                                    </li>
                                                    <li data-value="Bank">
                                                        <a class="ListItem">Bank</a>
                                                    </li>
                                                    <li data-value="Remarks">
                                                        <a class="ListItem">Remarks</a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <input class="form-control" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchChequeDueDate" style="height:18px;">
                                            <div class="input-group-btn">
                                                <button type="button" id="btnSearchChequeDueDate" class="btn btn-default" style="margin-left:20px">
                                                    &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-search fa-lg"></i>&nbsp;&nbsp;&nbsp;
                                                </button>
                                                <button type="button" id="btnRefreshChequeDueDate" class="btn btn-default">
                                                    &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-refresh fa-lg"></i>&nbsp;&nbsp;&nbsp;
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <table id="myTableChequeDueDate" class="table table-striped table-bordered table-hover" width="100%">
                                    <thead>
                                        <tr>
                                            <th data-class="expand"><i class="fa fa-fw fa-briefcase text-muted"></i>Bank</th>
                                            <th data-hide=""><i class="fa fa-hashtag text-muted"></i> Cheque No.</th>
                                            <th data-hide="phone,tablet"><i class="fa fa-info-circle text-muted"></i> Cheque Type</th>
                                            <th data-hide="phone,table"><i class="fa fa-calendar text-muted"></i> Cheque Date</th>
                                            <th data-hide="phone,tablet,desktop"> Remarks</th>
                                            <th data-hide="phone"><i class="fa fa-money-bill-alt text-muted"></i> Amount</th>
                                            <th data-hide="phone"><i class="fa fa-calendar text-muted"></i> Due Day</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var responsiveHelper_dt_basic = undefined;
            var responsiveHelper_datatable_fixed_column = undefined;
            var responsiveHelper_datatable_col_reorder = undefined;
            var responsiveHelper_datatable_tabletools = undefined;

            var breakpointDefinition = {
                desktop: 1920,
                tablet: 1024,
                phone: 380
            };

            $('#myTableChequeDueDate').dataTable({
                "sDom": '<"top">rt<"bottom"lp i><"clear">',
                "autoWidth": true,
                "preDrawCallback": function () {
                    if (!responsiveHelper_dt_basic) {
                        responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableChequeDueDate'), breakpointDefinition);
                    }
                },
                "rowCallback": function (nRow) {
                    responsiveHelper_dt_basic.createExpandIcon(nRow);
                },
                "drawCallback": function (oSettings) {
                    responsiveHelper_dt_basic.respond();
                },
                "bLengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/cheque/GetAllChequeDueDateAlerts",
                    "type": "POST",
                    "datatype": "json",
                    error: function (xhr, httpStatusMessage, customErrorMessage) {
                        if (xhr.status === 410) {
                            window.location.href = customErrorMessage;
                        }
                    }
                },
                "columns": [
                        { "data": "Bank", "name": "Bank", "width": "30%", "autoWidth": true, "orderable": true },
                     { "data": "ChequeNo", "name": "ChequeNo", "width": "15%", "orderable": true, "autoWidth": true, "class": "Acenter" },
                     { "data": "ChequeType", "name": "ChequeType", "width": "15%", "orderable": true, "autoWidth": true },
                     {
                         "data": "ChequeDate", "width": "13%", "class": "Acenter", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true },
                     { "data": "Amount", "name": "Amount", "width": "12%", "orderable": true, "autoWidth": true, "class": "Amount" },
                     {
                         "data": "StatusCountDays", "class": "Acenter", "width": "15%", "orderable": false, "render": function (data) {
                             if (data.toString() == "1") {
                                 return '<span class="badge status-badge bg-color-red" style="padding:7px;width:90%">Overdue yesterday</span>'
                             }
                             else if (data.toString().split('-')[0] == "2") {
                                 var d = data.toString().split('-')[1];
                                 return '<span class="badge status-badge bg-color-red" style="padding:7px;width:90%">' + d + ' days Overdue</span>'
                             }
                             else if (data.toString() == "3") {
                                 return '<span class="badge status-badge bg-color-orange" style="padding:7px;width:90%">Due today</span>'
                             }
                             else if (data.toString() == "4") {
                                 return '<span class="badge status-badge bg-color-green" style="padding:7px;width:90%">Due tomorrow</span>'
                             }
                             else if (data.toString().split('-')[0] == "5") {
                                 var d = data.toString().split('-')[1];
                                 return '<span class="badge status-badge bg-color-green" style="padding:7px;width:90%">Due in ' + d + ' days</span>'
                             }
                         }
                     },
                ]
            });
            oTable = $('#myTableChequeDueDate').DataTable();
        });

        $('#btnSearchChequeDueDate').click(function () {
            SearchItem();
        });
        $('#txtSearchChequeDueDate').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchChequeDueDateChequeDueDate");
            if (BElement.html().trim() == 'Cheque No.') {
                oTable.columns(0).search($('#txtSearchChequeDueDate').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Bank') {
                oTable.columns(1).search($('#txtSearchChequeDueDate').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Remarks') {
                oTable.columns(2).search($('#txtSearchChequeDueDate').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        $("#ulSearchChequeDueDateChequeDueDate").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchChequeDueDateChequeDueDate").html($this.data("value"));
        })
        $('#btnRefreshChequeDueDate').click(function () {
            oTable.ajax.reload(null, false);
        })
    </script>
}