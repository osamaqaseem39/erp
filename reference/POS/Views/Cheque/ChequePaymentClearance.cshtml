            var status = $('#ClearanceStatus').val();
            var clearanceDate = $('#ClearanceDate').val();
            var clearanceRemarks = $('#ClearanceRemarks').val();
            var formData =
            {
                ChequeInfoId: chequeInfoId,
                ClearRemarks: clearanceRemarks,
                ClearDate: clearanceDate,
                Status: status,
            }
            var url = $('#chequePaymentClearanceForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'formData': formData }),
                success: function (data) {
