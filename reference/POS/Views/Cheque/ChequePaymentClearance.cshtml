                        }
                    },
                }
            });
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#ClearanceDate').val(today);
        }
        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function getDate(date) {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
        function digits_count(n) {
            var count = 0;
            if (n > 1)
                ++count;
            while (n / 10 >= 1) {
                n /= 10;
                ++count;
            }
            return count;
        }
