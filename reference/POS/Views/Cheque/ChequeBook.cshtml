@model POS.Models.clsVoucher
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="ChequeBookListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Cheque Books List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="chequeBookListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Cheque Book </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("insertupdatechequebook", "cheque", FormMethod.Post, new { id = "chequeBookForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Cheque Book" id="btnAddChequeBook" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveChequeBook" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Cheque Books List" id="btnChequeBookList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ChequeBookListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshChequeBook" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitChequeBook" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveChequeBook" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Cheque Books List" id="btnChequeBookList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ChequeBookListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshChequeBook" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitChequeBook" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="row" style="">
                                    <div class="col col-4">
                                        <label>Select Account</label>
                                        <label class="select">
                                            <input type="hidden" id="ChequeBookId" value="0" />
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.DetailCode, ViewBag.DetailCode as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Cheque Book No.</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-hashtag"></i>
                                            <input type="text" placeholder="Cheque Book No." name="ChequeBookNo" id="ChequeBookNo" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>From Serial</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-hashtag"></i>
                                            <input type="text" placeholder="From" name="From" id="From" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>To Serial</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-hashtag"></i>
                                            <input type="text" placeholder="To" name="To" id="To" />
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:5px;">
                                    <div class="col col-4">
                                        <label>Issue Date</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-calendar"></i>
                                            <input type="date" name="IssueDate" id="IssueDate" min="@ViewBag.FromDate" max="@ViewBag.ToDate" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Status</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="Status">
                                                <option value="Pending">Pending</option>
                                                <option value="Generate Serial">Generate Serial</option>
                                            </select>
                                        </label>
                                    </div>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-3"></section>
                                    <section class="col col-md-9">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Third Level" id="btnDeleteChequeBook" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#DetailCode').select2();
            $('#DetailCode').val(null).trigger('change');
            $('#chequeBookForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    DetailCode: {
                        required: true
                    },
                    ChequeBookNo: {
                        required: true
                    },
                    From: {
                        required: true
                    },
                    To: {
                        required: true
                    },
                    IssueDate: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    DetailCode: {
                        required: 'Account is required.'
                    },
                    ChequeBookNo: {
                        required: 'Cheque Book No. is required.'
                    },
                    From: {
                        required: 'From Serial is required.'
                    },
                    To: {
                        required: 'To Serial is required.'
                    },
                    IssueDate: {
                        required: 'Issue Date is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddChequeBook').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#DetailCode').select().enable(true);
            $('#DetailCode').val(null).trigger('change');
            $('#ChequeBookNo').prop("disabled", false);
            $('#From').prop("disabled", false);
            $('#To').prop("disabled", false);
            $('#IssueDate').prop("disabled", false);
            $('#Status').prop("disabled", false);
            $('#ChequeBookNo').val('');
            $('#From').val('');
            $('#To').val('');
            $('#Status').val('Pending');
            $('#ChequeBookId').val(0);
            GetTodayDate();
            $('#btnSaveChequeBook').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
        }
        $('#btnRefreshChequeBook').click(function () {
            location.reload();
        })
        $('#btnChequeBookList').click(function () {
            $('#chequeBookListDiv').load('@Url.Action("chequebookslist", "cheque")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#DetailCode').select().enable(false);
            $('#DetailCode').val(null).trigger('change');
            $('#ChequeBookNo').prop("disabled", true);
            $('#From').prop("disabled", true);
            $('#To').prop("disabled", true);
            $('#IssueDate').prop("disabled", true);
            $('#Status').prop("disabled", true);
            $('#ChequeBookNo').val('');
            $('#From').val('');
            $('#To').val('');
            $('#Status').val('Pending');
            $('#ChequeBookId').val(0);
            GetTodayDate();
            $('#btnSaveChequeBook').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
        }
        $('#chequeBookForm').on('submit', function (e) {
            if (!$("#chequeBookForm").valid()) {
                return false;
            }
            var from = $('#From').val();
            var to = $('#To').val();
            if (parseFloat(from) > parseFloat(to))
            {
                alert("Error! From serial cannot be greater than To serial.");
                return false;
            }
            if (from.length != to.length) {
                alert("Error! From and to serials should contain same number of digits.");
                return false;
            }
            $('#btnSaveChequeBook').prop('disabled', true);
            var chequeBookId = $('#ChequeBookId').val();
            var account = $('#DetailCode').val();
            var chequeBookNo = $('#ChequeBookNo').val();
            
            var issueDate = $('#IssueDate').val();
            var status = $('#Status').val();
            var formData =
            {
                ChequeBookCompNo: chequeBookId,
                DetailCode: account,
                ChequeBookNo: chequeBookNo,
                FromSerialNo: from,
                ToSerialNo: to,
                IssuedDate: issueDate,
                Status: status
            }
            var url = $('#chequeBookForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'formData': formData }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Cheque Book Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveChequeBook').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $("#From").on('keypress', function (event) {
            NumberPostive(event, this);
        });
        $("#To").on('keypress', function (event) {
            NumberPostive(event, this);
        });
        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        $('#btnDeleteChequeBook').click(function () {
            var chequeBookId = $('#ChequeBookId').val();
            DeleteChequeBook(chequeBookId);
        })
        function DeleteChequeBook(id) {
            var a = $.confirm({
                title: 'Delete Cheque Book',
                content: 'Are you sure u want to delete this cheque book?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/cheque/deletechequebook/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#IssueDate').val(today);
        }
    </script>
}