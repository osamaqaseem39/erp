                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveChequeReceived" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveAndPrintTd" hidden>
                                                <button title="Save and Print" class="btnUpSave" id="btnSaveAndPrintChequeReceived" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/Print.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="documentTd" hidden>
                                                <a title="Attach Document" id="btnAttachDocument" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#DocumentModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/Document2.png" style="width: 42px; height: 42px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 41%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Third Levels List" id="btnChequeReceivedList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#ChequeReceivedListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshChequeReceived" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitChequeReceived" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="row" style="">
                                    <div class="col col-4">
                                        <label>Cheque No.</label>
                                        <label class="input">
                                            <input type="hidden" id="ChequeInfoId" value="0" />
                                            <i class="icon-prepend fa fa-briefcase"></i>
                                            <input type="text" name="ChequeNo" id="ChequeNo" placeholder="Cheque No." />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Bank</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-briefcase"></i>
                                            <input type="text" name="Bank" id="Bank" placeholder="Bank" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Received From</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            @Html.DropDownListFor(model => model.PaidToDetailCode, ViewBag.AllDetailCode as SelectList, new { @style = "width:100%" })
                                        </label>
                                    </div>

                                </div>
                                <div class="row" style="margin-top:5px;">
                                    <div class="col col-4">
                                        <label>Cheque Date</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-calendar"></i>
                                            <input type="date" name="ChequeDate" id="ChequeDate" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Due Date</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-calendar"></i>
                                            <input type="date" name="DueDate" id="DueDate" min="@ViewBag.FromDate" max="@ViewBag.ToDate" />
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Cheque Type</label>
                                        <label class="select">
                                            <i class="append fa fa-caret-down"></i>
                                            <select id="ChequeType" name="ChequeType">
                                                <option value="Cash">Cash</option>
                                                <option value="Cross">Cross</option>
                                                <option value="TT">TT</option>
                                                <option value="DD">DD</option>
                                                <option value="TC">TC</option>
                                            </select>
                                        </label>
                                    </div>
                                    <div class="col col-2">
                                        <label>Amount</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-money-bill-alt"></i>
                                            <input type="text" name="Amount" id="Amount" placeholder="Amount" />
                                        </label>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:5px;">
                                    <div class="col col-4">
                                        <label>Received By</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-user"></i>
                                            <input type="text" name="ReceivedBy" id="ReceivedBy" placeholder="Received By" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Paid By</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-user"></i>
                                            <input type="text" name="PaidBy" id="PaidBy" placeholder="Paid By" />
                                        </label>
                                    </div>
                                    <div class="col col-md-4">
                                        <label>Remarks</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" name="Remarks" id="Remarks" placeholder="Remarks" />
                                        </label>
                                    </div>
                                </div>
