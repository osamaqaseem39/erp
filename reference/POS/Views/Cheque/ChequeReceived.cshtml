                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#PaidToDetailCode').select2();
            $('#PaidToDetailCode').val(null).trigger('change');

            $('#chequeReceivedForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    ChequeNo: {
                        required: true
                    },
                    Bank: {
                        required: true
                    },
                    PaidToDetailCode: {
                        required: true
                    },
                    ChequeDate: {
                        required: true
                    },
                    DueDate: {
                        required: true
                    },
                    ChequeType: {
                        required: true
                    },
                    Amount: {
                        required: true
                    },
                },

                // Messages for form validation
                messages: {
                    ChequeNo: {
                        required: 'Cheque No. is required.'
                    },
                    Bank: {
                        required: 'Bank is required.'
                    },
                    PaidToDetailCode: {
                        required: 'Received From is required.'
                    },
                    ChequeDate: {
                        required: 'Cheque Date is required.'
                    },
                    DueDate: {
                        required: 'Due Date is required.'
                    },
                    ChequeType: {
                        required: 'Cheque Type is required.'
                    },
                    Amount: {
                        required: 'Amount is required.'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            ClearFormFields();
        })
        $('#btnAddChequeReceived').click(function () {
            $('#PaidToDetailCode').select().enable(true);
            $('#PaidToDetailCode').val(null).trigger('change');
            $('#ChequeNo').prop("disabled", false);
            $('#Bank').prop("disabled", false);
            $('#ChequeDate').prop("disabled", false);
            $('#DueDate').prop("disabled", false);
            $('#ChequeType').prop("disabled", false);
            $('#Amount').prop("disabled", false);
            $('#ReceivedBy').prop("disabled", false);
            $('#PaidBy').prop("disabled", false);
            $('#Remarks').prop("disabled", false);
            GetTodayDate();
            $('#ChequeNo').val('');
            $('#Bank').val('');
            $('#ChequeType').val('');
            $('#Amount').val('');
            $('#ReceivedBy').val('');
            $('#PaidBy').val('');
            $('#Remarks').val('');
            $('#ChequeInfoId').val(0);
            $('#documentTd').attr("hidden", "hidden");
            $('#btnSaveChequeReceived').prop('disabled', false);
            $('#btnSaveAndPrintChequeReceived').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#saveAndPrintTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '44%', 'text-align': 'right' });
            $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
        })
        $('#btnRefreshChequeReceived').click(function () {
            location.reload();
        })
        $('#btnChequeReceivedList').click(function () {
            $('#chequeReceivedListDiv').load('@Url.Action("chequereceivedlist", "cheque")')
        })
        $('#btnAttachDocument').click(function () {
            var chequeInfoId = $('#ChequeInfoId').val();
            $('#documentsDiv').load('@Url.Action("attachdocument", "documents")?type=Cheque&id=' + chequeInfoId + '');
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#PaidToDetailCode').select().enable(false);
            $('#PaidToDetailCode').val(null).trigger('change');
            $('#ChequeNo').prop("disabled", true);
            $('#Bank').prop("disabled", true);
            $('#ChequeDate').prop("disabled", true);
            $('#DueDate').prop("disabled", true);
            $('#ChequeType').prop("disabled", true);
            $('#Amount').prop("disabled", true);
            $('#ReceivedBy').prop("disabled", true);
            $('#PaidBy').prop("disabled", true);
            $('#Remarks').prop("disabled", true);
            GetTodayDate();
            $('#ChequeNo').val('');
            $('#Bank').val('');
            $('#ChequeType').val('');
            $('#Amount').val('');
            $('#ReceivedBy').val('');
            $('#PaidBy').val('');
            $('#Remarks').val('');
            $('#ChequeInfoId').val(0);
            $('#documentTd').attr("hidden", "hidden");
            $('#btnSaveChequeReceived').prop('disabled', true);
            $('#btnSaveAndPrintChequeReceived').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
            $('#saveAndPrintTd').attr("hidden", "hidden");
            $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '44%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'left' });
            }
        }
        $('#chequeReceivedForm').on('submit', function (e) {
            if (!$("#chequeReceivedForm").valid()) {
                return false;
            }
            var val = $(this).find("button:focus").attr("title");
            var print = 0;
            if (val.trim() == "Save") {
                print = 0;
            }
            else {
                print = 1;
            }
            $('#btnSaveChequeReceived').prop('disabled', true);
            $('#btnSaveAndPrintChequeReceived').prop('disabled', true);
            var chequeInfoId = $('#ChequeInfoId').val();
            var chequeNo = $('#ChequeNo').val();
            var bank = $('#Bank').val();
            var paidToDetailCode = $('#PaidToDetailCode').val();
            var chequeDate = $('#ChequeDate').val();
            var dueDate = $('#DueDate').val();
            var chequeType = $('#ChequeType').val();
            var amount = $('#Amount').val();
            var receivedBy = $('#ReceivedBy').val();
            var paidBy = $('#PaidBy').val();
            var remarks = $('#Remarks').val();
            var formData =
            {
                ChequeInfoId: chequeInfoId,
                ChequeBookDId: 0,
                CDetailCode: paidToDetailCode,
                ChequeNo: chequeNo,
                DDetailCode: 0,
                ChequeDate: chequeDate,
                DueDate: dueDate,
                ChequeType: chequeType,
                Amount: amount,
                ReceivedBy: receivedBy,
                PaidBy: paidBy,
                Remarks: remarks,
                DetailName: bank
            }
            var url = $('#chequeReceivedForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'formData': formData }),
                success: function (data) {
                    if (data.status == true) {
                        if (print == 1) {
                            window.location.href = "/cheque/chequereceivereport/" + data.chequeInfoId;
                        }
                        else {
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Cheque Received Succesfully.' +
                                            '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            ClearFormFields();
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveChequeReceived').prop('disabled', false);
                        $('#btnSaveAndPrintChequeReceived').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteChequeReceived').click(function () {
            var chequeInfoId = $('#ChequeInfoId').val();
            DeleteChequeReceived(chequeInfoId);
        })
        function DeleteChequeReceived(id) {
            var a = $.confirm({
                title: 'Delete Cheque Received',
                content: 'Are you sure u want to delete this cheque received?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/cheque/deletechequereceived/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
        function GetTodayDate() {
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!

            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var today = yyyy + '-' + mm + '-' + dd;
            $('#ChequeDate').val(today);
            $('#DueDate').val(today);
        }
        $("#Amount").on('keypress', function (event) {
            NumberPostiveNegativeWithDecimal(event, this);
        });
        $("#ChequeNo").on('keypress', function (event) {
            NumberPostive(event, this);
        });
        function NumberPostiveNegativeWithDecimal(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 127) &&
                (charCode != 8) &&
                (charCode != 45 || $(element).val().indexOf('-') != -1) &&
                (charCode != 46 || $(element).val().indexOf('.') != -1) &&
                (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
        function NumberPostive(evt, element) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (
                (charCode != 8) && (charCode != 127) && (charCode < 48 || charCode > 57))
                evt.preventDefault();
            return true;
        }
    </script>
}