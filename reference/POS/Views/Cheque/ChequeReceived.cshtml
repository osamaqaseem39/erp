                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Third Level" id="btnDeleteChequeReceived" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
