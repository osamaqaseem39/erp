<!-- widget content -->
@model POS.Models.clsCheque
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="content" class="tablecontainer" style="padding: 12px 30px;">

    <div class="row">
        <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
            <h1 class="page-title txt-color-blueDark">
                <i class="fa fa-shopping-cart fa-fw "></i>
                Cheque Payment
                <span>
                    >
                    Cheque Payment Report
                </span>
            </h1>
        </div>
    </div>
    <section>
        <div class="panel">
            <div class="panel-heading">
                @using (Html.BeginForm("download", "pdf", FormMethod.Post, new { @class = "smart-form custome-class-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                {
                    <span class="header"> Cheque Payment Report&nbsp;&nbsp;&nbsp;&nbsp;</span>

                    <input type="hidden" name="DocumentName" id="DocumentName" value="" />
                    <input type="hidden" name="FileName" id="FileName" value="@Model.ChequeNo" />
                    <a id="backBtn" class="btn btn-labeled  btn-default defaultBtn" href="@Url.Action("chequepayment", "cheque")" style="color: #000 !important; background-color: #fff !important; height: 34px; width: 65px;line-height:31px">
                        Back
                    </a>
                    <button type="button" class="btn printBtn" onclick="window.print();" style="background-color: #03386C; color: white;height:32px;width:65px">
                        Print
                    </button>
                    <button type="submit" class="btn btn-primary downloadBtn" formtarget="_blank" style="background-color: #890505 !important; border-color: #890505 !important; color: white;padding:5.5px ">Download</button>
                }
            </div>
            <div class="panel-body">
                <div id="HtmlData">
                    <div id="printable-content" class="panel rpt" style="width: 800px; font-size: 12px; padding: 1px; border-radius: 0px;">
                        <table style="padding-top: 37px;padding-left: 37px;padding-right: 37px" class="headTable">
                            <tr>
                                <td colspan="99">
                                    @if (!(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessName"].ToString()))
                                        || !(string.IsNullOrEmpty(System.Web.HttpContext.Current.Application["BusinessAddress"].ToString())))
                                    {
                                        <table class="purchaseHeading">
                                        <tbody>
                                            <tr>
                                                <th style="  text-align: left; padding-bottom: 15px;padding-left:5px;padding-top:10px;" colspan="12" class="pull-left businssName businssName22">
                                                    <div style="font-weight: bold;font-size: 20px;">@System.Web.HttpContext.Current.Application["BusinessName"]</div>
                                                    <div style="font-size: 14px;margin-left:2px">
                                                        @System.Web.HttpContext.Current.Application["BusinessAddress"]
                                                    </div>
                                                    @*<div style="font-size: 15px;margin-left:2px;margin-top:15px;font-weight:bold">
                                                            Cheque Payment
                                                        </div>*@
                                                </th>
                                            </tr>
                                        </tbody>
                                    </table>
                                    }
                                    @*<table style="" class="borderLineTable">
                                            <tr>
                                                <td style="border-bottom:1px solid black;"></td>
                                            </tr>
                                        </table>*@
                                    <center>
                                        <div style="border:1px solid black; padding:5px;width:100%;border-radius:10px;margin-top:-5px" id="MainDiv">
                                            <table class="mainTable" id="" style="margin-top:5px;">
                                                <tr>
                                                    <th style="text-align:left;font-size:16px;width:18%;border-bottom:1px solid black" colspan="1"><b>Cheque No. </b></th>
                                                    <th style="text-align:left;font-size:16px;width:32%;border-bottom:1px solid black" colspan="1">@Model.ChequeNo</th>
                                                    <th style="text-align:right;font-size:16px;width:50%;border-bottom:1px solid black" colspan="2"><b>Amount : </b>&nbsp;&nbsp;@Convert.ToDecimal(Model.Amount).ToString("#,##0.00")</th>
                                                </tr>
                                                <tr>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 10px" colspan="1"><b>Bank : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 10px" colspan="1">@Model.Bank</th>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 10px; " colspan="1"><b>Paid To : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 10px; " colspan="1">@Model.PaidTo</th>
                                                </tr>
                                                <tr>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px" colspan="1"><b>Cheque Date : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px" colspan="1">@Convert.ToDateTime(Model.ChequeDate).ToString("dd/MM/yyyy")</th>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px; " colspan="1"><b>Due Date : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px; " colspan="1">@Convert.ToDateTime(Model.DueDate).ToString("dd/MM/yyyy")</th>
                                                </tr>
                                                <tr>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px" colspan="1"><b>Cheque Type : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px" colspan="1">@Model.ChequeType</th>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px; " colspan="1"><b>Status : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px; " colspan="1">@Model.Status</th>
                                                </tr>
                                                <tr>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px" colspan="1"><b>Paid By : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px" colspan="1">@Model.PaidBy</th>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px; " colspan="1"><b>Received By : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 30%; padding-top: 5px; " colspan="1">@Model.ReceivedBy</th>
                                                </tr>
                                                <tr>
                                                    <th style="text-align: left; font-size: 14px; width: 20%; padding-top: 5px" colspan="1"><b>Remarks : </b></th>
                                                    <th style="text-align: left; font-size: 14px; width: 80%; padding-top: 5px" colspan="3">@Html.Raw(Model.Remarks)</th>
                                                </tr>
                                            </table>
                                        </div>
                                    </center>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- END MAIN CONTENT -->
