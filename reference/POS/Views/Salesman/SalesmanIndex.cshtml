<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="SalesmanListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Salesmans List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="salesmanListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <section id="widget-grid" class="" style="padding: 10px; margin-top: 15px">
        <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false" data-widget-deletebutton="false" data-widget-draggable="false">
                    <header>
                        <span class="widget-icon"> <i class="fa fa-table"></i> </span>
                        <h2>Salesman </h2>
                    </header>
                    <div>
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body smart-form">
                            @using (Html.BeginForm("insertupdatesalesman", "salesman", FormMethod.Post, new { id = "salesmanForm", @class = "smart-form", @novalidate = "novalidate", enctype = "multipart/form-data" }))
                            {
                                if (User.Save == 1)
                                {
                                    <input type="hidden" id="CanSave" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanSave" value="0" />
                                }
                                if (User.Change == 1)
                                {
                                    <input type="hidden" id="CanChange" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanChange" value="0" />
                                }
                                if (User.Delete == 1)
                                {
                                    <input type="hidden" id="CanDelete" value="1" />
                                }
                                else
                                {
                                    <input type="hidden" id="CanDelete" value="0" />
                                }
                                <table style="width: 100%;overflow-y: scroll; " class="smart-form dock">
                                    <tr>
                                        @if (User.Save == 1)
                                        {
                                            <td style="width: 44%; padding-bottom: 5px; padding-left: 3px;text-align: right;" id="addTd">
                                                <a title="Add New Salesman" id="btnAddSalesman" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/plus2.png" style="width: 45px; height: 45px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveSalesman" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px;text-align: left;" id="listTd">
                                                <a title="Salesmans List" id="btnSalesmanList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#SalesmanListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshSalesman" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 44%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitSalesman" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 0px; text-align: left; " id="saveTd" hidden>
                                                <button title="Save" class="btnUpSave" id="btnSaveSalesman" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img src="~/Content/img/save.png" style="width: 43px; height: 43px; color: white; " />
                                                </button>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px;text-align: right;" id="listTd">
                                                <a title="Salesmans List" id="btnSalesmanList" class="btnUp" href="javascript:void(0)" data-toggle="modal" data-target="#SalesmanListModal" style="width: 45px; height: 45px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/list2.png" style="width: 47px; height: 47px; color: white; margin-top: 4px; " />
                                                </a>
                                            </td>
                                            <td style="width: 3%; padding-bottom: 5px; padding-right: 3px; text-align: left; " id="refreshTd">
                                                <a title="Refresh" id="btnRefreshSalesman" class="btnUp" href="javascript:void(0)" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/refresh2.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                            <td style="width: 47%; padding-bottom: 5px; padding-right: 3px;text-align: left; " id="exitTd">
                                                <a title="Exit" id="btnExitSalesman" class="btnUp" href="@Url.Action("index", "home")" style="width: 43px; height: 43px; color: white; border: none; background: transparent !important; ">
                                                    <img class="btnUp" src="~/Content/img/exit.png" style="width: 43px; height: 43px; color: white; " />
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                </table>
                                <div class="row" style="padding-top: 10px; padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>Full Name</label>
                                        <input type="hidden" id="SalesmanID" value="0" />
                                        <label class="input">
                                            <i class="icon-prepend fa fa-info"></i>
                                            <input type="text" placeholder="Full Name" name="FullName" id="FullName" required />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Email</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-envelope"></i>
                                            <input type="text" placeholder="Email" name="Email" id="Email" />
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>Primary Mobile No.</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-mobile"></i>
                                            <input type="text" placeholder="Primary Mobile No." name="Cell1" id="Cell1" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Secondary Mobile No.</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-mobile"></i>
                                            <input type="text" placeholder="Secondary Mobile No." name="Cell2" id="Cell2" />
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-4">
                                        <label>CNIC</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-mobile"></i>
                                            <input type="text" placeholder="CNIC" name="CNIC" id="CNIC" />
                                        </label>
                                    </div>
                                    <div class="col col-4">
                                        <label>Address</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-user"></i>
                                            <input type="text" placeholder="Address" name="Address" id="Address" />
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row" style="padding-bottom: 15px;">
                                    <div class="col col-2"></div>
                                    <div class="col col-8">
                                        <label>Remarks</label>
                                        <label class="input">
                                            <i class="icon-prepend fa fa-map-marker"></i>
                                            <input type="text" placeholder="Remarks" name="Remarks" id="Remarks" />
                                        </label>
                                    </div>
                                    <div class="col col-2"></div>
                                </div>
                                <div class="row StatusSection" style="" hidden>
                                    <section class="col col-2"></section>
                                    <section class="col col-8">
                                        <label class="checkbox pull-right" style="margin-top:-12px">
                                            <input id="Status" type="checkbox" name="Status"><i></i>
                                            Active
                                        </label>
                                    </section>
                                    <section class="col col-2"></section>
                                </div>
                                <div class="row deleteRow" hidden>
                                    <section class="col col-md-2"></section>
                                    <section class="col col-md-8">
                                        <table class="pull-right footer-nav" style="">
                                            <tr>
                                                <td></td>
                                                <td>
                                                    <a title="Delete Salesman" id="btnDeleteSalesman" href="javascript:void(0)" class="btn btn-danger" style="width:75px; height:28px;color:white; margin-bottom:8px;line-height:26px;border-radius:5px;">
                                                        Delete
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </section>
                                    <section class="col col-md-2"></section>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#salesmanForm').validate({
                ignore: [],
                // Rules for form validation
                rules: {
                    FullName: {
                        required: true
                    },
                    Address: {
                        required: true
                    },
                    Email: {
                        email: true
                    },
                },

                // Messages for form validation
                messages: {
                    SalesmanName: {
                        required: 'Salesman Name is required.'
                    },
                    Address: {
                        required: 'Address is required.'
                    },
                    Email: {
                        email: 'Please enter a VALID email address'
                    },
                },
                // Do not change code below
                errorPlacement: function (error, element) {
                    error.insertAfter(element.parent());
                }
            });
            EnableFormFields();
        })
        $('#btnAddSalesman').click(function () {
            EnableFormFields();
        })
        function EnableFormFields() {
            $('#SalesmanID').val(0);
            $('#FullName').prop("disabled", false);
            $('#Email').prop("disabled", false);
            $('#Cell1').prop("disabled", false);
            $('#Cell2').prop("disabled", false);
            $('#CNIC').prop("disabled", false);
            $('#Address').prop("disabled", false);
            $('#Remarks').prop("disabled", false);

            $('#FullName').val('');
            $('#Email').val('');
            $('#Cell1').val('');
            $('#Cell2').val('');
            $('#CNIC').val('');
            $('#Address').val('');
            $('#Remarks').val('');
            $('#btnSaveSalesman').prop('disabled', false);
            $('#saveTd').removeAttr("hidden");
            $('#addTd').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
            $('.deleteRow').attr("hidden", "hidden");
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#btnRefreshSalesman').click(function () {
            location.reload();
        })
        $('#btnSalesmanList').click(function () {
            $('#salesmanListDiv').load('@Url.Action("salesmanslist", "salesman")')
        })
        $('.btnUpSave').mouseover(function () {
            $(this).find('img').css({ 'height': '50px', 'width': '50px' });
        }).mouseleave(function () {
            $(this).find('img').css({ 'height': '43px', 'width': '43px' });
        });
        function ClearFormFields() {
            $('#SalesmanID').val(0);
            $('#FullName').prop("disabled", true);
            $('#Email').prop("disabled", true);
            $('#Cell1').prop("disabled", true);
            $('#Cell2').prop("disabled", true);
            $('#CNIC').prop("disabled", true);
            $('#Address').prop("disabled", true);
            $('#Remarks').prop("disabled", true);

            $('#FullName').val('');
            $('#Email').val('');
            $('#Cell1').val('');
            $('#Cell2').val('');
            $('#CNIC').val('');
            $('#Address').val('');
            $('#Remarks').val('');
            $('#btnSaveSalesman').prop('disabled', true);
            $('#addTd').removeAttr("hidden");
            $('#saveTd').attr("hidden", "hidden");
             $('.deleteRow').attr("hidden", "hidden");
            $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            if ($('#CanSave').val() == 0) {
                $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
            }
            $('.StatusSection').attr("hidden", "hidden");
        }
        $('#salesmanForm').on('submit', function (e) {
            if (!$("#salesmanForm").valid()) {
                return false;
            }
            //FullName Email Cell1 Cell2 CNIC Address Remarks

            $('#btnSaveSalesman').prop('disabled', true);
            var salesmanId = $('#SalesmanID').val();
            var fullName = $('#FullName').val();
            var email = $('#Email').val();
            var cell1 = $('#Cell1').val();
            var cell2 = $('#Cell2').val();
            var cnic = $('#CNIC').val();
            var address = $('#Address').val();
            var remarks = $('#Remarks').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var salesmanForm =
            {
                SalesmanID: salesmanId,
                FullName: fullName,
                Email: email,
                Cell1: cell1,
                Cell2: cell2,
                Address: address,
                CNIC: cnic,
                Remarks: remarks,
                Status: stringStatus
            }
            var url = $('#salesmanForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ 'salesman': salesmanForm }),
                success: function (data) {
                    if (data.status == true) {
                        $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                ' <strong>Success! </strong>' +
                                                'Salesman Saved Succesfully.' +
                                            '</div>');
                        $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                            $("#success-alert").slideUp(500);
                            $('.alertDiv').html('');
                        });
                        //$.notify("First Level Saved Successfully.", "success");
                        EnableFormFields();
                    }
                    else {
                        alert(data.message);
                        $('#btnSaveSalesman').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeleteSalesman').click(function () {
            var salesmanId = $('#SalesmanID').val();
            DeleteSalesman(salesmanId);
        })
        function DeleteSalesman(id) {
            var a = $.confirm({
                title: 'Delete Salesman',
                content: 'Are you sure u want to delete this salesman?',
                type: 'white',
                buttons: {
                    ok: {
                        text: "Yes",
                        btnClass: 'btnConfirm',
                        keys: ['enter'],
                        action: function () {
                            $.ajax({
                                url: '/salesman/deletesalesman/' + id,
                                type: "POST",
                                dataType: 'json',
                                success: function (data) {
                                    if (data.status == true) {
                                        location.reload();
                                    }
                                    else {
                                        alert(data.message);
                                    }
                                }
                            })
                        }
                    },
                    cancel: {
                        text: "No",
                        btnClass: 'btn-default',
                        keys: ['esc'],
                        action: function () {
                            a.close();
                        }
                    },
                }
            });
        }
    </script>
}