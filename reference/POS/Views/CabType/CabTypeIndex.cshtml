@section pagespecific {
    <link href="~/Content/jquery-confirm.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-confirm.min.js"></script>
    <script src="~/Scripts/notify.min.js"></script>
    <script type="text/javascript">

        $('#btnAddInvoiceDetail').click(function () {

                var check = 0;
                var uptokm = $('#UptoKm').val();
                if (uptokm == '' || uptokm == null || isNaN(uptokm)) {
                    check = 1;
                }
                var vfare = $('#Fare').val();
                if (vfare == '' || vfare == null || isNaN(vfare)) {
                    check = 1;
                }

                if (check == 1) {
                    return false;
                }
               
                var vtable = $('#invoiceDetailTable').DataTable();
                if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                    vtable.row.add([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='ItemID01' value=" + uptokm + " />" + uptokm + "</span>",
                    "<span><input type='hidden' class='ItemName01' value=" + vfare + " />" + vfare + "</span>",
                    ]).draw(false);
                }
                else {
                    $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
                    $('#btnCancelDetail').hide();
                    var tr = $('#HiddenTr').val();
                    vtable.row(tr).data([
                    "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                    "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                    "<span><input type='hidden' class='ItemID01' value=" + uptokm + " />" + uptokm + "</span>",
                    "<span><input type='hidden' class='ItemName01' value=" + vfare + " />" + vfare + "</span>",
                    ]).draw(false);
                }

                $('#UptoKm').val('');
                $('#Fare').val('');
        })
        $('#btnCancelDetail').click(function () {
            $('#btnCancelDetail').hide();
            $('#UptoKm').val('');
            $('#Fare').val('');
            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
        })
        $(document).on('click', '.editRowBtn', function () {
            var vtable = $('#invoiceDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#HiddenTr').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var uptokm = data[2].split('value=')[1].split('/>')[0].trim();
            var vfare = data[3].split('value=')[1].split('/>')[0].trim();

            $('#UptoKm').val(uptokm);
            $('#Fare').val(vfare);
            
            $('#btnAddInvoiceDetail').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelDetail').removeAttr("hidden");
            $('#btnCancelDetail').show();
        })
        $(document).on('click', '.deleteRowBtn', function () {
            var vtable = $('#invoiceDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#btnCancelDetail').hide();
            $('#UptoKm').val('');
            $('#Fare').val('');
            $('#btnAddInvoiceDetail').html('<i class="fa fa-plus"></i> Add');
        })








        $('#btnAddModelDetail').click(function () {

            var check = 0;
            var carmodel = $('#CarModel').val();
            if (carmodel == '' || carmodel == null) {
                check = 1;
            }
            if (check == 1) {
                return false;
            }

            var vtable = $('#ModelDetailTable').DataTable();
            if ($(this).html().trim() == '<i class="fa fa-plus"></i> Add') {
                vtable.row.add([
                "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }
            else {
                $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
                $('#btnCancelModelDetail').hide();
                var tr = $('#HiddenTrM').val();
                vtable.row(tr).data([
                "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                "<span><input type='hidden' class='ItemID01' value=" + carmodel + " />" + carmodel + "</span>",
                ]).draw(false);
            }

            $('#CarModel').val('');
        })
        $('#btnCancelModelDetail').click(function () {
            $('#btnCancelModelDetail').hide();
            $('#CarModel').val('');
            $('#btnAddModelDetail').html('<i class="fa fa-plus"></i> Add');
        })
        $(document).on('click', '.editRowBtnM', function () {
            var vtable = $('#ModelDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            $('#HiddenTrM').val(tr);
            var data = vtable.row($(this).parents('tr')).data();
            var carmodel = data[2].split('value=')[1].split('/>')[0].trim();

            $('#CarModel').val(carmodel);

            $('#btnAddModelDetail').html('<i class="fa fa-edit"></i> Change');
            $('#btnCancelModelDetail').removeAttr("hidden");
            $('#btnCancelModelDetail').show();
        })
        $(document).on('click', '.deleteRowBtnM', function () {
            var vtable = $('#ModelDetailTable').DataTable();
            var tr = vtable.row($(this).parents('tr')).index();
            vtable.row(tr).remove().draw(false);
            $('#btnCancelModelDetail').hide();
            $('#CarModel').val('');
