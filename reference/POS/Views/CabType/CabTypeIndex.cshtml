        $('#ItemPicture').change(function (e) {
            var ext = $('#ItemPicture').val().split('.').pop().toLowerCase();
            var size = document.getElementById('ItemPicture').files[0].size;
            var filename = $('input[type=file]').val().replace(/C:\\fakepath\\/i, '');
            if ($.inArray(ext, ['jpeg', 'jpg', 'png']) == -1) {
                alert('Error! File type allowed : jpeg, jpg, png');
                $('#ItemPicture').val('');
                $('#AttachDocument').val('');
            }
            else if (size > (5000 * 1024)) {
                alert('Error! Maximum File size must be 5 mb');
                $('#ItemPicture').val('');
                $('#AttachStaffDocument').val('');
            }
            else {

                //Get count of selected files
                var countFiles = $(this)[0].files.length;
                var imgPath = $(this)[0].value;
                var extn = imgPath.substring(imgPath.lastIndexOf('.') + 1).toLowerCase();
                $('#ImageRow').removeAttr("hidden");
                $('#AttachDocument').val(filename);
                if (typeof (FileReader) != "undefined") {
                    //loop for each file selected for uploaded.
                    for (var i = 0; i < countFiles; i++) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            $("#DisplayImage").prop("src", e.target.result);
                        }
                        //image_holder.show();
                        reader.readAsDataURL($(this)[0].files[i]);
                    }

                }
                else {
                    alert("This browser does not support FileReader.");
                }
            }
        });

        function getAllDataFare() {
            var arrayData = [];
            var count = 0;
            $('#invoiceDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#invoiceDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();
                var uptokm = data[2].split('value=')[1].split('/>')[0].trim();
                var vfare = data[3].split('value=')[1].split('/>')[0].trim();
                var alldata = {
                    'UptoKm': uptokm,
                    'FarePrice': vfare,
                }
                arrayData.push(alldata);
            }
            console.log(arrayData);
            return arrayData;
        }

        function getAllDataModel() {
            var arrayData = [];
            var count = 0;
            $('#ModelDetailTable tr[role="row"]').each(function () {
                count++;
            });
            var rowsCount = count - 1;
            var vtable = $('#ModelDetailTable').DataTable();
            for (irow = 0; irow < rowsCount; irow++) {
                var data = vtable.row(irow).data();
                var carmodel = data[2].split('value=')[1].split('/>')[0].trim();
                var alldata = {
                    'CarModel': carmodel,
                }
                arrayData.push(alldata);
            }
            console.log(arrayData);
            return arrayData;
        }

        $('#cabtypeForm').on('submit', function (e) {
            if (!$("#cabtypeForm").valid()) {
                return false;
            }

            var FairDetail = JSON.stringify(getAllDataFare());
            var ModelDetail = JSON.stringify(getAllDataModel());

            $('#btnSavecabtype').prop('disabled', true);
            var CabTypeID = $('#CabTypeID').val();
            var description = $('#Description').val();
            var seatcapacity = $('#SeatCapacity').val();
            var PricePers = $('#PricePers').val();
            
            var remk = $('#Remarks').val();
            var status = $('#Status').is(':checked');
            var stringStatus = '';
            if (status == true) {
                stringStatus = "Active";
            }
            else {
                stringStatus = "In-Active";
            }
            var cabtypeForm =
            {
                CabTypeID: CabTypeID,
                Description: description,
                SeatCapacity: seatcapacity,
                PricePers: PricePers,
                Remarks: remk,
                Status: stringStatus,
            }
            var url = $('#cabtypeForm')[0].action;
            $.ajax({
                type: "POST",
                url: url,
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ CabForm: cabtypeForm, FareList: FairDetail, ModelList: ModelDetail }),

                success: function (data) {
                    if (data.status == true) {

                        var extension = $('#ItemPicture').text().split('.').pop().toLowerCase();
                        //alert(extension);
                        if (extension != '') {
                            var typeId = data.cabtypeid;
                            var documentType = "Cab";
                            var documentId = 0;
                            var date = null;
                            var remarks = "Cab Image";
                            var document = {
                                DocumentId: documentId,
                                DocumentType: documentType,
                                TypeId: typeId,
                                Date: date,
                                Remarks: remarks,
                                DocumentExtension: extension,
                            }
                            $.ajax({
                                type: "POST",
                                url: '/documents/AttachDocumentsForPost/',
                                dataType: 'json',
                                contentType: 'application/json; charset=utf-8',
                                data: JSON.stringify({ 'doc': document }),
                                success: function (data) {
                                    if (data.status == true) {
                                        var bannerImage = $("#ItemPicture").val();
                                        var file = $('#ItemPicture').get(0).files;
                                        var documentFile = file[0];
                                        var extension = $('#ItemPicture').text().split('.').pop().toLowerCase();
                                        var documentIdWithDocumentTypeWithExtension = data.documentId + "_" + data.documentType + "_" + data.typeId + "_" + extension;
                                        var formData = new FormData();
                                        formData.append(file.name, documentFile);
                                        formData.append("DocumentName", $("#ItemPicture").text());

                                        var xhr = new XMLHttpRequest();
                                        var url = '/documents/UploadDocument/' + documentIdWithDocumentTypeWithExtension;
                                        xhr.open('POST', url, true);

                                        xhr.onload = function (e) {
                                            //var response = $.parseJSON(e.target.response);
                                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                    '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                    ' <strong>Success! </strong>' +
                                                    'Item Saved Succesfully.' +
                                                '</div>');
                                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                                $("#success-alert").slideUp(500);
                                                $('.alertDiv').html('');
                                            });
                                            location.reload();
                                        };
                                        xhr.send(formData);  // multipart/form-data
                                    }
                                    else {
                                        alert("Error! Please try again.");
                                    }
                                }
                            })
                        }else{
                            $('.alertDiv').html('<div class="alert alert-success" id="success-alert" style="margin-top:15px;">' +
                                                    '<button type="button" class="close" data-dismiss="alert">x</button>' +
                                                    ' <strong>Success! </strong>' +
                                                    'Cab Type Saved Succesfully.' +
                                                '</div>');
                            $("#success-alert").fadeTo(1000, 500).slideUp(500, function () {
                                $("#success-alert").slideUp(500);
                                $('.alertDiv').html('');
                            });
                            //$.notify("First Level Saved Successfully.", "success");
                            location.reload();
                        }
                    }
                    else {
                        alert(data.message);
                        $('#btnSavecabtype').prop('disabled', false);
                    }
                }
            })
            e.preventDefault();
        })
        $('#btnDeletecabtype').click(function () {
