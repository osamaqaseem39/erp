<style>
    .Acenter {
        text-align: center;
    }
</style>
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="widget-body">
        <div class="row">
            <div class="col-lg-2">
            </div>
            <div class="col-lg-10">
                <div class="input-group input-group-sm col-lg-8 col-md-5 col-sm-6 col-xs-12 pull-right">
                    <div class="input-group-btn">
                        <button id="btnSearchBrandCabType" type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">Description</button>
                        <ul class="dropdown-menu" id="ulSearchBrandCabType" style="cursor:pointer">
                            <li data-value="Description">
                                <a class="ListItem">Description</a>
                            </li>
                            <li data-value="Status">
                                <a class="ListItem">Status</a>
                            </li>
                        </ul>
                    </div>
                    <input class="form-control input-lg" type="text" placeholder="Search here..." name="txtSearch" id="txtSearchCabType">
                    <div class="input-group-btn">
                        <button type="button" id="btnSearchCabType" class="btn btn-default">
                            &nbsp;&nbsp;&nbsp;<i class="fa fa-fw fa-search fa-lg"></i>&nbsp;&nbsp;&nbsp;
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <table id="myTableCabType" class="table table-striped table-bordered table-hover" width="100%">
            <thead>
                <tr>
                    <th data-hide=""></th>
                    <th data-class="expand"><i class="fa fa-fw fa-info text-muted"></i>Description</th>
                    <th data-hide="phone">Seat Capacity</th>
                    <th data-hide="phone">Remarks</th>
                    <th data-hide="phone">Status</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    @*</div>

                    </div>
                </article>
            </div>
        </section>*@
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            tablet: 1024,
            phone: 380
        };

        $('#myTableCabType').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableCabType'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "ajax": {
                "url": "/CabType/GetAllCabType",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, customErrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = customErrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "CabTypeID", "width": "5%", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#cabtypeListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "Description", "name": "Description", "width": "40%", "autoWidth": true, "orderable": true, },
                    { "data": "SeatCapacity", "name": "SeatCapacity", "width": "15%", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    { "data": "Remarks", "name": "Remarks", "width": "30%", "autoWidth": true, "orderable": true, },
                    { "data": "Status", "name": "Status", "width": "15%", "class": "Acenter", "autoWidth": true, "orderable": true, },
                    
            ]
        });
        oTable = $('#myTableCabType').DataTable();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var CabTypeId = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/CabType/GetCabTypeById/" + CabTypeId,
                dataType: 'json',
                success: function (response) {
                    //response.data.ReportType;

                    var pathname = window.location.origin;
                    var vcomppath = "";
                    if (response.data.ImageName != "Nothing") {
                        vcomppath = pathname + "/FormsDocuments/Cab/" + response.data.ImageName;
                        //alert(vcomppath);
                        $("#DisplayImage").prop("src", vcomppath);
                        $('#ItemPicture').text(vcomppath);
                    } else {
                        $("#DisplayImage").prop("src", "");
                        $('#ItemPicture').text(null);
                    }

                    //alert($('#ItemPicture').text());
                    $('#ItemPicture').prop("disabled", false);
                    

                    $('#Description').prop("disabled", false);
                    $('#CabTypeID').val(response.data.CabTypeID);
                    $('#Description').val(response.data.Description);
                    $('#SeatCapacity').val(response.data.SeatCapacity);
                    $('#PricePers').val(response.data.PricePers);
                    
                    $('#Remarks').val(response.data.Remarks);

                    //$('.StatusSection').removeAttr("hidden");
                    if (response.data.Status == "Active") {
                        $('#Status').prop("checked", true);
                    }
                    else {
                        $('#Status').prop("checked", false);
                    }
                    $('#btnSaveCabType').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '47%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '47%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }

                    getFareDetail(CabTypeId);
                    getModelDetail(CabTypeId);
                }
            })
        })


        function getFareDetail(id) {
            $.ajax({
                type: "POST",
                url: "/CabType/GetCabTypeFareDetailById/" + id,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#invoiceDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                            "<a href='javascript:void(0);' class='btn btn-success editRowBtn' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                            "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtn' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                            "<span><input type='hidden' class='ItemID01' value=" + response.data[key].UptoKm + " />" + response.data[key].UptoKm + "</span>",
                            "<span><input type='hidden' class='ItemName01' value=" + response.data[key].FarePrice + " />" + response.data[key].FarePrice + "</span>",
                        ]).draw(false);
                    }
                }
            })
        }

        function getModelDetail(id) {
            $.ajax({
                type: "POST",
                url: "/CabType/GetCabTypeModelDetailById/" + id,
                dataType: 'json',
                success: function (response) {
                    var vtable = $('#ModelDetailTable').DataTable();
                    vtable.clear().draw();
                    for (var key in response.data) {
                        vtable.row.add([
                            "<a href='javascript:void(0);' class='btn btn-success editRowBtnM' title='Edit' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-edit'></i></a>",
                            "<a href='javascript:void(0);' class='btn btn-danger deleteRowBtnM' title='Delete' style='height: 25px; font-size: 12.5px;width:25px;line-height:23px'><i class='fa fa-times'></i></a>",
                            "<span><input type='hidden' class='ItemID01' value=" + response.data[key].CarModel + " />" + response.data[key].CarModel + "</span>",
                        ]).draw(false);
                    }
                }
            })
        }






        $('#btnSearchCabType').click(function () {
            SearchItem();
        });
        $('#txtSearchCabType').on('keypress', function (event) {
            if (event.keyCode == 13) {
                SearchItem();
            }
        });
        function SearchItem() {
            var BElement = $("#btnSearchBrandCabType");
            if (BElement.html().trim() == 'Description') {
                oTable.columns(0).search($('#txtSearchCabType').val().trim()).draw();
            }
            else if (BElement.html().trim() == 'Status') {
                oTable.columns(1).search($('#txtSearchCabType').val().trim()).draw();
            }
            else {
                alert("Error! try again.");
            }
        }
        //$('#btnRefreshCabType').click(function () {
        //    oTable.ajax.reload(null,false);
        //});
        $("#ulSearchBrandCabType").on("click", "a", function (e) {
            e.preventDefault();
            var $this = $(this).parent();
            $this.addClass("select").siblings().removeClass("select");
            $("#btnSearchBrandCabType").html($this.data("value"));
        })
    });
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
</script>
