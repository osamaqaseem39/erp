<style>
    .Acenter {
        text-align: center;
    }

    .Aright {
        text-align: right;
    }
</style>
@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="widget-body">
        <div class="well smart-form" style="border: 1px solid #bdbdbd; background-color: #F7F7F7;padding:10px">
            <div class="row">
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 200px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="CustomerCheckbox" type="checkbox" name="CustomerCheckbox" checked><i></i>
                                    <span style="font-size: 11px">Supplier / Driver</span>
                                </label>
                            </td>
                            <td style="width: 70%; padding-left: 3px; " id="">
                                <label class="select">
                                    <i class="append fa fa-caret-down"></i>
                                    @Html.DropDownListFor(model => model.DetailCode, ViewBag.DetailCode as SelectList, new { @style = "width:100%", id = "SearchDetailCode" })
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-6">
                    <table class="" style="">
                        <tr>
                            <td style="width: 300px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="ComputerNoCheckbox" type="checkbox" name="ComputerNoCheckbox"><i></i>
                                    <span style="font-size:11px">Invoice No.</span>
                                </label>
                            </td>
                            <td style=" width:60%;padding-left: 3px; " id="">
                                <label class="input">
                                    <input type="text" id="SearchComputerNo" value="" style="width:100%" disabled />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row" style="margin-top:10px">
                <div class="col col-md-3">
                    <table class="" style="">
                        <tr>
                            <td style="width: 80px; padding-right: 3px; padding-left: 7px" id="">
                                <label class="checkbox pull-left" style="margin-top:2px">
                                    <input id="DateCheckbox" type="checkbox" name="DateCheckbox" checked /><i></i>
                                    <span style="font-size:11px">&nbsp;</span>
                                </label>
                            </td>
                            <td style="width: 85%; padding-right: 3px; padding-left: 0px" id="">

                                <label style="font-size:13px">Date</label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-5">
                </div>
                <div class="col col-md-4">
                </div>
            </div>
            <div class="row" style="margin-top:10px;padding-left:40px" id="DatesRow">
                <div class="col col-md-4">
                    <table class="" style="">
                        <tr>
                            <td style="width: 10%; padding-right: 3px; padding-left: 7px" id=""></td>
                            <td style="width: 90%; padding-right: 3px; padding-left: 7px" id="">
                                <label>From</label>
                                <label class="input">
                                    <i class="icon-prepend fa fa-user"></i>
                                    <input type="date" name="SearchFromDate" id="SearchFromDate" autocomplete="off" required />
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col col-md-4">
                    <label>To</label>
                    <label class="input">
                        <i class="icon-prepend fa fa-user"></i>
                        <input type="date" name="SearchToDate" id="SearchToDate" autocomplete="off" required />
                    </label>
                </div>

            </div>
            <div class="row" style="margin-top:10px">
                <table class="pull-right" style="margin-right:14px">
                    <tr>
                        <td style="padding-left:7px">
                            <button type="button" id="btnSearchSale" class="btn btn-primary" style="width: 65px; height: 25px; font-size: 13px; margin-bottom: 8px; color: white; line-height: 5px;">
                                Search
                            </button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <table id="myTableSale" class="table table-striped table-bordered table-hover" width="100%">
            <thead>
                <tr>
                    <th data-hide=""></th>
                    <th data-class="expand" style="width:130px"><i class="fa fa-fw fa-hashtag text-muted"></i>Invoice No.</th>
                    <th data-hide="phone"><i class="fa fa-user text-muted"></i> Supplier/Driver</th>
                    <th data-hide="phone,tablet"><i class="fa fa-hashtag text-muted"></i> Job No.</th>
                    <th data-hide="phone"><i class="fa fa-calendar text-muted"></i> Date</th>
                    <th data-hide="phone"><i class="fa fa-money-bill-alt text-muted"></i> Net Amount</th>
                    <th data-hide="phone,tablet,desktop"> Pickup</th>
                    <th data-hide="phone,tablet,desktop"> Dropoff</th>
                    <th data-hide="phone,tablet,desktop"> Remarks</th>
                </tr>
            </thead>
            <tbody>
                <tr class="noRecordTr">
                    <td class="" colspan="11" style="text-align:center;padding:10px">No Record Found.</td>
                </tr>
            </tbody>
        </table>
    </div>
    @*</div>

                    </div>
                </article>
            </div>
        </section>*@
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#SearchDetailCode').select2({
            dropdownParent: $("#SaleListModal")
        });
        $('#SearchDetailCode').val(null).trigger('change');
        
        GetTodayDateSearch();
        SetSession();
        $(document).on('click', '.selectBtn', function (e) {
            e.preventDefault();
            var invoiceNo = $(this).attr("data-value");
            $.ajax({
                type: "POST",
                url: "/Bill/GetBillById/" + invoiceNo,
                dataType: 'json',
                success: function (response) {
                    $('#DisableOrNot').val(1);
                    
                    $('#ReceivedDetailCode').select2().enable(true);
                    $('#SalesmanID').select2().enable(true);
                    $('#Date').prop("disabled", false);
                    //$('#ReferenceNo').prop("disabled", false);
                    //$('#CreditDays').prop("disabled", false);
                    $('#DiscountType').prop("disabled", false);
                    $('#DiscountAmount').prop("disabled", false);
                    $('#Overhead').prop("disabled", false);
                    $('#Freight').prop("disabled", false);
                    $('#Remarks').prop("disabled", false);
                    $('#Paid').prop("disabled", false);
                    $('#ShowBalance').prop("disabled", false);
                    $('#Transporter').prop("disabled", false);
                    $('#BiltyNo').prop("disabled", false);
                    $('#BiltyDate').prop("disabled", false);
                    //$('#BiltyPending').prop("disabled", false);
                    $('#Packing').prop("disabled", false);
                    $('#HiddenStock').val(0);
                    
                    $('#SaleDiscountTypeHidden').val("%");
                    $('#SaleDiscountAmountHidden').val(0);
                    $('#invoiceNoSection').removeAttr("hidden");
                    $('#IsNewOrEdit').val("Edit");
                    var invoiceType = response.data.InvoiceType;
                    $('#HiddenInvoiceType').val(invoiceType);
                    if (response.data.ShowBalance == 1) {
                        $('#ShowBalance').prop("checked", true);
                    }
                    else {
                        $('#ShowBalance').prop("checked", false);
                    }
                    $('#IsEdit').val(0);
                    $('#SaleInvoiceNo').val(response.data.ComputerNo);
                    $('#SaleInvoiceNoSpan').html(response.data.ComputerNo);
                    $('#MainDetailCode').val(response.data.DetailCode);
                    if (response.data.DetailName == null || response.data.DetailName == '') {
                        response.data.DetailName = response.data.CashCustomerName;
                    }
                    $('#CustomerName').val(response.data.DetailName);
                    $('#Date').val(getDate(response.data.RecordDate));
                    $('#ReferenceNo').val(response.data.RefrenceNo);
                    $('#CreditDays').val(response.data.CreditDays);
                    $('#DiscountType').val(response.data.DiscountType);
                    $('#DiscountAmount').val(response.data.Discount);
                    $('#NetDiscount').val(response.data.NetDiscount);
                    $('#Overhead').val(response.data.Overhead);
                    $('#Freight').val(response.data.Freight);

                    $('#GrossTotal').html(ReplaceNumberWithCommas(parseFloat(response.data.GrossTotal).toFixed(2)));
                    $('#NetAmount').html(ReplaceNumberWithCommas(parseFloat(response.data.NetAmount).toFixed(2)));

                    $('#Remarks').val(response.data.Remarks);
                    $('#PreviousBalance').html(ReplaceNumberWithCommas(parseFloat(response.data.PreviousBalance).toFixed(2)));
                    if (response.data.Received == 1) {
                        $('#PaidRow').removeAttr("hidden");
                        $('#Paid').prop("checked",true);
                    }
                    else {
                        $('#Paid').prop("checked", false);
                        $('#PaidRow').attr("hidden", "hidden");
                    }
                    $('#ReceivedDetailCode').val(response.data.ReceivedDetailCode).trigger('change');
                    $('#PaidAmount').val(response.data.ReceivedAmount);
                    $('#PaidRemarks').val(response.data.ReceivedRemarks);
                    $('#BalanceAmount').val(response.data.BalanceAmount);

                    //if (response.data.ExtraOrNot == 1) {
                    //    $('#ExtraInfoOrNot').val(1);
                    //    $('#ExtraInformation').removeAttr("hidden");
                    //}
                    //else {
                    //    $('#ExtraInfoOrNot').val(0);
                    //    $('#ExtraInformation').attr("hidden", "hidden");
                    //}
                    $('#Transporter').val(response.data.Transporter);
                    $('#BiltyNo').val(response.data.BiltyNo);
                    $('#Packing').val(response.data.BiltyPacking);
                    $('#BiltyDate').val(getDate(response.data.BiltyDate));
                    $('#SalesmanID').select2('val', response.data.SalesmanID);
                    $('#BiltyPending').val(response.data.BiltyPending);

                    $('#HiddenComputerNo').val('0');
                    $('#HiddenCompositeKey').val('0');
                    
                    $('.DeleteSection').removeAttr("hidden");
                    $('.PreviousBalance').removeAttr("hidden");
                    $('.GrossTotal').removeAttr("hidden");
                    //$('.heading-1').css('margin-top', '130px');
                    $('.NetAmount').removeAttr("hidden");
                   

                    $('#btnSaveSale').prop('disabled', false);
                    $('#btnHold').prop('disabled', false);
                    $('#btnSaveAndPrintSale').prop('disabled', false);
                    if ($('#CanChange').val() == 1) {
                        $('#saveTd').removeAttr("hidden");
                        $('#documentTd').removeAttr("hidden");
                        $('#saveAndPrintTd').removeAttr("hidden");
                        $('#holdTd').removeAttr("hidden");
                        $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                    }
                    else {
                        $('#saveTd').attr("hidden", "hidden");
                        $('#holdTd').attr("hidden", "hidden");
                        $('#documentTd').attr("hidden", "hidden");
                        $('#saveAndPrintTd').attr("hidden", "hidden");
                        if ($('#CanSave').val() == 0) {
                            $('#listTd').css({ 'width': '41%', 'text-align': 'right' });
                        }
                        else {
                            $('#listTd').css({ 'width': '3%', 'text-align': 'left' });
                        }
                    }


                    if ($('#CanSave').val() == 0) {
                        $('#saveTd').css({ 'width': '41%', 'text-align': 'right' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }
                    else {
                        $('#addTd').removeAttr("hidden");
                        $('#saveTd').css({ 'width': '3%', 'text-align': 'left' });
                        $('#saveAndPrintTd').css({ 'width': '3%', 'text-align': 'right' });
                    }


                    if ($('#CanDelete').val() == 1) {
                        $('.deleteRow').removeAttr("hidden");
                    }
                    
                }
            })
        })

    });
    $('#CustomerCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchDetailCode').prop("disabled", false);
        }
        else {
            $('#SearchDetailCode').prop("disabled", true);
            $('#SearchDetailCode').val(null).trigger('change');
        }
    })
    
    $('#DateCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#DatesRow').removeAttr("hidden");
        }
        else {
            $('#DatesRow').attr("hidden", "hidden");
        }
    })
    $('#ComputerNoCheckbox').change(function () {
        if ($(this).is(":checked")) {
            $('#SearchComputerNo').prop("disabled", false);
        }
        else {
            $('#SearchComputerNo').prop("disabled", true);
            $('#SearchComputerNo').val('');
        }
    })
    $('#btnSearchSale').click(function () {
        SetSession();
    })
    function SetSession() {
        var CustomerCheckbox = $('#CustomerCheckbox').is(":checked");
        var CustomerId = $('#SearchDetailCode').val();
        var cashCustomerNameCheckbox = false;
        var cashCustomerName = '';

        var cashCreditTypeCheckbox = false;
        var cashCreditType = '';

        var computerNoCheckbox = $('#ComputerNoCheckbox').is(":checked");
        var computerNo = $('#SearchComputerNo').val();

        var dateCheckbox = $('#DateCheckbox').is(":checked");
        var fromDate = $('#SearchFromDate').val();
        var toDate = $('#SearchToDate').val();
        $('#btnSearchSale').prop("disabled", true);
        $.ajax({
            type: "POST",
            url: "/Bill/SetSessionsForSaleList/",
            dataType: 'json',
            data: {
                'CustomerCheckbox': CustomerCheckbox, 'CustomerId': CustomerId, 'dateCheckbox': dateCheckbox,
                'fromDate': fromDate, 'toDate': toDate, 'cashCustomerCheckbox': cashCustomerNameCheckbox,
                'cashCustomerName': cashCustomerName, 'cashCreditTypeCheckbox': cashCreditTypeCheckbox, 'cashCreditType': cashCreditType,
                'computerNoCheckbox': computerNoCheckbox, 'computerNo': computerNo,
            },
            success: function (response) {
                getInvoices();

            }
        })
    }
    function getInvoices() {
        var responsiveHelper_dt_basic = undefined;
        var responsiveHelper_datatable_fixed_column = undefined;
        var responsiveHelper_datatable_col_reorder = undefined;
        var responsiveHelper_datatable_tabletools = undefined;

        var breakpointDefinition = {
            desktop: 1920,
            tablet: 1024,
            phone: 380
        };

        $('#myTableSale').dataTable({
            "sDom": '<"top">rt<"bottom"lp i><"clear">',
            "autoWidth": true,
            "preDrawCallback": function () {
                if (!responsiveHelper_dt_basic) {
                    responsiveHelper_dt_basic = new ResponsiveDatatablesHelper($('#myTableSale'), breakpointDefinition);
                }
            },
            "rowCallback": function (nRow) {
                responsiveHelper_dt_basic.createExpandIcon(nRow);
            },
            "drawCallback": function (oSettings) {
                responsiveHelper_dt_basic.respond();
            },
            "bLengthChange": true,
            "processing": true,
            "serverSide": true,
            "bDestroy": true,
            //"scrollX": true,
            "ajax": {
                "url": "/Bill/GetAllBills",
                "type": "POST",
                "datatype": "json",
                error: function (xhr, httpStatusMessage, CustomerrorMessage) {
                    if (xhr.status === 410) {
                        window.location.href = CustomerrorMessage;
                    }
                }
            },
            "columns": [
                {
                    "data": "ComputerNo", "width": "20px", "class": "Acenter", "orderable": false, "render": function (data) {
                        if ($('#CanChange').val() == 1 || $('#CanDelete').val() == 1) {
                            return '<a href="javascript:void(0);"  data-toggle="modal" data-target="#SaleListModal" class="btn btn-primary selectBtn" data-value="' + data + '"  title="Select" style=" text-align: center; height: 25px;width:25px; font-size: 12px;line-height:0px;color:#fff !important;background-color:#428bca !important;border-color:#357ebd !important;border-radius:2px "><i class="fa fa-edit" style="margin-left:-6px;"></i></a>';
                        }
                        else {
                            return '';
                        }
                    }
                },
                    { "data": "ComputerNo", "name": "ComputerNo", "autoWidth": true, "orderable": true },
                    { "data": "DetailName", "name": "DetailName", "autoWidth": true, "orderable": true },
                     { "data": "RefrenceNo", "name": "RefrenceNo", "orderable": true, "autoWidth": true },
                     {
                         "data": "RecordDate", "class": "Acenter", "orderable": false, 'render': function (date) {
                             if (date != null) {
                                 var date = new Date(parseInt(date.substr(6)));
                                 var day = date.getDate();
                                 var month = date.getMonth() + 1;
                                 if (parseFloat(day) < 10) {
                                     day = "0" + day;
                                 }
                                 if (parseFloat(month) < 10) {
                                     month = "0" + month;
                                 }
                                 return day + "-" + month + "-" + date.getFullYear();
                             }
                             else {
                                 return "";
                             }
                         }
                     },
                     { "data": "NetAmount", "name": "NetAmount", "autoWidth": true, "orderable": true, "class": "Aright" },
                     { "data": "PickupLocation", "name": "PickupLocation", "autoWidth": true, "orderable": true },
                     { "data": "DropOffLocation", "name": "DropOffLocation", "autoWidth": true, "orderable": true },
                     { "data": "Remarks", "name": "Remarks", "orderable": true, "autoWidth": true },
                     

            ]
        });
        $('#btnSearchSale').prop("disabled", false);
    }
    function NumberPostiveWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            charCode != 8 && charCode != 127 &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function GetTodayDateSearch() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!

        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd;
        }
        if (mm < 10) {
            mm = '0' + mm;
        }
        var today = yyyy + '-' + mm + '-' + dd;
        var dt = new Date(today);
        dt.setDate(dt.getDate() - 7);
        var dd2 = dt.getDate();
        var mm2 = dt.getMonth() + 1; //January is 0!

        var yyyy2 = dt.getFullYear();
        if (dd2 < 10) {
            dd2 = '0' + dd2;
        }
        if (mm2 < 10) {
            mm2 = '0' + mm2;
        }
        var today2 = yyyy2 + '-' + mm2 + '-' + dd2;
        $('#SearchFromDate').val(today2);
        $('#SearchToDate').val(today);
    }
    function NumberPostiveNegativeWithDecimal(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&
            (charCode < 48 || charCode > 57))
            evt.preventDefault();
        return true;
    }
    function getDate(date) {
        if (date == null) {
            return null;
        }
        else {
            var newdate = new Date(parseInt(date.substr(6)));
            var day = newdate.getDate();
            var month = newdate.getMonth() + 1;
            if (digits_count(day) == 1 || digits_count(day) == 0) {
                day = "0" + day;
            }
            if (digits_count(month) == 1 || digits_count(month) == 0) {
                month = "0" + month;
            }
            var year = newdate.getFullYear();
            var today = year + '-' + month + '-' + (day);
            if (year == 1900) {
                return null;
            }
            else {
                return today;
            }
        }
    }
    function digits_count(n) {
        var count = 0;
        if (n > 1)
            ++count;
        while (n / 10 >= 1) {
            n /= 10;
            ++count;
        }
        return count;
    }
</script>
