@model POS.Models.clsInvoice
<div id="content" class="tablecontainer" style=" padding: 12px 30px;">
    <div class="alertDiv">

    </div>
    <div class="modal fade" id="SaleListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header defaultBackgroundColor" style="height:50px;">
                    <h4 class="modal-title" style="color:white;margin-top:-4px;">Invoices List</h4>
                    <button type="button" class="close" data-dismiss="modal" style="color: white !important; margin-top: -25px; font-size: 30px;z-index:1;">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="SaleListDiv"></div>
                </div>
                <!-- Modal footer -->
            </div>
        </div>
    </div>
    <div class="modal fade" id="SaleHoldListModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);">
