        function getMainNetAmount() {
            var grossTotal = parseFloat(ReplaceCommas($('#GrossTotal').html()));
            var netAmount = 0;
            var discountType = $('#DiscountType').val();
            var discountAmount = 0;
            var netDiscount = 0;
            if (discountType.trim() != '') {
                discountAmount = $('#DiscountAmount').val();
                if (discountAmount == '' || discountAmount == null || isNaN(discountAmount)) {
                    discountAmount = 0;
                }
            }
            if (discountType.trim() == '%') {
                netDiscount = parseFloat(discountAmount) / 100 * grossTotal;
                netDiscount = parseFloat(netDiscount.toFixed(2));
            }
            else if (discountType.trim() == 'Rs') {
                netDiscount = parseFloat(discountAmount).toFixed(2);
            }
            $('#NetDiscount').val(netDiscount);
            var overHead = $('#Overhead').val();
            var freight = $('#Freight').val();
            if (overHead == '' || overHead == null || isNaN(overHead)) {
                overHead = 0;
            }
            if (freight == '' || freight == null || isNaN(freight)) {
                freight = 0;
            }
            netAmount = grossTotal - netDiscount + parseFloat(overHead) + parseFloat(freight);
            netAmount = netAmount.toFixed(2);
            $('#NetAmount').html(ReplaceNumberWithCommas(netAmount));
            getPaidBalanceAmount();
        }

        $('#PaidAmount').keyup(function () {
            getPaidBalanceAmount();
        })
        function getPaidBalanceAmount() {
            var netAmount = parseFloat(ReplaceCommas($('#NetAmount').html()));
            var balance = 0;
            var paidAmount = $('#PaidAmount').val();
            if (paidAmount == '' || paidAmount == null || isNaN(paidAmount)) {
                paidAmount = 0;
            }
            balance = netAmount - parseFloat(paidAmount);
            //if (balance < 0) {
            //    balance = 0;
            //}
            $('#BalanceAmount').val(balance.toFixed(2));
        }
        
